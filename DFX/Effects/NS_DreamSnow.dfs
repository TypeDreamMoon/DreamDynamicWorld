// DreamWeather: snow around the view (GPU).
//
// Driven like the rain by UDreamWeatherFXSubsystem: the fall paths it traced for the snow (slow and far blown,
// so they slant much more than rain) and how hard it snows. Flakes fall along the paths, each at its own
// path's velocity, with a gentle side-to-side sway that comes back to the path, and die where it lands.
System(Name="Weather/Effects/NS_DreamSnow", Root="Plugin.DreamDynamicWorld")
{
    Settings = {
        ModulePaths = ["/DreamDynamicWorld/Weather/Modules"];
        WarmupTime  = 0.0;
        FixedBounds = box(-8000, -8000, -12000, 8000, 8000, 6000);
    }

    Properties = {
        DI<ArrayFloat4> Paths;
        DI<ArrayFloat3> Starts;
        DI<ArrayFloat3> Normals;
        float  DropRate     = 0.0                [ Group="Amount"; Description="Flakes spawned per second." ];
        float  SplashRate   = 0.0                [ Group="Amount"; Description="Unused by snow." ];
        float  Anywhere     = 0.0                [ Group="Amount"; Description="Share of the flakes spawned now that start part way down their path (1 for the frame that fills the air at once)." ];
        float  Sway         = 35.0               [ Group="Motion"; Description="Side-to-side speed of a flake, cm/s." ];
        float  FlakeSize    = 5.0                [ Group="Look"; Description="Flake size, cm (larger than real flakes, so far ones still read)." ];
        Color  Tint         = (0.95, 0.97, 1.0, 0.85) [ Group="Look" ];
    }

    Emitter Flakes
    {
        Settings = {
            SimTarget          = GPU;
            LocalSpace         = false;
            Determinism        = false;
            AllocationMode     = Fixed;
            PreAllocationCount = 65536;
            FixedBounds        = box(-8000, -8000, -12000, 8000, 8000, 6000);
        }

        EmitterUpdate = {
            EmitterState(LifeCycleMode = Self, LoopBehavior = Infinite);
            SpawnRate(SpawnRate = User.DropRate);
        }

        ParticleSpawn = {
            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode         = DirectSet,
                Lifetime             = 20.0,
                ColorMode            = DirectSet,
                Color                = User.Tint,
                SpriteSizeMode       = RandomUniform,
                UniformSpriteSizeMin = hlsl { User.FlakeSize * 0.6 },
                UniformSpriteSizeMax = hlsl { User.FlakeSize * 1.4 }
            );
            DreamFallPath(Paths = User.Paths, Starts = User.Starts, Normals = User.Normals, AtEnd = false, Anywhere = User.Anywhere);
            float Particles.SnowPhase = hlsl { rand(6.2831853) };
        }

        ParticleUpdate = {
            ParticleState();
            // Sway around the path: the sideways velocity is a sine, so the flake keeps coming back to its path.
            Vector Particles.Velocity = hlsl {
                Particles.DreamPathVelocity + float3(sin(Particles.Age * 1.7 + Particles.SnowPhase),
                                           cos(Particles.Age * 1.3 + Particles.SnowPhase * 1.7), 0.0) * User.Sway
            };
            SolveForcesAndVelocity();
        }

        SpriteRenderer Flake
        {
            Material   = "Plugin.DreamDynamicWorld:Weather/M_DreamSnowFlake";
            Alignment  = Unaligned;
            FacingMode = FaceCamera;
            SortMode   = None;

            Bind SpriteSize -> Particles.SpriteSize;
            Bind Color      -> Particles.Color;
        }
    }
}
