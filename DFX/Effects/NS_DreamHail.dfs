// DreamWeather: hail around the view (GPU).
//
// Driven like the rain by UDreamWeatherFXSubsystem: the fall paths it traced for the hail (fast and hardly blown) and
// how hard it hails (DropRate / SplashRate). Pellets fall along the paths and die where they land; where landed paths
// end, pellets bounce up off the surface and fall back, a hop or two before they settle. Nothing here queries
// collision.
System(Name="Weather/Effects/NS_DreamHail", Root="Plugin.DreamDynamicWorld")
{
    Settings = {
        ModulePaths = ["/DreamDynamicWorld/Weather/Modules"];
        WarmupTime  = 0.0;
        FixedBounds = box(-8000, -8000, -12000, 8000, 8000, 6000);
    }

    Properties = {
        DI<ArrayFloat4> Paths;
        DI<ArrayFloat3> Starts;
        DI<ArrayFloat3> Normals;
        float  DropRate     = 0.0                [ Group="Amount"; Description="Pellets spawned per second." ];
        float  SplashRate   = 0.0                [ Group="Amount"; Description="Bounces spawned per second." ];
        float  Anywhere     = 0.0                [ Group="Amount"; Description="Share of the pellets spawned now that start part way down their path (1 for the frame that fills the air at once)." ];
        float  WindResponse = 0.05               [ Group="Motion"; Description="How much of the wind's deviation the pellets take (the wind field gives it; hail hardly any)." ];
        float  BounceSpeed  = 320.0              [ Group="Motion"; Description="How fast a pellet leaves the surface, cm/s (the fastest)." ];
        float  PelletSize   = 5.5                [ Group="Look"; Description="Pellet size, cm (larger than most hail, so far ones still read)." ];
        float  Scatter      = 70.0               [ Group="Look"; Description="cm a pellet strays sideways off its fall path, so pellets do not line up in beads along the paths." ];
        float  PelletStretch = 2.2               [ Group="Look"; Description="A falling pellet's length over its width: a little motion blur (rain's streaks are thirty times their width)." ];
        Color  Tint         = (1.6, 1.6, 1.65, 1.0) [ Group="Look"; Description="Over 1 lifts it above the light around it: hail is icy white even under a dark sky." ];
    }

    Emitter Pellets
    {
        Settings = {
            SimTarget          = GPU;
            LocalSpace         = false;
            Determinism        = false;
            AllocationMode     = Fixed;
            PreAllocationCount = 32768;
            FixedBounds        = box(-8000, -8000, -12000, 8000, 8000, 6000);
        }

        EmitterUpdate = {
            EmitterState(LifeCycleMode = Self, LoopBehavior = Infinite);
            SpawnRate(SpawnRate = User.DropRate);
        }

        ParticleSpawn = {
            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode      = DirectSet,
                Lifetime          = 3.0,
                ColorMode         = DirectSet,
                Color          = User.Tint,
                SpriteSizeMode = NonUniform,
                SpriteSize     = hlsl { float2(User.PelletSize, User.PelletSize * User.PelletStretch) }
            );
            DreamFallPath(Paths = User.Paths, Starts = User.Starts, Normals = User.Normals, AtEnd = false, Anywhere = User.Anywhere, Scatter = User.Scatter);
        }

        ParticleUpdate = {
            ParticleState();
            SolveForcesAndVelocity();
        }

        // Stretched along the fall a little (a short blur, not a streak), so the pellets read as moving at a distance.
        SpriteRenderer Pellet
        {
            Material   = "Plugin.DreamDynamicWorld:Weather/M_DreamSnowFlake";
            Alignment  = VelocityAligned;
            FacingMode = FaceCamera;
            SortMode   = None;

            Bind SpriteSize -> Particles.SpriteSize;
            Bind Color      -> Particles.Color;
        }
    }

    Emitter Bounces
    {
        Settings = {
            SimTarget          = GPU;
            LocalSpace         = false;
            Determinism        = false;
            AllocationMode     = Fixed;
            PreAllocationCount = 8192;
            FixedBounds        = box(-8000, -8000, -12000, 8000, 8000, 6000);
        }

        EmitterUpdate = {
            EmitterState(LifeCycleMode = Self, LoopBehavior = Infinite);
            SpawnRate(SpawnRate = User.SplashRate);
        }

        ParticleSpawn = {
            Spawn/Initialization/V2/InitializeParticle(
                LifetimeMode      = Random,
                LifetimeMin       = 0.35,
                LifetimeMax       = 0.8,
                ColorMode         = DirectSet,
                Color             = User.Tint,
                SpriteSizeMode    = Uniform,
                UniformSpriteSize = User.PelletSize
            );
            DreamFallPath(Paths = User.Paths, Starts = User.Starts, Normals = User.Normals, AtEnd = true);
            // Off the surface: up along its normal, at most BounceSpeed, scattered a little to the side -- one expression
            // (the assignments of one block all read the values from before it).
            Vector Particles.Velocity = hlsl {
                Particles.DreamSurfaceNormal * (User.BounceSpeed * (0.35 + rand(0.65)))
                + float3(rand(1.0) - 0.5, rand(1.0) - 0.5, 0.0) * (User.BounceSpeed * 0.6)
            };
        }

        ParticleUpdate = {
            ParticleState();
            GravityForce(Gravity = hlsl { float3(0.0, 0.0, -980.0) });
            SolveForcesAndVelocity();
        }

        SpriteRenderer Hop
        {
            Material   = "Plugin.DreamDynamicWorld:Weather/M_DreamSnowFlake";
            Alignment  = Unaligned;
            FacingMode = FaceCamera;
            SortMode   = None;

            Bind SpriteSize -> Particles.SpriteSize;
            Bind Color      -> Particles.Color;
        }
    }
}
