//
// Ground fog marched as a participating medium: the fog of a terrain fog (ADreamTerrainFog) or a fog bank
// (ADreamFogBank) drawn by M_DreamGroundFog over the box it fills. Plain HLSL like the cloud march it is built on
// (DreamCloudMarch.ush: the stepping, DreamCloudLight.ush: the light): every input a function argument.
//
// The fog is a layer over the ground, given by a small map over the box (one texel a cell of the terrain fog's grid,
// bilinear): r the ground's height (cm, from the map's origin), g how deep the cold air pools there at full radiation
// fog (the hollow, no deeper than the pool), b 1 where there is ground. With the fog's state it makes, at a point:
//   - the pooled fog: filling the hollow to Radiation * g (or the advection fog's level over the lowest ground, the
//     higher), dense to near its top and thinning over its upper half;
//   - the mist: a thin layer over all the ground, thinning upward over MistThickness;
// both broken up by a 3D noise that drifts with the wind (DDW_FogDrift) and churns slowly, which also lifts and lowers
// their tops, so the fog lies in billows and patches with soft edges rather than in slabs. A fog bank is the same with
// a flat ground and the mist alone.
//
// The light: the sun (or the moon) through the fog above the sample -- its optical depth up to the fog's top along the
// light, in closed form for a layer, so the top of a fog bank catches the low sun and its depths go grey --, scattered
// with the clouds' phase and multiple scattering octaves; and the sky above, less deep inside.
//
// ---------------------------------------------------------------------------------------------------------------------

#ifndef DREAM_GROUNDFOG_USH
#define DREAM_GROUNDFOG_USH

#include "/Plugin/DreamDynamicWorld/Private/DreamCloudMarch.ush"
#include "/Plugin/DreamDynamicWorld/Private/DreamCloudLight.ush"

struct FDGroundFog
{
	float3 Origin;      // the map's centre (world cm): its texels span Origin.xy +- Area
	float2 Area;
	float EdgeFade;     // the share of the map at its rim the fog fades out over
	float Radiation;    // 0..1
	float Advection;    // 0..1
	float Lowest;       // the lowest ground (cm, from Origin.z)
	float AdvectionDepth;
	float MistThickness;
	float SigmaPool;    // extinction (per cm) of the pooled fog, and of the mist
	float SigmaMist;
	float InvNoise;     // 1 / the noise's size (cm)
	float NoiseAmount;  // 0 smooth layers .. 1 billows and patches
	float3 Drift;       // how far the noise has moved (cm)
	float DetailNear;   // within this distance (cm) a finer octave keeps the fog from going soft close up
	float ShadowSoft;   // over how much height (cm) the terrain's shadow edge is soft
};

struct FDGroundFogLight
{
	float3 Dir;         // toward the light
	float3 Sun;         // the light's illuminance, coloured
	float3 SkyTop;      // the sky's radiance from above, and from below (the ground's bounce)
	float3 SkyBottom;
	float4 CloudMap;    // the sky's cloud shadow map: its middle (world cm), 1 / its width, how much of the light it takes
	float CloudBase;    // the cloud layer's base (world cm)
};

// How much of the main light reaches X past the clouds: up the light to the cloud layer's base, then the sky's cloud
// shadow map there (whole past its edge, or when the sky does not draw its clouds).
float DGF_CloudLight(FDGroundFogLight Lt, float3 X, Texture2D CloudShadow, SamplerState CloudShadowSampler)
{
	if (Lt.CloudMap.w <= 0.0)
	{
		return 1.0;
	}
	float Up = max(Lt.CloudBase - X.z, 0.0) / max(Lt.Dir.z, 0.05);
	float2 UV = (X.xy + Lt.Dir.xy * Up - Lt.CloudMap.xy) * Lt.CloudMap.z + 0.5;
	float Inside = saturate(min(min(UV.x, 1.0 - UV.x), min(UV.y, 1.0 - UV.y)) * 10.0);
	float Through = CloudShadow.SampleLevel(CloudShadowSampler, saturate(UV), 0).r;
	return lerp(1.0, Through, Lt.CloudMap.w * Inside);
}

// The fog at X: its extinction (per cm), the fog's top over the ground there (world cm, out) and the sample's height in
// the fog (0 at the ground .. 1 at its top, out).
float DGF_Density(FDGroundFog F, float3 X, float Distance, float Mip, Texture2D Layer, SamplerState LayerSampler, Texture3D Noise,
	SamplerState NoiseSampler, out float Top, out float Height01, out float ShadowTop)
{
	float2 UV = (X.xy - F.Origin.xy) / (2.0 * F.Area) + 0.5;
	float4 L = Layer.SampleLevel(LayerSampler, UV, 0);
	float Ground = F.Origin.z + L.r;
	ShadowTop = F.Origin.z + L.a;
	// Toward the map's rim the layer thins out to nothing (rather than ending in a wall where the box does).
	float2 Rim = abs(UV - 0.5) * 2.0;
	float Edge = 1.0 - smoothstep(1.0 - max(F.EdgeFade, 1.0e-3), 1.0, max(Rim.x, Rim.y));
	float Pool = F.Radiation * L.g;
	float Carried = max(F.Lowest + F.Advection * F.AdvectionDepth - L.r, 0.0);
	float Depth = max(Pool, Carried) * Edge;
	float Mist = F.Radiation * F.MistThickness * Edge;
	float H = X.z - Ground;

	// Billows: the clouds' noise (its low octaves: the Perlin-Worley and the first Worley), a finer one near the view.
	float4 N = Noise.SampleLevel(NoiseSampler, (X - F.Drift) * F.InvNoise, Mip);
	float Billow = saturate(0.6 * N.r + 0.4 * N.g);
	if (Distance < F.DetailNear)
	{
		float4 M = Noise.SampleLevel(NoiseSampler, (X - 1.6 * F.Drift) * (3.7 * F.InvNoise), Mip + 1.9);
		float Near = 1.0 - smoothstep(0.5 * F.DetailNear, F.DetailNear, Distance);
		Billow = saturate(Billow + Near * 0.35 * (M.g - 0.5));
	}
	float Lumpy = lerp(1.0, 0.45 + 1.1 * Billow, F.NoiseAmount);
	float DepthN = Depth * Lumpy;
	float MistN = Mist * Lumpy;

	float Pooled = DepthN > 1.0 ? 1.0 - smoothstep(0.45 * DepthN, DepthN, H) : 0.0;
	float Misty = MistN > 1.0 ? 1.0 - smoothstep(0.25 * MistN, 1.2 * MistN, H) : 0.0;
	float Patches = lerp(1.0, saturate(1.6 * Billow - 0.15), 0.7 * F.NoiseAmount);

	Top = Ground + max(DepthN, 2.0 * MistN);
	Height01 = saturate(H / max(Top - Ground, 1.0));
	return (F.SigmaPool * Pooled + F.SigmaMist * Misty) * saturate(L.b) * Edge * Patches;
}

// The fog along the ray Camera + Dir * t, t in T0..T1 (cm): (light it adds, premultiplied; the share of what is behind
// it that it hides). Samples: how many fine steps the segment is cut into (more for a short one, never finer than
// MinStep); Jitter 0..1 a per-pixel, per-frame offset.
float4 DGF_Shade(FDGroundFog F, FDGroundFogLight Lt, float3 Camera, float3 Dir, float T0, float T1, float Samples,
	float MinStep, float Jitter, Texture2D Layer, SamplerState LayerSampler, Texture3D Noise, SamplerState NoiseSampler,
	Texture2D CloudShadow, SamplerState CloudShadowSampler)
{
	// The fine step: the segment cut into Samples, but no longer than an optical depth of one and a half in the densest
	// fog (a long ray through a dense layer would step past the thin skin its top is lit in; the march stops once the
	// view sees through no more, and skips the clear air above the fog), and never finer than MinStep.
	float SigmaMax = max(max(F.SigmaPool, F.SigmaMist), 1.0e-7);
	float Fine = max(min((T1 - T0) / max(Samples, 1.0), 1.5 / SigmaMax), MinStep);
	// The noise's level of detail to the step (128 texels a tile): finer than two texels a step is detail the step
	// cannot see, and reads that miss the cache.
	float NoiseMip = clamp(log2(max(Fine * F.InvNoise * 64.0, 1.0)), 0.0, 5.0);
	FDCloudMarchParams P = DCM_DefaultParams(Fine);
	P.MaxSkip = 8.0 * Fine;
	P.BackOff = 1.0;
	P.Jitter = Jitter;
	P.MinTransmittance = 0.01;

	FDCloudLightParams LP = DCL_DefaultParams();
	LP.G1 = 0.6;
	LP.G2 = -0.2;
	LP.Blend = 0.3;
	LP.Albedo = 0.95;
	LP.MsContribution = 0.7;
	LP.MsOcclusion = 0.35;

	float LightUp = max(Lt.Dir.z, 0.06);
	float Cos = dot(Dir, Lt.Dir);
	// The phase of each multiple scattering octave is the same all along the ray: weighed once here (DCL_SunScatter's
	// octaves, without the powder term), so a sample only pays for the octaves' transmittance.
	float3 Phase;
	float3 Occlusion;
	{
		float A = 1.0;
		float B = 1.0;
		float C = 1.0;
		for (int o = 0; o < 3; ++o)
		{
			Phase[o] = A * DCL_DualHG(Cos, LP.G1 * C, LP.G2 * C, LP.Blend);
			Occlusion[o] = B;
			A *= LP.MsContribution;
			B *= LP.MsOcclusion;
			C *= LP.MsEccentricity;
		}
	}
	FDCloudMarch M = DCM_Begin(T0, T1, P);
	int MaxSamples = int(2.0 * Samples) + 8;
	for (int i = 0; i < MaxSamples && DCM_Running(M); ++i)
	{
		float3 X = Camera + Dir * M.T;
		float Top, Height01, ShadowTop;
		float Sigma = DGF_Density(F, X, M.T, NoiseMip, Layer, LayerSampler, Noise, NoiseSampler, Top, Height01, ShadowTop);
		FDCloudField Field;
		Field.Signed = 0.0;
		Field.Density = Sigma;
		// Above the fog's top the march may skip (by what lies between, the top being flat enough near by).
		Field.Distance = Sigma > 0.0 ? 0.0 : max(X.z - Top, 0.0) * 0.8;
		float Dt = DCM_Advance(M, Field, P);
		if (Dt > 0.0 && Sigma > 1.0e-9)
		{
			// The fog above the sample, toward the light and straight up (a layer: its depth to the top over the sine).
			// Toward a low sun only a thin skin under the fog's top is lit (a metre or so in a thick fog): a step much
			// longer than that would land below it and see the fog dark. So the light's transmittance is averaged over
			// the step in closed form -- the depth to the top changing along it at Dir.z, the view's own transmittance
			// weighting it -- and the step's light is what that average stands for.
			float Above = max(Top - X.z, 0.0);
			float A = Sigma / LightUp;
			float Above0 = max(Above + 0.5 * Dt * Dir.z, 0.0);
			float K = Sigma - A * Dir.z;
			float KDt = max(K * Dt, -60.0);
			float Along = abs(K) > 1.0e-9 ? (1.0 - exp(-KDt)) / K : Dt;
			float View = (1.0 - exp(-Sigma * Dt)) / Sigma;
			float LightT = saturate(exp(-A * Above0) * Along / max(View, 1.0e-6));
			float TauLight = -log(max(LightT, 1.0e-6));
			// The terrain's shadow (the layer's alpha: below that height the light is behind the ground) and the clouds'.
			float Lit = smoothstep(ShadowTop - F.ShadowSoft, ShadowTop + F.ShadowSoft, X.z) * DGF_CloudLight(Lt, X, CloudShadow, CloudShadowSampler);
			float3 Sun = Lt.Sun * (Lit * dot(Phase, exp(-Occlusion * TauLight)));
			// The sky's light and the sunlight diffused down through the fog above: a scattering slab lets through
			// some 1 / (1 + 0.3 tau) of the light falling on its top (forward-peaked, nearly lossless scattering), so
			// deep in a thick fog it is dim and grey rather than dark; the sky from below (the ground's bounce) near
			// the ground.
			float Diffuse = 1.0 / (1.0 + 0.3 * Sigma * Above);
			float Up = Height01 * Height01 * (3.0 - 2.0 * Height01);
			float3 Sky = lerp(Lt.SkyBottom, Lt.SkyTop, 0.35 + 0.65 * Up) * (0.3 + 0.7 * Diffuse)
				+ Lt.Sun * (Lit * LightUp * Diffuse * 0.5 / DCL_PI);
			DCM_Integrate(M, Sigma, Sigma * LP.Albedo * (Sun + Sky), Dt);
		}
		DCM_CheckDone(M, P);
	}
	return float4(M.Luminance, 1.0 - M.Transmittance);
}

#endif // DREAM_GROUNDFOG_USH
