// Copyright DreamMoon. All Rights Reserved.
//
// The shape of the clouds, shared by every way the sky draws them: the sky cloud renderer's looks
// (DreamSkyCloudRender.usf) and the toon clouds the dome marches itself (DreamSkyStylized.ush). Whichever draws them,
// the same clouds stand in the same places.
//
// A density field, built the way UDS's volumetric clouds (and Nubis) build theirs:
//   - the weather map's cover at a point picks the cloud type there, as a coverage of 0..3: small fair-weather
//     cumulus, towering cumulus, stratocumulus, an overcast deck. Fair-weather cumulus follow the hour (fewer in the
//     morning), and a slow patchiness varies the coverage across the sky;
//   - a low-frequency formation noise, cut at a threshold that falls as the coverage rises, says where cloud may
//     stand: whole blobs of every size, crowded in places, sparse in others. The world clock moves it through its
//     phase (UDS's formation change), so each cloud grows out of nothing and dissolves again over some 20 game
//     minutes while the wind carries it;
//   - the cloud type's vertical profile (DCS_Profile, drawn after UDS's Cloud_Profile) tapers the formation with
//     height: small cumulus stay in the lowest fifth of the layer, towering cumulus climb it narrowing. The base is
//     level, lifted here and there;
//   - a closing cover first spreads its cumulus out flat into stratocumulus, then turns into a deck (DCS_Deck):
//     stratocumulus cells, thick in their middles and thin between them, opened in a few winding rifts while the cover
//     is short of full; toward rain and storms a deep deck with a low, ragged base, a thunderstorm's hanging in rolls
//     with scud under it;
//   - under storm darkness, storm cells raise cumulonimbus out of the deck (DCS_Cumulonimbus): a billowed column up to
//     the tropopause, swelling downwind into a flat-topped anvil drawn out downwind there, with mammatus under it;
//   - billows (the noise's Worley octaves, warped and gathered into clumps by its Perlin-Worley channel) erode it --
//     erosion only, it never adds cloud -- small clouds most, a deck's base lumpy, its inside hardly; a finer octave
//     near the view frays the edges.
// The volumetric material turns the density into extinction; the toon march draws the surface where the solid shape
// crosses a low threshold.

#ifndef DREAMSKY_CLOUDSHAPE_USH
#define DREAMSKY_CLOUDSHAPE_USH

// How thick the cloud layer is above its base (cm): small cumulus stand in its lowest fifth (some 0.8 km), towering
// cumulus and an overcast fill it.
#define DCS_LAYER_TOP 400000.0

// How high above the layer's base a storm's cumulonimbus climb (the tropopause, cm): the marches stop there.
#define DCS_STORM_TOP 1000000.0

// The weather the map holds at a point (its world position, cm, horizontally): (cover, darkness, precipitation), or the
// view's own values off the map. MapParams = (minus the drawn map's centre x, y; 1 / its extent; 1 when it is live).
float3 DCS_MapAt(float2 Point, float3 Fallback, float4 MapParams, Texture2D Map, SamplerState MapSampler)
{
	float2 UV = (MapParams.xy + Point) * MapParams.z + 0.5;
	float Inside = MapParams.w < 0.5 ? 0.0 : saturate(min(min(UV.x, 1.0 - UV.x), min(UV.y, 1.0 - UV.y)) * 8.0);
	return lerp(Fallback, Map.SampleLevel(MapSampler, saturate(UV), 0).xyz, Inside);
}

// The weather at the view itself, for points off the map: (cover, darkness, and rain going with the darkness).
float3 DCS_ViewWeather(float4 Cloud0, float4 CloudLayer)
{
	return float3(Cloud0.x, CloudLayer.y, saturate(CloudLayer.y * 1.5 - 0.3));
}

// How high the cloud type of a coverage reaches, as a share of the layer (X = coverage / 3): small cumulus a fifth,
// towering cumulus all of it from a coverage of 1.5 up.
float DCS_ProfileTop(float X)
{
	return 0.19 + 0.81 * pow(smoothstep(0.05, 0.5, X), 1.5);
}

// The vertical profile of the cloud type of a coverage (X = coverage / 3) at a height in the layer (H, 0..1):
//   x  how much of the formation may stand here: tapering from the base to the type's top (only the strongest
//      blobs reach it), cut off right at the base; an overcast keeps most of it up to the top;
//   y  how dense the cloud is: small clouds soft, bodies dense, bases soft;
//   z  how much the billows erode it: small clouds most, an overcast hardly at its underside.
float3 DCS_Profile(float X, float H)
{
	float Top = DCS_ProfileTop(X);
	float Stand = smoothstep(0.0, 0.04, H) * (1.0 - smoothstep(0.96, 1.0, H)) * saturate((Top - H) / (0.5 * Top) + 0.65 * smoothstep(0.5, 1.0, X));
	float Dense = lerp(0.13, 0.5, smoothstep(0.0, 0.45, X)) * lerp(0.45, 1.0, smoothstep(0.02, 0.25, H));
	float Erode = lerp(1.0, saturate(0.1 + 0.8 * H), smoothstep(0.4, 1.0, X));
	return float3(Stand, Dense, Erode);
}

// How much of a cloud the air between it and the view veils, 0..1 (in the colour of the sky behind it): Distance cm
// along a ray rising at Up (its direction's z; < 0 looking down) from the view at Altitude cm above the ground, Cover =
// the cover at the view (an overcast's air is thicker), Cloud3 =
// (visibility, cm; haze height, cm; -, -). The haze is thick low down and thins with height (the optical depth along
// the rising ray), so a tower's top stays clear long after its base has sunk into the horizon; whatever stands far
// off within the last degrees of the horizon sinks into its haze.
float DCS_AirVeil(float Distance, float Up, float Altitude, float Cover, float4 Cloud3)
{
	float Visibility = max(Cloud3.x, 1000.0) * lerp(1.0, 0.35, smoothstep(0.45, 0.95, Cover));
	float HazeHeight = max(Cloud3.y, 1000.0);
	// The ray from the view's altitude to the cloud's (over the planet's curve): the haze it went through, as a share of
	// as long a stretch at the ground (the density falls off exponentially with height).
	float From = max(Altitude, 0.0);
	float To = max(From + Distance * Up + Distance * Distance / (2.0 * 636000000.0), 0.0);
	float X = (To - From) / HazeHeight;
	float Share = exp(-From / HazeHeight) * (abs(X) > 1.0e-3 ? (1.0 - exp(-X)) / X : 1.0);
	float Veil = 1.0 - exp(-3.912 * Distance / Visibility * Share);
	// (Far off along the horizon, either side of it, whatever stands there sinks into the haze: from the ground that is
	// everything in the last degrees over it. From among the clouds the near ones at eye level stay: it goes by distance,
	// not by the angle alone, or they would be cut off in a band along the horizon.)
	float Horizon = (1.0 - smoothstep(0.004, 0.03, abs(Up))) * smoothstep(1000000.0, 3000000.0, Distance);
	return max(Veil, Horizon);
}

// Integer hash of a cell, 4 values 0..1 (a float hash loses its low bits at the coordinates drifting clouds reach).
float4 DCS_Hash4(int2 C, uint Salt)
{
	uint4 H = uint4(uint(C.x) * 1597334677u ^ uint(C.y) * 3812015801u ^ Salt * 2654435769u, 0u, 0u, 0u);
	H.y = H.x * 0x7feb352du;
	H.y ^= H.y >> 15;
	H.z = H.y * 0x846ca68bu;
	H.z ^= H.z >> 16;
	H.w = H.z * 0x9e3779b9u;
	H.w ^= H.w >> 13;
	H.x ^= H.x >> 16;
	H.x *= 0x7feb352du;
	return float4(H & 0xffffu) * (1.0 / 65535.0);
}

// One storm cell's cumulonimbus, at Offset from its centre (cm, horizontally) and Z above the layer's base (cm); Size
// scales it (about 1), Downwind is the wind's direction (unit), Seed varies it, Ragged (0..1, a slow noise at the point)
// frays the anvil's rim and lifts and sags its underside, Pouches (the noise at the point some 2 km to a cell: g and b
// cells to hang the mammatus from, r and b to notch the rim). Returns how far inside it the point is, in a solid-shape
// measure (> 0 inside; 0.25 about 700 m in), and, for the point, how much it belongs to the anvil (0 column .. 1
// anvil), how near the anvil's underside it is (0..1), how near its rim (0..1), its height through the cloud (0..1)
// and, outside it, at least how far it is from it (cm; never more than the true distance, whatever the noise inputs
// are, so a march that keeps to it steps over nothing).
//   - The column: some 5 to 8 km wide, rising from the base, hardly narrowing as it climbs, bulging in tiers (the
//     towers that built it), leaning downwind higher up and swelling out downwind into the anvil's underside near the
//     top (the outflow), not a stalk under a disc. No dome stands on it.
//   - The anvil: a flat-topped lens at the tropopause, which a bigger tower reaches higher (9.2 to 9.8 km) and spreads
//     thicker (up to some 2.4 km over the column; billows eat into its underside, not its top). Its upwind end is
//     rounded just upwind of the column's top; downwind it is drawn out into a long ellipse (some 13 km long and 11 km
//     wide for a tower of size 1) that narrows and thins toward its far end, hanging out over clear air there. It thins
//     out toward a frayed and notched rim. Its underside sags and lifts by some 450 m, and outside the column, away from
//     the rim and most downwind, it hangs in pouches (mammatus) up to some 1.2 km deep.
float DCS_Cumulonimbus(float2 Offset, float Z, float Size, float2 Downwind, float Seed, float Ragged, float4 Pouches,
	out float Anvil, out float Under, out float Edge, out float Height, out float Outside)
{
	float Rc = 330000.0 * Size;
	float AnvilTop = min(950000.0 * (0.85 + 0.15 * Size), 980000.0);
	float h = saturate(Z / AnvilTop);
	Height = h;
	float2 Across = float2(-Downwind.y, Downwind.x);

	// The column. (Out: near the top it swells and its middle moves downwind, into the anvil's upwind part.)
	float Out = smoothstep(0.72, 0.97, h);
	float R = Rc * ((1.0 - 0.06 * h) * (1.0 + 0.1 * sin(h * 13.0 + Seed * 6.283)) + 0.2 * Out);
	float2 Lean = Downwind * Rc * (0.45 * h * h + 0.15 * Out);
	float Wall = length(Offset - Lean) - R;
	float ColumnTop = AnvilTop - 60000.0;
	float Column = min(-Wall / Rc, (ColumnTop - Z) / 150000.0);

	// The anvil, measured from a point over the column's top: Lu upwind, Ld downwind, W0 across (half widths), the width
	// narrowing to 55 % toward the far end. (Its rim is frayed slowly by Ragged and bitten into by notches a few
	// kilometres and one across, so it is no ellipse: the notches' noise is the pouches' own, its smooth and its fine
	// channel. The fraying never pushes the rim out by more than 1 / 0.85, which keeps the anvil inside the storm search's
	// reach and the bound below tight.)
	float Lu = 1.0 * Rc;
	float Ld = 3.0 * Rc;
	float W0 = 1.7 * Rc;
	float2 A = Offset - Downwind * (0.6 * Rc);
	float Along = dot(A, Downwind);
	float Side = dot(A, Across);
	float Down = saturate(Along / Ld);
	float Fray = max(lerp(0.8, 1.2, Ragged) * lerp(0.85, 1.3, 0.6 * Pouches.r + 0.4 * Pouches.b), 0.85);
	float Rr = length(float2(Along / (Along > 0.0 ? Ld : Lu), Side / (W0 * (1.0 - 0.45 * Down)))) * Fray;
	// A lens: thickest over the column, thin toward the rim and toward the far end; its top flat but for the rim.
	float Thick = 240000.0 * Size * pow(saturate(1.0 - Rr * Rr), 0.35) * lerp(1.0, 0.6, Down);
	float Top = AnvilTop - 20000.0 * Rr * Rr * Rr * Rr;
	// (The pouches hang wherever the anvil is thick enough to hold them, but outside the column itself and not under
	// the rim, most downwind; each a rounded lobe, deepest in its cell's middle. The underside around them sags and
	// lifts by some 450 m.)
	float Pouch = 0.7 * Pouches.g + 0.3 * Pouches.b;
	float Mammatus = smoothstep(-0.15, 0.3, Along / Ld) * (1.0 - smoothstep(0.75, 0.97, Rr)) * saturate(Thick / 60000.0)
		* smoothstep(0.0, 0.25 * Rc, Wall);
	float Lobe = smoothstep(0.25, 0.8, Pouch);
	float Bottom = Top - Thick - 120000.0 * Mammatus * Lobe * sqrt(Lobe) - 90000.0 * (Ragged - 0.5) * saturate(Thick / 40000.0);
	// (Measured three times faster down from the top than up from the underside: billows eat into the underside and
	// leave the top flat.)
	float AnvilShape = min(3.0 * (Top - Z), Z - Bottom) / 280000.0;
	Anvil = AnvilShape > Column ? 1.0 : 0.0;
	Under = Anvil * (1.0 - smoothstep(0.0, 60000.0, Z - Bottom));
	// (Toward the rim the anvil thins out: its outer part thinner and more frayed.)
	Edge = Anvil * smoothstep(0.55, 1.0, Rr);

	// How far outside, at least.
	// The column: across the wall at the point's height, slanted by how fast the column's radius and middle can move
	// with height (sums of the largest slopes of R and Lean per unit of h: 1.37 tiers + 0.2 x 6 swell, 0.9 lean +
	// 0.15 x 6 swell), and above its top.
	float Slope = 4.37 * Rc / AnvilTop;
	float ColumnOut = max(Wall * rsqrt(1.0 + Slope * Slope), Z - ColumnTop);
	// The anvil: inside it only where the unfrayed, unnarrowed ellipse scaled by 1 / 0.85 holds the point (a convex
	// shape around the measuring point with an inscribed radius of min(Lu, W0) / 0.85), and between its highest top and
	// its lowest possible underside (the rim's droop, the thickest lens, the deepest pouch and sag).
	float Rb = length(float2(Along / (Along > 0.0 ? Ld : Lu), Side / W0)) * 0.85;
	float AnvilLow = AnvilTop - 20000.0 - 240000.0 * Size - 120000.0 - 45000.0;
	float AnvilOut = max(max(Z - AnvilTop, AnvilLow - Z), (Rb - 1.0) * min(Lu, W0) / 0.85);
	Outside = min(ColumnOut, AnvilOut);
	return max(Column, AnvilShape);
}

// How far around a storm's cumulonimbus the shape's bound (FDCloudShape.Conservative) still says "cloud may be here"
// (cm): a march may step this far through what the bound calls clear air without stepping over an anvil.
#define DCS_STORM_BOUND_MARGIN 250000.0

// How far a march may trust there is no cumulonimbus beyond the ones a full sample searched (cm, times the field's scale):
// a tower stands at least 0.4 km inside its 18 km cell and reaches at most 16 km from where it stands, so one outside the
// 3 x 3 cells searched is at least 2.4 km off. Where the darkness keeps a sample from searching at all, no tower stands at
// the point, but one may stand nearby: a shorter, untrusted step. (600 m: at 1.2 km a march over the layer stepped from
// where the darkness let no search into an anvil past the fragments of its rim, and a far tower's rim came out a smooth
// blob; 300 m keeps them all, at some twice the cost.)
#define DCS_STORM_UNSEARCHED_GAP 230000.0
#define DCS_STORM_UNSEARCHED_STEP 60000.0

// What a full sample found (DCS_Shape) that samples near it can take as theirs (DCS_ShapeNear): the weather there and
// the two cumulonimbus standing nearest.
struct FDCloudAnchor
{
	float2 Weather;       // the weather map's (cover, darkness), read where the point's weather wanders to
	float4 Storm;         // the nearest cumulonimbus: its middle in the drifting field (cm, x, y), its size (0 = none), its seed
	float4 Storm2;        // the next nearest, the same way
};

struct FDCloudShape
{
	float Solid;          // 0..1: how far into the cloud's shape the point is (the toon surface is a low level of it)
	float Signed;         // the shape before it is clamped: Solid where that is between 0 and 1, below 0 outside and the
	                      // lower the further out (not a distance: a cumulus falls some 0.1 per 300 m, a deck 1 per
	                      // 200 m above or under it, a storm tower 1 per 700 m; -1 below or above the layer)
	float Density;        // 0..1: Solid weighed by the cloud type's density (the volumetric extinction)
	float Conservative;   // an upper bound of both (0 = surely empty); around a storm's cumulonimbus it reaches
	                      // DCS_STORM_BOUND_MARGIN beyond the cloud
	float Dark;           // storm darkness here
	float Height;         // 0 base .. 1 top of the cloud here
	float Column;         // cm: how tall the cloud here stands (a deck: how thick it is here)
	float Deck;           // 1: an overcast deck
	FDCloudAnchor Anchor; // for DCS_ShapeNear around this point
	float StormDistance;  // cm: at least how far the nearest cumulonimbus is (DCS_Cumulonimbus's Outside, never more than
	                      // the true distance), or DCS_STORM_UNSEARCHED_GAP when none is nearer; under the layer's base
	                      // or over the tallest tops, how far the nearest cloud of any kind is. A full sample's only
	                      // (DCS_Shape): DCS_ShapeNear knows two towers only. Where no storm is searched for, a step
	                      // length to take (DCS_STORM_UNSEARCHED_STEP), not a bound.
};

// The overcast deck at a height H in the layer (0..1): stratocumulus, cells some 1.5 km across, over a kilometre thick
// in their middles, which hang down as rounded lobes (seen from below a ceiling of cells), some 80 m between them,
// where the base is lifted some 240 m (lumpy all over); as it darkens toward rain and storms (Thick 0..1) it grows into a deck some 2 to
// 3 km deep whose lumpy base (relief some 250 m) hangs at the layer's bottom. While the cover is short of full
// (Shut < 1) it cracks open along the borders between its cells (Gap: the cells' Worley value, low on a border, wandered): the
// deck thins toward a crack from above and below alike, so a hole's rim is a tapering lip, not a cut wall, and the
// holes are narrow and many (a few percent of the deck at an overcast) rather than one large blot. Cell = 0 between
// the cells .. 1 in a cell's middle. Formed (0..1) = how far the deck has formed: its strongest cells condense first,
// as rounded lenses (each thickening gradually from its rim to its middle, not a flat-topped slab), and spread until
// it closes at 1. Lift (in the layer) raises its base: a thunderstorm's, between the rolls it hangs in. Returns (how far
// inside it the point is: 1 at 200 m in, below 0 outside; how near a crack or an edge it is, 0..1; the deck's base and
// top here, both in the layer).
float4 DCS_Deck(float Cell, float Gap, float Shut, float Formed, float Thick, float Lift, float H)
{
	float Bottom = lerp(0.03 + 0.06 * pow(1.0 - Cell, 1.5), 0.004 + 0.06 * pow(1.0 - Cell, 1.5), Thick) + Lift;
	float Top = lerp(0.13 + 0.19 * Cell, 0.5 + 0.25 * Cell, Thick);
	float Open = 0.26 * (1.0 - Shut);
	float Emerge = 1.45 * (1.0 - Formed);
	float Crack = max(1.0 - smoothstep(Open - 0.05, Open + 0.09, Gap), 1.0 - smoothstep(Emerge - 0.35, Emerge + 0.1, Cell));
	float Half = 0.5 * (Top - Bottom) * (1.0 - Crack);
	float Inside = (Half - abs(H - 0.5 * (Top + Bottom))) / 0.05;
	return float4(Inside, Crack, Bottom, Top);
}

// The field at a point of the drifting field P (cm), World2 its place in the world (cm, horizontally), Rel the point
// from the view (cm), Z its altitude above the layer's base (cm), Weather the weather map's (cover, darkness) there.
// bSearch: look for the storm cells around it (Wander = where its weather was read, from World2);
// otherwise Storm and Storm2 are the cumulonimbus to stand there (FDCloudAnchor). Shared by DCS_Shape and DCS_ShapeNear: pass bSearch as a
// literal, so each keeps only its own half.
FDCloudShape DCS_Field(float2 P, float2 World2, float3 Rel, float Z, float2 Weather, bool bSearch, float4 Storm, float4 Storm2, float2 Wander,
	float Scale, float4 Cloud0, float4 Cloud1, float4 Cloud2, float4 CloudLayer, float4 MapParams, float Detail,
	Texture2D Map, SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler)
{
	FDCloudShape S = (FDCloudShape)0;
	S.Column = 1.0;
	S.Signed = -1.0;
	S.Anchor.Weather = Weather;
	S.Dark = saturate(Weather.y * 1.3 - 0.2);
	// (No anvil tops 9.8 km.)
	S.StormDistance = Z <= 0.0 ? -Z : max(Z - 980000.0, 0.0);
	if (Z <= 0.0 || Z >= DCS_STORM_TOP)
	{
		return S;
	}
	S.StormDistance = DCS_STORM_UNSEARCHED_STEP * Scale;
	float H = Z / DCS_LAYER_TOP;
	// (The noise tiles in z as well: the phase wraps where it repeats, and the clouds never jump.)
	float Phase = Cloud1.z;

	// The coverage here, 0..3: the weather's cover (fair-weather cumulus fewer in the morning; a closing cover is not
	// touched), varied in patches tens of kilometres wide (which change within an hour or so). It picks the cloud type
	// (X: how tall they grow, when they close into a deck), the patches making some taller than others.
	float Cover = saturate(Weather.x);
	float Closing = smoothstep(0.7, 0.95, Cover);
	Cover *= lerp(lerp(0.6, 1.0, saturate(Cloud2.x)), 1.0, Closing);
	float4 Wide = Noise.SampleLevel(NoiseSampler, float3(P / (6000000.0 * Scale), 0.37 + Phase), 0);
	float Patches = (Wide.r - 0.5) * (1.0 - Closing);
	float Coverage = clamp(3.0 * Cover * Cover + Patches * 0.5, 0.0, 3.0);
	float X = Coverage / 3.0;
	// How many of them stand is the formation's coverage: more than the type's for a thin cover (a clear sky still
	// holds a few small cumulus -- some 3% of it at a cover of 0.15 --), a little less from a half up (a cover of 0.55
	// is scattered cumulus over a third of the sky; a closing cover is the deck's), and the patches vary it less
	// (scattered cumulus fill the sky evenly, not in clumps).
	float Spread = clamp(2.6 * Cover * Cover + 4.25 * Cover * pow(1.0 - Cover, 4.0) + Patches * 0.3, 0.0, 3.0);

	// The formation: Worley cells some 3 km across with their finer octaves (a cloud and its turrets), mixed with the
	// smooth Perlin-Worley for larger irregularity; gathered toward the middle with a long upper tail, as UDS's cells
	// are (median about 0.5, a tenth above 0.65), so only the strongest cells survive a high threshold. It shifts a
	// little with height (towers lean and change as they climb). Through the phase each cell rises out of nothing and
	// falls apart again: from its base up, as the noise is read further along the phase low down than high up. Higher
	// up it is read further upwind, so the clouds lean downwind as they climb (some 400 m at a small cumulus' top).
	float2 Wind = dot(Cloud1.xy, Cloud1.xy) > 1.0e-6 ? normalize(Cloud1.xy) : float2(0.866, 0.5);
	float2 PF = P - Wind * (H * 200000.0 * Scale);
	float4 F = Noise.SampleLevel(NoiseSampler, float3(PF / (2400000.0 * Scale), 0.61 + Phase - 0.25 * H), 0);
	// (With a little of the finest channel, some 750 m cells: a small cumulus, cut near the top of one Worley cell, is
	// otherwise a round cap; this makes it a cluster of unequal swellings.)
	float Form = 0.55 * F.g + 0.3 * F.r + 0.15 * F.a;
	// The base is level, lifted here and there by the smooth channel (a little more under an overcast; a storm's base
	// hangs low and even).
	float Storminess = smoothstep(0.35, 0.7, S.Dark);
	float Lift = lerp(0.1, 0.25, saturate(Coverage - 1.5)) * (1.0 - 0.6 * Storminess) * F.r * F.r;
	// The hour shapes fair-weather cumulus (Cloud2.x, the day's growth): flat humilis a few hundred metres tall in the
	// morning and the night, building through the late morning into the tall cumulus of the mid-afternoon, sinking and
	// fraying again toward evening. They are pressed down to a third of their height at the least; a closing cover is
	// not touched.
	float Grow = lerp(lerp(0.3, 1.0, smoothstep(0.5, 1.0, saturate(Cloud2.x))), 1.0, Closing);
	// A cover closing into a deck spreads its cumulus out into stratocumulus as they merge: they sink to a deck's
	// thickness (a rain deck's deeper), each a little more than its cell is strong, so their clumps stay in its top
	// and, thick against thin, in its underside -- not one slab filling the layer, flat grey from below, until the deck
	// forms within it. (Never thinner than some 150 m where they stand, or the sun broke through a closing sky.)
	float Rainy = smoothstep(0.15, 0.6, S.Dark) * smoothstep(0.8, 0.95, X);
	float Spreading = smoothstep(0.4, 0.7, X);
	float Flat = lerp(1.0, lerp(0.4, 0.8, Rainy), Spreading);
	float Hs = H / (Grow * Flat);
	float Hf = saturate(Hs - Lift * (1.0 - Hs));
	// (A cumulus is no dome: its top swells unevenly, a turret here climbing a quarter higher, a shoulder there lower,
	// as the formation's finer channel says, over a flat base.)
	float Uneven = lerp(0.75, 1.25, F.b);
	float Hu = saturate(Hf / Uneven);
	float3 Profile = DCS_Profile(X, Hu);
	Profile.x = lerp(Profile.x, smoothstep(0.0, 0.04, Hu) * (1.0 - smoothstep(0.96, 1.0, Hu)) * (1.0 - max(Hu - 0.08, 0.0)), Spreading);
	Profile.z *= lerp(1.3, 1.0, Grow);
	float Threshold = pow(1.0 - Spread / 6.5, 3.0) - 0.25;
	float Strength = (Form - Threshold) / (1.0 - Threshold);
	float BaseU = Strength - (1.0 - Profile.x);
	float Base = saturate(BaseU);
	float Signed = BaseU;
	float Top = DCS_ProfileTop(X);
	// (A stratocumulus' height and depth are its own where it stands: the drawing sees its thick and thin parts.)
	float Local = min(0.08 + max(Strength, 0.0), 1.0);
	S.Height = lerp(saturate(Hf / Top), saturate(Hu / Local), Spreading);
	S.Column = lerp(Top, Local * Uneven, Spreading) * Grow * Flat * DCS_LAYER_TOP;

	// A closing cover turns into a deck (DCS_Deck) out of its own cells, some 1.5 km across, that grow and dissolve
	// with the phase as the cumulus do. Its height and thickness are its own, so the drawing sees thick cells and thin
	// gaps. On the way the two trade places by their thresholds, not their strength (weakening both instead left thin
	// shapes the billows ate into crumbs): the deck's thickest cells appear first and spread, and only once it has
	// all but closed do the cumulus within it shrink away whole -- so as the cover rises the sky only ever fills
	// (shrinking them as the deck began opened blue sky again between the two).
	float DeckW = smoothstep(0.55, 0.85, X);
	float DeckBand = 0.0;
	float DeckThin = 0.0;
	if (DeckW > 0.0)
	{
		float4 C = Noise.SampleLevel(NoiseSampler, float3(P / (1200000.0 * Scale), 0.29 + Phase), 0);
		float Cell = saturate((0.65 * C.g + 0.2 * C.r + 0.15 * C.b - 0.2) / 0.6);
		// (Where it cracks: along the cells' borders, wandered off them by the smooth and the fine channel -- a Worley
		// border alone runs in straight lines between corners, and a crack along it read as cut with a knife.)
		float Gap = C.g + 0.18 * (C.r - 0.5) + 0.12 * (C.b - 0.5);
		// It opens mostly in rifts: a few winding ones kilometres long (along the middle line of the wide patches'
		// smooth channel), broken where they cross a cell's thick middle and ragged along the fine channel. Along the
		// cells' borders alone it opens only at their corners -- a lone lens-shaped hole in a wide thinned halo, an eye
		// in the sky -- so those open later, once the deck is breaking up. (Never in a deck that has closed.)
		float Shut = smoothstep(0.75, 0.93, X);
		float Rift = 0.02 + 0.25 * smoothstep(0.6, 1.0, Shut) + 4.8 * abs(Wide.r - 0.5) + 0.4 * (C.b - 0.5) + 0.15 * (C.r - 0.5) + 1.1 * (C.g - 0.45);
		Gap = min(Gap + 0.06, Rift);
		// (A rain deck is deep only while it is closed: as it opens -- a storm clearing -- it first sinks back to a
		// stratocumulus' thickness, then cracks along its cells' borders and its cells shrink one by one, the way it
		// formed in reverse; a deep deck cracking open would stand in kilometre-high walls.)
		float Thick = Rainy;
		// A thunderstorm's base is no flat ceiling (a deep deck hanging level reads as a thick overcast): it hangs low in
		// rolls some 5.5 km apart, bent by the wide patches and broken into lengths kilometres long, each rounded under
		// its middle and steeper on one face (a shelf's terraces), and in broad masses off the wide cells; between them
		// it is lifted some 500 m, thinner there and so lighter from below. (No steeper: a ray grazing under a roll comes
		// out of it into the open trough, the more often the steeper its faces. The rolls keep one direction in the
		// drifting field, the default wind's: turned with the wind, they would sweep across the sky as it veered.)
		float Tempest = Thick * smoothstep(0.5, 0.85, S.Dark);
		float Along = dot(P, float2(0.866, 0.5)) / (550000.0 * Scale) + 2.5 * (Wide.r - 0.5) + 1.2 * (Wide.g - 0.5);
		float Saw = frac(Along);
		float Roll = smoothstep(0.0, 0.3, Saw) * (1.0 - smoothstep(0.45, 1.0, Saw));
		float Hang = max(Roll * smoothstep(0.2, 0.45, 0.6 * Wide.b + 0.4 * C.r), 0.6 * smoothstep(0.45, 0.8, 0.6 * Wide.g + 0.4 * Wide.b));
		float Raise = 0.12 * (1.0 - Hang) * Tempest;
		float4 D = DCS_Deck(Cell, Gap, Shut, DeckW, Thick, Raise, H);
		// (Under a storm none of the cumulus within the deck is left: its lifted base would bare them.)
		float CumulusU = BaseU - smoothstep(0.75, 1.0, DeckW) - 2.0 * Tempest;
		float DeckU = min(D.x, 1.0);
		float Cumulus = saturate(CumulusU);
		float DeckSolid = saturate(DeckU);
		// (Which of the two the point belongs to: near their surfaces both are thin, so the closing decides as much as
		// which stands more solid there -- a deck must keep its own thickness, or its gaps would not read.)
		float W = saturate(0.5 + (DeckSolid - Cumulus) * 4.0 + (DeckW - 0.5) * 2.0);
		Base = max(Cumulus, DeckSolid);
		Signed = max(CumulusU, DeckU);
		// Thin cells less dense than thick ones; the base lumpy (the billows eat into it), a rain deck's ragged (scud),
		// the inside hardly; a crack's lip frayed, and a deck still forming billowed all over.
		float Rise = saturate((H - D.z) / lerp(0.08, 0.12, Thick));
		float3 DeckProfile = float3(1.0, lerp(lerp(0.25, 0.5, Cell), 0.5, Thick),
			max(max(lerp(lerp(0.75, 0.95, Thick), 0.3, Rise), 0.7 * D.y), 0.6 * (1.0 - DeckW)));
		Profile = lerp(Profile, DeckProfile, W);
		// (A storm's height in it goes from where its rolls hang: its lifted base sits higher in the cloud, lighter.)
		float Low = D.z - Raise;
		S.Height = lerp(S.Height, saturate((H - Low) / max(D.w - Low, 1.0e-3)), W);
		S.Column = lerp(S.Column, (D.w - D.z) * DCS_LAYER_TOP, W);
		S.Deck = DeckW * W;
		// (Up to a little above the deck's top it stays the deck, storm towers or not.)
		DeckBand = DeckW * (1.0 - smoothstep(D.w, D.w + 0.08, H));
		// (How much lighter a stratocumulus deck's thin gaps are: less dense as well as thinner.)
		DeckThin = S.Deck * (1.0 - Thick) * (1.0 - Cell) * (1.0 - Cell);
		// Scud: thin torn scraps a couple of hundred metres under a storm's lifted base (where it hangs low there is no
		// room for them), drawn out along the rolls some three times as long as they are wide, in strings and clusters
		// of all sizes -- a hundred metres to a kilometre or so long -- with frayed edges. Their own noise is read
		// stretched along the rolls' direction (the same fixed one), its smooth channel leading (Worley cells cut by a
		// threshold alone are round: they drew as discs), the field wandered off its grid by the deck's channels, the
		// threshold varied by the wide patches (big scraps in some places, only shreds in others), and the two finer
		// channels eating into their edges (with the finest alone the smallest scraps, seen from afar, were still smooth
		// ovals); it changes with height, so their sides are ragged too. They are drawn as the deck is, dark as the deck
		// over them (as small clouds of their own, lit in a cumulus's tones, they broke into jagged steps), and come and
		// go by their threshold as the storm does.
		float ScudW = Thick * smoothstep(0.35, 0.8, S.Dark) * smoothstep(0.04, 0.09, D.z);
		if (ScudW > 0.0 && H < D.z)
		{
			float2 Q = float2(dot(P, float2(0.866, 0.5)) / 3.0, dot(P, float2(-0.5, 0.866)))
				+ (25000.0 * Scale) * float2(2.0 * C.r + C.g - 1.5, 2.0 * C.g + C.r - 1.5);
			float4 R = Noise.SampleLevel(NoiseSampler, float3(Q / (180000.0 * Scale), 0.83 + Phase + 2.2 * H), 0);
			float Torn = 0.45 * R.r + 0.35 * R.g + 0.2 * R.b;
			float Cut = 0.55 - 0.24 * (Wide.g - 0.5) - 0.16 * (C.r - 0.5);
			float Frag = (Torn - lerp(1.0, Cut, ScudW)) * 3.0;
			Frag -= 2.6 * (1.0 - 0.5 * (R.b + R.a)) * (1.0 - smoothstep(0.0, 0.8, Frag));
			float HalfT = 0.012 + 0.028 * saturate(Frag);
			float Mid = max(D.z * lerp(0.45, 0.7, C.g), HalfT + 0.004);
			// (Tallest where a scrap is strongest, thinning to its edges -- a flat slab drew as a disc.)
			float V = (H - Mid) / HalfT;
			float ScudU = Frag - 0.3 * V * V;
			float Scud = saturate(ScudU);
			float Own = saturate((Scud - Base) * 4.0);
			Base = max(Base, Scud);
			Signed = max(Signed, ScudU);
			Profile = lerp(Profile, float3(1.0, 0.35, 1.0), Own);
			S.Height = lerp(S.Height, saturate((H - Low) / max(D.w - Low, 1.0e-3)), Own);
		}
	}

	// Storms: cells 16 km apart, each where the weather is storm-dark at its centre raising a cumulonimbus out of the
	// deck (most do; their size varies). Looked for only near a storm: here, or upwind as far as an anvil reaches;
	// and not within a closed deck, up to its top, where none shows (the deck stands there) -- under a storm most
	// samples are taken there, in it and under its base.
	float2 Downwind = dot(Cloud1.xy, Cloud1.xy) > 1.0e-6 ? normalize(Cloud1.xy) : float2(0.866, 0.5);
	float3 ViewWeather = DCS_ViewWeather(Cloud0, CloudLayer);
	bool bInDeck = DeckBand > 0.999;
	bool bStorm = Storm.z > 0.0 && !bInDeck;
	if (bSearch && !bInDeck)
	{
		float Upwind = DCS_MapAt(World2 + Wander - Downwind * 900000.0, ViewWeather, MapParams, Map, MapSampler).y;
		bStorm = max(S.Dark, saturate(Upwind * 1.3 - 0.2)) > 0.3;
	}
	float Bound = 0.0;
	if (bStorm)
	{
		// The anvils' mammatus (rounded pouches some 2 km across, with smaller ones among them) and the notches in their
		// rims.
		float4 M = Noise.SampleLevel(NoiseSampler, float3(P / (1600000.0 * Scale), 0.47 + Phase), 0);
		float Best = -1.0;
		float BestAnvil = 0.0;
		float BestUnder = 0.0;
		float BestEdge = 0.0;
		float BestHeight = 0.0;
		float Nearest = 1.0e9;
		float4 BestCell = float4(0, 0, 0, 0);
		float SecondBest = -1.0e9;
		float4 SecondCell = float4(0, 0, 0, 0);
		if (bSearch)
		{
			// (A cumulonimbus, its anvil included, reaches at most a cell from where it stands: only the 3 x 3 nearest
			// cells are looked at.)
			const float StormCell = 1800000.0 * Scale;
			// (The field drifted this far: a place in it, less this, is where it stands in the world now.)
			float2 Drift = P - World2;
			int2 Home = int2(floor(P / StormCell));
			[loop]
			for (int j = -1; j <= 1; ++j)
			{
				for (int i = -1; i <= 1; ++i)
				{
					int2 C = Home + int2(i, j);
					float4 Hc = DCS_Hash4(C, 71u);
					if (Hc.z > 0.8)
					{
						continue;
					}
					// It stands where its cell is darkest, its middle or some 5 km off (a small storm zone still gets its
					// cumulonimbus). (A middle as dark as it gets cannot be outdone: under a storm's middle one tap does.)
					float2 Centre = (float2(C) + 0.3 + 0.4 * Hc.xy) * StormCell;
					float Darkness = DCS_MapAt(Centre - Drift, ViewWeather, MapParams, Map, MapSampler).y;
					float2 At = Centre;
					if (Darkness < 0.95)
					{
						[unroll]
						for (int t = 1; t < 5; ++t)
						{
							float2 Tap = Centre + float2(t == 1 ? 1.0 : (t == 2 ? -1.0 : 0.0), t == 3 ? 1.0 : (t == 4 ? -1.0 : 0.0)) * 500000.0 * Scale;
							float Dt = DCS_MapAt(Tap - Drift, ViewWeather, MapParams, Map, MapSampler).y;
							if (Dt > Darkness + 0.05)
							{
								Darkness = Dt;
								At = Tap;
							}
						}
					}
					Centre = At;
					if (saturate(Darkness * 1.3 - 0.2) < 0.5)
					{
						continue;
					}
					float Size = lerp(0.8, 1.2, Hc.w) * Scale;
					float CellAnvil;
					float CellUnder;
					float CellEdge;
					float CellHeight;
					float CellOut;
					float D = DCS_Cumulonimbus(P - Centre, Z, Size, Downwind, Hc.z, F.r, M, CellAnvil, CellUnder, CellEdge, CellHeight, CellOut);
					Nearest = min(Nearest, CellOut);
					if (D > Best)
					{
						SecondBest = Best;
						SecondCell = BestCell;
						Best = D;
						BestAnvil = CellAnvil;
						BestUnder = CellUnder;
						BestEdge = CellEdge;
						BestHeight = CellHeight;
						BestCell = float4(Centre, Size, Hc.z);
					}
					else if (D > SecondBest)
					{
						SecondBest = D;
						SecondCell = float4(Centre, Size, Hc.z);
					}
				}
			}
		}
		else
		{
			// (The anchor's two nearest cells: with one only, the samples around a surface would see the other tower
			// vanish where the nearest changes, a hard seam across the sky.)
			Best = DCS_Cumulonimbus(P - Storm.xy, Z, Storm.z, Downwind, Storm.w, F.r, M, BestAnvil, BestUnder, BestEdge, BestHeight, Nearest);
			BestCell = Storm;
			if (Storm2.z > 0.0)
			{
				float CellAnvil;
				float CellUnder;
				float CellEdge;
				float CellHeight;
				float CellOut;
				float D = DCS_Cumulonimbus(P - Storm2.xy, Z, Storm2.z, Downwind, Storm2.w, F.r, M, CellAnvil, CellUnder, CellEdge, CellHeight, CellOut);
				Nearest = min(Nearest, CellOut);
				SecondCell = Storm2;
				if (D > Best)
				{
					Best = D;
					BestAnvil = CellAnvil;
					BestUnder = CellUnder;
					BestEdge = CellEdge;
					BestHeight = CellHeight;
					SecondCell = Storm;
					BestCell = Storm2;
				}
			}
		}
		S.Anchor.Storm = BestCell;
		S.Anchor.Storm2 = SecondCell;
		S.StormDistance = min(Nearest, DCS_STORM_UNSEARCHED_GAP * Scale);
		Bound = saturate(1.0 - Nearest / DCS_STORM_BOUND_MARGIN);
		float TowerU = Best * 4.0;
		float Tower = saturate(TowerU);
		// Where a tower stands out of the clouds around it, it is a tower: billowed up the column (cauliflower), smooth
		// across the anvil's top, lumpier under it; dense throughout. Within the deck it stays the deck (a column's
		// footprint must not show in the deck's underside from below), and the two blend, never switch.
		float Take = saturate((Tower - Base) * 4.0) * (1.0 - DeckBand);
		Base = max(Base, Tower * (1.0 - DeckBand));
		Signed = max(Signed, TowerU > 0.0 ? Tower * (1.0 - DeckBand) : TowerU);
		Profile = lerp(Profile, float3(1.0, lerp(0.5, 0.2, BestEdge), lerp(0.9, lerp(lerp(0.15, 0.4, BestUnder), 0.8, BestEdge), BestAnvil)), Take);
		S.Height = lerp(S.Height, BestHeight, Take);
		S.Column = lerp(S.Column, DCS_STORM_TOP, Take);
		S.Deck *= 1.0 - Take;
	}
	S.Conservative = max(Base, Bound);
	S.Signed = Signed;
	if (Base <= 0.0)
	{
		return S;
	}

	// Billows some 600 m across eat into it: in a cumulus' outer rim mostly the large ones, deeper in the finer and
	// finest mixed in. (The fine octaves' middles in the thin rim would stand alone, crumbs off the cloud; the large
	// ones alone leave round lumps like grapes, so a quarter of the next octave goes with them. The rim is pared back
	// a little as well, whatever the billows there.) A deck is all one body: all the octaves throughout, or its
	// underside swells in large smooth bubbles.
	// The billows are no balls (Worley alone gave round lumps of one size, each lit through near the sun and each
	// shading a ring on its neighbours -- grapes): the field they are read from is warped a little (some 300 m, by the
	// formation's smooth and finer channel, so each billow is dented its own way; much more drew them out into streaks
	// along the Worley channel's creases), and the smooth Perlin-Worley channel gathers them into clumps of every size
	// here and parts them there, crowded cauliflower rather than beads. They carve the shape's outer part; deep in a
	// large body they only dent it, so its middle shows no rings.
	float3 Warp = float3(F.r - 0.5, F.b - 0.5, 0.5 * (F.r + F.b) - 0.5) * (30000.0 * Scale);
	float3 Q = (float3(P, Z) + Warp) / (500000.0 * Scale);
	float4 E = Noise.SampleLevel(NoiseSampler, Q, 0);
	float Deep = max(smoothstep(0.1, 0.4, Base), S.Deck);
	float Worley = lerp(0.75 * E.g + 0.25 * E.b, dot(E.gba, float3(0.5, 0.33, 0.17)), Deep);
	float Billow = saturate(Worley + 0.4 * (E.r - 0.5));
	float Rim = 1.0 - smoothstep(0.0, 0.2, Base);
	float Depth = lerp(1.0, 0.4, smoothstep(0.35, 0.8, Base));
	float Shape = Base - (pow(saturate(1.0 - Billow), 1.5) + 0.08 * Rim) * Cloud2.y * Profile.z * Depth;
	// Near the view a finer octave frays the edges (it fades out with distance, as UDS's high frequency does), within
	// the body, not off its thinnest rim.
	if (Detail > 0.0 && Shape > 0.0)
	{
		float Fine = Detail * (1.0 - smoothstep(300000.0, 1500000.0, length(Rel))) * smoothstep(0.05, 0.3, Base);
		if (Fine > 0.0)
		{
			float N = Noise.SampleLevel(NoiseSampler, Q * 3.5 + E.rgb * 0.21, 0).a;
			Shape -= (1.0 - N) * Cloud2.z * Fine * Profile.z;
		}
	}
	S.Solid = saturate(Shape);
	S.Signed = min(Shape, 1.0);
	// The density rises steeply inside the surface (a cumulus is optically thick: its outline is clear, its inside
	// unseen); small clouds, bases and a deck's gaps stay thinner.
	S.Density = saturate(Shape * 2.5) * (0.4 + 0.6 * saturate(Profile.y / 0.5)) * (1.0 - 0.6 * DeckThin);
	return S;
}

// The clouds at a point. Rel = the point from the view (cm; the detail near the view uses it), World = the point in the
// world (cm), Z = its altitude above the layer's base (cm).
// Cloud0 = (cover at the view, -, scale, -), Cloud1 = (how far the wind has carried the clouds, in units of 2.2 km
// times the scale; how far they have grown and dissolved, the formation's phase 0..1; -), Cloud2 = (how far the hour
// has let fair-weather cumulus grow 0..1, how deep the billows erode, how much the edges fray near the view, -),
// CloudLayer.y = darkness at the view. Detail (0..1) = how much of that fraying this sample takes (0 for the cheap
// samples: normals, shadows).
// Texture reads per call: 3 noise and 2 map always; 1 noise more where a deck closes, 1 noise and up to 9 x 5 map taps
// more near a storm (1 x 9 under a storm's middle); 1 noise more inside the shape and 1 more near the view.
FDCloudShape DCS_Shape(float3 Rel, float3 World, float Z, float4 Cloud0, float4 Cloud1, float4 Cloud2, float4 CloudLayer,
	float4 MapParams, float Detail, Texture2D Map, SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler)
{
	// The field drifts with the wind.
	float Scale = max(Cloud0.z, 0.05);
	float2 P = World.xy + Cloud1.xy * 220000.0 * Scale;
	// The weather is read a couple of kilometres off, wandering, differently with height: a zone's edge (a circle, a box,
	// blended over a short distance) comes out ragged in the clouds, its side heaped, instead of a wall along the shape
	// the level drew.
	float2 Wander = (Noise.SampleLevel(NoiseSampler, float3(P / (1600000.0 * Scale), 0.13 + Z / 1500000.0), 0).rb - 0.5) * 500000.0;
	float3 Here = DCS_MapAt(World.xy + Wander, DCS_ViewWeather(Cloud0, CloudLayer), MapParams, Map, MapSampler);
	return DCS_Field(P, World.xy, Rel, Z, Here.xy, true, float4(0, 0, 0, 0), float4(0, 0, 0, 0), Wander, Scale, Cloud0, Cloud1, Cloud2, CloudLayer,
		MapParams, Detail, Map, MapSampler, Noise, NoiseSampler);
}

// The clouds at a point near one DCS_Shape has sampled (Anchor = that sample's S.Anchor): for the samples around a
// surface -- its normal's taps, the shadow's samples toward the light, a few kilometres at most. It takes the weather
// and the two nearest cumulonimbus from the anchor instead of reading the weather map (no wandering read, no 3 x 3 storm
// search) and leaves out the fine fraying near the view; otherwise it is the same field, so the normals and shadows
// fit the surface. Texture reads: 2 noise; 1 more where a deck closes, 1 more with a cumulonimbus, 1 more inside the
// shape; no map reads. (MapParams, Map and MapSampler go unread; they keep the call like DCS_Shape's.)
FDCloudShape DCS_ShapeNear(float3 World, float Z, FDCloudAnchor Anchor, float4 Cloud0, float4 Cloud1, float4 Cloud2, float4 CloudLayer,
	float4 MapParams, Texture2D Map, SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler)
{
	float Scale = max(Cloud0.z, 0.05);
	float2 P = World.xy + Cloud1.xy * 220000.0 * Scale;
	return DCS_Field(P, World.xy, float3(0, 0, 0), Z, Anchor.Weather, false, Anchor.Storm, Anchor.Storm2, float2(0, 0), Scale, Cloud0, Cloud1,
		Cloud2, CloudLayer, MapParams, 0.0, Map, MapSampler, Noise, NoiseSampler);
}

#endif // DREAMSKY_CLOUDSHAPE_USH
