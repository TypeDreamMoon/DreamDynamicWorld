//
// Niagara GPU side of UNiagaraDataInterfaceDreamWind. Appended once per data interface symbol, so
// every global carries the _{ParameterName} suffix; the shared header has an include guard.

#include "/Plugin/DreamWind/Shared/DreamWindShared.h"

float4  {ParameterName}_P0;
float4  {ParameterName}_P1;
float4  {ParameterName}_P2;
float4  {ParameterName}_V0;
float4  {ParameterName}_V1;
float4  {ParameterName}_V2;
float4  {ParameterName}_V3;
float4  {ParameterName}_T0;
float4  {ParameterName}_T1;
float3  {ParameterName}_SystemLWCTile;
uint    {ParameterName}_NumSources;
StructuredBuffer<float4> {ParameterName}_Sources;
Texture3D<float4> {ParameterName}_VolumeTexture;
SamplerState      {ParameterName}_VolumeSampler;
Texture3D<float4> {ParameterName}_VolumeFarTexture;
SamplerState      {ParameterName}_VolumeFarSampler;
Texture2D<float4> {ParameterName}_TerrainTexture;
SamplerState      {ParameterName}_TerrainSampler;

void SampleWind_{ParameterName}(in float3 In_Position, out float3 Out_Velocity, out float Out_Gust)
{
	const float3 WorldPos = In_Position + {ParameterName}_SystemLWCTile * UE_LWC_RENDER_TILE_SIZE;

	const FDreamWindParams P = DW_UnpackParams({ParameterName}_P0, {ParameterName}_P1, {ParameterName}_P2);
	FDreamWindSample S = {AnalyticFunction}(P, WorldPos);
	{
		const FDreamWindTerrainParams TP = DW_UnpackTerrain({ParameterName}_T0, {ParameterName}_T1);
		const float2 TUV = DW_TerrainUV(WorldPos, TP);
		const float Inside = DW_TerrainInside(TUV, TP);
		if (Inside > 0.0f)
		{
			S = DW_ApplyTerrain(S, {ParameterName}_TerrainTexture.SampleLevel({ParameterName}_TerrainSampler, TUV, 0), TP, Inside);
		}
	}
	float3 V = S.Velocity;

	float VolumeMask = 0.0f;
#if {SampleVolume}
	// near level wins inside its window; the far level covers the rest of its own window
	const FDreamWindVolumeParams VP = DW_UnpackVolume({ParameterName}_V0, {ParameterName}_V1);
	const FDreamWindVolumeParams VPF = DW_UnpackVolume({ParameterName}_V2, {ParameterName}_V3);
	const float NearMask = DW_VolumeMask(WorldPos, VP);
	const float FarMask = DW_VolumeMask(WorldPos, VPF);
	float3 Residual = 0;
	if (FarMask > 0.0f)
	{
		Residual = {ParameterName}_VolumeFarTexture.SampleLevel({ParameterName}_VolumeFarSampler, DW_VolumeUVW(WorldPos, VPF), 0).xyz * FarMask;
	}
	if (NearMask > 0.0f)
	{
		Residual = lerp(Residual, {ParameterName}_VolumeTexture.SampleLevel({ParameterName}_VolumeSampler, DW_VolumeUVW(WorldPos, VP), 0).xyz, NearMask);
	}
	V += Residual;
	VolumeMask = max(NearMask, FarMask);
#endif

#if {ApplySources}
	// Inside the volume window the sources already live in the volume; outside it they are applied directly.
	const float SourceFactor = 1.0f - VolumeMask;
	if (SourceFactor > 0.0f)
	{
		for (uint i = 0; i < {ParameterName}_NumSources; ++i)
		{
			FDreamWindSourceData Src;
			Src.PositionRadius    = {ParameterName}_Sources[i * DW_SOURCE_FLOAT4S + 0];
			Src.DirectionStrength = {ParameterName}_Sources[i * DW_SOURCE_FLOAT4S + 1];
			Src.Misc              = {ParameterName}_Sources[i * DW_SOURCE_FLOAT4S + 2];
			Src.BoxExtent         = {ParameterName}_Sources[i * DW_SOURCE_FLOAT4S + 3];
			Src.BoxRotation       = {ParameterName}_Sources[i * DW_SOURCE_FLOAT4S + 4];
			V = DW_ApplySource(V, Src, WorldPos, SourceFactor);
		}
	}
#endif

	Out_Velocity = V;
	Out_Gust = S.Gust;
}

void GetGlobalWind_{ParameterName}(out float3 Out_Direction, out float Out_Speed)
{
	Out_Direction = {ParameterName}_P0.xyz;
	Out_Speed = {ParameterName}_P0.w;
}
