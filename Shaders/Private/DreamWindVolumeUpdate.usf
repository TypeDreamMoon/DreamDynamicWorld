//
// One step of the dynamic wind volume (L2). See FDreamWindVolumeRenderer.

#include "/Engine/Private/Common.ush"
#include "/Plugin/DreamDynamicWorld/Shared/DreamWindShared.h"

float4 P0;
float4 P1;
float4 P2;
float4 T0;
float4 T1;
float4 T2;
float3 PrevCenter;
float  PrevValid;
float3 NewCenter;
float  VoxelSize;
float3 InvExtent;
float  DeltaTime;
int3   Resolution;
float  DecayFactor;
uint   NumSources;
float  AdvectScale;

StructuredBuffer<float4> Sources;
Texture3D<float4> PrevVolume;
SamplerState PrevSampler;
Texture2D<float4> TerrainTexture;
SamplerState TerrainSampler;
float4 L1Near;
float4 L1Far;
float4 L1Params;
Texture2D<float4> L1NearMap;
Texture2D<float4> L1FarMap;
SamplerState L1Sampler;
RWTexture3D<float4> OutVolume;

float4 SamplePrev(float3 WorldPos)
{
	float3 uvw = (WorldPos - PrevCenter) * InvExtent + 0.5f;
	// half a voxel inside the border, so the clamp sampler never mixes in the edge texel twice
	float3 lo = InvExtent * VoxelSize * 0.5f;
	if (any(uvw < lo) || any(uvw > 1.0f - lo))
	{
		return 0;
	}
	return PrevVolume.SampleLevel(PrevSampler, uvw, 0);
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, THREADGROUP_SIZE)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
	if (any(DTid >= uint3(Resolution)))
	{
		return;
	}

	const float3 HalfExtent = 0.5f / InvExtent;
	const float3 WorldPos = NewCenter - HalfExtent + (float3(DTid) + 0.5f) * VoxelSize;

	const FDreamWindParams P = DW_UnpackParams(P0, P1, P2);
	FDreamWindSample Analytic = DW_SampleAnalyticCheap(P, WorldPos);
	const FDreamWindL1Level LN = DW_UnpackL1Level(L1Near);
	const FDreamWindL1Level LF = DW_UnpackL1Level(L1Far);
	if (LN.Mode > 0.5f || LF.Mode > 0.5f)
	{
		// the runtime terrain wind map: one texel per level
		const float WN = DW_L1Weight(WorldPos, LN);
		const float WF = DW_L1Weight(WorldPos, LF);
		const float4 TN = WN > 0.0f ? L1NearMap.SampleLevel(L1Sampler, DW_L1UV(WorldPos, LN), 0) : float4(1.0f, 0.0f, 0.0f, -1.0e7f);
		const float4 TF = WF > 0.0f ? L1FarMap.SampleLevel(L1Sampler, DW_L1UV(WorldPos, LF), 0) : float4(1.0f, 0.0f, 0.0f, -1.0e7f);
		Analytic = DW_ApplyL1(Analytic, WorldPos, TN, WN, TF, WF, DW_UnpackL1Params(L1Params));
	}
	else
	{
		const FDreamWindTerrainParams TP = DW_UnpackTerrain(T0, T1, T2);
		const float2 TUV = DW_TerrainUV(WorldPos, TP);
		const float Inside = DW_TerrainInside(TUV, TP);
		if (Inside > 0.0f)
		{
			FDreamWindSample S = DW_ApplyTerrain(Analytic, TerrainTexture.SampleLevel(TerrainSampler, DW_TerrainAtlasUV(TUV, 0, TP), 0), TP, Inside);
			// occlusion: the sample's own texel, then upwind taps through the baked heights
			if (DW_OcclusionActive(TP, length(float2(S.Velocity.x, S.Velocity.y))))
			{
				float Shadow = DW_OcclusionSelf(DW_TerrainHeight(TerrainTexture.SampleLevel(TerrainSampler, DW_TerrainAtlasUV(TUV, 0, TP), 0), TP), WorldPos.z);
				const float2 UpDir = -normalize(float2(S.Velocity.x, S.Velocity.y));
				[unroll]
				for (int k = 1; k <= DW_OCCLUSION_TAPS; ++k)
				{
					const int Level = DW_OcclusionTapLevel(k, TP);
					const float TapDist = DW_OcclusionTapDistance(k, TP);
					const float2 TapXY = DW_OcclusionXYAt(WorldPos, UpDir, TapDist);
					const float2 TapUV = DW_TerrainUV(float3(TapXY.x, TapXY.y, WorldPos.z), TP);
					if (DW_TerrainInside(TapUV, TP) <= 0.0f)
					{
						break;
					}
					const float MidDist = DW_OcclusionMidDistance(k, TP);
					const float2 MidXY = DW_OcclusionXYAt(WorldPos, UpDir, MidDist);
					const float2 MidUV = DW_TerrainUV(float3(MidXY.x, MidXY.y, WorldPos.z), TP);
					Shadow = DW_OcclusionAccumulate(Shadow, DW_TerrainHeight(TerrainTexture.SampleLevel(TerrainSampler, DW_TerrainAtlasUV(MidUV, Level, TP), 0), TP), WorldPos.z, MidDist, TP);
					Shadow = DW_OcclusionAccumulate(Shadow, DW_TerrainHeight(TerrainTexture.SampleLevel(TerrainSampler, DW_TerrainAtlasUV(TapUV, Level, TP), 0), TP), WorldPos.z, TapDist, TP);
				}
				S = DW_ApplyOcclusion(S, Shadow, TP);
			}
			Analytic = S;
		}
	}

	float4 Residual = 0;
	if (PrevValid > 0.5f)
	{
		float3 SamplePos = WorldPos;
		if (AdvectScale > 0.0f)
		{
			// where did the air that is here now come from? (semi-Lagrangian back-trace)
			const float3 Here = SamplePrev(WorldPos).xyz;
			SamplePos = WorldPos - (Analytic.Velocity + Here) * (DeltaTime * AdvectScale);
		}
		Residual = SamplePrev(SamplePos) * DecayFactor;
	}

	float3 Velocity = Residual.xyz;
	float  Activity = Residual.w;

	// Sources: blend the TOTAL wind toward the source velocity, i.e. the residual toward
	// (source - analytic), so a full-weight source reads back as exactly its own velocity.
	for (uint i = 0; i < NumSources; ++i)
	{
		FDreamWindSourceData S;
		S.PositionRadius    = Sources[i * DW_SOURCE_FLOAT4S + 0];
		S.DirectionStrength = Sources[i * DW_SOURCE_FLOAT4S + 1];
		S.Misc              = Sources[i * DW_SOURCE_FLOAT4S + 2];
		S.BoxExtent         = Sources[i * DW_SOURCE_FLOAT4S + 3];
		S.BoxRotation       = Sources[i * DW_SOURCE_FLOAT4S + 4];
		const FDreamWindSourceEval E = DW_EvalSource(S, WorldPos);
		const float Rate = saturate(S.Misc.y * DeltaTime);
		const float W = saturate(E.Weight * Rate);
		Velocity = lerp(Velocity, E.Velocity - Analytic.Velocity, W);
		Activity = max(Activity, E.Weight);
	}

	OutVolume[DTid] = float4(Velocity, Activity);
}
