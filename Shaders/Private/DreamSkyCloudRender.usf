// The farthest the clouds are drawn (cm), and where the fine fraying near the view has faded out.
static const float DSkyR_MaxDist = 9000000.0;
static const float DSkyR_DetailEnd = 6000000.0;

int2 DSkyR_RaySize()
{
	return int2(ceil(View.ViewSizeAndInvSize.xy / float(Downsample)));
}

// The full-resolution position (pixels, in the scene textures) a ray goes through: the middle of its block.
float2 DSkyR_FullPixel(int2 Ray)
{
	return View.ViewRectMin.xy + (float2(Ray) + 0.5) * float(Downsample);
}

float3 DSkyR_ViewDir(float2 FullPixel)
{
	return normalize(SvPositionToTranslatedWorld(float4(FullPixel, 0.5, 1.0)) - View.TranslatedWorldCameraOrigin);
}

bool DSkyR_IsSky(int2 Pixel)
{
	float DeviceZ = SceneDepth.Load(int3(Pixel, 0)).r;
	return DeviceZ <= 0.0 || ConvertFromDeviceZ(DeviceZ) >= SkyDepth;
}

// How far along V (from the view, cm) the scene stands at a pixel.
float DSkyR_SceneDistance(int2 Pixel, float3 V)
{
	float DeviceZ = SceneDepth.Load(int3(Pixel, 0)).r;
	return DeviceZ <= 0.0 ? 1.0e10 : ConvertFromDeviceZ(DeviceZ) / max(dot(V, View.ViewForward), 1.0e-3);
}

FDSkyCloudField DSkyR_Field()
{
	FDSkyCloudField F;
	F.Camera = CameraWorld;
	F.Base = max(P_CloudLayer.x, 10000.0);
	F.Iso = 0.06;
	F.Cloud0 = P_Cloud0;
	F.Cloud1 = P_Cloud1;
	F.Cloud2 = P_Cloud2;
	F.CloudLayer = P_CloudLayer;
	F.Thin = 0.0;
	return F;
}

// The march's steps at T (cm along the ray) with Left samples left for the rest of the ray (to T1): fine steps of some
// 0.6 % of the distance (30 m near, 200 m from 33 km: within a billow), never shorter than half the samples left could
// walk the rest of the ray in -- most of a ray is skipped (budgeted to walk all of it fine, 160 samples walked a storm
// tower seen from under it in some 140 m steps where 70 m were meant, and the toon surface came out blurred and mottled,
// a realistic or painted one washed out); skips up to 4 km, trusted in full (a true bound, or a step meant as one).
// bByDistance: the fine steps by the distance alone -- the toon march's (which stops at its surface and walks no cloud
// through), the realistic and painted marches' out of a deck (whose long way through needs the samples). Stretched to
// the samples left (tens of kilometres of the layer ahead of a ray aslant), a cloud's thin fringe and a deck's first
// lenses fell between them on some rays and not on their neighbours', in rows of dashes and stripes across the clouds.
FDCloudMarchParams DSkyR_Params(float3 V, float T, float T1, int Left, float Jitter, FDSkyCloudField F, bool bByDistance)
{
	float Fine = clamp(T * 0.006, 3000.0, 20000.0);
	if (!bByDistance)
	{
		Fine = max(Fine, 0.5 * (T1 - T) / float(max(Left - 8, 1)));
	}
	// (Never so long near a funnel that its narrow column falls between two samples.)
	float3 World = CameraWorld + V * T;
	Fine = min(Fine, DSky_FunnelStep(World, World.z + dot(World.xy, World.xy) / (2.0 * DSky_PlanetRadius), F.Base));
	FDCloudMarchParams P = DCM_DefaultParams(Fine);
	P.MinSkip = Fine;
	P.MaxSkip = 400000.0;
	P.SkipScale = 1.0;
	P.ExitDistance = 1.5 * Fine;
	P.BackOff = 1.0;
	P.Jitter = Jitter;
	return P;
}

// Whether a sample whose weather reads this point of the map could search for storms: the darkest the map's bilinear read
// gives about it (its texel's, the view's where the read leans that way at the map's rim or off it).
float DSkyR_SearchDarkness(float2 Point, float3 ViewWeather)
{
	float2 UV = (P_MapParams.xy + Point) * P_MapParams.z + 0.5;
	if (P_MapParams.w < 0.5)
	{
		return ViewWeather.y;
	}
	float Inside = saturate(min(min(UV.x, 1.0 - UV.x), min(UV.y, 1.0 - UV.y)) * 8.0);
	float Dark = DCS_AdjustMap(WeatherMap.SampleLevel(WeatherMapSampler, saturate(UV), 0).xyz).y;
	return Inside < 1.0 ? max(Dark, ViewWeather.y) : Dark;
}

// How far (cm, at least) a point of the world (horizontally) is from wherever a sample may search for storms: the storm
// proximity map, less what its cells and a sample's wandering weather leave unknown. Off the map, the map's rim is that
// far, less how far off; and a point off it searches only where the view's weather is dark enough, or where its weather
// (wandering) or that 9 km upwind of it falls on the map.
float DSkyR_StormReach(float2 World2)
{
	float Extent = 1.0 / max(P_MapParams.z, 1.0e-12);
	float2 UV = (P_MapParams.xy + World2) * P_MapParams.z + 0.5;
	float Off = length(max(max(-UV, UV - 1.0), 0.0)) * Extent;
	float3 ViewWeather = DCS_ViewWeather(P_Cloud0, P_CloudLayer);
	if (Off > 0.0 && (P_MapParams.w < 0.5 || saturate(ViewWeather.y * 1.3 - 0.2) > DCS_STORM_SEARCH_DARKNESS))
	{
		return 0.0;
	}
	int2 Cell = clamp(int2(UV * float(ProximityResolution)), 0, ProximityResolution - 1);
	// (The wander either way across and along, and two cells: a cell's middle against its far corner where it is read,
	// and where it was marked. Off the map, the 9 km upwind too: a point marked on the map may search from off it.)
	float Wander = DCS_WEATHER_WANDER * 1.4143;
	float Margin = Wander + 2.0 * 1.4143 * Extent / float(ProximityResolution) + (Off > 0.0 ? 900000.0 : 0.0);
	return max(StormProximity.Load(int3(Cell, 0)) - Off - Margin, Off - 900000.0 - Wander);
}

// How far the march may skip from a sample: over the layer only cumulonimbus stand, and the shape gives a true bound of
// the distance to them (and to the layer's top), or where it searched for none, the storm proximity map does
// (DSkyR_StormReach); in the layer, the shape's bound says only whether cloud may be here, and nothing bounds how far the
// nearest such place is (the formation's noise and the weather it reads, wandering, have no useful limit to their
// slope), so the march walks fine where cloud may be and some two fine steps where it may not, backing off to walk fine
// if one lands where it may. (A step of 1.2 % of the distance, up to 800 m, crossed what the bound calls cloud where it
// was thinner than that -- a toon tower's ledges seen from under it came and went from frame to frame -- and cost no
// less: landing in cloud, it backed off and searched for the edge.) SkipJitter (0..1, per pixel and frame) varies the
// bounds' skips 0.7 to 1 times, never past them: with lengths fixed by the distance alone, neighbouring rays' samples
// fell in step with one another, and where they skimmed a thin cloud they drew moire, hatched patches and horizontal
// bands that no history averages away. (Not the two fine steps: the march's own jitter already parts the rays by up to a
// step there; varied as well, some fell under the length the march leaves its fine walk at, and the march cost up to
// half as much again.)
// A city's light from below as a cloud catches it at a height in it (0 base .. 1 top): the light pollution at the horizon
// (DDW_LightPollution) times how much the bases catch (DDW_NightGlow.a), most at the base.
float3 DSkyR_UnderLight(float Height)
{
	float FromBase = 1.0 - saturate(Height);
	return P_LightPollution.rgb * P_NightGlow.a * FromBase * FromBase;
}

// The stretch of the ray through the funnels' reach (empty, T1 <= T0, where it passes none): where the ray passes
// within ReachRadii of a funnel's radii at the base from its axis, between its root and TopOver (of the root's height
// under the base) up in the cloud. In: T0, T1 a stretch already found, widened by the funnels'.
void DSkyR_WidenByFunnels(float3 V, FDSkyCloudField F, float MaxT, float ReachRadii, float TopOver, inout float T0,
	inout float T1)
{
	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		float4 A = DSKY_FUNNEL_A(i);
		float4 B = DSKY_FUNNEL_B(i);
		if (abs(A.w) <= 0.001 || A.z <= 0.0)
		{
			continue;
		}
		float2 Centre = A.xy + B.zw * 0.5;
		float Reach = A.z * ReachRadii + 0.5 * length(B.zw);
		float2 O = CameraWorld.xy - Centre;
		float a = dot(V.xy, V.xy);
		float b = dot(O, V.xy);
		float c = dot(O, O) - Reach * Reach;
		float Lo = 0.0;
		float Hi = MaxT;
		if (a > 1.0e-8)
		{
			float Disc = b * b - a * c;
			if (Disc < 0.0)
			{
				continue;
			}
			float Root = sqrt(Disc);
			Lo = (-b - Root) / a;
			Hi = (-b + Root) / a;
		}
		else if (c > 0.0)
		{
			continue;
		}
		// Between the root's height and a little over the base.
		float Bottom = B.y - 1000.0;
		float Top = F.Base + (TopOver - 1.0) * max(F.Base - B.y, 1000.0);
		if (abs(V.z) > 1.0e-6)
		{
			float TA = (Bottom - CameraWorld.z) / V.z;
			float TB = (Top - CameraWorld.z) / V.z;
			Lo = max(Lo, min(TA, TB));
			Hi = min(Hi, max(TA, TB));
		}
		else if (CameraWorld.z < Bottom || CameraWorld.z > Top)
		{
			continue;
		}
		Lo = max(Lo, 0.0);
		Hi = min(Hi, MaxT);
		if (Hi <= Lo)
		{
			continue;
		}
		if (T1 <= T0)
		{
			T0 = Lo;
			T1 = Hi;
		}
		else
		{
			T0 = min(T0, Lo);
			T1 = max(T1, Hi);
		}
	}
}

// The stretch of the ray through the funnels' columns themselves, up to where they flare into the base (not the base
// lowered and darkened round them, nor the flare).
void DSkyR_FunnelSpan(float3 V, FDSkyCloudField F, float MaxT, out float T0, out float T1)
{
	T0 = 0.0;
	T1 = 0.0;
	DSkyR_WidenByFunnels(V, F, MaxT, 2.0, 0.75, T0, T1);
}

// The stretch of the ray to march: DSky_LayerSpan's through the layer, widened to every funnel's below the base.
void DSkyR_CloudSpan(float3 V, FDSkyCloudField F, float MaxT, out float T0, out float T1)
{
	DSky_LayerSpan(CameraWorld, V, F.Base, F.Base + DCS_STORM_TOP, MaxT, T0, T1);
	DSkyR_WidenByFunnels(V, F, MaxT, DSky_FunnelReach, DSky_FunnelTop, T0, T1);
}

float DSkyR_Distance(FDSkyCloudSample C, float T, FDCloudMarchParams P, float SkipJitter, float2 World2)
{
	float LayerStep = 2.0 * P.FineStep;
	float Bound = 0.7 + 0.3 * SkipJitter;
	if (C.Z >= DCS_LAYER_TOP)
	{
		// (Over the layer only cumulonimbus stand. Where this sample searched for none, the nearest stands at least as far
		// as the nearest place a sample searches from; close to one, a step no longer than 300 m -- a rim's fragments are
		// that size -- rather than the march walking it fine.)
		float Storm = C.StormDistance > 0.5 * DCS_STORM_UNSEARCHED ? C.StormDistance : max(DSkyR_StormReach(World2), 30000.0);
		return min(Storm * Bound, max(C.Z - DCS_LAYER_TOP, LayerStep));
	}
	if (C.Z <= 0.0)
	{
		return C.StormDistance * Bound;
	}
	return C.Form > 0.0 ? 0.0 : LayerStep;
}

FDSkyCloudSample DSkyR_Sample(float3 V, float T, FDSkyCloudField F, FDCloudAnchor Anchor)
{
	return DSky_CloudAt(V * T, F, false, Anchor, P_MapParams, WeatherMap, WeatherMapSampler, CloudNoise, CloudNoiseSampler,
		1.0 - smoothstep(DSkyR_DetailEnd * 0.5, DSkyR_DetailEnd, T));
}

// The sky along V the way the dome sees it: Base (the gradient), its sun halo, Tone (the gradient against its mean: what
// tints the clouds) and SkyBehind (the colour the air between takes; looking down, the low sky's).
void DSkyR_Sky(float3 V, out float3 Halo, out float3 Tone, out float3 SkyBehind)
{
	// (The dome's own sky: the physical one through the style's grade, the style's gradient as far as it says.)
	float3 Sun = normalize(P_SunDir.xyz);
	float3 Moon = normalize(P_MoonDir.xyz);
	float Share;
	float3 Base = DSky_SkyBackdrop(V, Sun, Moon, P_Zenith, P_Horizon, P_Ground, P_SunHalo, P_SkyGrade0, P_SkyGrade1, P_SkyGrade2,
		P_SkyGrade3, P_AtmosphereSun, P_AtmosphereMoon, SkyTable, SkyTableSampler, Halo, Share);
	float3 Mean = max(0.5 * (P_Zenith.rgb + P_Horizon.rgb), 1.0e-4);
	Tone = clamp(Base / Mean, 0.25, 4.0);
	// (Its hue kept within a third of its brightness of neutral: in the deep twilight the warm horizon in the mean and the
	// blue overhead made it a deep blue, which painted the clouds a glowing blue; by day it is well within.)
	float ToneLuma = dot(Tone, float3(0.2126, 0.7152, 0.0722));
	float3 ToneChroma = Tone - ToneLuma;
	float Spread = max(max(abs(ToneChroma.r), abs(ToneChroma.g)), abs(ToneChroma.b));
	Tone = ToneLuma + ToneChroma * min(1.0, 0.35 * ToneLuma / max(Spread, 1.0e-4));
	float3 HazeHalo = Halo;
	float3 Haze = V.z >= 0.0 ? Base : DSky_SkyBackdrop(DSky_HazeDirection(V), Sun, Moon, P_Zenith, P_Horizon, P_Ground, P_SunHalo,
		P_SkyGrade0, P_SkyGrade1, P_SkyGrade2, P_SkyGrade3, P_AtmosphereSun, P_AtmosphereMoon, SkyTable, SkyTableSampler, HazeHalo, Share);
	SkyBehind = Haze + HazeHalo;
}


// The extinction at a sample (per cm), as the engine's cloud material has it: its CloudExtinction (some 0.08 per metre)
// in a full cloud, the faint fringe drawn in a little (1 - (1 - d)^2), a storm's cloud up to twice as dense. (What the
// sun map and the light toward the sun go by, in every look.)
float DSkyR_Extinction(FDSkyCloudSample C)
{
	return (1.0 - (1.0 - C.Volume) * (1.0 - C.Volume)) * LP_Extinction * (1.0 + C.Dark);
}

// The sun map at a point (World: in the world, cm; Z: above the layer's base over the planet's curve, cm): the optical
// depth toward the sun, from the near cascade where it reaches, the far one beyond, none past both.
float DSkyR_SunTauOr(float3 World, float Z, float Outside)
{
	float3 Near = float3((World.xy - NearCenterExtent.xy) / (2.0 * NearCenterExtent.z) + 0.5, Z / DCS_STORM_TOP);
	float2 NearEdge = min(Near.xy, 1.0 - Near.xy);
	if (min(NearEdge.x, NearEdge.y) > 0.01)
	{
		return NearTau.SampleLevel(TauSampler, saturate(Near), 0);
	}
	float3 Far = float3((World.xy - FarCenterExtent.xy) / (2.0 * FarCenterExtent.z) + 0.5, Z / DCS_STORM_TOP);
	float2 FarEdge = min(Far.xy, 1.0 - Far.xy);
	return min(FarEdge.x, FarEdge.y) > 0.0 ? FarTau.SampleLevel(TauSampler, saturate(Far), 0) : Outside;
}

float DSkyR_SunTau(float3 World, float Z)
{
	return DSkyR_SunTauOr(World, Z, 0.0);
}

// The air's transmittance from a point at a height (cm over the ground) toward a light at an elevation (its direction's
// z), as the engine lights its clouds by their atmosphere lights: the light component's colour is the light above the
// air, and each sample sees it through the air between -- a low sun's light reaches a low cloud red and dim, a tall
// tower's top bright. (The engine's default atmosphere: Rayleigh 8 km, Mie 1.2 km, ozone; the slant through the air by
// the elevation counted from the horizon's dip at that height.)
float3 DSkyR_AirTransmittance(float Height, float LightZ)
{
	// (The atmosphere's own table once built: the light through the same air the sky is made of.)
	if (TransmittanceSize.x > 0)
	{
		FDSA_Atmosphere A = DSA_Unpack(Atmosphere[0], Atmosphere[1], Atmosphere[2], Atmosphere[3], Atmosphere[4]);
		float r = A.BottomRadius + max(Height, 0.0) * 1.0e-5;
		float mu = clamp(LightZ, -1.0, 1.0);
		if (DSA_HitsGround(A, r, mu))
		{
			return 0.0;
		}
		float2 P = DSA_TransmittanceUv(A, r, mu);
		return TransmittanceLut.SampleLevel(TransmittanceSampler, float2(DSA_TableTexcoord(P.x, float(TransmittanceSize.x)), DSA_TableTexcoord(P.y, float(TransmittanceSize.y))), 0).rgb;
	}
	float Km = max(Height, 0.0) * 1.0e-5;
	float Dip = sqrt(2.0 * max(Height, 0.0) / DSky_PlanetRadius);
	float Elevation = degrees(asin(clamp(LightZ, -1.0, 1.0)) + Dip);
	float Air = 1.0 / (sin(radians(max(Elevation, 0.0))) + 0.15 * pow(max(Elevation, 0.0) + 3.885, -1.253));
	float3 Rayleigh = float3(5.802, 13.558, 33.1) * 1.0e-3 * 8.0 * exp(-Km / 8.0);
	float Mie = 4.44e-3 * 1.2 * exp(-Km / 1.2);
	float3 Ozone = float3(0.65, 1.881, 0.085) * 1.0e-3 * 25.0 * saturate(1.0 - Km / 35.0);
	return exp(-(Rayleigh + Mie + Ozone) * Air);
}

// A colour's hue taken a share (Toward) of the way to another's, its luminance kept.
float3 DSkyR_TowardHue(float3 C, float3 Other, float Toward)
{
	const float3 Luma = float3(0.2126, 0.7152, 0.0722);
	float L = dot(C, Luma);
	float3 Hue = lerp(C / max(L, 1.0e-6), Other / max(dot(Other, Luma), 1.0e-6), saturate(Toward));
	return Hue * (L / max(dot(Hue, Luma), 1.0e-6));
}

// The clouds' lit and shade colours (rgb; a as the style's: the rim, the opacity): from the physical sky's light -- the
// sun's and the moon's outside the air through it to the clouds' base, the sky's ambient light (the shared parameters'
// DDW_AmbientSky / Equator, as the sky works them out), as bright as the style's curves when it asks (their colour the
// light's), their hue taken toward the style's as far as it says at this sun (LookParameters[161]: at night all of the
// way for the shade, most of it for the lit side, so a blue night floor never comes out saturated), times the style's
// scales (LookParameters[157..160]); the
// style's own curves (DDW_CloudLit / Shadow) when it asks for them (bCloudColorsAbsolute) or the atmosphere's tables are
// not built.
void DSkyR_CloudColours(out float4 Lit, out float4 Shade)
{
	Lit = P_CloudLit;
	Shade = P_CloudShadow;
	if (LookParameters[157].w > 0.5 || P_AtmosphereSun.w < 0.5)
	{
		return;
	}
	float Base = P_CloudLayer.x + 50000.0;
	float3 SunLight = P_AtmosphereSun.rgb * DSkyR_AirTransmittance(Base, normalize(P_SunDir.xyz).z);
	float3 MoonLight = P_AtmosphereMoon.rgb * DSkyR_AirTransmittance(Base, normalize(P_MoonDir.xyz).z);
	float3 Light = SunLight + MoonLight;
	float3 Ambient = 0.5 * (P_AmbientSky.rgb + P_AmbientEquator.rgb);
	if (LookParameters[158].w > 0.5)
	{
		// (As bright as the style's own colours: their luminance, the light's colour.)
		const float3 Luma = float3(0.2126, 0.7152, 0.0722);
		Light *= dot(P_CloudLit.rgb, Luma) / max(dot(Light, Luma), 1.0e-6);
		Ambient *= dot(P_CloudShadow.rgb, Luma) / max(dot(Ambient, Luma), 1.0e-6);
	}
	// (The hue toward the style's own, as far as the style says at this sun; then the toon look's scales, or the painted
	// look's.)
#if DSKY_LOOK == 2
	Lit.rgb = DSkyR_TowardHue(Light, P_CloudLit.rgb, LookParameters[161].z) * LookParameters[159].rgb;
	Shade.rgb = DSkyR_TowardHue(Ambient, P_CloudShadow.rgb, LookParameters[161].w) * LookParameters[160].rgb;
#else
	Lit.rgb = DSkyR_TowardHue(Light, P_CloudLit.rgb, LookParameters[161].x) * LookParameters[157].rgb;
	Shade.rgb = DSkyR_TowardHue(Ambient, P_CloudShadow.rgb, LookParameters[161].y) * LookParameters[158].rgb;
#endif
}

// The sky's height fog over a cloud Distance along V, as the engine's renderer lays it over its own clouds (its
// exponential height fog, one term, the start distance, the max opacity; no directional inscattering, which the sky does
// not use): rgb the fog's light, a what of the cloud still shows.
float4 DSkyR_HeightFog(float3 V, float Distance)
{
	float Density = LP_Fog.x;
	if (Density <= 0.0 || Distance <= 0.0)
	{
		return float4(0, 0, 0, 1);
	}
	float Falloff = LP_Fog.y;
	float Start = min(LP_Fog.w, Distance);
	float RayLength = Distance - Start;
	float StartZ = CameraWorld.z + V.z * Start;
	float RayZ = V.z * RayLength;
	float OriginTerms = Density * exp2(-max(-127.0, Falloff * (StartZ - LP_Fog.z)));
	float F = max(-127.0, Falloff * RayZ);
	float LineIntegral = abs(F) > 1.0e-4 ? (1.0 - exp2(-F)) / F : log(2.0) - 0.5 * log(2.0) * log(2.0) * F;
	float Through = max(saturate(exp2(-OriginTerms * LineIntegral * RayLength)), LP_FogColor.a);
	return float4(LP_FogColor.rgb * (1.0 - Through), Through);
}

// A point's height over the layer's base, over the planet's curve (cm), as the field measures it.
float DSkyR_HeightAt(float3 World, FDSkyCloudField F)
{
	return World.z + dot(World.xy, World.xy) / (2.0 * DSky_PlanetRadius) - F.Base;
}

#if DSKY_LOOK == 0

// Toon: the surface (the first crossing of the toon level, refined), then lit and painted as the dome's toon march does.
float4 DSkyR_Toon(float3 V, int2 Ray, float SceneT, out float SurfaceDepth)
{
	SurfaceDepth = -1.0;
	if (P_Cloud0.x <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	FDSkyCloudField F = DSkyR_Field();
	// (Thinned round the sun and the moon, as this ray sees them.)
	F.Thin = DSky_Clearing(V, normalize(P_SunDir.xyz), normalize(P_MoonDir.xyz), P_CloudClearing);
	float T0;
	float T1;
	DSkyR_CloudSpan(V, F, min(DSkyR_MaxDist, SceneT), T0, T1);
	if (T0 >= T1)
	{
		return float4(0, 0, 0, 0);
	}
	float Jitter = MarchDebug == 2u ? 0.5 : DCM_InterleavedGradientNoise(float2(Ray), View.StateFrameIndex);
	float SkipJitter = frac(Jitter + 0.618034 * float(View.StateFrameIndex % 97u) + 0.5);
	FDCloudSurface S = DCM_SurfaceBegin(T0, T1, 5);
	FDCloudAnchor Anchor = (FDCloudAnchor)0;
	float AnchorSigned = -1.0e9;
	[loop]
	for (int i = 0; i < MaxSamples && DCM_SurfaceRunning(S); ++i)
	{
		float T = S.M.T;
		FDSkyCloudSample C = DSkyR_Sample(V, T, F, Anchor);
		// (The walk round the surface reads the field the cheap way, from the sample nearest to being inside.)
		if (C.Signed >= AnchorSigned)
		{
			AnchorSigned = C.Signed;
			Anchor = C.Anchor;
		}
		FDCloudMarchParams P = DSkyR_Params(V, T, T1, MaxSamples - i, Jitter, F, true);
		FDCloudField Fd;
		Fd.Signed = C.Signed - F.Iso;
		Fd.Density = C.Volume;
		Fd.Distance = DSkyR_Distance(C, T, P, SkipJitter, CameraWorld.xy + V.xy * T);
		DCM_SurfaceAdvance(S, Fd, P);
	}
	float SurfaceT = S.bHit ? S.HitT : S.ClosestT;
	float BestSigned = S.bHit ? F.Iso : S.Closest + F.Iso;
	// A ray that only came near a cloud (some 80 m of a cumulus) searches the stretch round its nearest sample for the
	// closest approach, as the dome's march does (the walk's phase 2): a cloud that barely reaches the toon level can lie
	// between two samples.
	bool bNear = !S.bHit && BestSigned > F.Iso - 0.025;
	if (!S.bHit && !bNear)
	{
		return float4(0, 0, 0, 0);
	}

	float3 Halo;
	float3 Tone;
	float3 SkyBehind;
	DSkyR_Sky(V, Halo, Tone, SkyBehind);
	float3 Sun = normalize(P_SunDir.xyz);
	float3 LightDir = normalize(P_MainLight.xyz);
	float3 Ld = normalize(LightDir + float3(0.0, 0.0, 0.08));
	float Merging = smoothstep(0.55, 0.85, P_Cloud0.x);

	FDSkySurfaceWalk W = (FDSkySurfaceWalk)0;
	W.Phase = S.bHit ? 3 : 2;
	if (bNear)
	{
		W.BestStep = 2.0 * clamp(SurfaceT * 0.006, 3000.0, 20000.0);
		W.Lo = max(SurfaceT - W.BestStep, T0);
		W.Hi = min(SurfaceT + W.BestStep, T1);
	}
	W.bHit = S.bHit;
	W.BestSigned = BestSigned;
	W.BestT = SurfaceT;
	// (No surface yet when the walk is to search for it: a search that finds none paints nothing.)
	W.SurfaceT = S.bHit ? SurfaceT : 0.0;
	W.Surface = V * W.SurfaceT;
	W.E = max(30000.0, SurfaceT * 0.006);
	W.Anchor = Anchor;
	W.N = -V;
	W.NForm = -V;
	W.Behind = 1.0;
	W.Within = 1.0;
	// The shade a whole cloud casts on the surface, from the sun map (read 600 m toward the light, past the billow the
	// surface is on) instead of looking toward the light from it: the map's optical depth in the walk's measure (cm of
	// solid cloud).
	float3 Toward = V * SurfaceT + Ld * 60000.0;
	float TowardZ = DSkyR_HeightAt(CameraWorld + Toward, F);
	W.GivenDepth = DSkyR_SunTau(CameraWorld + Toward, TowardZ) / max(LP_Extinction, 1.0e-6);
	DSky_WalkSurface(W, V, F, Ld, Merging, T0, T1, P_MapParams, WeatherMap, WeatherMapSampler, CloudNoise, CloudNoiseSampler);
	float Core;
	float4 CloudLit, CloudShade;
	DSkyR_CloudColours(CloudLit, CloudShade);
	float4 VC = DSky_PaintSurface(W, V, F, Ld, Merging, LightDir, P_Cloud0, P_Cloud1, P_Cloud3, P_CloudLayer, CloudNoise,
		CloudNoiseSampler, CameraWorld, Tone, Halo, SkyBehind, CloudLit, CloudShade, P_Extra, Sun, P_MainLightColor, SceneT,
		DSkyR_MaxDist, Core);
	SurfaceDepth = VC.a > 0.0 ? W.SurfaceT : -1.0;
	// A city's light from below on the cloud's base (DSkyR_UnderLight).
	VC.rgb += DSkyR_UnderLight(W.Here.Height) * VC.a;
	return VC * P_CloudShadow.a;
}

#else

// Realistic: the shape's density integrated along the ray, as the engine's cloud material it took over from had
// it, with its settings (LP_*: the style's RealisticClouds, the level's cloud overrides over them): its
// extinction, a storm's cloud up to twice as dense; near clouds by day thinner to the eye (ViewThinning); the sunlight
// reaching each sample through the cloud toward the sun (three taps, then the sun map), scattered by its two lobes and
// two octaves of multiple scattering, at CloudSunScattering; the sky's light as its glow (CloudGlow, BaseGlow, its
// shade tint, an overcast deck mottled, DeckMottle); a storm absorbing; the earth's shadow at dusk.
// Painted (DSKY_LOOK 2): the same march at the painted look's extinction (the style's PaintedClouds) through its soft outer skin
// (EdgeSoftness), each sample painted in the style's three tones by the light through the cloud toward the sun (the
// core's DCL_ShadePainted, its falloffs at the scale of clouds kilometres deep), the painted look's tone thresholds
// (HalfToneAt, LitToneAt, ToneSoftness), tints, billows (BillowShade), silver lining (SilverLining), gain (PaintGain), a
// low sun warming the lit side, an overcast deck painted soft by its thickness, a storm dark below.
float4 DSkyR_Realistic(float3 V, int2 Ray, float SceneT, out float SurfaceDepth)
{
	SurfaceDepth = -1.0;
	if (P_Cloud0.x <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	FDSkyCloudField F = DSkyR_Field();
	// (Thinned round the sun and the moon, as this ray sees them.)
	F.Thin = DSky_Clearing(V, normalize(P_SunDir.xyz), normalize(P_MoonDir.xyz), P_CloudClearing);
	float T0;
	float T1;
	DSkyR_CloudSpan(V, F, min(DSkyR_MaxDist, SceneT), T0, T1);
	if (T0 >= T1)
	{
		return float4(0, 0, 0, 0);
	}
	float3 Halo;
	float3 Tone;
	float3 SkyBehind;
	DSkyR_Sky(V, Halo, Tone, SkyBehind);
	float3 LightDir = normalize(P_MainLight.xyz);
	float Cos = dot(V, LightDir);
	float Day = smoothstep(-0.12, -0.02, normalize(P_SunDir.xyz).z);
	float Scale = max(P_Cloud0.z, 0.05);
	// The light as the engine's clouds take it -- the light component's colour (a low sun's deep red) and illuminance --
	// times CloudSunScattering; the engine material's lobes, and its multiple scattering: the single scattering and
	// two octaves over it, as the engine's (with one octave the body of a cloud kilometres deep went grey: a backlit
	// tower flat, a moonlit one dark but for its top).
	float3 SunColor = LP_LightIlluminance * LP_SunScattering;
	FDCloudLightParams L = DCL_DefaultParams();
	L.G1 = LP_ScatterForward;
	L.G2 = LP_ScatterBackward;
	L.Blend = LP_ScatterBlend;
	L.Albedo = LP_Albedo;
	L.MsContribution = LP_MultiScatter;
	L.MsOcclusion = LP_MultiScatterOcclusion;
	L.MsEccentricity = LP_MultiScatterEccentricity;
	L.MsOctaves = 3;
#if DSKY_LOOK == 2
	// The tones as the engine's painted material made them: the lit one in its tint, by the sky behind (as the toon
	// clouds' are) and the halo round the sun; a low sun warms it, the more on the side toward the sun; the shade in its
	// tint and the hue of the sky above, which lights it; the half tone between.
	float4 CloudLit, CloudShade;
	DSkyR_CloudColours(CloudLit, CloudShade);
	float3 PaintLit = CloudLit.rgb * LP_PaintLitTint * lerp(1.0, Tone, P_Extra.x * 0.2);
	float3 SunHue = P_MainLightColor.rgb / max(dot(P_MainLightColor.rgb, float3(0.2126, 0.7152, 0.0722)), 1.0e-4);
	float2 Across = V.xy * rsqrt(max(dot(V.xy, V.xy), 1.0e-6));
	float2 SunAcross = LightDir.xy * rsqrt(max(dot(LightDir.xy, LightDir.xy), 1.0e-6));
	float Toward = saturate(dot(Across, SunAcross) * 0.5 + 0.5);
	// (The painted look's finer settings: LookParameters[153..156].)
	float4 PA0 = LookParameters[153];
	float4 PA1 = LookParameters[154];
	float4 PA2 = LookParameters[155];
	float4 PA3 = LookParameters[156];
	float LowSun = (1.0 - saturate(LightDir.z * PA0.x)) * (1.0 - P_MainLightColor.a);
	PaintLit *= lerp(1.0, min(SunHue, PA0.z), LowSun * lerp(1.0 - PA0.y, 1.0, Toward));
	float3 Above = P_Zenith.rgb / max(dot(P_Zenith.rgb, float3(0.2126, 0.7152, 0.0722)), 1.0e-4);
	float3 PaintShade = CloudShade.rgb * LP_PaintShadeTint * lerp(1.0, Above, PA0.w * P_Extra.x);
	// (The core's falloffs suit volumes some hundreds of metres across; a sky cloud's optical depth runs some fifty times
	// as deep: the key goes by the cloud some 0.2 to 1.5 km toward the sun, as the engine material's does. The key is
	// worked out here -- its billows, the earth's shadow -- and handed to the core as the optical depth that gives it.)
	FDCloudPaintedParams PP = DCL_DefaultPaintedParams();
	PP.HalfAt = LP_HalfToneAt;
	PP.LitAt = LP_LitToneAt;
	const float KeyFalloff = LookParameters[15].y;
	PP.KeyFalloff = KeyFalloff;
	PP.KeyLow = PA1.y;
	PP.KeyHigh = PA1.z;
	PP.RimFalloff = LookParameters[15].z;
	PP.RimPower = LookParameters[15].w;
	PP.Rim = LP_SilverLining * P_CloudLit.a;
	PP.Softness = LP_ToneSoftness;
#endif

	float Jitter = MarchDebug == 2u ? 0.5 : DCM_InterleavedGradientNoise(float2(Ray), View.StateFrameIndex);
	float SkipJitter = frac(Jitter + 0.618034 * float(View.StateFrameIndex % 97u) + 0.5);
	FDCloudMarchParams P0 = DSkyR_Params(V, T0, T1, MaxSamples, Jitter, F, false);
	FDCloudMarch M = DCM_Begin(T0, T1, P0);
	FDCloudAnchor Anchor = (FDCloudAnchor)0;
	// How much of the cover the funnels make (they are seen through the height fog only, not the clouds' air veil).
	float FunnelCover = 0.0;
	[loop]
	for (int i = 0; i < MaxSamples && DCM_Running(M); ++i)
	{
		float T = M.T;
		FDSkyCloudSample C = DSkyR_Sample(V, T, F, Anchor);
		FDCloudMarchParams P = DSkyR_Params(V, T, T1, MaxSamples - i, Jitter, F, C.Deck <= 0.05);
		FDCloudField Fd;
		Fd.Signed = C.Signed - F.Iso;
		Fd.Density = C.Volume;
		Fd.Distance = DSkyR_Distance(C, T, P, SkipJitter, CameraWorld.xy + V.xy * T);
		float Dt = DCM_Advance(M, Fd, P);
		if (Dt > 0.0 && C.Volume > 0.0)
		{
			float3 At = V * T;
			float3 World = CameraWorld + At;
			// (A funnel, a narrow column, opaque at any width: its own extinction; not thinned near the view.)
			float FunnelHere;
			float FunnelSigma = DSky_FunnelSigma(World, World.z + dot(World.xy, World.xy) / (2.0 * DSky_PlanetRadius), F.Base,
				FunnelHere);
			FunnelHere = max(FunnelHere, C.Funnel);
			float CoverBefore = M.Transmittance;
#if DSKY_LOOK == 2
			// Opaque inside, with a thin soft skin: the extinction rises as the cube of the way through it, so a ray that only
			// grazes a cloud's edge sees it partly. A deck goes by its density, which thins toward its cracks, over a wider
			// skin; near the view the skin narrows to a quarter.
			// (A funnel by its density too, so its top thins out softly into the base: by its shape's skin it stood a cap in
			// it.)
			float Fill = lerp(C.Solid, C.Volume, max(C.Deck, C.Funnel));
			float Near = lerp(0.25, 1.0, saturate(T / 1500000.0));
			float Skin = saturate((Fill - 0.02) / max(LP_EdgeSoftness * Near * lerp(1.0, 3.0, C.Deck), 0.005));
			float SigmaT = max(Skin * Skin * Skin * LP_PaintExtinction, FunnelSigma);
			if (SigmaT <= 0.0)
			{
				DCM_CheckDone(M, P);
				continue;
			}
#else
			// By day a near cloud's body is thinner to the eye (not to the light): a solid cloud's mean free path (some 12
			// m) is far shorter than a step, and the pixel would take the light of wherever its first sample in it fell.
			float Body = smoothstep(0.08, 0.3, C.Volume) * Day * (1.0 - smoothstep(800000.0, 2000000.0, T));
			Body *= 1.0 - FunnelHere;
			// At night, as in the engine's material, the core is thickened (a small cumulus is thin by the shape's measure;
			// the stars must not show through it, and the moonlit cloud must not fade to a haze).
			float Core = smoothstep(0.08, 0.3, C.Volume) * (1.0 - Day);
			float SigmaT = (DSkyR_Extinction(C) + 2.0 * Core * LP_Extinction * (1.0 + C.Dark)) * lerp(1.0, LP_ViewThinning, Body);
			SigmaT = max(SigmaT, FunnelSigma);
#endif
			// Toward the sun: the first 900 m in three taps (the billows round the sample; the map's texels, 500 m by some
			// 400 m, are too coarse there: read at the sample, a sunlit face took the dark inside's depth and the tower came
			// out flat, and its texels' planes drew contour lines across an underside), the map from there on. Far off, where
			// a pixel spans a few hundred metres, the taps reach up to 3.6 km: a distant tower stands in the far cascade, its
			// texels some 3 km wide, and its faces took one flat light.
			float TapReach = lerp(90000.0, 360000.0, smoothstep(1200000.0, 3000000.0, T));
#if DSKY_LOOK == 2
			// Painted: the key goes by the cloud's own envelope toward the light, as the engine's painted material's did --
			// how far each of three points 0.2, 0.6 and 1.5 km on stands inside it (the envelope stands a little proud of the
			// eroded surface) -- not by the optical depth on the way: through a low sun's long path in a cloud that came out
			// all shade, and a sunset's clouds went the lavender of their shade where the engine's were lit orange.
			float Depth = 0.0;
			[unroll]
			for (int k = 0; k < 3; ++k)
			{
				float Reach = k == 0 ? 20000.0 : (k == 1 ? 60000.0 : 150000.0);
				float Weight = k == 0 ? 0.4 : (k == 1 ? 0.35 : 0.25);
				FDSkyCloudSample Tap = DSky_CloudAt(At + LightDir * Reach, F, true, C.Anchor, P_MapParams, WeatherMap,
					WeatherMapSampler, CloudNoise, CloudNoiseSampler, 0.0);
				Depth += saturate((Tap.Form - 0.15) * 4.0) * saturate(Tap.Signed * 2.0 + 1.0) * Weight;
			}
			// The billows: the full shape some 60 m on (a turret's own sunlit side).
			FDSkyCloudSample Billow = DSky_CloudAt(At + LightDir * 6000.0, F, true, C.Anchor, P_MapParams, WeatherMap,
				WeatherMapSampler, CloudNoise, CloudNoiseSampler, 0.0);
			float Turret = 1.0 - saturate(Billow.Solid * 6.0);
#else
			float Tau = 0.0;
			float Prev = 0.0;
			[unroll]
			for (int k = 1; k <= 3; ++k)
			{
				float Next = TapReach * DSky_Square(float(k) / 3.0);
				FDSkyCloudSample Tap = DSky_CloudAt(At + LightDir * (0.5 * (Prev + Next)), F, true, C.Anchor, P_MapParams,
					WeatherMap, WeatherMapSampler, CloudNoise, CloudNoiseSampler, 0.0);
				Tau += DSkyR_Extinction(Tap) * (Next - Prev);
				Prev = Next;
			}
#endif
			// (Read at a height dithered over one of the map's slices: interpolated between its slices, piecewise straight in
			// height, its depth drew level stripes across a far cloud's faces; the history averages the dither out.)
			float3 Beyond = World + LightDir * TapReach;
			float Slice = DCS_STORM_TOP / 24.0;
			// (Past the far cascade, some 90 km out, the cloud's own column above the sample stands in: read as nothing
			// there, every cloud on the horizon was lit through, and the painted ones showed white shreds in a night's
			// overcast.)
			float Above = LP_Extinction * (1.0 + C.Dark) * 0.5 * (1.0 - saturate(C.Height)) * C.Column / max(LightDir.z, 0.2);
#if DSKY_LOOK != 2
			// (Under the moon the cloud hardly shades itself: the engine's clouds take the moon, their second atmosphere light,
			// without a shadow map or a traced shadow -- its light lies on a moonlit tower's whole face, where through the sun
			// map, and through the taps, the face went dark but for its top.)
			Tau = P_MainLightColor.a > 0.5 ? 0.0 : Tau + DSkyR_SunTauOr(Beyond, C.Z + LightDir.z * TapReach + (Jitter - 0.5) * Slice, Above);
			// As the engine's material has it (ShadowReach): the cloud thins toward the light by where its shadow lands, from a
			// quarter of the reach out to all of it short of its end -- a distant tower, its shadow landing tens of kilometres
			// off, is lit well into its body (with its whole depth it went grey by day and dark under the moon).
			float2 Lands = At.xy - LightDir.xy * (max(World.z, 0.0) / max(LightDir.z, 0.05));
			Tau *= 1.0 - smoothstep(0.25 * LP_ShadowReach, 0.95 * LP_ShadowReach, length(Lands));
#endif
			// The earth's shadow: with the light under the horizon a cloud is lit only while it stands high enough to see
			// it over the curve of the earth (the horizon dips by sqrt(2 h / R) at a height h).
			float Dip = sqrt(2.0 * max(World.z, 0.0) / DSky_PlanetRadius);
			float EarthLit = smoothstep(-Dip - 0.008, -Dip + 0.004, LightDir.z);
#if DSKY_LOOK == 2
			// The key: out of the envelope toward the light, a turret's own sunlit side (BillowShade), the bottom of a cloud a
			// little darker (in its own shade, seeing little of the sky), the earth's shadow. (The core bands it at the
			// look's thresholds.)
			float Key = (1.0 - Depth) * lerp(1.0, Turret, LP_BillowShade) * lerp(PA1.x, 1.0, saturate(C.Height * 2.0)) * EarthLit;
			float3 Shade = PaintShade * lerp(LookParameters[17].x, 1.0, saturate(C.Height));
			float3 Lit = PaintLit + Halo * P_Extra.y * saturate(Key);
			float3 Half = lerp(Shade, Lit, LookParameters[16].w) * LookParameters[16].rgb;
			float3 Paint = DCL_ShadePainted(-log(max(saturate(Key), 1.0e-4)) / KeyFalloff, Cos, C.Height, saturate(C.Signed * 4.0),
				Shade, Half, Lit, PP);
			// An overcast deck is painted soft: no bands, the gradient from its thick shade to the half tone where it thins.
			float Through = exp(-C.Column / PA1.w) * (1.0 - PA2.x * C.Dark);
			Paint = lerp(Paint, lerp(Shade, Half, smoothstep(PA2.y, PA2.z, max(Key, Through))), C.Deck);
			// Storm clouds are dark below, their lit tops much less so.
			float Storm = P_CloudLayer.z * C.Dark;
			Paint *= saturate(1.0 - Storm * lerp(PA2.w, 1.0, 1.0 - Key) * lerp(1.0, PA3.x, saturate(C.Height)));
			// The sky's light on the cloud, as the realistic look's glow: no part of it goes darker than the shade tone lit by
			// the sky (less of it low in the cloud and in a storm). Without it a storm's thick body went a flat grey where the
			// engine's painted clouds keep their blue-lavender.
			float FromBase = 1.0 - saturate(C.Height);
			Paint = max(Paint, Shade * LookParameters[17].y * lerp(1.0, PA3.y, FromBase * FromBase * FromBase) * (1.0 - PA3.z * Storm));
			Paint += DSkyR_UnderLight(C.Height);
			// (A funnel, its wall cloud and its dust in the shade tone, darker than the cloud over them -- rain, dust and the
			// storm's shade -- the side toward the light a little lighter, the foot darkest.)
			Paint = lerp(Paint, Shade * lerp(0.34, 0.52, saturate(Key)) * lerp(0.85, 1.0, saturate(C.Height)), max(C.Funnel, FunnelHere));
			DCM_Integrate(M, SigmaT, SigmaT * L.Albedo * Paint * LP_PaintGain, Dt);
#else
			float3 Sun = SunColor * DSkyR_AirTransmittance(World.z, LightDir.z) * DCL_SunScatter(Tau, Cos, L) * EarthLit;
			// A storm's cloud absorbs (rain and graupel), its lit top less so; a deck a little.
			float Storm = P_CloudLayer.z * C.Dark * lerp(1.0, 0.35, C.Height);
			float Albedo = L.Albedo * (1.0 - 0.75 * Storm) * (1.0 - 0.2 * C.Deck);
			// The glow: the sky light on the cloud, the style's shade colour in the tint at its top, BaseGlow of it at its base
			// (the sky above hidden by the cloud); an overcast deck seen from below in thicker and thinner patches.
			float FromBase = 1.0 - saturate(C.Height);
			float Shade01 = lerp(1.0, LP_BaseGlow, FromBase * FromBase * FromBase);
			if (C.Deck > 0.0)
			{
				float2 Drift = World.xy + P_Cloud1.xy * 220000.0 * Scale;
				float Patch = CloudNoise.SampleLevel(CloudNoiseSampler, float3(Drift / (1100000.0 * Scale), 0.83), 0).g;
				Shade01 *= 1.0 + (Patch - 0.5) * 2.0 * LP_DeckMottle * C.Deck;
			}
			float3 Glow = P_CloudShadow.rgb * LP_ShadeTint * LP_Glow * Shade01 * (1.0 - 0.8 * Storm) + DSkyR_UnderLight(C.Height);
			// A funnel, its wall cloud and its dust: a grey to dark grey column under the storm's shade, lit by the sky as a
			// cloud's base is (whatever its height), darkest low down; the light catches only the side toward it, a little.
			// (By where the column is, its extinction's smooth inside, as well as by the sample's weight, which depends on where
			// the jittered sample lands: by that alone the jitter's grid showed on it.)
			float Dark = max(C.Funnel, FunnelHere);
			Sun *= lerp(1.0, 0.18, Dark);
			float3 BaseGlow = P_CloudShadow.rgb * LP_ShadeTint * LP_Glow * LP_BaseGlow * (1.0 - 0.8 * Storm);
			// (The storm's base round it as dark: a cloud's base is already lit by BaseGlow of the sky.)
			Glow = lerp(Glow, BaseGlow * lerp(0.75, 1.0, saturate(C.Height)), Dark) * lerp(1.0, 0.6, Dark);
			DCM_Integrate(M, SigmaT, SigmaT * (Albedo * Sun + Glow), Dt);
#endif
			FunnelCover += (CoverBefore - M.Transmittance) * FunnelHere;
		}
		DCM_CheckDone(M, P);
	}
	float Cover = 1.0 - M.Transmittance;
	if (Cover <= 1.0e-3)
	{
		return float4(0, 0, 0, 0);
	}
	SurfaceDepth = DCM_MeanDepth(M);
	// The air between, as the engine's cloud materials have it: the cloud fades into the sky behind it (and the halo round
	// the sun) by the veil itself.
	float Veil = DCS_AirVeil(SurfaceDepth, V.z, CameraWorld.z, P_Cloud0.x, P_Cloud3);
	float FunnelShare = saturate(FunnelCover / Cover);
	Veil *= 1.0 - 0.85 * FunnelShare;
	float3 Light = lerp(M.Luminance, SkyBehind * Cover, Veil);
	// The height fog in front of it, as the engine fogs its clouds: in a sunset's warm fog a low deck's underside goes
	// the warm brown of the old volumetric clouds, where without it it stayed the blue-lavender of its glow.
	float4 Fog = DSkyR_HeightFog(V, SurfaceDepth);
	// (A funnel's share as the scene's own fog takes the ground a few kilometres off: the clouds' fog is set for decks
	// kilometres up and far, and swallowed a funnel's foot two kilometres away while the hills behind it stood clear.)
	Fog = lerp(Fog, float4(0.0, 0.0, 0.0, 1.0), 0.7 * FunnelShare);
	Light = Light * Fog.a + Fog.rgb * Cover;
	return float4(Light, Cover) * P_CloudShadow.a;
}

#endif

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void MarchCS(uint3 Id : SV_DispatchThreadID)
{
	int2 Ray = int2(Id.xy);
	if (any(Ray >= DSkyR_RaySize()))
	{
		return;
	}
	float2 FullPixel = DSkyR_FullPixel(Ray);
	float3 V = DSkyR_ViewDir(FullPixel);
	// A ray a sky pixel's bilinear read reaches is marched all the way. Otherwise (all the pixels round its block are
	// scene) only where clouds may stand between the view and the scene -- the view over the layer's base, looking down
	// on clouds over the ground (CompositeBelowPS lays those over the scene) -- and only as far as the farthest scene in
	// its block; with the view under the base, not at all.
	int2 Lo = int2(View.ViewRectMin.xy);
	int2 Hi = Lo + int2(View.ViewSizeAndInvSize.xy) - 1;
	int2 Middle = int2(FullPixel);
	bool bSky = false;
	float SceneT = 0.0;
	for (int y = -Downsample; y < Downsample && !bSky; ++y)
	{
		for (int x = -Downsample; x < Downsample && !bSky; ++x)
		{
			int2 Pixel = clamp(Middle + int2(x, y), Lo, Hi);
			bSky = DSkyR_IsSky(Pixel);
			SceneT = max(SceneT, DSkyR_SceneDistance(Pixel, V));
		}
	}
	FDSkyCloudField F0 = DSkyR_Field();
	if (!bSky && DSkyR_HeightAt(CameraWorld, F0) < 0.0)
	{
		OutColor[Ray] = float4(0, 0, 0, 1);
		OutDepth[Ray] = -2.0;
		return;
	}
	SceneT = bSky ? 1.0e10 : SceneT;

	float Depth;
#if DSKY_LOOK != 0
	float4 VC = DSkyR_Realistic(V, Ray, SceneT, Depth);
#else
	float4 VC = DSkyR_Toon(V, Ray, SceneT, Depth);
#endif
	// The dome's weather haze, from the horizon up (it hazes the sky behind; the clouds take it here).
	float4 Haze = P_Haze;
	if (Haze.a > 0.0 && VC.a > 0.0)
	{
		float Amount = Haze.a * lerp(exp(-saturate(V.z) * 8.0), 1.0, Haze.a * Haze.a);
		Amount *= 1.0 - 0.5 * VC.a * smoothstep(0.2, 0.6, P_CloudLayer.y) * saturate(V.z * 4.0);
		VC.rgb = lerp(VC.rgb, Haze.rgb * VC.a, saturate(Amount));
	}
	if (MarchDebug == 1u)
	{
		VC = Depth < 0.0 ? float4(1.0, 0.0, 0.0, 1.0) : float4(0.0, 0.3, 0.0, 1.0);
	}
	OutColor[Ray] = float4(max(VC.rgb, 0.0) * View.PreExposure, 1.0 - saturate(VC.a));
	OutDepth[Ray] = Depth;
}

// One texel of a sun map cascade: from its middle toward the sun (kept 3 degrees over the horizon) to the top of the
// tallest towers, no further than a sample's shadow looks (CloudShadowTracingDistance), in 16 steps growing with the
// distance.
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, THREADGROUP_SIZE)]
void SunMapCS(uint3 DispatchId : SV_DispatchThreadID)
{
	// (One more layer of threads than the map's: the ground's march, apart from the texels', so no thread does both --
	// a slice of the map is as slow as its slowest thread.)
	uint3 Id = DispatchId + uint3(MapOffset);
	if (int(Id.x) >= MapResolution.x || int(Id.y) >= MapResolution.y || int(Id.z) > MapResolution.z)
	{
		return;
	}
	const bool bGround = int(Id.z) == MapResolution.z;
	float3 L = normalize(P_MainLight.xyz);
	L = normalize(float3(L.xy, max(L.z, 0.05)));
	float3 Fr = (float3(Id) + 0.5) / float3(MapResolution);
	float2 XY = MapCenterExtent.xy + (Fr.xy - 0.5) * 2.0 * MapCenterExtent.z;
	float Z = Fr.z * DCS_STORM_TOP;
	FDSkyCloudField F = DSkyR_Field();
	// (Back from the field's height over the planet's curve to the world's.)
	float3 World = float3(XY, F.Base + Z - dot(XY, XY) / (2.0 * DSky_PlanetRadius));
	float3 Rel = World - CameraWorld;
	if (!bGround)
	{
		float Reach = min((DCS_STORM_TOP - Z) / L.z, max(LP_ShadowTracing, 50000.0));
		FDCloudAnchor Anchor = (FDCloudAnchor)0;
		float Tau = 0.0;
		float Prev = 0.0;
		const int Steps = 16;
		for (int k = 0; k < Steps; ++k)
		{
			float Next = Reach * DSky_Square(float(k + 1) / float(Steps));
			FDSkyCloudSample C = DSky_CloudAt(Rel + L * (0.5 * (Prev + Next)), F, false, Anchor, P_MapParams, WeatherMap,
				WeatherMapSampler, CloudNoise, CloudNoiseSampler, 0.0);
			Tau += DSkyR_Extinction(C) * (Next - Prev);
			Prev = Next;
		}
		OutTau[Id] = Tau;
		return;
	}

	// The ground's: from the layer's base the whole way up to the storm top, every cloud on the way (not only the first
	// few kilometres a cloud's own shading looks): with the sun low a tower's shadow lies tens of kilometres out over the
	// ground, as the engine's cloud shadow map, drawn from the sun over the whole layer, had it.
	{
		float3 Base = float3(XY, F.Base - dot(XY, XY) / (2.0 * DSky_PlanetRadius)) - CameraWorld;
		float Whole = DCS_STORM_TOP / L.z;
		FDCloudAnchor GroundAnchor = (FDCloudAnchor)0;
		float GroundTau = 0.0;
		float GroundPrev = 0.0;
		// (Fine near the base, where the small cumulus stand -- spread evenly, a low sun's steps were a kilometre long and
		// stepped over them -- longer up through the towers.)
		const int GroundSteps = 32;
		for (int g = 0; g < GroundSteps; ++g)
		{
			float GroundNext = Whole * DSky_Square(float(g + 1) / float(GroundSteps));
			FDSkyCloudSample C = DSky_CloudAt(Base + L * (0.5 * (GroundPrev + GroundNext)), F, false, GroundAnchor, P_MapParams,
				WeatherMap, WeatherMapSampler, CloudNoise, CloudNoiseSampler, 0.0);
			GroundTau += DSkyR_Extinction(C) * (GroundNext - GroundPrev);
			GroundPrev = GroundNext;
		}
		OutGroundTau[Id.xy] = GroundTau;
	}
}

// A cell of the storm proximity map is marked where a sample may search for storms anywhere in it: where the darkness its
// weather reads (DSkyR_SearchDarkness), there or 9 km upwind, lets it. The map's bilinear read never peaks between the
// centres of its texels, so those covering the cell (and the cell 9 km upwind) are all it needs.
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void StormSeedCS(uint3 Id : SV_DispatchThreadID)
{
	if (any(int2(Id.xy) >= ProximityResolution))
	{
		return;
	}
	uint MapWidth;
	uint MapHeight;
	WeatherMap.GetDimensions(MapWidth, MapHeight);
	float MapRes = float(max(MapWidth, 1u));
	float Extent = 1.0 / max(P_MapParams.z, 1.0e-12);
	float Ratio = MapRes / float(ProximityResolution);
	int Span = min(int(ceil(Ratio)) + 2, 10);
	float2 Downwind = dot(P_Cloud1.xy, P_Cloud1.xy) > 1.0e-6 ? normalize(P_Cloud1.xy) : float2(0.866, 0.5);
	float3 ViewWeather = DCS_ViewWeather(P_Cloud0, P_CloudLayer);
	float Darkest = 0.0;
	for (int Pass = 0; Pass < 2; ++Pass)
	{
		// (In texels: the cell's corner, and the shift to the cell 9 km upwind.)
		float2 Shift = Pass == 0 ? float2(0.0, 0.0) : -Downwind * 900000.0 * P_MapParams.z * MapRes;
		float2 First = floor(float2(Id.xy) * Ratio + Shift - 0.5) + 0.5;
		[loop]
		for (int y = 0; y < Span; ++y)
		{
			for (int x = 0; x < Span; ++x)
			{
				float2 Texel = First + float2(x, y);
				float2 At = (Texel / MapRes - 0.5) * Extent - P_MapParams.xy;
				Darkest = max(Darkest, DSkyR_SearchDarkness(At, ViewWeather));
			}
		}
	}
	bool bSearch = saturate(Darkest * 1.3 - 0.2) > DCS_STORM_SEARCH_DARKNESS;
	OutSeed[Id.xy] = bSearch ? float2(Id.xy) : float2(-1.0, -1.0);
}

// One round of the jump flood: of the cells JumpStep away round this one (and itself), the nearest marked cell any of
// them knows.
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void StormJumpCS(uint3 Id : SV_DispatchThreadID)
{
	if (any(int2(Id.xy) >= ProximityResolution))
	{
		return;
	}
	float2 Here = float2(Id.xy);
	float2 Best = float2(-1.0, -1.0);
	float BestD = 1.0e20;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			int2 Q = int2(Id.xy) + int2(x, y) * JumpStep;
			if (any(Q < 0) || any(Q >= ProximityResolution))
			{
				continue;
			}
			float2 Seed = InSeed.Load(int3(Q, 0));
			if (Seed.x >= 0.0)
			{
				float D = dot(Seed - Here, Seed - Here);
				if (D < BestD)
				{
					BestD = D;
					Best = Seed;
				}
			}
		}
	}
	OutSeed[Id.xy] = Best;
}

// The distance (cm) from each cell's middle to the nearest marked cell's (far off when there is none).
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void StormProximityCS(uint3 Id : SV_DispatchThreadID)
{
	if (any(int2(Id.xy) >= ProximityResolution))
	{
		return;
	}
	float2 Seed = InSeed.Load(int3(Id.xy, 0));
	float Cell = 1.0 / (max(P_MapParams.z, 1.0e-12) * float(ProximityResolution));
	OutProximity[Id.xy] = Seed.x >= 0.0 ? length(Seed - float2(Id.xy)) * Cell : 1.0e10;
}

// One texel of the panorama: the clouds along its direction from the view, premultiplied, cover in alpha, without the
// weather haze (the dome lays it over the clouds as it does over its own).
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void PanoramaCS(uint3 Id : SV_DispatchThreadID)
{
	if (any(int2(Id.xy) >= PanoramaResolution))
	{
		return;
	}
	float2 UV = (float2(Id.xy) + 0.5) / float2(PanoramaResolution);
	float Longitude = UV.x * 2.0 * PI;
	float Latitude = (0.5 - UV.y) * PI;
	float3 V = float3(cos(Latitude) * cos(Longitude), cos(Latitude) * sin(Longitude), sin(Latitude));
	float Depth;
#if DSKY_LOOK != 0
	float4 VC = DSkyR_Realistic(V, int2(Id.xy), 1.0e10, Depth);
#else
	float4 VC = DSkyR_Toon(V, int2(Id.xy), 1.0e10, Depth);
#endif
	OutPanorama[Id.xy] = float4(max(VC.rgb, 0.0), saturate(VC.a));
}

// The share of the sun the clouds let through to the layer's base (and below it) round the view: the transmittance
// through them toward the sun, as the engine's cloud shadow map has it (how much of it the ground takes is the light
// function's strength, GroundShadow).
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ShadowCS(uint3 Id : SV_DispatchThreadID)
{
	if (any(int2(Id.xy) >= ShadowResolution))
	{
		return;
	}
	float2 UV = (float2(Id.xy) + 0.5) / float2(ShadowResolution);
	float2 XY = ShadowPlacement.xy + (UV - 0.5) * 2.0 * ShadowPlacement.z;
	// (Debug: the reference, the same way up through the field in even steps from this very point.)
	if (ReferenceSteps > 0)
	{
		float3 L = normalize(P_MainLight.xyz);
		L = normalize(float3(L.xy, max(L.z, 0.05)));
		FDSkyCloudField F = DSkyR_Field();
		float3 Base = float3(XY, F.Base - dot(XY, XY) / (2.0 * DSky_PlanetRadius)) - CameraWorld;
		float Whole = DCS_STORM_TOP / L.z;
		FDCloudAnchor Anchor = (FDCloudAnchor)0;
		float RefTau = 0.0;
		for (int r = 0; r < ReferenceSteps; ++r)
		{
			FDSkyCloudSample C = DSky_CloudAt(Base + L * (Whole * (float(r) + 0.5) / float(ReferenceSteps)), F, false, Anchor,
				P_MapParams, WeatherMap, WeatherMapSampler, CloudNoise, CloudNoiseSampler, 0.0);
			RefTau += DSkyR_Extinction(C);
		}
		OutShadow[Id.xy] = exp(-RefTau * Whole / float(ReferenceSteps));
		return;
	}
	// (The cascades' ground maps: the near one where it reaches, the far one beyond, the whole sun past both.)
	float2 Near = (XY - NearCenterExtent.xy) / (2.0 * NearCenterExtent.z) + 0.5;
	float2 Far = (XY - FarCenterExtent.xy) / (2.0 * FarCenterExtent.z) + 0.5;
	float NearIn = saturate(min(min(Near.x, 1.0 - Near.x), min(Near.y, 1.0 - Near.y)) * 40.0);
	float FarIn = min(min(Far.x, 1.0 - Far.x), min(Far.y, 1.0 - Far.y)) > 0.0 ? 1.0 : 0.0;
	float Tau = lerp(FarGround.SampleLevel(TauSampler, saturate(Far), 0) * FarIn, NearGround.SampleLevel(TauSampler, saturate(Near), 0), NearIn);
	OutShadow[Id.xy] = exp(-Tau);
}

// What TemporalCS writes for a ray: its colour, or (DreamSky.CloudRender.Debug 3) the tint of the way it got it, opaque,
// brighter where the clouds cover more.
void DSkyR_TemporalOut(int2 Ray, float4 Color, float3 Tint)
{
	OutColor[Ray] = TemporalDebug != 0 ? float4(Tint * lerp(0.3, 1.0, 1.0 - Color.a), 0.0) : Color;
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void TemporalCS(uint3 Id : SV_DispatchThreadID)
{
	int2 Ray = int2(Id.xy);
	int2 Size = DSkyR_RaySize();
	if (any(Ray >= Size))
	{
		return;
	}
	if (all(Ray == 0))
	{
		OutRaySize[0] = uint2(Size);
	}
	float4 Current = CurrentColor[Ray];
	float Depth = CurrentDepth[Ray];
	OutDepth[Ray] = Depth;
	if (Depth < -1.5 || HistoryWeight == 0.0)
	{
		DSkyR_TemporalOut(Ray, Current, float3(0.1, 0.3, 1.0));
		return;
	}
	// The neighbourhood: its range keeps the history from ghosting; its mean stands in for a ray with no history (a cut, a
	// view first drawn, an editor viewport drawn again after standing still): one frame's per-pixel jitter is a grain
	// that a 3x3 mean of its interleaved gradient noise smooths out.
	float4 Lo = Current;
	float4 Hi = Current;
	float4 Sum = 0.0;
	float Count = 0.0;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			int2 Q = clamp(Ray + int2(x, y), 0, Size - 1);
			if (CurrentDepth[Q] > -1.5)
			{
				float4 N = CurrentColor[Q];
				Lo = min(Lo, N);
				Hi = max(Hi, N);
				Sum += N;
				Count += 1.0;
			}
		}
	}
	float4 Mean = Sum / max(Count, 1.0);
	if (HistoryWeight < 0.0)
	{
		DSkyR_TemporalOut(Ray, Mean, float3(1.0, 0.9, 0.1));
		return;
	}
	// Where this ray's clouds were on screen the frame before: at their depth, where the wind had them then (CloudDrift:
	// read where they stand now, the history lagged clouds the wind carries), or (none) the sky at infinity.
	float3 V = DSkyR_ViewDir(DSkyR_FullPixel(Ray));
	float3 Was = View.TranslatedWorldCameraOrigin + V * Depth + float3(CloudDrift, 0.0);
	float4 Clip = Depth > 0.0 ? mul(float4(Was, 1.0), View.TranslatedWorldToClip) : mul(float4(V, 0.0), View.TranslatedWorldToClip);
	float4 Prev = mul(Clip, View.ClipToPrevClip);
	float2 PrevUV = (Prev.xy / max(Prev.w, 1.0e-6)) * float2(0.5, -0.5) + 0.5;
	// (At the ray grid the history was drawn at: the screen percentage may have changed since.)
	float2 PrevSize = float2(HistoryRaySize[0]);
	float2 PrevRay = PrevUV * PrevSize;
	if (Prev.w <= 0.0 || any(PrevRay < 0.0) || any(PrevRay > PrevSize))
	{
		DSkyR_TemporalOut(Ray, Mean, float3(1.0, 0.15, 0.1));
		return;
	}
	if (HistoryDepth.Load(int3(int2(PrevRay), 0)) < -1.5)
	{
		DSkyR_TemporalOut(Ray, Mean, float3(1.0, 0.15, 0.1));
		return;
	}
	float4 History = HistoryColor.SampleLevel(HistorySampler, PrevRay * HistoryInvExtent, 0);
	// Where the view holds still the history weighs more, up to 0.97: at the set weight (0.9) a tenth of every frame's
	// jitter stays in the picture, and close to a cloud, whose first step decides a ray, that tenth showed the jitter's own
	// diagonal pattern, a fine hatching that never settled. Where the clouds move across the screen the set weight holds,
	// so nothing trails behind them.
	float Motion = length(PrevRay - (float2(Ray) + 0.5));
	float Weight = HistoryWeight + (1.0 - HistoryWeight) * 0.7 * (1.0 - smoothstep(0.25, 1.5, Motion));
	// (Less of it the further the world's clock ran since: the clouds changed in their own right.)
	Weight *= HistoryFresh;
	// Where the clouds a ray found are a funnel's (their depth within its column) the history weighs little: a funnel
	// turns, moves and grows within seconds, and at the still view's weight its rope took twenty seconds to show. (Not on
	// the clouds round it, nor the base lowered round its top, nor its top flared into it: lowered there, the jitter's
	// hatching showed on them.)
	{
		FDSkyCloudField F = DSkyR_Field();
		float FunnelT0;
		float FunnelT1;
		DSkyR_FunnelSpan(V, F, DSkyR_MaxDist, FunnelT0, FunnelT1);
		if (FunnelT1 > FunnelT0 && Depth > 0.0 && Depth > FunnelT0 - 20000.0 && Depth < FunnelT1 + 20000.0)
		{
			Weight = min(Weight, 0.85);
		}
	}
	// Kept within what this frame shows round the ray, so a cloud that moved or changed leaves no ghost.
	DSkyR_TemporalOut(Ray, lerp(Current, clamp(History, Lo, Hi), Weight), float3(0.1, 1.0, 0.2));
}

float DSkyR_GridLine(float Degrees, float Spacing, float PixelDegrees)
{
	float F = abs(frac(Degrees / Spacing + 0.5) - 0.5) * Spacing;
	return 1.0 - saturate(F / max(PixelDegrees, 1.0e-4) - 0.5);
}

void CompositePS(float4 SvPosition : SV_POSITION, out float4 Out : SV_Target0)
{
	float2 Pixel = SvPosition.xy;
	float2 Local = Pixel - View.ViewRectMin.xy;
	if (any(Local < 0.0) || any(Local >= View.ViewSizeAndInvSize.xy) || !DSkyR_IsSky(int2(Pixel)))
	{
		discard;
	}
	if (DebugMode > 0)
	{
		float3 V = DSkyR_ViewDir(Pixel);
		float Azimuth = degrees(atan2(V.y, V.x));
		float Elevation = degrees(asin(clamp(V.z, -1.0, 1.0)));
		float PixelDegrees = max(length(float2(ddx(Elevation), ddy(Elevation))), 1.0e-3);
		float AzimuthPixel = min(abs(ddx(Azimuth)) + abs(ddy(Azimuth)), 2.0);
		float3 Tint = lerp(1.0.xxx, 0.35 + 0.65 * (V * 0.5 + 0.5), 0.8);
		if (abs(Elevation) < 2.0)
		{
			Tint = float3(1.6, 0.2, 0.2);
		}
		float Line = max(DSkyR_GridLine(Elevation, 15.0, PixelDegrees), DSkyR_GridLine(Azimuth, 15.0, max(AzimuthPixel, 1.0e-3)) * step(abs(Elevation), 80.0));
		Out = float4(Tint * (1.0 - 0.85 * Line), 1.0);
		return;
	}
	Out = CloudColor.SampleLevel(CloudSampler, (Local / float(Downsample)) * CloudInvExtent, 0);
	// Lightning lights the clouds toward the strike, their solid middles more than their edges, as the dome lights its
	// own (its flash on the sky behind sees no clouds: theirs is added here), held back against a dark sky by the sky's
	// own brightness so a night storm keeps its shapes. Here, after the frames are blended: a flash lasts a frame or two,
	// and through the history it came out speckled.
	float FlashNow = P_Flash.w * P_Extra.w;
	float Cover = 1.0 - Out.a;
	if (FlashNow > 0.0 && Cover > 0.0)
	{
		float3 V = DSkyR_ViewDir(Pixel);
		float Toward = pow(saturate(dot(V, normalize(P_Flash.xyz))), 3.0);
		float3 Mean = max(0.5 * (P_Zenith.rgb + P_Horizon.rgb), 1.0e-4);
		float Level = saturate(0.3 + dot(Mean, float3(0.2126, 0.7152, 0.0722)) * 3.0);
		Out.rgb += float3(0.75, 0.8, 1.0) * FlashNow * Level * (0.15 + 0.85 * Toward) * 1.7 * Cover * lerp(0.6, 1.4, Cover)
			* View.PreExposure * P_CloudShadow.a;
	}
}

// With the view over the layer's base: the clouds below it, over the scene. Of the four rays round the pixel only those
// whose clouds stand nearer than the pixel's scene count (a ray's block may reach past a near object's edge), weighted
// as the bilinear read would weigh them.
// The Henyey-Greenstein phase function.
float DSkyR_ShaftPhase(float CosTheta, float G)
{
	float G2 = G * G;
	return (1.0 - G2) / (4.0 * PI * pow(max(1.0 + G2 - 2.0 * G * CosTheta, 1.0e-4), 1.5));
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void LightShaftsCS(uint3 Id : SV_DispatchThreadID)
{
	int2 Ray = int2(Id.xy);
	if (any(Ray >= DSkyR_RaySize()))
	{
		return;
	}
	float2 Pixel = DSkyR_FullPixel(Ray);
	float3 V = DSkyR_ViewDir(Pixel);
	float SceneT = DSkyR_SceneDistance(int2(Pixel), V);
	float Far = min(SceneT, SH_Distance);
	float3 L = normalize(P_MainLight.xyz);
	// (As the light function: up the sun's direction to the layer's base kept 3 degrees over the horizon.)
	float LZ = max(L.z, 0.05);
	float Base = P_CloudLayer.x;
	// The part of the ray below the layer's base.
	float T0 = 0.0;
	float T1 = Far;
	if (CameraWorld.z < Base)
	{
		T1 = V.z > 0.0 ? min(T1, (Base - CameraWorld.z) / V.z) : T1;
	}
	else
	{
		T0 = V.z < 0.0 ? (Base - CameraWorld.z) / V.z : T1;
	}
	float3 Light = 0.0;
	float Lit = 0.0;
	if (T1 > T0)
	{
		int N = int(SH_Samples);
		float Dt = (T1 - T0) / float(N);
		// (The same jitter every frame: nothing gathers the frames, so a moving one would crawl; the composite softens it.)
		float Jitter = DCM_InterleavedGradientNoise(float2(Ray), 0);
		float RefZ = LP_Fog.z;
		float Tau = 0.0;
		for (int i = 0; i < N; ++i)
		{
			float T = T0 + (float(i) + Jitter) * Dt;
			float3 P = CameraWorld + V * T;
			float Sigma = SH_Density * exp(-max(P.z - RefZ, 0.0) * SH_InvScale);
			float2 UV = (P.xy + L.xy * (max(Base - P.z, 0.0) / LZ) - ShadowPlacement.xy) / (2.0 * ShadowPlacement.z) + 0.5;
			float Edge = min(min(UV.x, 1.0 - UV.x), min(UV.y, 1.0 - UV.y));
			float Through = ShaftShadow.SampleLevel(ShaftShadowSampler, saturate(UV), 0);
			// (All of the clouds' shadow, whatever share of it the looks lay on the ground: the shadowed air lit half
			// would wash the sky instead of parting it into shafts.)
			Through = lerp(1.0, Through, saturate(Edge * 10.0));
			// (Each step's own scattering, (1 - e^-sigma dt), seen through the haze before it.)
			float Step = Sigma * Dt;
			Light += Through * exp(-Tau) * (1.0 - exp(-Step));
			Tau += Step;
			Lit += Through / float(N);
		}
		Light *= DSkyR_ShaftPhase(dot(V, L), SH_Anisotropy) * SH_Strength * smoothstep(0.0, 0.05, L.z);
	}
	OutShafts[Ray] = SH_Debug > 0.0 ? float4(Lit.xxx * 0.5, Far) : float4(Light * LP_LightIlluminance * View.PreExposure, Far);
}

// Up to the scene's resolution: the 3x3 rays round the pixel, by their distance from it and how near their rays went to
// as far as its own.
void LightShaftsCompositePS(float4 SvPosition : SV_POSITION, out float4 Out : SV_Target0)
{
	float2 Pixel = SvPosition.xy;
	float2 Local = Pixel - View.ViewRectMin.xy;
	if (any(Local < 0.0) || any(Local >= View.ViewSizeAndInvSize.xy))
	{
		discard;
	}
	float3 V = DSkyR_ViewDir(Pixel);
	float Far = min(DSkyR_SceneDistance(int2(Pixel), V), SH_Distance);
	float2 H = Local / float(Downsample) - 0.5;
	int2 Centre = int2(round(H));
	int2 Size = DSkyR_RaySize();
	float3 Sum = 0.0;
	float Weight = 0.0;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			int2 Q = clamp(Centre + int2(x, y), 0, Size - 1);
			float4 S = Shafts.Load(int3(Q, 0));
			float2 D = float2(Q) - H;
			float W = exp(-dot(D, D) * 0.5) / (0.02 + abs(S.a - Far) / max(Far, 100.0));
			Sum += W * S.rgb;
			Weight += W;
		}
	}
	Out = float4(Sum / max(Weight, 1.0e-6), 0.0);
}

void CompositeBelowPS(float4 SvPosition : SV_POSITION, out float4 Out : SV_Target0)
{
	float2 Pixel = SvPosition.xy;
	float2 Local = Pixel - View.ViewRectMin.xy;
	if (any(Local < 0.0) || any(Local >= View.ViewSizeAndInvSize.xy) || DSkyR_IsSky(int2(Pixel)))
	{
		discard;
	}
	float3 V = DSkyR_ViewDir(Pixel);
	float SceneT = DSkyR_SceneDistance(int2(Pixel), V);
	float2 H = Local / float(Downsample) - 0.5;
	int2 Base = int2(floor(H));
	float2 Fr = H - float2(Base);
	int2 Size = DSkyR_RaySize();
	float4 Sum = 0.0;
	float Weight = 0.0;
	for (int k = 0; k < 4; ++k)
	{
		int2 Q = clamp(Base + int2(k & 1, k >> 1), 0, Size - 1);
		float W = ((k & 1) ? Fr.x : 1.0 - Fr.x) * ((k >> 1) ? Fr.y : 1.0 - Fr.y);
		float D = CloudDepth.Load(int3(Q, 0));
		float4 C = CloudColor.Load(int3(Q, 0));
		// (No cloud on the ray counts as clear air in front of the scene; a cloud behind the scene does not count.)
		bool bCounts = D > -1.5 && (D < 0.0 || D < SceneT);
		Sum += bCounts ? W * (D < 0.0 ? float4(0, 0, 0, 1) : C) : 0.0;
		Weight += bCounts ? W : 0.0;
	}
	if (Weight < 1.0e-3)
	{
		discard;
	}
	Out = Sum / Weight;
}
