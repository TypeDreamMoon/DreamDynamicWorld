// Copyright DreamMoon. All Rights Reserved.
//
// The sky cloud renderer (FDreamSkyCloudViewExtension): per view, after the base pass,
//   MarchCS     one ray per Downsample x Downsample pixels through the cloud layer (DreamSkyCloudShape.ush), stepped by
//               the shared march (DreamCloudMarch.ush): skipping clear air -- by a true lower bound of the distance near
//               and above the layer, where only cumulonimbus stand; by a step in the layer, backing off to walk fine
//               when a skip lands where cloud may be --, fine steps no longer than a billow near a surface, offset per
//               pixel and frame (the steps' banding turns into noise the history averages away). Toon: the surface,
//               refined, then read around and painted in the style's tones exactly as the dome's toon march does
//               (DSky_WalkSurface, DSky_PaintSurface). Realistic: the density integrated along the ray, lit by scattering
//               (DreamCloudLight.ush). The dome's weather haze goes on the clouds here (the dome hazes its own sky).
//   TemporalCS  the previous frames' clouds reprojected by the clouds' depth (the sky at infinity by the rotation alone),
//               clamped to the new frame's neighbourhood, blended in.
//   CompositePS the clouds over the sky pixels (premultiplied: the sky behind times their transmittance plus their
//               light), bilinear from the reduced resolution: the clouds stand behind everything the depth buffer holds,
//               so every texel a sky pixel reads is a sky ray. DebugMode 1 instead multiplies the sky by a grid of view
//               directions (15 degree lines, the horizon band red).

#include "/Engine/Private/Common.ush"
#include "/Plugin/DreamDynamicWorld/Private/DreamSkyStylized.ush"
#include "/Plugin/DreamDynamicWorld/Private/DreamCloudMarch.ush"
#include "/Plugin/DreamDynamicWorld/Private/DreamCloudLight.ush"

#ifndef DSKY_REALISTIC
#define DSKY_REALISTIC 0
#endif

// The shared parameter collection's vectors (FDreamSkyCloudViewExtension::GetParameterNames).
float4 Parameters[17];
#define P_SunDir       Parameters[0]
#define P_Zenith       Parameters[1]
#define P_Horizon      Parameters[2]
#define P_Ground       Parameters[3]
#define P_SunHalo      Parameters[4]
#define P_Cloud0       Parameters[5]
#define P_Cloud1       Parameters[6]
#define P_Cloud2       Parameters[7]
#define P_Cloud3       Parameters[8]
#define P_CloudLit     Parameters[9]
#define P_CloudShadow  Parameters[10]
#define P_MainLight    Parameters[11]
#define P_MainLightColor Parameters[12]
#define P_CloudLayer   Parameters[13]
#define P_MapParams    Parameters[14]
#define P_Extra        Parameters[15]
#define P_Haze         Parameters[16]

float3 CameraWorld;   // the view in the world (cm)
float SkyDepth;       // view depth (cm) beyond which a pixel is sky
int Downsample;       // pixels per ray across and down

Texture2D SceneDepth;
Texture2D WeatherMap;
SamplerState WeatherMapSampler;
Texture3D CloudNoise;
SamplerState CloudNoiseSampler;
int MaxSamples;
RWTexture2D<float4> OutColor;  // rgb = the clouds' light (premultiplied, pre-exposed), a = transmittance
RWTexture2D<float> OutDepth;   // cm along the ray to the clouds; -1 none; -2 a ray no sky pixel reads (not marched)

Texture2D<float4> CurrentColor;
Texture2D<float> CurrentDepth;
Texture2D<float4> HistoryColor;
Texture2D<float> HistoryDepth;
SamplerState HistorySampler;
float2 HistoryInvExtent;
float HistoryWeight;

Texture2D<float4> CloudColor;
SamplerState CloudSampler;
float2 CloudInvExtent;
uint DebugMode;

// The farthest the clouds are drawn (cm), and where the fine fraying near the view has faded out.
static const float DSkyR_MaxDist = 9000000.0;
static const float DSkyR_DetailEnd = 6000000.0;

int2 DSkyR_RaySize()
{
	return int2(ceil(View.ViewSizeAndInvSize.xy / float(Downsample)));
}

// The full-resolution position (pixels, in the scene textures) a ray goes through: the middle of its block.
float2 DSkyR_FullPixel(int2 Ray)
{
	return View.ViewRectMin.xy + (float2(Ray) + 0.5) * float(Downsample);
}

float3 DSkyR_ViewDir(float2 FullPixel)
{
	return normalize(SvPositionToTranslatedWorld(float4(FullPixel, 0.5, 1.0)) - View.TranslatedWorldCameraOrigin);
}

bool DSkyR_IsSky(int2 Pixel)
{
	float DeviceZ = SceneDepth.Load(int3(Pixel, 0)).r;
	return DeviceZ <= 0.0 || ConvertFromDeviceZ(DeviceZ) >= SkyDepth;
}

FDSkyCloudField DSkyR_Field()
{
	FDSkyCloudField F;
	F.Camera = CameraWorld;
	F.Base = max(P_CloudLayer.x, 10000.0);
	F.Iso = 0.06;
	F.Cloud0 = P_Cloud0;
	F.Cloud1 = P_Cloud1;
	F.Cloud2 = P_Cloud2;
	F.CloudLayer = P_CloudLayer;
	return F;
}

// The march's steps at T (cm along the ray) with Left samples left for the rest of the ray (to T1): fine steps of some
// 0.6 % of the distance (30 m near, 200 m from 33 km: within a billow), never shorter than the samples left can cover the
// rest of the ray with; skips up to 4 km, trusted in full (a true bound, or a step meant as one).
FDCloudMarchParams DSkyR_Params(float T, float T1, int Left, float Jitter)
{
	float Fine = clamp(T * 0.006, 3000.0, 20000.0);
	Fine = max(Fine, (T1 - T) / float(max(Left - 8, 1)));
	FDCloudMarchParams P = DCM_DefaultParams(Fine);
	P.MinSkip = Fine;
	P.MaxSkip = 400000.0;
	P.SkipScale = 1.0;
	P.ExitDistance = 1.5 * Fine;
	P.BackOff = 1.0;
	P.Jitter = Jitter;
	return P;
}

// How far the march may skip from a sample: over the layer only cumulonimbus stand, and the shape gives a true bound of
// the distance to them (and to the layer's top); in the layer, the shape's bound says only whether cloud may be here, so
// the march walks fine where it may and takes a step of some 1.2 % of the distance where it may not, no longer than 800 m
// (a small cumulus' formation), backing off to walk fine if that step lands where cloud may be. SkipJitter (0..1, per
// pixel and frame) varies every skip's length -- the step 0.6 to 1.4 times, the bound 0.7 to 1 times, never past it: with
// lengths fixed by the distance alone, neighbouring rays' samples fell in step with one another, and where they skimmed a
// thin cloud they drew moire, hatched patches and horizontal bands that no history averages away.
float DSkyR_Distance(FDSkyCloudSample C, float T, FDCloudMarchParams P, float SkipJitter)
{
	float LayerStep = max(clamp(T * 0.012, 20000.0, 80000.0) * (0.6 + 0.8 * SkipJitter), 2.0 * P.FineStep);
	float Bound = 0.7 + 0.3 * SkipJitter;
	if (C.Z >= DCS_LAYER_TOP)
	{
		return min(C.StormDistance * Bound, max(C.Z - DCS_LAYER_TOP, LayerStep));
	}
	if (C.Z <= 0.0)
	{
		return C.StormDistance * Bound;
	}
	return C.Form > 0.0 ? 0.0 : LayerStep;
}

FDSkyCloudSample DSkyR_Sample(float3 V, float T, FDSkyCloudField F, FDCloudAnchor Anchor)
{
	return DSky_CloudAt(V * T, F, false, Anchor, P_MapParams, WeatherMap, WeatherMapSampler, CloudNoise, CloudNoiseSampler,
		1.0 - smoothstep(DSkyR_DetailEnd * 0.5, DSkyR_DetailEnd, T));
}

// The sky along V the way the dome sees it: Base (the gradient), its sun halo, Tone (the gradient against its mean: what
// tints the clouds) and SkyBehind (the colour the air between takes; looking down, the low sky's).
void DSkyR_Sky(float3 V, out float3 Halo, out float3 Tone, out float3 SkyBehind)
{
	float3 Sun = normalize(P_SunDir.xyz);
	float3 Base = DSky_Backdrop(V, Sun, P_Zenith, P_Horizon, P_Ground, P_SunHalo, Halo);
	float3 Mean = max(0.5 * (P_Zenith.rgb + P_Horizon.rgb), 1.0e-4);
	Tone = clamp(Base / Mean, 0.25, 4.0);
	float3 HazeHalo = Halo;
	float3 Haze = V.z >= 0.0 ? Base : DSky_Backdrop(DSky_HazeDirection(V), Sun, P_Zenith, P_Horizon, P_Ground, P_SunHalo, HazeHalo);
	SkyBehind = Haze + HazeHalo;
}

#if !DSKY_REALISTIC

// Toon: the surface (the first crossing of the toon level, refined), then lit and painted as the dome's toon march does.
float4 DSkyR_Toon(float3 V, int2 Ray, out float SurfaceDepth)
{
	SurfaceDepth = -1.0;
	if (P_Cloud0.x <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	FDSkyCloudField F = DSkyR_Field();
	float T0;
	float T1;
	DSky_LayerSpan(CameraWorld, V, F.Base, F.Base + DCS_STORM_TOP, DSkyR_MaxDist, T0, T1);
	if (T0 >= T1)
	{
		return float4(0, 0, 0, 0);
	}
	float Jitter = DCM_InterleavedGradientNoise(float2(Ray), View.StateFrameIndex);
	float SkipJitter = frac(Jitter + 0.618034 * float(View.StateFrameIndex % 97u) + 0.5);
	FDCloudSurface S = DCM_SurfaceBegin(T0, T1, 5);
	FDCloudAnchor Anchor = (FDCloudAnchor)0;
	float AnchorSigned = -1.0e9;
	[loop]
	for (int i = 0; i < MaxSamples && DCM_SurfaceRunning(S); ++i)
	{
		float T = S.M.T;
		FDSkyCloudSample C = DSkyR_Sample(V, T, F, Anchor);
		// (The walk round the surface reads the field the cheap way, from the sample nearest to being inside.)
		if (C.Signed >= AnchorSigned)
		{
			AnchorSigned = C.Signed;
			Anchor = C.Anchor;
		}
		FDCloudMarchParams P = DSkyR_Params(T, T1, MaxSamples - i, Jitter);
		FDCloudField Fd;
		Fd.Signed = C.Signed - F.Iso;
		Fd.Density = C.Volume;
		Fd.Distance = DSkyR_Distance(C, T, P, SkipJitter);
		DCM_SurfaceAdvance(S, Fd, P);
	}
	float SurfaceT = S.bHit ? S.HitT : S.ClosestT;
	float BestSigned = S.bHit ? F.Iso : S.Closest + F.Iso;
	if (!S.bHit && BestSigned <= F.Iso - DSky_EdgeWidth(SurfaceT))
	{
		return float4(0, 0, 0, 0);
	}

	float3 Halo;
	float3 Tone;
	float3 SkyBehind;
	DSkyR_Sky(V, Halo, Tone, SkyBehind);
	float3 Sun = normalize(P_SunDir.xyz);
	float3 LightDir = normalize(P_MainLight.xyz);
	float3 Ld = normalize(LightDir + float3(0.0, 0.0, 0.08));
	float Merging = smoothstep(0.55, 0.85, P_Cloud0.x);

	FDSkySurfaceWalk W = (FDSkySurfaceWalk)0;
	W.Phase = 3;
	W.bHit = S.bHit;
	W.BestSigned = BestSigned;
	W.BestT = SurfaceT;
	W.SurfaceT = SurfaceT;
	W.Surface = V * SurfaceT;
	W.E = max(30000.0, SurfaceT * 0.006);
	W.Anchor = Anchor;
	W.N = -V;
	W.NForm = -V;
	W.Behind = 1.0;
	W.Within = 1.0;
	DSky_WalkSurface(W, V, F, Ld, Merging, T0, T1, P_MapParams, WeatherMap, WeatherMapSampler, CloudNoise, CloudNoiseSampler);
	float Core;
	float4 VC = DSky_PaintSurface(W, V, F, Ld, Merging, LightDir, P_Cloud0, P_Cloud1, P_Cloud3, P_CloudLayer, CloudNoise,
		CloudNoiseSampler, CameraWorld, Tone, Halo, SkyBehind, P_CloudLit, P_CloudShadow, P_Extra, Sun, P_MainLightColor, 1.0e10,
		DSkyR_MaxDist, Core);
	SurfaceDepth = SurfaceT;
	return VC * P_CloudShadow.a;
}

#else

// Realistic: the shape's density integrated along the ray (extinction some 0.08 per metre in a full cloud, twice that
// in a storm's darkest, as the engine's cloud material has it), the sunlight reaching each sample through three taps toward it, scattered by two lobes and a few
// octaves of multiple scattering, the sky's light by the sample's height in its cloud.
float4 DSkyR_Realistic(float3 V, int2 Ray, out float SurfaceDepth)
{
	SurfaceDepth = -1.0;
	if (P_Cloud0.x <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	FDSkyCloudField F = DSkyR_Field();
	float T0;
	float T1;
	DSky_LayerSpan(CameraWorld, V, F.Base, F.Base + DCS_STORM_TOP, DSkyR_MaxDist, T0, T1);
	if (T0 >= T1)
	{
		return float4(0, 0, 0, 0);
	}
	float3 Halo;
	float3 Tone;
	float3 SkyBehind;
	DSkyR_Sky(V, Halo, Tone, SkyBehind);
	float3 LightDir = normalize(P_MainLight.xyz);
	float3 SunColor = P_CloudLit.rgb * lerp(1.0, P_MainLightColor.rgb / max(max(P_MainLightColor.r, max(P_MainLightColor.g, P_MainLightColor.b)), 1.0e-4), 0.5);
	float3 SkyTop = lerp(P_CloudShadow.rgb, P_Zenith.rgb * Tone, 0.35);
	float3 SkyBottom = P_CloudShadow.rgb * 0.45;
	FDCloudLightParams L = DCL_DefaultParams();
	float Cos = dot(V, LightDir);

	float Jitter = DCM_InterleavedGradientNoise(float2(Ray), View.StateFrameIndex);
	float SkipJitter = frac(Jitter + 0.618034 * float(View.StateFrameIndex % 97u) + 0.5);
	FDCloudMarchParams P0 = DSkyR_Params(T0, T1, MaxSamples, Jitter);
	FDCloudMarch M = DCM_Begin(T0, T1, P0);
	FDCloudAnchor Anchor = (FDCloudAnchor)0;
	[loop]
	for (int i = 0; i < MaxSamples && DCM_Running(M); ++i)
	{
		float T = M.T;
		FDSkyCloudSample C = DSkyR_Sample(V, T, F, Anchor);
		FDCloudMarchParams P = DSkyR_Params(T, T1, MaxSamples - i, Jitter);
		FDCloudField Fd;
		Fd.Signed = C.Signed - F.Iso;
		Fd.Density = C.Volume;
		Fd.Distance = DSkyR_Distance(C, T, P, SkipJitter);
		float Dt = DCM_Advance(M, Fd, P);
		if (Dt > 0.0 && C.Volume > 0.0)
		{
			// (As the engine's cloud material has it: the faint fringe drawn in a little, a storm's cloud twice as dense.)
			float Sigma = 0.0008 * (1.0 + C.Dark);
			float SigmaT = (1.0 - (1.0 - C.Volume) * (1.0 - C.Volume)) * Sigma;
			float Tau = 0.0;
			float3 At = V * T;
			[unroll]
			for (int k = 0; k < 3; ++k)
			{
				float Along = 15000.0 * float((k + 1) * (k + 1));
				float Len = 15000.0 * float((k + 1) * (k + 1) - k * k);
				FDSkyCloudSample Toward = DSky_CloudAt(At + LightDir * Along, F, true, C.Anchor, P_MapParams, WeatherMap,
					WeatherMapSampler, CloudNoise, CloudNoiseSampler, 0.0);
				Tau += (1.0 - (1.0 - Toward.Volume) * (1.0 - Toward.Volume)) * Sigma * Len;
			}
			float3 Sun = SunColor * DCL_SunScatter(Tau, Cos, L) * (4.0 * DCL_PI) * 0.6;
			float3 Sky = DCL_Ambient(SkyTop, SkyBottom, C.Height, saturate(C.Signed * 3.0), L);
			DCM_Integrate(M, SigmaT, SigmaT * L.Albedo * (Sun + Sky) * lerp(1.0, 0.35, C.Dark * P_CloudLayer.z), Dt);
		}
		DCM_CheckDone(M, P);
	}
	float Cover = 1.0 - M.Transmittance;
	if (Cover <= 1.0e-3)
	{
		return float4(0, 0, 0, 0);
	}
	SurfaceDepth = DCM_MeanDepth(M);
	// The air between, as the toon clouds have it.
	float Veil = DCS_AirVeil(SurfaceDepth, V.z, CameraWorld.z, P_Cloud0.x, P_Cloud3);
	float3 Light = lerp(M.Luminance, SkyBehind * Cover, pow(Veil, 1.6 + 1.4 * smoothstep(0.15, 0.6, P_CloudLayer.y)));
	return float4(Light, Cover) * P_CloudShadow.a;
}

#endif

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void MarchCS(uint3 Id : SV_DispatchThreadID)
{
	int2 Ray = int2(Id.xy);
	if (any(Ray >= DSkyR_RaySize()))
	{
		return;
	}
	float2 FullPixel = DSkyR_FullPixel(Ray);
	// A ray no sky pixel's bilinear read reaches (all the pixels round its block are scene) is not marched.
	int2 Lo = int2(View.ViewRectMin.xy);
	int2 Hi = Lo + int2(View.ViewSizeAndInvSize.xy) - 1;
	int2 Middle = int2(FullPixel);
	bool bSky = false;
	for (int y = -Downsample; y < Downsample && !bSky; ++y)
	{
		for (int x = -Downsample; x < Downsample && !bSky; ++x)
		{
			bSky = DSkyR_IsSky(clamp(Middle + int2(x, y), Lo, Hi));
		}
	}
	if (!bSky)
	{
		OutColor[Ray] = float4(0, 0, 0, 1);
		OutDepth[Ray] = -2.0;
		return;
	}

	float3 V = DSkyR_ViewDir(FullPixel);
	float Depth;
#if DSKY_REALISTIC
	float4 VC = DSkyR_Realistic(V, Ray, Depth);
#else
	float4 VC = DSkyR_Toon(V, Ray, Depth);
#endif
	// The dome's weather haze, from the horizon up (it hazes the sky behind; the clouds take it here).
	float4 Haze = P_Haze;
	if (Haze.a > 0.0 && VC.a > 0.0)
	{
		float Amount = Haze.a * lerp(exp(-saturate(V.z) * 8.0), 1.0, Haze.a * Haze.a);
		Amount *= 1.0 - 0.5 * VC.a * smoothstep(0.2, 0.6, P_CloudLayer.y) * saturate(V.z * 4.0);
		VC.rgb = lerp(VC.rgb, Haze.rgb * VC.a, saturate(Amount));
	}
	OutColor[Ray] = float4(max(VC.rgb, 0.0) * View.PreExposure, 1.0 - saturate(VC.a));
	OutDepth[Ray] = Depth;
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void TemporalCS(uint3 Id : SV_DispatchThreadID)
{
	int2 Ray = int2(Id.xy);
	int2 Size = DSkyR_RaySize();
	if (any(Ray >= Size))
	{
		return;
	}
	float4 Current = CurrentColor[Ray];
	float Depth = CurrentDepth[Ray];
	OutDepth[Ray] = Depth;
	if (Depth < -1.5 || HistoryWeight <= 0.0)
	{
		OutColor[Ray] = Current;
		return;
	}
	// Where this ray's clouds were on screen the frame before: at their depth, or (none) the sky at infinity.
	float3 V = DSkyR_ViewDir(DSkyR_FullPixel(Ray));
	float4 Clip = Depth > 0.0 ? mul(float4(View.TranslatedWorldCameraOrigin + V * Depth, 1.0), View.TranslatedWorldToClip)
		: mul(float4(V, 0.0), View.TranslatedWorldToClip);
	float4 Prev = mul(Clip, View.ClipToPrevClip);
	float2 PrevUV = (Prev.xy / max(Prev.w, 1.0e-6)) * float2(0.5, -0.5) + 0.5;
	float2 PrevRay = PrevUV * View.ViewSizeAndInvSize.xy / float(Downsample);
	if (Prev.w <= 0.0 || any(PrevRay < 0.0) || any(PrevRay > float2(Size)))
	{
		OutColor[Ray] = Current;
		return;
	}
	if (HistoryDepth.Load(int3(int2(PrevRay), 0)) < -1.5)
	{
		OutColor[Ray] = Current;
		return;
	}
	float4 History = HistoryColor.SampleLevel(HistorySampler, PrevRay * HistoryInvExtent, 0);
	// Kept within what this frame shows round the ray, so a cloud that moved or changed leaves no ghost.
	float4 Lo = Current;
	float4 Hi = Current;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			int2 Q = clamp(Ray + int2(x, y), 0, Size - 1);
			if (CurrentDepth[Q] > -1.5)
			{
				float4 N = CurrentColor[Q];
				Lo = min(Lo, N);
				Hi = max(Hi, N);
			}
		}
	}
	OutColor[Ray] = lerp(Current, clamp(History, Lo, Hi), HistoryWeight);
}

float DSkyR_GridLine(float Degrees, float Spacing, float PixelDegrees)
{
	float F = abs(frac(Degrees / Spacing + 0.5) - 0.5) * Spacing;
	return 1.0 - saturate(F / max(PixelDegrees, 1.0e-4) - 0.5);
}

void CompositePS(float4 SvPosition : SV_POSITION, out float4 Out : SV_Target0)
{
	float2 Pixel = SvPosition.xy;
	float2 Local = Pixel - View.ViewRectMin.xy;
	if (any(Local < 0.0) || any(Local >= View.ViewSizeAndInvSize.xy) || !DSkyR_IsSky(int2(Pixel)))
	{
		discard;
	}
	if (DebugMode > 0)
	{
		float3 V = DSkyR_ViewDir(Pixel);
		float Azimuth = degrees(atan2(V.y, V.x));
		float Elevation = degrees(asin(clamp(V.z, -1.0, 1.0)));
		float PixelDegrees = max(length(float2(ddx(Elevation), ddy(Elevation))), 1.0e-3);
		float AzimuthPixel = min(abs(ddx(Azimuth)) + abs(ddy(Azimuth)), 2.0);
		float3 Tint = lerp(1.0.xxx, 0.35 + 0.65 * (V * 0.5 + 0.5), 0.8);
		if (abs(Elevation) < 2.0)
		{
			Tint = float3(1.6, 0.2, 0.2);
		}
		float Line = max(DSkyR_GridLine(Elevation, 15.0, PixelDegrees), DSkyR_GridLine(Azimuth, 15.0, max(AzimuthPixel, 1.0e-3)) * step(abs(Elevation), 80.0));
		Out = float4(Tint * (1.0 - 0.85 * Line), 1.0);
		return;
	}
	Out = CloudColor.SampleLevel(CloudSampler, (Local / float(Downsample)) * CloudInvExtent, 0);
}
