// The realistic, painted and toon looks' settings (FDreamSkyCloudViewExtension::PackLookParameters): the volumetric cloud
// materials' parameters, the sky's overrides over them; the toon tones and their ramps (FDreamSkyToonClouds, baked), which
// the stylized include's toon painting reads (DSKY_TOON_*).
float4 LookParameters[163];

// A toon ramp (0 the tone by the light, 1 an underside's by its glow) at X, between its 256 samples (two to a vector,
// from LookParameters[18]).
float DSkyR_ToonRamp(float X, int Channel)
{
	float P = saturate(X) * 255.0;
	int I = min(int(P), 254);
	float4 A = LookParameters[18 + (I >> 1)];
	float4 B = LookParameters[18 + ((I + 1) >> 1)];
	float2 FromA = (I & 1) != 0 ? A.zw : A.xy;
	float2 FromB = ((I + 1) & 1) != 0 ? B.zw : B.xy;
	float2 Value = lerp(FromA, FromB, P - float(I));
	return Channel == 0 ? Value.x : Value.y;
}
#define DSKY_TOON_TONE(Light) DSkyR_ToonRamp(Light, 0)
#define DSKY_TOON_UNDER(Glow) DSkyR_ToonRamp(Glow, 1)
#define DSKY_TOON_HALF LookParameters[11]
#define DSKY_TOON_DEEP LookParameters[12]
#define DSKY_TOON_KEY LookParameters[13]
#define DSKY_TOON_KEY2 LookParameters[14]
#define DSKY_TOON_RIM LookParameters[15].x
#define DSKY_TOON_ADV0 LookParameters[146]
#define DSKY_TOON_ADV1 LookParameters[147]
#define DSKY_TOON_ADV2 LookParameters[148]
#define DSKY_TOON_ADV3 LookParameters[149]
