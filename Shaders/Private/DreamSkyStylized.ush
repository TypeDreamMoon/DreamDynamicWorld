// Copyright DreamMoon. All Rights Reserved.
//
// The stylized sky dome: a gradient sky, the sun with its halo, the moon with its phase, stars, thin high cloud and
// rain shafts; in the sky light capture, the panorama of the clouds the sky cloud renderer draws. And the toon cumulus
// the renderer's toon look draws (DreamSkyCloudRender.usf): the clouds of DreamSkyCloudShape.ush, walked to their
// surface and painted the way anime backgrounds paint them, each lobe lit on its own in a few tones, the air between
// veiling the far ones in the sky's colour. Everything comes in as the vectors the sky subsystem writes to the shared
// parameter collection (see DreamSkyModule.h for the layout); this file only draws.
//
// Directions are world space unit vectors: V from the camera through the pixel, SunDir / MoonDir / LightDir
// from the ground toward the body.

#ifndef DREAMSKY_STYLIZED_USH
#define DREAMSKY_STYLIZED_USH

#include "/Plugin/DreamDynamicWorld/Private/DreamSkyCloudShape.ush"
#include "/Plugin/DreamDynamicWorld/Private/DreamSkyFlatClouds.ush"
#include "/Plugin/DreamDynamicWorld/Shared/DreamAtmosphereShared.h"
#include "/Plugin/DreamDynamicWorld/Shared/DreamSkyGradeShared.h"

// The cloud panorama (the sky cloud renderer's PanoramaCS writes it, the dome reads it in the sky light capture): longitude
// across, latitude down from the zenith to a little below the horizon -- the clouds are seen from below, so the lower
// hemisphere is left out and its texels go to the upper one (0.7 degrees a texel at 512 x 128).
#define DSKY_PANORAMA_BELOW 0.13962634  // 8 degrees under the horizon at the bottom row

float2 DSky_PanoramaUV(float3 V)
{
	float Latitude = asin(clamp(V.z, -1.0, 1.0));
	return float2(frac(atan2(V.y, V.x) / (2.0 * 3.14159265)), saturate((0.5 * 3.14159265 - Latitude) / (0.5 * 3.14159265 + DSKY_PANORAMA_BELOW)));
}

float3 DSky_PanoramaDirection(float2 UV)
{
	float Longitude = UV.x * 2.0 * 3.14159265;
	float Latitude = 0.5 * 3.14159265 - UV.y * (0.5 * 3.14159265 + DSKY_PANORAMA_BELOW);
	return float3(cos(Latitude) * cos(Longitude), cos(Latitude) * sin(Longitude), sin(Latitude));
}

// How much of the panorama a direction takes: all of it above its bottom row, none further down (fading in between).
float DSky_PanoramaShare(float3 V)
{
	return smoothstep(-DSKY_PANORAMA_BELOW, -0.5 * DSKY_PANORAMA_BELOW, asin(clamp(V.z, -1.0, 1.0)));
}

float DSky_Hash12(float2 p)
{
	float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return frac((p3.x + p3.y) * p3.z);
}

float3 DSky_Hash33(float3 p)
{
	p = frac(p * float3(0.1031, 0.1030, 0.0973));
	p += dot(p, p.yxz + 33.33);
	return frac((p.xxy + p.yxx) * p.zyx);
}

float DSky_ValueNoise(float2 p)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float2 u = f * f * (3.0 - 2.0 * f);
	float a = DSky_Hash12(i);
	float b = DSky_Hash12(i + float2(1.0, 0.0));
	float c = DSky_Hash12(i + float2(0.0, 1.0));
	float d = DSky_Hash12(i + float2(1.0, 1.0));
	return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float3 DSky_Gradient(float3 V, float3 Zenith, float3 Horizon, float HorizonExp, float3 Ground)
{
	float Up = pow(saturate(V.z), max(HorizonExp, 0.05));
	float3 Sky = lerp(Horizon, Zenith, Up);
	float3 Below = lerp(Horizon, Ground, saturate(-V.z * 6.0));
	return lerp(Below, Sky, smoothstep(-0.01, 0.01, V.z));
}

// How close V is to the sun, 0..1, with vertical distance counted up to three times over while the sun is low:
// the glow spreads along the horizon instead of climbing the sky.
float DSky_SunCloseness(float3 V, float3 SunDir)
{
	float Stretch = 1.0 + 2.0 * (1.0 - saturate(-SunDir.z)) * lerp(1.0, 0.25, saturate(SunDir.z * 1.5));
	float3 W = normalize(float3(V.xy, (V.z - SunDir.z) * Stretch + SunDir.z));
	return saturate(dot(W, SunDir));
}

// The halo around the sun, plus a broad glow along the horizon on the sun's side (sunrise / sunset).
float3 DSky_SunHalo(float3 V, float3 SunDir, float3 HaloColor, float HaloExp)
{
	float Halo = pow(DSky_SunCloseness(V, SunDir), max(HaloExp, 1.0));
	float2 Vh = V.xy;
	float2 Sh = SunDir.xy;
	// (Kept to 0..1: right away from the sun the rounding took the cosine a hair under -1, and its cube's pow came out NaN
	// -- a dotted black line straight up the sky from the horizon opposite the sun.)
	float Side = (length(Vh) > 1e-4 && length(Sh) > 1e-4) ? saturate(dot(normalize(Vh), normalize(Sh)) * 0.5 + 0.5) : 0.5;
	float NearHorizon = 1.0 - saturate(abs(V.z) * 3.0);
	return HaloColor * (Halo + 0.35 * pow(Side, 3.0) * NearHorizon);
}

// The sky's own colour along V, before the bodies, the stars and the clouds: the gradient (while the sun is low,
// the warm horizon belongs to its side and the far side cools toward the sky above it), and the sun's halo apart.
float3 DSky_Backdrop(float3 V, float3 Sun, float4 Zenith, float4 Horizon, float4 Ground, float4 SunHalo, out float3 Halo)
{
	float2 Vh = V.xy;
	float2 Sh = Sun.xy;
	float SunSide = (length(Vh) > 1e-4 && length(Sh) > 1e-4) ? dot(normalize(Vh), normalize(Sh)) * 0.5 + 0.5 : 0.5;
	float LowSun = 1.0 - saturate(abs(Sun.z) * 4.0);
	float3 HorizonHere = lerp(Horizon.rgb, 0.5 * (Horizon.rgb + Zenith.rgb), 0.75 * LowSun * (1.0 - SunSide) * (1.0 - SunSide));
	Halo = DSky_SunHalo(V, Sun, SunHalo.rgb, SunHalo.a);
	return DSky_Gradient(V, Zenith.rgb, HorizonHere, Horizon.a, Ground.rgb);
}

// A disk of angular radius RadiusDeg, anti-aliased over one pixel.
float DSky_Disk(float3 V, float3 Dir, float RadiusDeg)
{
	float c = dot(V, Dir);
	float Edge = cos(radians(max(RadiusDeg, 0.01)));
	float Aa = max(fwidth(c), 1e-6);
	return smoothstep(Edge - Aa, Edge + Aa, c);
}

// The moon as a lit sphere: Phase 0 new (dark), 0.5 full. Its lit side shades as the moon's dust does (Lommel-Seeliger:
// a full moon is evenly bright to its limb), the terminator soft over Look.x (in the sun's cosine); the dark side shows
// the earthshine, Look.y of the lit side at its strongest, a little blue, the brighter the fuller the earth stands in
// the moon's sky -- most near the new moon, gone at the full. Its face: NASA's map of it (Face, selenographic longitude
// across, latitude down), the near side toward the earth and its north toward the celestial pole (Pole; no libration), as
// much as Look.w says; else its maria Look.z darker than its highlands, large dark patches over the near side. Lunar =
// (how much the earth's umbra covers it, the umbra's centre on it and its radius, in moon radii): the umbra turns it a
// dark copper, with a soft edge.
float3 DSky_Moon(float3 V, float3 MoonDir, float3 SunDir, float Phase, float RadiusDeg, float3 Color, float4 Lunar, float4 Look,
	Texture2D Face, SamplerState FaceSampler, float3 Pole)
{
	float Facing = dot(V, MoonDir);
	if (Facing <= 0.0)
	{
		return 0;
	}
	float SinR = sin(radians(max(RadiusDeg, 0.01)));
	float3 Up = abs(MoonDir.z) < 0.99 ? float3(0, 0, 1) : float3(1, 0, 0);
	float3 X = normalize(cross(Up, MoonDir));
	float3 Y = cross(MoonDir, X);
	float3 D = V - MoonDir * Facing;
	float2 UV = float2(dot(D, X), dot(D, Y)) / SinR;
	float R2 = dot(UV, UV);
	float Aa = max(fwidth(R2), 1e-5);
	float Inside = 1.0 - smoothstep(1.0 - Aa, 1.0 + Aa, R2);
	if (Inside <= 0.0)
	{
		return 0;
	}
	float3 N = float3(UV, sqrt(saturate(1.0 - R2)));
	float2 Toward = float2(dot(SunDir, X), dot(SunDir, Y));
	float Len = length(Toward);
	Toward = Len > 1e-3 ? Toward / Len : float2(1, 0);
	float A = Phase * 6.2831853;
	float3 L = float3(Toward * sin(A), -cos(A));
	float NdL = dot(N, L);
	float Soft = max(Look.x, 0.002);
	float Lit = 2.0 * saturate(NdL) / max(saturate(NdL) + N.z, 1.0e-3) * smoothstep(-Soft, Soft, NdL);
	float Earth = max(Look.y, 0.0) * 0.5 * (1.0 + cos(A));
	// (The maria: large patches, their edges uneven, a little texture over all of it -- by a faint noise alone, under a
	// bright full moon's tone they were all but gone.)
	float Seas = smoothstep(0.42, 0.62, DSky_ValueNoise(UV * 1.7 + 11.0) * 0.75 + DSky_ValueNoise(UV * 4.3 + 3.0) * 0.25);
	float3 Mare = (1.0 - saturate(Look.z) * Seas) * (0.9 + 0.1 * DSky_ValueNoise(UV * 9.0 + 5.0));
	if (Look.w > 0.0)
	{
		// (Seen along MoonDir, its north up, its east -- Mare Crisium's side -- on the right; the map read at the level
		// the disk's size on screen takes: half the map across its diameter.)
		float3 North = Pole - MoonDir * dot(Pole, MoonDir);
		North = dot(North, North) > 1.0e-6 ? normalize(North) : Y;
		float3 East = cross(North, MoonDir);
		float3 Out = N.x * X + N.y * Y - N.z * MoonDir;
		float Lat = asin(clamp(dot(Out, North), -1.0, 1.0));
		float Lon = atan2(dot(Out, East), -dot(Out, MoonDir));
		float2 FaceUV = float2(0.5 + Lon / 6.2831853, 0.5 - Lat / 3.14159265);
		float Lod = log2(max(256.0 * length(fwidth(UV)), 1.0));
		Mare = lerp(Mare, Face.SampleLevel(FaceSampler, FaceUV, Lod).rgb, saturate(Look.w));
	}
	float3 Shown = Color * Inside * Mare * (Lit + Earth * float3(0.85, 0.93, 1.1) * (1.0 - saturate(Lit)));
	if (Lunar.x > 0.0)
	{
		float Umbra = 1.0 - smoothstep(Lunar.w - 0.3, Lunar.w + 0.4, length(UV - Lunar.yz));
		float3 Copper = float3(0.42, 0.12, 0.06) * dot(Color, float3(0.33, 0.33, 0.33)) * 0.1 * Inside * Mare;
		Shown = lerp(Shown, Copper, Umbra);
	}
	return Shown;
}

// A solar eclipse on the sun's disk (drawn RadiusDeg wide): Eclipse = (how much the moon covers, the moon's centre on
// the sun in sun radii, the corona's share of the disk's brightness). Out: how much of the sun's disk shows here (the
// moon's disk, a little larger, masks it), and the corona round the moon at totality, streamered.
float DSky_Eclipse(float3 V, float3 Sun, float RadiusDeg, float4 Eclipse, float3 DiskColor, out float3 Corona)
{
	Corona = 0;
	float Facing = dot(V, Sun);
	if (Eclipse.x <= 0.0 || Facing <= 0.0)
	{
		return 1.0;
	}
	float SinR = sin(radians(max(RadiusDeg, 0.01)));
	float3 Up = abs(Sun.z) < 0.99 ? float3(0, 0, 1) : float3(1, 0, 0);
	float3 X = normalize(cross(Up, Sun));
	float3 Y = cross(Sun, X);
	float3 D = V - Sun * Facing;
	float2 UV = float2(dot(D, X), dot(D, Y)) / SinR;
	float ToMoon = length(UV - Eclipse.yz);
	float Aa = max(fwidth(ToMoon), 1.0e-4);
	float Moon = 1.0 - smoothstep(1.03 - Aa, 1.03 + Aa, ToMoon);
	// The corona: a bright inner ring falling off fast, and streamers of uneven length reaching two or three sun radii,
	// finely combed along their way out (read round a circle, so no seam where the angle wraps).
	float R = length(UV);
	float2 Round = UV / max(R, 1.0e-4);
	float Long = DSky_ValueNoise(Round * 1.6 + float2(7.0, 3.3));
	float Comb = DSky_ValueNoise(Round * 7.0 + float2(1.7, 9.1));
	float Reach = 0.25 + 1.9 * Long * Long * Long;
	float Out = max(R - 1.0, 0.0);
	float Glow = 0.55 * exp(-Out * 6.0) + 0.45 * exp(-Out / Reach) * lerp(0.55, 1.0, Comb);
	Corona = DiskColor * float3(1.0, 0.97, 0.92) * Eclipse.w * Glow * (1.0 - Moon);
	return 1.0 - Moon;
}

// Points on a jittered 3D lattice the dome cuts through; Rotation turns them about the vertical (0..1 = a turn); Hidden:
// the share of them, the dimmest first, left out.
float DSky_Stars(float3 V, float Rotation, float Density, float Twinkle, float Seconds, float Hidden, float4 Look)
{
	if (V.z <= 0.0 || Density <= 0.0)
	{
		return 0.0;
	}
	float A = Rotation * 6.2831853;
	float3 P = float3(V.x * cos(A) - V.y * sin(A), V.x * sin(A) + V.y * cos(A), V.z);
	float3 G = P * 70.0;
	float3 Cell = floor(G);
	float3 F = frac(G);
	float3 R = DSky_Hash33(Cell);
	float Present = step(1.0 - 0.12 * Density, R.x);
	float Dist = length(F - (0.25 + 0.5 * R.zxy));
	float Size = lerp(0.03, 0.09, R.y) * Look.x;
	// The pixel's footprint in lattice units, from the lattice coordinate itself, which runs on smoothly (the distance
	// to a cell's star jumps where a pixel's neighbour lies in the next cell: its screen derivative there smeared the
	// stars along the cells' faces into dashes, arcs and rings). A star is never drawn smaller than some 0.7 pixel
	// across its radius, dimmed for what it was enlarged, so it does not break up as it falls between pixels.
	float Pixel = max(0.5 * length(fwidth(G)), 1e-4);
	float Radius = max(Size, 0.7 * Pixel);
	float Point = (1.0 - smoothstep(Radius - 0.5 * Pixel, Radius + 0.5 * Pixel, Dist)) * (Size / Radius);
	float Flicker = 1.0 - Twinkle * 0.5 * (1.0 + sin(Seconds * Look.y * (1.5 + 3.0 * R.z) + R.y * 40.0));
	return Present * step(Hidden, R.z) * Point * lerp(Look.z, 1.0, R.z) * Flicker * saturate(V.z * 5.0);
}

// A direction to an octahedral map's 0..1 coordinates, and back (as DreamStarMap.h builds the star map).
float2 DSky_OctEncode(float3 D)
{
	D /= abs(D.x) + abs(D.y) + abs(D.z);
	float2 P = D.xy;
	if (D.z < 0.0)
	{
		P = (1.0 - abs(D.yx)) * float2(D.x >= 0.0 ? 1.0 : -1.0, D.y >= 0.0 ? 1.0 : -1.0);
	}
	return P * 0.5 + 0.5;
}

float3 DSky_OctDecode(float2 UV)
{
	float2 P = UV * 2.0 - 1.0;
	float3 D = float3(P, 1.0 - abs(P.x) - abs(P.y));
	float T = saturate(-D.z);
	D.xy += float2(D.x >= 0.0 ? -T : T, D.y >= 0.0 ? -T : T);
	return normalize(D);
}

// A star's colour from its B-V index: blue-white, white, yellow, orange.
float3 DSky_StarColor(float BV)
{
	float3 C = lerp(float3(0.66, 0.76, 1.0), float3(1.0, 1.0, 1.0), smoothstep(-0.25, 0.2, BV));
	C = lerp(C, float3(1.0, 0.87, 0.68), smoothstep(0.2, 0.9, BV));
	return lerp(C, float3(1.0, 0.7, 0.48), smoothstep(0.9, 1.7, BV));
}

// The catalogue's stars (the star map Setup builds, DreamStarMap.h): the sphere set by its pole and the March equinox
// in the world (Pole.xyz, Equinox.xyz); each cell of the map round the view's holds a star, drawn a point some pixel
// across, brighter for each magnitude by Equinox.w (1 = as in the sky), the brightest a little larger, in its colour.
// Hidden: the share of them, the dimmest first, left out (from how many stars are brighter than a magnitude).
float3 DSky_CatalogueStars(float3 V, float4 Pole, float4 Equinox, Texture2D StarMap, float Twinkle, float Seconds, float Hidden, float4 Look)
{
	if (V.z <= 0.0)
	{
		return 0.0;
	}
	float3 Z = normalize(Pole.xyz);
	float3 X = normalize(Equinox.xyz - Z * dot(Equinox.xyz, Z));
	float3 Y = cross(X, Z);
	float3 E = float3(dot(V, X), dot(V, Y), dot(V, Z));
	uint Width, Height;
	StarMap.GetDimensions(Width, Height);
	float Size = float(Width);
	int2 Cell = int2(floor(DSky_OctEncode(E) * Size));
	// (The pixel's footprint on the sphere, radians; the direction runs on smoothly where the cells do not.)
	float Pixel = max(length(fwidth(E)), 1.0e-5);
	float Faintest = Hidden > 0.0 ? 6.5 + log10(max(1.0 - Hidden, 1.0e-4)) / 0.48 : 99.0;
	float3 Light = 0.0;
	UNROLL
	for (int Dy = -1; Dy <= 1; ++Dy)
	{
		UNROLL
		for (int Dx = -1; Dx <= 1; ++Dx)
		{
			int2 C = Cell + int2(Dx, Dy);
			if (any(C < 0) || any(C >= int(Width)))
			{
				continue;
			}
			float4 T = StarMap.Load(int3(C, 0));
			float Magnitude = 8.0 - (T.b * 255.0 - 1.0) * (10.0 / 254.0);
			if (T.b <= 0.0 || Magnitude > Faintest)
			{
				continue;
			}
			float3 S = DSky_OctDecode((float2(C) + 0.5 + T.rg * 3.0 - 1.5) / Size);
			float Bright = min(pow(10.0, -0.4 * Equinox.w * (Magnitude - 2.0)), 6.0);
			float Radius = Pixel * (0.65 + (0.45 * saturate(Bright) + 0.35 * saturate((Bright - 1.0) / 3.0)) * Look.x);
			float Point = 1.0 - smoothstep(Radius - 0.5 * Pixel, Radius + 0.5 * Pixel, length(E - S));
			float Seed = frac(T.r * 7.13 + T.g * 3.71 + T.a * 1.37);
			float Flicker = 1.0 - Twinkle * 0.5 * (1.0 + sin(Seconds * Look.y * (1.5 + 3.0 * Seed) + Seed * 40.0));
			Light += DSky_StarColor(T.a * 2.4 - 0.4) * Bright * Point * Flicker;
		}
	}
	return Light * saturate(V.z * 5.0);
}

// The Milky Way (the map Setup makes, DreamMilkyWay.h, in galactic longitude and latitude) on the celestial sphere set
// by its pole and the March equinox (as the catalogue's stars); MilkyWay = (tint x how bright it shows, contrast),
// Dust = (how dark the dust lanes, saturation). The light dimmed by the dust (the map's alpha: its optical depth / 4).
float3 DSky_MilkyWay(float3 V, float4 Pole, float4 Equinox, Texture2D Galaxy, SamplerState GalaxySampler, float4 MilkyWay, float4 Dust)
{
	if (V.z <= 0.0)
	{
		return 0.0;
	}
	float3 Z = normalize(Pole.xyz);
	float3 X = normalize(Equinox.xyz - Z * dot(Equinox.xyz, Z));
	float3 Y = cross(X, Z);
	float3 E = float3(dot(V, X), dot(V, Y), dot(V, Z));
	// (The galactic frame in the equatorial one, J2000: toward the centre, toward longitude 90, toward the north pole.)
	float3 G = float3(dot(E, float3(-0.0548755, -0.8734371, -0.4838349)), dot(E, float3(0.4941094, -0.4448295, 0.7469823)),
		dot(E, float3(-0.8676661, -0.1980764, 0.4559838)));
	float2 UV = float2(atan2(G.y, G.x) * (0.5 / PI) + 0.5, 0.5 - asin(clamp(G.z, -1.0, 1.0)) / PI);
	float4 T = Galaxy.SampleLevel(GalaxySampler, UV, 0);
	float3 Light = pow(max(T.rgb * exp(-4.0 * 0.8 * Dust.x * T.a), 0.0), MilkyWay.a);
	float Grey = dot(Light, float3(0.2126, 0.7152, 0.0722));
	Light = max(lerp(Grey.xxx, Light, Dust.y), 0.0);
	// (Low down it is seen through more air.)
	return Light * MilkyWay.rgb * saturate(V.z * 4.0);
}

// The aurora: curtains of soft light over the auroral oval toward the magnetic pole, from a sharp lower edge some 95 km
// up (where they shine brightest) fading out by 320 km, green low down going to violet at the top. Where the curtains
// stand is drawn as thin ribbons: two copies of one smooth noise field, drifting apart, light where they nearly agree
// (1 - |a - b| to a high power) -- lines that wander, fold and slowly change shape as the fields slide; stretched along
// the oval (east-west), strongest in its middle and where a broad field of activity is up. Each view ray is walked up
// through the shell at fourteen heights (dithered, so the steps blend over frames): a ribbon on the ground is a
// curtain standing over it, and fine noise along its length (the same at every height) striates it with rays.
// A negative strength draws it for the stylized looks: its light banded in three clean tones.
// Aurora = (strength, speed, toward the pole x, y), Low = (low colour, arc distance km), High = (high colour, arc width km),
// Tones = (the three steps of the banded tones, how soft their edges), Shape = (ribbons' length, width km, sharpness; rays'
// spacing km), Shape2 = (rays' contrast, upward fade; the banded tones' first two levels), Shape3 = (lower edge, top km;
// the edge band's brightness; the oval's width in ArcWidths).
float3 DSky_Aurora(float3 V, float4 Aurora, float4 Low, float4 High, float4 Tones, float4 Shape, float4 Shape2, float4 Shape3, float Seconds,
	Texture3D Noise, SamplerState NoiseSampler, float2 ScreenUV)
{
	if (Aurora.x == 0.0 || V.z <= 0.0)
	{
		return 0;
	}
	float Strength = abs(Aurora.x);
	float2 Pole = dot(Aurora.zw, Aurora.zw) > 1.0e-6 ? normalize(Aurora.zw) : float2(1.0, 0.0);
	float2 East = float2(-Pole.y, Pole.x);
	float Flat = length(V.xy);
	float2 Out = Flat > 1.0e-4 ? V.xy / Flat : Pole;
	float T = Seconds * Aurora.y;
	float Width = max(High.a, 1.0);
	// (Interleaved gradient noise over the screen, turning each frame.)
	float Dither = frac(52.9829189 * frac(dot(ScreenUV * float2(1920.0, 1080.0), float2(0.06711056, 0.00583715))) + frac(Seconds * 7.31));
	float3 Sum = 0;
	const int Heights = 14;
	[loop]
	for (int i = 0; i < Heights; ++i)
	{
		float H = (float(i) + Dither) / float(Heights);
		float Altitude = lerp(Shape3.x, Shape3.y, H * H);
		// (Where the ray reaches that height over a 6371 km planet, and how far off along the ground.)
		float a = Flat * Flat / (2.0 * 6371.0);
		float Along = 2.0 * Altitude / (V.z + sqrt(V.z * V.z + 4.0 * a * Altitude));
		float2 P = Out * (Along * Flat);
		float E = dot(P, East);
		float N = dot(P, Pole) - Low.a;
		// The oval: a broad band across the pole's direction, and the activity over it.
		float Band = exp(-Square(N / (Shape3.w * Width)));
		if (Band < 0.01)
		{
			continue;
		}
		float Active = smoothstep(0.25, 0.7, Noise.SampleLevel(NoiseSampler, float3(E / 2600.0 + T * 0.0004, N / 1400.0, 0.71 + T * 0.0003), 2.0).r);
		// The ribbons: the same field twice, sliding apart.
		float3 C = float3(E / Shape.x, N / Shape.y, 0.0);
		float A1 = Noise.SampleLevel(NoiseSampler, C + float3(T * 0.0021, T * 0.0009, 0.13 + T * 0.0006), 1.0).r;
		float A2 = Noise.SampleLevel(NoiseSampler, C * 0.85 + float3(0.37 - T * 0.0017, 0.61 + T * 0.0012, 0.29 + T * 0.0005), 1.0).r;
		float Ribbon = pow(saturate(1.0 - abs(A1 - A2)), Shape.z);
		// Rays along the curtain, the same all the way up.
		float Rays = Noise.SampleLevel(NoiseSampler, float3(E / Shape.w + T * 0.004, N / 400.0, 0.47 + T * 0.002), 0.0).g;
		Rays = 0.15 + Shape2.x * Rays * Rays;
		// A sharp lower edge, a bright band along it, the body fading upward (the rays reach higher than the rest).
		float Edge = smoothstep(0.0, 0.03, H);
		float Profile = Edge * (Shape3.z * exp(-Square((H - 0.06) / 0.07)) + exp(-Shape2.y * H / max(Rays, 0.3)));
		float3 Colour = lerp(Low.rgb, High.rgb, smoothstep(0.12, 0.6, H));
		Sum += Colour * (Ribbon * Band * Active * Profile * lerp(1.0, Rays, smoothstep(0.02, 0.2, H)));
	}
	// (Low over the horizon it is seen through more air: it fades into it.)
	Sum *= Strength * (7.5 / float(Heights)) * smoothstep(0.0, 0.08, V.z);
	if (Aurora.x < 0.0)
	{
		// The stylized looks: three tones with clean edges, the hue kept (Tones: the three steps, how soft).
		float Level = dot(Sum, float3(0.3, 0.6, 0.1)) / Strength;
		float Soft = max(Tones.w, 0.001);
		float Stepped = Shape2.z * smoothstep(Tones.x - 0.01 * Soft, Tones.x + 0.01 * Soft, Level) + Shape2.w * smoothstep(Tones.y - 0.015 * Soft, Tones.y + 0.015 * Soft, Level)
			+ saturate(1.0 - Shape2.z - Shape2.w) * smoothstep(Tones.z - 0.02 * Soft, Tones.z + 0.02 * Soft, Level);
		Sum *= Stepped / max(Level, 1.0e-4);
	}
	return Sum;
}

// The night sky's own light: NightGlow = (airglow, -), brighter low down where the eye looks through more of the glowing
// upper air; LightPollution = (a city's light at the horizon, how high it climbs: the sine of the elevation where it
// has fallen to a third), dropping off upward and dying out a little under the horizon.
float3 DSky_NightGlow(float3 V, float4 NightGlow, float4 LightPollution)
{
	float Up = max(V.z, 0.0);
	float3 Glow = NightGlow.rgb * (1.0 + 1.5 * (1.0 - Up));
	Glow += LightPollution.rgb * exp(-Up / max(LightPollution.a, 0.01)) * smoothstep(-0.08, 0.0, V.z);
	return Glow;
}

// ---------------------------------------------------------------------------------------------------------------
// Volumetric clouds, toon: the cloud layer (shaped in DreamSkyCloudShape.ush) walked to its surface, which is then lit
// once, by its normal and its own shadow toward the main light, and banded into the style's few tones: volumes with a
// painted look. The sky cloud renderer's toon look marches to the surface and draws it with these.

// The cloud field for one frame, as the toon march sees it.
struct FDSkyCloudField
{
	float3 Camera;     // the view in the world (cm): the shapes are anchored in the world, not to the view
	float Base;        // altitude of the cloud layer's base (cm)
	float Iso;         // the level of the clouds' solid shape (0..1) the toon surface is drawn at
	float4 Cloud0;
	float4 Cloud1;
	float4 Cloud2;
	float4 CloudLayer;
	float Thin;        // how much the clouds along this ray are thinned (the clearing round the sun and the moon), 0..1
};

// What the field holds at a point besides its density.
struct FDSkyCloudSample
{
	float Density;      // 0..1, the surface at one half
	float Solid;        // 0..1, the clouds' solid shape: the surface is where it reaches the field's Iso
	float Signed;       // the shape before it is clamped: Solid inside, below 0 outside and the lower the further out
	float Form;         // the shape before the billows eat into it: >= Solid, so below Iso no cloud can be here
	float Dark;         // storm darkness here
	float Column;       // cm: how tall the cloud type standing here is
	float Height;       // 0 base .. 1 top, where the point sits in that column
	float Deck;         // 1: the point belongs to the deck
	float Z;            // cm above the layer's base
	FDCloudAnchor Anchor; // what samples near this one may take from it (DCS_ShapeNear)
	float StormDistance; // cm: FDCloudShape.StormDistance (a full sample only)
	float Volume;        // FDCloudShape.Density: the density a volume march integrates
	float Funnel;        // 0..1: how much of this is a tornado's funnel, its wall cloud or its dust (the looks darken it)
};

// The planet the cloud layer curves over (the engine's cloud layer uses the same without a sky atmosphere).
static const float DSky_PlanetRadius = 636000000.0;

// How far along V (from the view) the ray reaches an altitude A above the ground, over the planet's curve (the
// layer is centred under the world's origin, as the engine's is); 0 if the view is already at or above it.
float DSky_AltitudeT(float3 Camera, float3 V, float A)
{
	float a = dot(V.xy, V.xy) / (2.0 * DSky_PlanetRadius);
	float b = V.z + dot(Camera.xy, V.xy) / DSky_PlanetRadius;
	float c = Camera.z + dot(Camera.xy, Camera.xy) / (2.0 * DSky_PlanetRadius) - A;
	if (c >= 0.0)
	{
		return 0.0;
	}
	// The positive root, in the form that keeps its precision (a is tiny).
	return -2.0 * c / (b + sqrt(max(b * b - 4.0 * a * c, 0.0)));
}

// Where along V the ray's altitude (h + b t + a t^2: over the planet's curve it falls to its lowest, then rises) is A:
// T1 <= T2; false if it never is. In the form that keeps its precision (a is tiny; a nearly vertical ray gets one root
// where its altitude line crosses A and one far off).
bool DSky_AltitudeRoots(float a, float b, float h, float A, out float T1, out float T2)
{
	float c = h - A;
	float D = b * b - 4.0 * a * c;
	T1 = 0.0;
	T2 = 0.0;
	if (D < 0.0)
	{
		return false;
	}
	float q = -0.5 * (b + (b >= 0.0 ? 1.0 : -1.0) * sqrt(D));
	float R1 = q / a;
	float R2 = abs(q) > 1.0e-20 ? c / q : R1;
	T1 = min(R1, R2);
	T2 = max(R1, R2);
	return true;
}

// The stretch along V (from the view) inside the layer between altitudes Lo and Hi above the ground, over the planet's
// curve, within MaxT: [T0, T1], empty if T1 <= T0. From below the ray enters at Lo, from inside it starts at the view,
// from above it enters at Hi; looking down it ends at Lo (nothing stands below the layer's base).
void DSky_LayerSpan(float3 Camera, float3 V, float Lo, float Hi, float MaxT, out float T0, out float T1)
{
	float a = max(dot(V.xy, V.xy) / (2.0 * DSky_PlanetRadius), 1.0e-12);
	float b = V.z + dot(Camera.xy, V.xy) / DSky_PlanetRadius;
	float h = Camera.z + dot(Camera.xy, Camera.xy) / (2.0 * DSky_PlanetRadius);
	T0 = 0.0;
	T1 = 0.0;
	float U1;
	float U2;
	// (Never as low as Hi: always above the layer.)
	if (!DSky_AltitudeRoots(a, b, h, Hi, U1, U2))
	{
		return;
	}
	float Start = max(U1, 0.0);
	float End = min(U2, MaxT);
	float L1;
	float L2;
	if (DSky_AltitudeRoots(a, b, h, Lo, L1, L2))
	{
		// Below the base between L1 and L2: the stretch starts after it, or ends where it dips under it.
		if (Start > L1 && Start < L2)
		{
			Start = L2;
		}
		if (L1 > Start && L1 < End)
		{
			End = L1;
		}
	}
	T0 = Start;
	T1 = End;
}

// The direction whose sky colour the haze takes along V: V itself, or, looking down, the horizon under it (the air
// between the view and a cloud below is lit like the low sky, not coloured like the ground).
float3 DSky_HazeDirection(float3 V)
{
	float3 H = float3(V.xy, max(V.z, 0.0));
	return dot(H, H) > 1.0e-6 ? normalize(H) : float3(1.0, 0.0, 0.0);
}

#ifdef DSKY_FUNNEL_A
// The tornadoes' funnel clouds (DreamSkyFunnels.h), over the clouds' shape at a world point at an altitude (cm, over the
// planet's curve) under a cloud base at Base (DSky_Funnels).
//   DSKY_FUNNEL_A(i) = (root x, y (cm), radius at the base (cm), strength x the spin's sign)
//   DSKY_FUNNEL_B(i) = (how far it has turned (radians), the ground's height at the root (cm), the lean x, y (cm))
//   DSKY_FUNNEL_DECAY(i) = how far it has roped out as it dies, 0..1 (Dk below): the funnel thins to a rope, sways and
//                          leans further (the lean comes packed already grown), its wall cloud and dust fade, and it breaks
//                          (DSky_FunnelBreak)
// How far a funnel has roped out (0..1, by its decay): thinned to a rope, swaying.
float DSky_FunnelRope(float Dk)
{
	return smoothstep(0.0, 0.6, Dk);
}

// A funnel's axis across at a height (Hn: 0 its root .. 1 the base): leaning toward the top, wavering (whole multiples of
// the turn, so a full turn is seamless); a rope sways further, in a longer curve.
float2 DSky_FunnelAxis(float4 A, float4 B, float Dk, float Hn)
{
	float H = saturate(Hn);
	float Rope = DSky_FunnelRope(Dk);
	float2 Lean = B.zw * lerp(pow(H, 1.5), H, 0.5 * Rope);
	float Waver = A.z * lerp(0.12, 0.45, Rope) * saturate(1.2 - Hn);
	return A.xy + Lean + Waver * float2(sin(Hn * lerp(9.0, 5.0, Rope) + B.x), cos(Hn * lerp(7.0, 4.0, Rope) + B.x));
}

// How much of a funnel breaking away is gone at a height (0 none .. 1 all): a gap opening half way down the rope and
// widening, a piece left hanging from the base and one standing on the ground, then both thinning out.
float DSky_FunnelBreak(float Dk, float Hn)
{
	float Break = smoothstep(0.75, 0.9, Dk);
	float Gap = Break * (1.0 - smoothstep(0.03 + 0.18 * Break, 0.07 + 0.2 * Break, abs(Hn - 0.45)));
	return saturate(Gap + smoothstep(0.86, 0.98, Dk));
}

// A funnel's profile, from its size (so a tornado keeps its own as it moves): 1.3 a wide cone tapering all the way down
// .. 3.2 a rope that widens only near the base.
float DSky_FunnelProfile(float4 A)
{
	return lerp(1.3, 3.2, frac(sin(A.z * 0.0731 + 1.7) * 43758.5453));
}

// A funnel's radius at a height (cm), before its lobes: from a rope at its tip to its radius at the base, down as far as
// its strength takes it; roping out, a fifth as wide at the base and nearly as narrow all the way down.
float DSky_FunnelRadius(float4 A, float Dk, float Hn)
{
	float Strength = abs(A.w);
	float H = saturate(Hn);
	float Tip = 1.0 - Strength;
	float Rope = DSky_FunnelRope(Dk);
	float Floor = lerp(0.06, 0.45, Rope);
	float Profile = pow(H, lerp(DSky_FunnelProfile(A), 5.0, Rope));
	return A.z * lerp(1.0, 0.22, Rope) * (Floor + (1.0 - Floor) * Profile) * smoothstep(Tip - 0.03, Tip + 0.12, Hn);
}

// The widest a funnel, its wall cloud, the storm's darkened base round it and its dust reach from its axis (in its
// radii at the base), and how far up over the base the base round it is darkened (of the root's height under it).
static const float DSky_FunnelReach = 13.0;
static const float DSky_FunnelTop = 2.0;

// How far the cloud base sinks round a funnel at a point (of the root's height under the base): the wall cloud round
// its top, some three funnel radii across, a quarter of the way to the ground; the storm's rain-free base round that,
// four times as wide, a little. Both are the base itself lowered, not shapes of their own -- so they are the base's own
// underside, the wall cloud rising smoothly into it with no top of its own -- their edges torn by a noise NW (0.5:
// none). (Its sides slope gently: steep, a deck's thin sheets lowered down them let the light through in streaks.)
float DSky_FunnelSink(float4 A, float4 B, float Dk, float2 XY, float NW)
{
	// (Going as it ropes out.)
	float Forming = smoothstep(0.05, 0.35, abs(A.w)) * (1.0 - smoothstep(0.1, 0.6, Dk));
	float Across = length(XY - DSky_FunnelAxis(A, B, Dk, 1.0)) / (A.z * 3.2);
	float Wall = 0.25 * (1.0 - smoothstep(0.0, 1.4, Across + (NW - 0.5) * 0.4));
	float Storm = 0.05 * (1.0 - smoothstep(0.3, 1.0, Across * 0.25 + (NW - 0.5) * 0.3));
	return Forming * max(Wall, Storm);
}

// How far the cloud base is lowered at a world point under a cloud base at Base (cm), the most of any funnel's.
float DSky_FunnelLower(float3 World, float Base, Texture3D Noise, SamplerState NoiseSampler)
{
	float Lower = 0.0;
	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		float4 A = DSKY_FUNNEL_A(i);
		float4 B = DSKY_FUNNEL_B(i);
		float Dk = DSKY_FUNNEL_DECAY(i);
		if (abs(A.w) <= 0.001 || A.z <= 0.0)
		{
			continue;
		}
		float2 DW = World.xy - DSky_FunnelAxis(A, B, Dk, 1.0);
		if (dot(DW, DW) > A.z * A.z * DSky_FunnelReach * DSky_FunnelReach)
		{
			continue;
		}
		float NW = Noise.SampleLevel(NoiseSampler, float3(DW / A.z * 0.22, 0.71 + float(i) * 0.13), 0).g;
		Lower = max(Lower, DSky_FunnelSink(A, B, Dk, World.xy, NW) * max(Base - B.y, 1000.0));
	}
	return Lower;
}

// The longest step a march may take at a world point so as not to step over a funnel's narrow column there (cm): a
// tenth of its width where the point is near it (the funnel is opaque within a few steps: longer ones drew the jitter's
// grid on it), no limit elsewhere.
float DSky_FunnelStep(float3 World, float Altitude, float Base)
{
	float Step = 1.0e9;
	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		float4 A = DSKY_FUNNEL_A(i);
		float4 B = DSKY_FUNNEL_B(i);
		float Dk = DSKY_FUNNEL_DECAY(i);
		if (abs(A.w) <= 0.001 || A.z <= 0.0)
		{
			continue;
		}
		float Hn = (Altitude - B.y) / max(Base - B.y, 1000.0);
		if (Hn < -0.05 || Hn > DSky_FunnelTop)
		{
			continue;
		}
		float R = max(DSky_FunnelRadius(A, Dk, Hn), A.z * 0.1);
		float Dist = length(World.xy - DSky_FunnelAxis(A, B, Dk, Hn));
		if (Dist < R * 1.6 + A.z * 0.4)
		{
			Step = min(Step, max(R * 0.2, 300.0));
		}
		// Its top, flaring into the base lowered over it: an underside nearly level, seen aslant, its edge crossed within a
		// step or two -- longer ones drew the jitter's grid on it. (Only there: walked fine further round, the rays crossing
		// it had too few samples left for the cloud beyond, and walked it in rings.)
		float Top = 1.0 - DSky_FunnelSink(A, B, Dk, World.xy, 0.5);
		float Flare = smoothstep(0.7, 1.05, Hn + 1.0 - Top);
		if (Hn > Top - 0.4 && Hn < Top + 0.12 && Dist < R * (1.0 + Flare * Flare) * 2.0 + A.z)
		{
			Step = min(Step, max(A.z * 0.08, 300.0));
		}
	}
	return Step;
}

// The extinction a funnel and its dust have to the eye at a world point (per cm; 0 elsewhere): some six optical depths
// across, however narrow -- a rope ten metres across as opaque as the wide top -- for the realistic and painted looks,
// whose clouds' measure would leave a column a hundred metres across half seen through. Dark: how dark the looks draw
// it there (0..1), its top only as dark as the wall cloud it grows out of.
float DSky_FunnelSigma(float3 World, float Altitude, float Base, out float Dark)
{
	float Sigma = 0.0;
	Dark = 0.0;
	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		float4 A = DSKY_FUNNEL_A(i);
		float4 B = DSKY_FUNNEL_B(i);
		float Dk = DSKY_FUNNEL_DECAY(i);
		if (abs(A.w) <= 0.001 || A.z <= 0.0)
		{
			continue;
		}
		float Hn = (Altitude - B.y) / max(Base - B.y, 1000.0);
		if (Hn < -0.05 || Hn > 1.2)
		{
			continue;
		}
		float R = max(DSky_FunnelRadius(A, Dk, Hn), A.z * 0.03);
		float Dist = length(World.xy - DSky_FunnelAxis(A, B, Dk, Hn));
		// (Ending as it flares into the base lowered over it, where its own soft density takes over: on up, the column drew
		// a round top through the cloud, and in its flare a dark cap.)
		float Top = 1.0 - DSky_FunnelSink(A, B, Dk, World.xy, 0.5);
		float Inside = saturate((R * 1.2 - Dist) / R * 2.0) * (1.0 - smoothstep(Top - 0.3, Top - 0.08, Hn))
			* (1.0 - DSky_FunnelBreak(Dk, Hn));
		Sigma = max(Sigma, Inside * 3.0 / R);
		Dark = max(Dark, saturate(Inside * 1.0e3) * lerp(1.0, 0.25, smoothstep(0.7, 1.05, Hn + 1.0 - Top)));
		// The dust at its foot, once it touches down.
		float Down = smoothstep(0.85, 1.0, abs(A.w)) * (1.0 - smoothstep(0.2, 0.6, Dk));
		float Low = 1.0 - smoothstep(0.04, 0.12, Hn);
		float Dust = Down * Low * saturate((A.z * 1.3 - Dist) / (A.z * 0.4));
		Sigma = max(Sigma, Dust * 2.0 / A.z);
		Dark = max(Dark, saturate(Dust * 1.0e3));
	}
	return Sigma;
}

// A smooth union of two shapes (k: how wide the seam is blended), so the funnel grows out of its wall cloud and its dust
// with no line between.
float DSky_SmoothMax(float A, float B, float K)
{
	float H = saturate(0.5 + 0.5 * (A - B) / K);
	return lerp(B, A, H) + K * H * (1.0 - H);
}

// The funnels over the clouds' shape at a world point, the cloud base already lowered round them by Lower (cm,
// DSky_FunnelLower). Each is two shapes, blended smoothly:
//   the funnel   hanging from the base, lowered there into its wall cloud, down toward its root as far as its strength
//                takes it; its own profile (a cone or a rope, DSky_FunnelProfile), three lobes twisting with height and
//                turning with it, long streaks up its wall in a frame that turns with it; ending just inside the base
//   its dust    once it touches down, a low tumbling ring of dark dust and debris at its foot
// Where they are the more solid the shape is theirs, dark (FunnelOut: how much, for the looks' darker tones); the base
// round it is darkened too, smoothly, the wall cloud the most. Every funnel brings the nearest cloud (StormDistance) at
// most as far as its reach, so a march below the base does not skip it.
void DSky_Funnels(float3 World, float Altitude, float Base, float Lower, Texture3D Noise, SamplerState NoiseSampler,
	inout FDCloudShape C, inout float FunnelOut)
{
	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		float4 A = DSKY_FUNNEL_A(i);
		float4 B = DSKY_FUNNEL_B(i);
		float Dk = DSKY_FUNNEL_DECAY(i);
		float Strength = abs(A.w);
		if (Strength <= 0.001 || A.z <= 0.0)
		{
			continue;
		}
		float R0 = A.z;
		float Spin = A.w < 0.0 ? -1.0 : 1.0;
		float Span = max(Base - B.y, 1000.0);
		float Hn = (Altitude - B.y) / Span;
		float H = saturate(Hn);
		float2 D = World.xy - DSky_FunnelAxis(A, B, Dk, Hn);
		float Dist = length(D);
		// (How near a cloud may be: the widest reach, wherever along its lean.)
		C.StormDistance = min(C.StormDistance, max(Dist - R0 * DSky_FunnelReach - length(B.zw), 0.0)
			+ max(Altitude - (Base + (DSky_FunnelTop - 1.0) * Span), 0.0) + max(B.y - Altitude, 0.0));
		float2 DW = World.xy - DSky_FunnelAxis(A, B, Dk, 1.0);
		if (Hn < -0.02 || Hn > DSky_FunnelTop || dot(DW, DW) > R0 * R0 * DSky_FunnelReach * DSky_FunnelReach)
		{
			continue;
		}
		// (The height over the base as lowered here: 1 on its underside.)
		float Hl = Hn + Lower / Span;
		float Forming = smoothstep(0.05, 0.35, Strength) * (1.0 - smoothstep(0.1, 0.6, Dk));
		// The base round it darkened, smoothly across and from its underside up into the cloud: the storm's rain-free base
		// some four times as wide as the wall cloud, the wall cloud more the lower it hangs, as dark as the base round it
		// where it meets it -- by where they are, not by the cloud's own billows (a dark cauliflower printed on the lighter
		// base), nor darker up there (seen from afar, the base in front cut a line across its top).
		float Across = length(DW) / (R0 * 3.2);
		// (A deck's underside may stand well over the layer's base: darkened up to twice its height.)
		float Up = 1.0 - smoothstep(1.5, 1.95, Hn);
		float BaseDark = 0.4 * (1.0 - smoothstep(0.3, 1.0, Across * 0.25)) * Forming;
		float WallDark = 0.6 * (1.0 - smoothstep(0.4, 1.6, Across)) * (1.0 - smoothstep(0.75, 1.0, Hn)) * Forming;
		float BaseTone = max(BaseDark, WallDark);
		FunnelOut = max(FunnelOut, BaseTone * Up);
		// The funnel, in a frame turning with it: its lobes and streaks twist with height.
		float Turn = Spin * B.x;
		float CosA = cos(-Turn - Spin * Hn * 2.5);
		float SinA = sin(-Turn - Spin * Hn * 2.5);
		float2 Q = float2(D.x * CosA - D.y * SinA, D.x * SinA + D.y * CosA) / R0;
		float Lobes = sin(3.0 * (atan2(D.y, D.x) - Turn) + Spin * Hn * 7.0);
		// (Flaring out into the wall cloud at its top, so it grows out of it with no corner.)
		float Flare = smoothstep(0.7, 1.05, Hl);
		// (A rope's barely: on its own, with no wall cloud round it, its flare stood a disc under the base.)
		float R = DSky_FunnelRadius(A, Dk, Hn) * (1.0 + 0.22 * Lobes * (1.0 - smoothstep(0.7, 0.9, Hl))
			+ Flare * Flare * (1.0 - 0.8 * DSky_FunnelRope(Dk)));
		float N = Noise.SampleLevel(NoiseSampler, float3(Q * 0.22, Hn * 0.18 + float(i) * 0.37), 0).r;
		// (By its own width where it is: a rope tens of metres across is as solid at its core as the wide top. Ending
		// just inside the base: on up, it stood through the cloud with a round top of its own.)
		float Funnel = (R - Dist) / max(R * 0.6, R0 * 0.05) * 0.25 + (N - 0.5) * 0.22 - max(Hl - 1.0, 0.0) * 5.0
			- 0.7 * DSky_FunnelBreak(Dk, Hn);
		// The dust at its foot once it touches down: low, wide, tumbling.
		float Down = smoothstep(0.85, 1.0, Strength) * (1.0 - smoothstep(0.2, 0.6, Dk));
		float ND = Noise.SampleLevel(NoiseSampler, float3(Q * 0.8, Hn * 1.5 + 0.29 + float(i) * 0.53), 0).b;
		float Rd = R0 * (1.0 + 0.6 * ND);
		float Ed = sqrt((Dist / Rd) * (Dist / Rd) + (max(Hn, 0.0) / 0.1) * (max(Hn, 0.0) / 0.1));
		float Dust = (1.0 - Ed) * 0.4 + (ND - 0.5) * 0.3 - (1.0 - Down) * 0.6;
		float Signed = DSky_SmoothMax(Funnel, Dust, 0.06);
		// (An upper bound whatever the noise: each shape at its noise's most, and the blend's bulge.)
		float Bound = max((R - Dist) / max(R * 0.6, R0 * 0.05) * 0.25 + 0.11, (1.0 - Ed) * 0.4 + 0.15) + 0.04;
		C.Conservative = max(C.Conservative, Bound);
		if (Signed > C.Signed)
		{
			float W = saturate(Signed * 8.0 + 0.5);
			C.Signed = Signed;
			C.Solid = max(C.Solid, saturate(Signed));
			// The streaks show in its density, denser and thinner bands up its wall, fading out as it widens into the base; its
			// flared top thins out softly to its edge, into the base lowered round it (by the column's own skin it was a dark
			// cap with an edge).
			float Streaks = lerp(0.55 + 0.9 * N, 1.0, smoothstep(0.6, 0.9, Hl));
			C.Density = max(C.Density, saturate(Signed * lerp(5.0, 1.2, Flare)) * (0.6 + 0.3 * Strength) * Streaks);
			C.Dark = max(C.Dark, 0.85 * W);
			C.Column = Span;
			// (Its top, flared into the wall cloud, at the base's height, lit as the base round it is: as a storm's lit top it
			// came out a pale bell under the darker base.)
			C.Height = H * (1.0 - Flare);
			C.Deck *= 1.0 - W;
			// (Its top as dark as the wall cloud it grows out of: darker, its top showed as a line along the base.)
			FunnelOut = max(FunnelOut, W * lerp(1.0, BaseTone, Flare));
		}
	}
}
#endif

// The density at a point (cm from the view) as the toon surface sees it: the shared clouds' distance turned into a
// ramp with the surface at one half. Detail (0..1) scales the fine fraying near the view. bNear: a sample within a few
// kilometres of a surface already found (its normal, its shadow), read the cheap way (DCS_ShapeNear: the weather and the
// storm cell taken from the surface's Anchor, no map reads, no search for storm cells).
FDSkyCloudSample DSky_CloudAt(float3 P, FDSkyCloudField F, bool bNear, FDCloudAnchor Anchor, float4 MapParams, Texture2D Map,
	SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler, float Detail)
{
	float3 World = F.Camera + P;
	// The altitude over the planet's curve: far clouds sink toward the horizon.
	float Z = World.z + dot(World.xy, World.xy) / (2.0 * DSky_PlanetRadius) - F.Base;
	// (The cloud base lowered round the funnels: the shape read that much higher.)
	float Lower = 0.0;
#ifdef DSKY_FUNNEL_A
	Lower = DSky_FunnelLower(World, F.Base, Noise, NoiseSampler);
#endif
	float3 Sunk = float3(0.0, 0.0, Lower);
	FDCloudShape C;
	if (bNear)
	{
		C = DCS_ShapeNear(World + Sunk, Z + Lower, Anchor, F.Cloud0, F.Cloud1, F.Cloud2, F.CloudLayer, MapParams, Map,
			MapSampler, Noise, NoiseSampler);
	}
	else
	{
		C = DCS_Shape(P + Sunk, World + Sunk, Z + Lower, F.Cloud0, F.Cloud1, F.Cloud2, F.CloudLayer, MapParams, Detail, Map,
			MapSampler, Noise, NoiseSampler);
	}
	float Funnel = 0.0;
#ifdef DSKY_FUNNEL_A
	DSky_Funnels(World, Z + F.Base, F.Base, Lower, Noise, NoiseSampler, C, Funnel);
#endif
	// The clearing round the sun and the moon: the shape eaten back from its edges (the thicker cores last) and the
	// volume thinned -- only ever less cloud, so the march's bounds hold.
	if (F.Thin > 0.0)
	{
		float Eaten = 0.22 * F.Thin;
		C.Solid = max(C.Solid - Eaten, 0.0);
		C.Signed -= Eaten;
		C.Density *= saturate(1.0 - 0.85 * F.Thin) * saturate(1.0 - Eaten * 2.0);
	}
	FDSkyCloudSample S;
	// (0.5 on the surface, 0 to 1 within a sixteenth of the shape either side of it.)
	S.Density = saturate(0.5 + (C.Solid - F.Iso) * 8.0);
	S.Solid = C.Solid;
	S.Signed = C.Signed;
	S.Form = C.Conservative;
	S.Dark = C.Dark;
	S.Column = C.Column;
	S.Height = C.Height;
	S.Deck = C.Deck;
	S.Z = Z;
	S.Anchor = C.Anchor;
	S.StormDistance = C.StormDistance;
	S.Volume = C.Density;
	S.Funnel = Funnel;
	return S;
}

// The corners of a tetrahedron around a point (the normal's four taps).
float3 DSky_Tetra(int Index)
{
	return float3((Index == 0 || Index == 3) ? 1.0 : -1.0, Index >= 2 ? 1.0 : -1.0, (Index & 1) == 1 ? 1.0 : -1.0);
}

// How far toward the light the shadow's samples lie (cm): 300 m, 1.2 km, 2.7 km, 4.8 km.
float DSky_ShadowAlong(int Index)
{
	return 30000.0 * float((Index + 1) * (Index + 1));
}

float DSky_Square(float X)
{
	return X * X;
}

// The noise level that fits a pattern Scale cm per texture unit seen T cm off (the texture is some 128 texels a side; a
// pixel some 0.0015 of the distance): mip 0 that far below its texels shimmers into moire.
float DSky_NoiseLod(float T, float Scale)
{
	return max(log2(T * 0.0015 * 128.0 / Scale), 0.0);
}

// How far below the surface's level the signed shape of a ray's closest approach may be and still cover some of the
// pixel (T cm along the ray): about a pixel's width at a cumulus's slope (0.1 of the shape per 300 m) -- the outline is
// soft over a pixel instead of stepping where the samples happen to fall.
float DSky_EdgeWidth(float T)
{
	return max(T * 5.0e-9, 5.0e-4);
}

// What a march found of the clouds' surface along a ray, and what the walk around it then reads (DSky_WalkSurface): the
// sky cloud renderer's toon march hands its hit over in this, and the surface is lit from it (DSky_PaintSurface).
// Phase: 1 refine between Lo and Hi, 2 search the closest approach, 3 the surface at SurfaceT, 7 done.
struct FDSkySurfaceWalk
{
	int Phase;
	int Index;
	float Lo;
	float Hi;
	float HitLo;
	float HitHi;
	bool bHitWaiting;
	float BestSigned;
	float BestT;
	float BestStep;
	FDCloudAnchor Anchor;
	float FirstProbe;
	float SurfaceT;
	float3 Surface;
	float E;
	FDSkyCloudSample Here;
	float3 GradSolid;
	float3 GradForm;
	float3 GradSigned;
	float3 N;
	float3 NForm;
	float Depth;
	float Travelled;
	float Sliver;
	float Behind;
	float Within;
	bool bHit;
	float GivenDepth;   // >= 0: how much cloud stands toward the light (Depth's measure), given: the walk does not look
};

// The toon march's second loop: refines the surface (phases 1 and 2), then reads around it (3 to 6: the surface, its
// normal, its shadow, how far the cloud goes on behind it), reading the field the cheap way, from W.Anchor.
void DSky_WalkSurface(inout FDSkySurfaceWalk W, float3 V, FDSkyCloudField F, float3 Ld, float Merging, float T0, float T1,
	float4 MapParams, Texture2D Map, SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler)
{
	int Phase = W.Phase;
	int Index = W.Index;
	float Lo = W.Lo;
	float Hi = W.Hi;
	float HitLo = W.HitLo;
	float HitHi = W.HitHi;
	bool bHitWaiting = W.bHitWaiting;
	float BestSigned = W.BestSigned;
	float BestT = W.BestT;
	float BestStep = W.BestStep;
	FDCloudAnchor Anchor = W.Anchor;
	float FirstProbe = W.FirstProbe;
	float SurfaceT = W.SurfaceT;
	float3 Surface = W.Surface;
	float E = W.E;
	FDSkyCloudSample Here = W.Here;
	float3 GradSolid = W.GradSolid;
	float3 GradForm = W.GradForm;
	float3 GradSigned = W.GradSigned;
	float3 N = W.N;
	float3 NForm = W.NForm;
	float Depth = W.Depth;
	float Travelled = W.Travelled;
	float Sliver = W.Sliver;
	float Behind = W.Behind;
	float Within = W.Within;
	bool bHit = W.bHit;
	// (As many as the longest way through takes -- refined, the closest approach searched, refined again, the normal, the
	// shadow and the two samples behind the surface: 27. With fewer, the rays that needed the most steps to find their
	// surface lost the last samples, in bands across the sky that followed how many each took.)
	[loop]
	for (int It2 = 0; It2 < 28 && Phase < 7; ++It2)
	{
		// Where to look.
		float3 P;
		if (Phase == 1)
		{
			P = V * (0.5 * (Lo + Hi));
		}
		else if (Phase == 2)
		{
			P = V * (Lo + (Hi - Lo) * ((Index & 1) == 0 ? 0.382 : 0.618));
		}
		else if (Phase == 3)
		{
			P = Surface;
		}
		else if (Phase == 4)
		{
			// The normal is read at the billows' scale: each billow lit as a whole.
			P = Surface + DSky_Tetra(Index) * E;
		}
		else if (Phase == 5)
		{
			P = Surface + N * 30000.0 + Ld * DSky_ShadowAlong(Index);
		}
		else
		{
			P = Surface + V * (max(30000.0, SurfaceT * 0.01) * float(1 + 2 * Index));
			// (Under merging cumulus, straight up from the surface to 250 and 500 m over the layer's base: how solid the
			// cloud is there goes by where it stands, not by the few metres the surface's refining is off by -- along
			// the ray, where it also goes by the height, those came out as fine diagonal stripes.)
			if (Here.Deck <= 0.05 && Here.Column <= 600000.0)
			{
				P = float3(Surface.xy, Surface.z + 25000.0 * float(1 + Index) - Here.Z);
			}
		}

		FDSkyCloudSample S = DSky_CloudAt(P, F, true, Anchor, MapParams, Map, MapSampler, Noise, NoiseSampler, 0.0);

		// What it says.
		float T = dot(P, V);
		bool bSurfaceFound = false;
		if (Phase == 1)
		{
			if (S.Solid >= F.Iso)
			{
				Hi = T;
			}
			else
			{
				Lo = T;
			}
			if (++Index >= 5)
			{
				bHit = true;
				SurfaceT = Hi;
				bSurfaceFound = true;
			}
		}
		else if (Phase == 2)
		{
			if (S.Signed > BestSigned)
			{
				BestSigned = S.Signed;
				BestT = T;
			}
			if ((Index & 1) == 0)
			{
				FirstProbe = S.Signed;
			}
			else if (FirstProbe > S.Signed)
			{
				Hi = Lo + (Hi - Lo) * 0.618;
			}
			else
			{
				Lo = Lo + (Hi - Lo) * 0.382;
			}
			if (++Index >= 6)
			{
				Index = 0;
				if (BestSigned >= F.Iso)
				{
					Lo = max(BestT - BestStep, T0);
					Hi = BestT;
					Phase = 1;
				}
				else if (bHitWaiting)
				{
					Lo = HitLo;
					Hi = HitHi;
					Phase = 1;
				}
				else if (BestSigned > F.Iso - DSky_EdgeWidth(BestT))
				{
					SurfaceT = BestT;
					bSurfaceFound = true;
				}
				else
				{
					Phase = 7;
				}
			}
		}
		else if (Phase == 3)
		{
			Here = S;
			// A deck's shape is solid a couple of hundred metres in from its surface, and its cells meet in sharp creases:
			// its normal is read from the signed shape, which goes on falling outside it, over a few hundred metres (the
			// solid shape's gradient there snapped to straight down; read close, it flipped across every crease, and a
			// storm's deck came out in hard dark arcs across the sky).
			E = lerp(E, max(25000.0, SurfaceT * 0.004), S.Deck);
			Phase = 4;
			Index = 0;
		}
		else if (Phase == 4)
		{
			// The gradient of the shape itself (not of the density's narrow ramp, which is flat a little off the
			// surface) and of the form before the billows: the cloud's mass, which keeps neighbouring billows' light
			// together.
			GradSolid += DSky_Tetra(Index) * S.Solid;
			GradForm += DSky_Tetra(Index) * S.Form;
			GradSigned += DSky_Tetra(Index) * S.Signed;
			if (++Index >= 4)
			{
				float3 Nb = dot(GradSolid, GradSolid) > 1.0e-12 ? -normalize(GradSolid) : -V;
				float3 Nm = dot(GradForm, GradForm) > 1.0e-12 ? -normalize(GradForm) : Nb;
				float3 Ns = dot(GradSigned, GradSigned) > 1.0e-12 ? -normalize(GradSigned) : Nm;
				Nb = normalize(lerp(Nb, Ns, Here.Deck));
				Nm = normalize(lerp(Nm, Ns, Here.Deck));
				// (Far off, where a cloud is small on screen and the march's steps are long, a ray grazing its tops finds its
				// surface on one billow or the next from row to row: lit by the billows' normal, far clouds came out in
				// horizontal streaks. There the cloud is lit by its signed shape's normal, which the wide taps far off read
				// smoothly: the form's, solid a few hundred metres in, snapped between a few directions and drew rings.)
				float Far = smoothstep(1000000.0, 4000000.0, SurfaceT);
				N = normalize(lerp(Nb * 0.55 + Nm * 0.45, Ns, Far) + 1.0e-4 * -V);
				NForm = normalize(lerp(Nm, Ns, Far) + 1.0e-4 * -V);
				// (A deck's underside takes its tones from its thickness and its lobes, and faces away from the light: no
				// shadow to look for there, the heaviest samples of a storm saved.)
				Phase = (Here.Deck > 0.95 && N.z < -0.3) ? 6 : 5;
				if (Phase == 5 && W.GivenDepth >= 0.0)
				{
					Depth = W.GivenDepth;
					Phase = (Here.Deck > 0.05 || Here.Column > 600000.0 || (Merging > 0.0 && N.z < -0.3)) ? 6 : 7;
				}
				Index = 0;
			}
		}
		else if (Phase == 5)
		{
			float Along = DSky_ShadowAlong(Index);
			Depth += S.Solid * (Along - Travelled);
			Travelled = Along;
			if (++Index >= 4)
			{
				// (And under the merging cumulus of a closing cover: how solid the cloud is just over its flat base tells
				// its thick parts from its thin ones, below.)
				Phase = (Here.Deck > 0.05 || Here.Column > 600000.0 || (Merging > 0.0 && N.z < -0.3)) ? 6 : 7;
				Index = 0;
			}
		}
		else
		{
			Sliver += 0.5 * smoothstep(F.Iso - 0.08, F.Iso + 0.08, S.Signed);
			Behind = Index == 0 ? S.Signed : Behind;
			Within = Index == 1 ? S.Signed : Within;
			if (++Index >= 2)
			{
				Phase = 7;
			}
		}
		if (bSurfaceFound)
		{
			Surface = V * SurfaceT;
			E = max(30000.0, SurfaceT * 0.006);
			Phase = 3;
			Index = 0;
		}
	}
	W.Phase = Phase;
	W.Index = Index;
	W.Lo = Lo;
	W.Hi = Hi;
	W.HitLo = HitLo;
	W.HitHi = HitHi;
	W.bHitWaiting = bHitWaiting;
	W.BestSigned = BestSigned;
	W.BestT = BestT;
	W.BestStep = BestStep;
	W.Anchor = Anchor;
	W.FirstProbe = FirstProbe;
	W.SurfaceT = SurfaceT;
	W.Surface = Surface;
	W.E = E;
	W.Here = Here;
	W.GradSolid = GradSolid;
	W.GradForm = GradForm;
	W.GradSigned = GradSigned;
	W.N = N;
	W.NForm = NForm;
	W.Depth = Depth;
	W.Travelled = Travelled;
	W.Sliver = Sliver;
	W.Behind = Behind;
	W.Within = Within;
	W.bHit = bHit;
}

// The toon look's tones (the style's ToonClouds): the sky cloud renderer defines these from its parameters before it
// includes this file; anywhere else they are the look's own defaults. TONE: the light on a billow to its tone (0 shade,
// 0.5 half, 1 lit); UNDER: an underside's glow to its tone (0 deepest, 0.5 shade, 1 half); HALF = (half tone tint, how far
// toward the lit), DEEP = (deepest underside, of the shade; the key's height pivot), KEY = (weights: facing the light,
// facing up, height; a storm's darkening of the lit side), KEY2 = (where the light starts, its ramp; rim power,
// strength), RIM = how tightly the rim glows toward the light behind. ADV0..6: the finer settings
// (FDreamSkyToonAdvanced): (cast depth cm, cast from, to, thin column cm), (ambient base, up, thin, height),
// (underside self-shade, warm from, to, toward the sun), (underside gaps, flanks, toward the sun, in a storm), (deck lit
// from, to, deck top from, to), (rim height from, to, storm top darkening, crack scale), (veil power, storm power, crack
// tear, -).
#ifndef DSKY_TOON_TONE
#define DSKY_TOON_TONE(Light) (0.5 * smoothstep(0.24, 0.28, Light) + 0.5 * smoothstep(0.56, 0.6, Light))
#define DSKY_TOON_UNDER(Glow) (0.5 * smoothstep(0.05, 0.35, Glow) + 0.5 * smoothstep(0.45, 0.8, Glow))
#define DSKY_TOON_HALF float4(0.96, 0.97, 1.03, 0.55)
#define DSKY_TOON_DEEP float4(0.62, 0.64, 0.7, 0.35)
#define DSKY_TOON_KEY float4(0.7, 0.45, 0.5, 0.55)
#define DSKY_TOON_KEY2 float4(-0.3, 0.6, 3.0, 2.0)
#define DSKY_TOON_RIM 4.0
#define DSKY_TOON_ADV0 float4(15000.0, 0.35, 0.65, 120000.0)
#define DSKY_TOON_ADV1 float4(0.94, 0.04, 0.12, 0.05)
#define DSKY_TOON_ADV2 float4(0.3, 0.03, 0.4, 0.3)
#define DSKY_TOON_ADV3 float4(0.45, 0.45, 0.3, 0.65)
#define DSKY_TOON_ADV4 float4(0.2, 0.7, 0.3, 0.7)
#define DSKY_TOON_ADV5 float4(0.1, 0.5, 0.3, 1.0)
#define DSKY_TOON_ADV6 float4(1.6, 1.4, 0.8, 0.0)
#endif
#ifndef DSKY_TOON_MOONHUE
#define DSKY_TOON_MOONHUE 0.4
#endif

// Paints the surface a walk found: the toon tones, the undersides, the silver lining, the veil of the air between, how
// see-through it is; returns the colour (premultiplied) and the cover, Core = how deep the cloud is (for the lightning).
float4 DSky_PaintSurface(FDSkySurfaceWalk W, float3 V, FDSkyCloudField F, float3 Ld, float Merging, float3 LightDir,
	float4 Cloud0, float4 Cloud1, float4 Cloud3, float4 CloudLayer, Texture3D Noise, SamplerState NoiseSampler, float3 Camera,
	float3 Tone, float3 Halo, float3 SkyBehind, float4 CloudLit, float4 CloudShadow, float4 Extra, float3 Sun, float4 LightColor,
	float SceneReach, float MaxDist, out float Core)
{
	int Phase = W.Phase;
	int Index = W.Index;
	float Lo = W.Lo;
	float Hi = W.Hi;
	float HitLo = W.HitLo;
	float HitHi = W.HitHi;
	bool bHitWaiting = W.bHitWaiting;
	float BestSigned = W.BestSigned;
	float BestT = W.BestT;
	float BestStep = W.BestStep;
	FDCloudAnchor Anchor = W.Anchor;
	float FirstProbe = W.FirstProbe;
	float SurfaceT = W.SurfaceT;
	float3 Surface = W.Surface;
	float E = W.E;
	FDSkyCloudSample Here = W.Here;
	float3 GradSolid = W.GradSolid;
	float3 GradForm = W.GradForm;
	float3 GradSigned = W.GradSigned;
	float3 N = W.N;
	float3 NForm = W.NForm;
	float Depth = W.Depth;
	float Travelled = W.Travelled;
	float Sliver = W.Sliver;
	float Behind = W.Behind;
	float Within = W.Within;
	bool bHit = W.bHit;
	Core = 0.0;
	float Cover = bHit ? 1.0 : smoothstep(F.Iso - DSky_EdgeWidth(SurfaceT), F.Iso, BestSigned);
	if (Cover <= 0.0 || SurfaceT <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	// Shaded where a whole cloud stands toward the light (some hundreds of metres of it), not where the light only
	// grazes a neighbouring billow: a cast shadow is a clean shape, or it breaks the tops into grey patches.
	float4 Adv0 = DSKY_TOON_ADV0;
	float4 Adv1 = DSKY_TOON_ADV1;
	float4 Adv2 = DSKY_TOON_ADV2;
	float4 Adv3 = DSKY_TOON_ADV3;
	float4 Adv4 = DSKY_TOON_ADV4;
	float4 Adv5 = DSKY_TOON_ADV5;
	float4 Adv6 = DSKY_TOON_ADV6;
	float Cast = smoothstep(Adv0.y, Adv0.z, 1.0 - exp(-Depth / Adv0.x));

	// Dusk and dawn. With the sun under the horizon a cloud is lit only while it stands above the earth's shadow: the
	// higher it stands and the further toward the sun, the longer. The clouds on the far side of the sky go dark first
	// (helped along a little: in a painting the night comes up from the side away from the sun). Moonlight, the main
	// light at night, does not fade so.
	float2 SunAcross = dot(Sun.xy, Sun.xy) > 1.0e-8 ? normalize(Sun.xy) : float2(1.0, 0.0);
	float SideToSun = dot(V.xy, V.xy) > 1.0e-6 ? dot(normalize(V.xy), SunAcross) : 0.0;
	float Altitude = max(F.Base + Here.Z, 0.0);
	float Reach = sqrt(2.0 * Altitude / DSky_PlanetRadius) + dot(V.xy, SunAcross) * SurfaceT / DSky_PlanetRadius + 0.012 * SideToSun;
	float SunLit = lerp(1.0 - smoothstep(Reach - 0.01, Reach + 0.01, asin(saturate(-Sun.z))), 1.0, LightColor.a);

	// Painted light, three tones the way anime clouds are coloured: near white where the sun falls, a pale
	// blue-lavender half tone (the sky mixed into white), the shade blue; each billow reads by its own normal. A
	// cumulus seen from the ground is painted white over its crown and dark under its base, its sides parting between
	// them: the tone goes by how a billow faces the sun, how much it faces up (the sky lights the tops, the cloud's own
	// shade its underside) and how high in the cloud it sits, and the tones part around where that crosses zero.
	float NdL = dot(N, Ld);
	float4 ToonKey = DSKY_TOON_KEY;
	float4 ToonKey2 = DSKY_TOON_KEY2;
	float4 ToonDeep = DSKY_TOON_DEEP;
	float4 ToonHalf = DSKY_TOON_HALF;
	float Key = ToonKey.x * NdL + ToonKey.y * N.z + ToonKey.z * (Here.Height - ToonDeep.w);
	float Light = saturate((Key - ToonKey2.x) / ToonKey2.y) * (1.0 - Cast) * SunLit;
	float Thin = exp(-Here.Column / Adv0.w);
	float Ambient = Adv1.x + Adv1.y * N.z + Adv1.z * Thin + Adv1.w * Here.Height;
	// The underside sits in the cloud's own shade and sees little of the sky: darker low in the cloud, the more so where
	// it faces down (a cumulus seen from the ground is dark under its base, not the sky's grey).
	float Under = 1.0 - Adv2.x * DSky_Square(1.0 - Here.Height) * (0.5 + 0.5 * saturate(-N.z));

	// Sunrise and sunset: the lit side takes the low sun's own colour (the main light's hue: peach going to orange as
	// it sinks), the more toward the side of the sky the sun is on.
	float Low = (1.0 - smoothstep(Adv2.y, Adv2.z, Sun.z)) * (1.0 - LightColor.a);
	float3 SunHue = LightColor.rgb / max(max(LightColor.r, max(LightColor.g, LightColor.b)), 1.0e-4);
	float Warmth = Low * ((1.0 - Adv2.w) + Adv2.w * saturate(SideToSun * 0.5 + 0.5));

	float3 Shadow = CloudShadow.rgb * lerp(1.0, Tone, Extra.x) * Ambient * Under;
	// (By moonlight the lit side is the shade lifted in the moon's hue, as the style's night colours have it: its lit
	// colour is the sun's, still a sunset pink while the moon has already taken over in the dusk.)
	// (Only part of the moonlight's hue: by moonlight the eye sees little colour, and the moonlight's full blue made the
	// toon clouds a glowing blue in the deep twilight.)
	float3 MoonHue = lerp(dot(SunHue, float3(0.2126, 0.7152, 0.0722)).xxx, SunHue, DSKY_TOON_MOONHUE);
	MoonHue /= max(max(MoonHue.r, max(MoonHue.g, MoonHue.b)), 1.0e-4);
	float3 LitColor = lerp(CloudLit.rgb * lerp(1.0, SunHue, Warmth), CloudShadow.rgb * 1.8 * MoonHue, LightColor.a);
	float3 Lit = LitColor * lerp(1.0, Tone, Extra.x * 0.2) + Halo * Extra.y * Light;
	float3 Half = lerp(Shadow, Lit, ToonHalf.w) * ToonHalf.rgb;
	float3 Color = Shadow;
	if (Cloud0.w < 1.0)
	{
		Color = lerp(Shadow, Lit, Light);
	}
	else
	{
		// (The ramp's tone: from the shade to the half tone over its first half, on to the lit tone over its second.)
		float Tone = DSKY_TOON_TONE(Light);
		Color = Tone < 0.5 ? lerp(Shadow, Half, 2.0 * Tone) : lerp(Half, Lit, 2.0 * Tone - 1.0);
	}
	// Undersides, painted soft: from below the lobes of a deck, the base of a cumulus, the underside of a storm's anvil
	// and its mammatus read by their shapes, not as one shade: dark where the cloud is thick over them, light where it
	// is thin, their flanks lighter than their bottoms (they see the sky round them) and the side toward the sun lighter
	// still -- from a deep shade through the shade to the half tone. An underside varies only gently, so each of these
	// is read across the range it spans, not an absolute one: how thick the cloud is here between a deck's thinnest gaps
	// and thickest cells (some 80 m to 1.2 km; a storm's deck 2 to 3 km throughout, its cells still parting from its gaps,
	// the storm darkening all of it below), how far a lobe's flank turns from straight down, and how far it turns toward
	// the sun.
	float Deep = smoothstep(0.15, 0.6, Here.Dark);
	float Thickest = lerp(120000.0, 300000.0, Deep);
	float Thinnest = lerp(8000.0, 190000.0, Deep);
	float Gap = saturate((Thickest - Here.Column) / (Thickest - Thinnest));
	// (Read from the normal of the cloud's mass: by the billows' normal the backlit body of a big cumulus came out
	// spattered with specks of the underside's tones.) Where the ray only clips a cumulonimbus's anvil, near its thinning
	// rim (only its underside, high in the cloud and facing down), it is lighter, and see-through further on (below): the
	// anvil's underside feathers out instead of ending in a hard arc across the sky.
	float Anvil = smoothstep(500000.0, 900000.0, Here.Column) * smoothstep(0.55, 0.75, Here.Height) * smoothstep(-0.2, -0.5, NForm.z);
	float Flank = smoothstep(0.05, 0.4, 1.0 + NForm.z);
	// The merging cumulus of a closing cover are one flat base from below, as thick as their type everywhere: there the
	// thin is where the cloud is weak over the base (how solid it is some way in), lighter in patches -- the
	// stratocumulus' thick and thin cells -- not one flat grey. (Laid on the tone after the steps below: put into their
	// input, it lifted the underside onto a step's slope, where any slight unevenness is sharpened.)
	float Weak = Merging * (1.0 - Here.Deck) * (1.0 - smoothstep(F.Iso, 0.6, Within));
	// (A storm's underside is heavy: its lightest is well short of the half tone.)
	float Glow = saturate((Adv3.x * Gap + Adv3.y * Flank + Adv3.z * saturate((dot(NForm, Ld) + 0.45) / 0.6) * SunLit) * lerp(1.0, Adv3.w, Deep)
		+ 0.5 * (1.0 - Sliver) * Anvil);
	float UnderTone = DSKY_TOON_UNDER(Glow);
	float3 Underside = UnderTone < 0.5 ? lerp(Shadow * ToonDeep.rgb, Shadow, 2.0 * UnderTone) : lerp(Shadow, Half, 2.0 * UnderTone - 1.0);
	Underside = lerp(Underside, max(Underside, Shadow), Weak);
	Color = lerp(Color, Underside, smoothstep(-0.25, -0.65, NForm.z) * (1.0 - smoothstep(0.35, 0.6, Light)));
	// A deck is painted soft, the way an overcast is in anime backgrounds: no bands. Its upper side, seen from above, is
	// a sea of cloud in the sun, from the half tone to the lit white -- only from above: from below, the walls of a hole
	// in it are its underside's tones, not a lit white rim.
	float FromAbove = smoothstep(-20000.0, 20000.0, -V.z * SurfaceT);
	float3 DeckOver = lerp(Half, Lit, smoothstep(Adv4.x, Adv4.y, Light));
	Color = lerp(Color, lerp(Underside, DeckOver, smoothstep(Adv4.z, Adv4.w, Here.Height) * FromAbove), Here.Deck);
	// Silver lining: edges turned from the view, with the light behind them; grazed edges glow the most. Only on
	// the upper sides (the lobes of an underside face away from the light), and not round a hole in a deck.
	float Rim = pow(1.0 - saturate(abs(dot(N, V))), ToonKey2.z) * smoothstep(Adv5.x, Adv5.y, Here.Height) * SunLit * (1.0 - Here.Deck);
	Color += CloudLit.rgb * CloudLit.a * Rim * pow(saturate(dot(V, LightDir)), DSKY_TOON_RIM) * ToonKey2.w;
	// Storm clouds are dark below; their lit tops much less so.
	Color *= saturate(1.0 - CloudLayer.z * Here.Dark * lerp(ToonKey.w, 1.0, 1.0 - Light) * lerp(1.0, Adv5.z, Here.Height));
	// A funnel, its wall cloud and its dust: the underside's dark tones, the side toward the light a little lighter, the
	// foot darkest.
	Color = lerp(Color, Shadow * ToonDeep.rgb * lerp(0.72, 1.0, saturate(Light)) * lerp(0.85, 1.0, saturate(Here.Height)), Here.Funnel);
	// The air between: far clouds sink into the sky's colour, their bases (in the hazy low air) before their tops. Painted,
	// the near ones keep their tones (a base a few kilometres overhead stays dark, not the sky's grey) and the haze closes
	// in with distance: the veil eases in, the more slowly under a storm (its low dark base looms through the rain).
	float Veil = DCS_AirVeil(SurfaceT, V.z, Camera.z, Cloud0.x, Cloud3);
	Color = lerp(Color, SkyBehind, pow(Veil, Adv6.x + Adv6.y * Deep) * (1.0 - 0.8 * Here.Funnel));
	// Where the ray only clips a thin sliver of a deck (its thin gaps, the specks a breaking deck leaves) or of an anvil
	// (its thinning rim) it is see-through: the specks fade instead of sparkling, an anvil's edge thins out. Round a crack
	// in a deck (the ray goes into a deck there, not thin, and straight out into the crack) the deck tears instead, the
	// way a painted overcast's cracks are drawn: holes open in it, hard-edged and ragged, the more and the larger the
	// further it has thinned toward the crack (how far the deck goes on behind its surface), until it is open; between
	// them pieces of the deck, as see-through as the deck round them. (Drawn whole up to the edge of where it thins, a
	// crack's outline was a contour of the deck's smooth rifts: a long straight edge cut into the soft deck. The edge is
	// torn too: the thinning is read through a noise of its own, so the first holes do not all open along one line.) The
	// pieces drift with the clouds.
	float SeeThrough = lerp(0.3, 1.0, Sliver);
	float Keep = SeeThrough;
	float Lip = smoothstep(12000.0, 18000.0, Here.Column) * Here.Deck;
	if (Lip > 0.0 && Sliver < 0.5)
	{
		float3 Q = float3(Camera.xy + Surface.xy + Cloud1.xy * 220000.0 * max(Cloud0.z, 0.05), Here.Z);
		float CrackScale = Adv5.w;
		float Big = Noise.SampleLevel(NoiseSampler, Q / (300000.0 * CrackScale) + float3(0.17, 0.61, 0.29), DSky_NoiseLod(SurfaceT, 300000.0 * CrackScale)).g;
		float Mid = Noise.SampleLevel(NoiseSampler, Q / (110000.0 * CrackScale) + float3(0.53, 0.07, 0.83), DSky_NoiseLod(SurfaceT, 110000.0 * CrackScale)).r;
		float Fine = Noise.SampleLevel(NoiseSampler, Q / (40000.0 * CrackScale) + float3(0.91, 0.37, 0.13), DSky_NoiseLod(SurfaceT, 40000.0 * CrackScale)).g;
		float Ragged = saturate((0.45 * Big + 0.35 * Mid + 0.2 * Fine - 0.3) / 0.4);
		// (Ragged: which pieces hold longest; Tear: where the deck reads as more or less thinned than it is.)
		float Tear = Noise.SampleLevel(NoiseSampler, Q / (70000.0 * CrackScale) + float3(0.29, 0.83, 0.47), DSky_NoiseLod(SurfaceT, 70000.0 * CrackScale)).g;
		float Thinned = F.Iso - Behind + Adv6.z * (Tear - 0.5);
		float Open = 0.5 * saturate(Thinned / 0.4) + 0.5 * saturate((Thinned - 0.4) / 0.6);
		float Piece = smoothstep(Ragged - 0.03, Ragged + 0.03, 1.05 - 1.1 * Open);
		Keep = lerp(SeeThrough, 0.65 * Piece, Lip);
	}
	// (Not in a storm's deck, which is closed: a ray grazing the bottom of one of its rolls into the trough under it read
	// as a crack's lip and showed specks of blue sky.)
	Cover *= lerp(1.0, Keep, max(Here.Deck * (1.0 - Deep), Anvil));
	Cover *= 1.0 - smoothstep(0.85 * MaxDist, MaxDist, SurfaceT);
	// (A cloud just in front of the ground fades into it over the last few hundred metres, instead of a hard line where
	// they cross.)
	Cover *= saturate((SceneReach - SurfaceT) / max(0.05 * SceneReach, 20000.0));
	Core = Cover * saturate(Here.Column / 300000.0) * (1.0 - Veil);
	return float4(Color * Cover, Cover);
}

// High cloud: thin cirrus veils on a layer far above the cumulus (Cloud3.w cm up), lying along the wind and drifting
// faster than the cumulus, in patches over Cloud3.z of the sky, gone under a closing overcast. The dome draws them
// under either kind of cumulus (they are higher than any). Returns the colour (premultiplied) and the cover.
float4 DSky_HighClouds(float3 V, float4 Cloud0, float4 Cloud1, float4 Cloud3, float3 Camera, float3 SkyBehind, float4 CloudLit,
	float3 Halo, Texture3D Noise, SamplerState NoiseSampler)
{
	float Amount = saturate(Cloud3.z) * (1.0 - smoothstep(0.7, 0.95, Cloud0.x));
	if (Amount <= 0.0 || V.z <= 0.01)
	{
		return float4(0, 0, 0, 0);
	}
	float T = DSky_AltitudeT(Camera, V, max(Cloud3.w, 100000.0));
	float2 Wind = dot(Cloud1.xy, Cloud1.xy) > 1.0e-8 ? normalize(Cloud1.xy) : float2(1.0, 0.0);
	float2 W = Camera.xy + V.xy * T + Cloud1.xy * 220000.0 * max(Cloud0.z, 0.05) * 1.6;
	float2 Q = float2(dot(W, Wind), dot(W, float2(-Wind.y, Wind.x)));   // along the wind, across it
	// Where the patches are (large, slow), and a gentle bend of the streaks over tens of kilometres.
	float Patch = Noise.SampleLevel(NoiseSampler, float3(Q / 6000000.0, 0.71), 0).r;
	float Bend = Noise.SampleLevel(NoiseSampler, float3(Q / 6000000.0, 0.23), 0).r - 0.5;
	// The veils: the smooth noise drawn out two-and-a-half to one along the wind, some 6 km wide, bent gently and broken
	// into sheets, most of it (thin streaks ran together toward one point of the horizon like combed hair, and only the
	// strongest of a four-to-one noise was thin arcs: overhead, scratches radiating across the sky); fine fibres run along
	// them, fainter still. Thin gauze, not lines. (Explicit levels, the coarser the further: the sky material is also
	// built for ray tracing hits, which have no screen derivatives, and the finest level far below its texels shimmers.)
	float2 S = float2(Q.x / 1600000.0, (Q.y + Bend * 300000.0) / 640000.0);
	float Body = Noise.SampleLevel(NoiseSampler, float3(S, 0.53), DSky_NoiseLod(T, 640000.0)).r;
	float Fibres = Noise.SampleLevel(NoiseSampler, float3(Q.x / 800000.0 + 0.37, Q.y / 60000.0, 0.11), DSky_NoiseLod(T, 60000.0)).r;
	float Along = Noise.SampleLevel(NoiseSampler, float3(Q.x / 2500000.0, Q.y / 1200000.0, 0.87), DSky_NoiseLod(T, 1200000.0)).r;
	float Fibre = smoothstep(0.4, 0.8, Body) * lerp(0.85, 1.0, Fibres) * smoothstep(0.35, 0.7, Along);
	float Mask = saturate((Patch - (1.0 - Amount)) * 2.0);
	float Alpha = Fibre * Mask * 0.3 * smoothstep(0.02, 0.15, V.z);
	// Thin ice: white in the sun and brightest toward it (it scatters forward), letting the sky through; far off,
	// veiled like any cloud.
	float3 Color = lerp(SkyBehind, CloudLit.rgb * 0.9 + Halo * 1.5, 0.75);
	Color = lerp(Color, SkyBehind, DCS_AirVeil(T, V.z, Camera.z, Cloud0.x, Cloud3));
	return float4(Color * Alpha, Alpha);
}

// How much the clouds along V thin round the sun and the moon: Clearing = (the strength by the sun, by the moon, the
// radius in degrees, the falloff's exponent), each light's strength times exp(-(angle / radius)^exponent).
float DSky_Clearing(float3 V, float3 Sun, float3 Moon, float4 Clearing)
{
	if (Clearing.x <= 0.0 && Clearing.y <= 0.0)
	{
		return 0.0;
	}
	float Radius = radians(max(Clearing.z, 1.0));
	float ToSun = acos(clamp(dot(V, Sun), -1.0, 1.0)) / Radius;
	float ToMoon = acos(clamp(dot(V, Moon), -1.0, 1.0)) / Radius;
	float Exponent = max(Clearing.w, 0.5);
	return saturate(max(Clearing.x * exp(-pow(ToSun, Exponent)), Clearing.y * exp(-pow(ToMoon, Exponent))));
}

// The Bessel function J1 (the corona's diffraction): its series near the middle, its far form beyond.
float DSky_BesselJ1(float X)
{
	X = abs(X);
	if (X > 9.0)
	{
		return sqrt(2.0 / (3.14159265 * X)) * cos(X - 2.35619449);
	}
	float H = 0.5 * X;
	float Term = H;
	float Sum = H;
	[unroll]
	for (int k = 1; k < 14; ++k)
	{
		Term *= -H * H / (float(k) * float(k + 1));
		Sum += Term;
	}
	return Sum;
}

// The ice halos and the corona round the light (LightDir: the sun by day, the moon by night), in the high cloud's light
// (Lit): Halo = the 22 degree ring's brightness, the sun dogs', the corona's (each as far as the high cloud makes them),
// the sheet's milkiness; Halo2 = the ring's radius, its width, the corona's first red ring, the moon's drawn radius
// (degrees). Veil: the high
// cloud's cover here (the halos are brightest in its veils). The ring has a sharp red inner edge, its colours running
// out to a whitish fade; the dogs stand either side at the light's height, red toward it with a white tail outward,
// moving out as it climbs; the corona's rings (the moon's, in thin cloud) are the droplets' diffraction.
float3 DSky_Halos(float3 V, float3 LightDir, float3 Moon, float3 Lit, float4 Halo, float4 Halo2, float Veil, float Closing)
{
	float Shows = (1.0 - Closing) * smoothstep(-0.03, 0.02, LightDir.z);
	if (Shows <= 0.0 || dot(Halo.xyz, float3(1, 1, 1)) <= 0.0)
	{
		return float3(0, 0, 0);
	}
	const float3 Dispersion = float3(-0.35, 0.0, 0.45);   // (red, green, blue: the inner edge red)
	const float3 Index = float3(1.307, 1.311, 1.317);
	float Angle = degrees(acos(clamp(dot(V, LightDir), -1.0, 1.0)));
	float3 Light = float3(0, 0, 0);
	// The 22 degree ring.
	if (Halo.x > 0.0)
	{
		float3 Edge = Halo2.x + Dispersion;
		float3 Ring = smoothstep(Edge - 0.3, Edge + 0.15, Angle) * exp(-max(Angle - Edge, 0.0) / Halo2.y);
		Light += Halo.x * Ring * lerp(0.55, 1.0, Veil);
	}
	// The sun dogs, at the light's height, either side.
	float H = asin(clamp(LightDir.z, -1.0, 1.0));
	if (Halo.y > 0.0 && H < radians(60.0) && dot(V.xy, V.xy) > 1.0e-6 && dot(LightDir.xy, LightDir.xy) > 1.0e-6)
	{
		float Up = degrees(asin(clamp(V.z, -1.0, 1.0)) - H);
		float Around = degrees(acos(clamp(dot(normalize(V.xy), normalize(LightDir.xy)), -1.0, 1.0)));
		float3 Effective = sqrt(max(Index * Index - sin(H) * sin(H), 0.0)) / cos(H);
		float3 Offset = degrees(2.0 * asin(saturate(Effective * 0.5))) - 60.0;
		float3 X = Around - Offset;   // (negative toward the light)
		float3 Dog = exp(-Up * Up / (2.0 * 0.9 * 0.9)) * lerp(exp(-X * X / (2.0 * 0.35 * 0.35)), exp(-X / 1.2) * 0.85 + 0.15 * exp(-X / 4.0), step(0.0, X));
		Light += Halo.y * Dog * (1.0 - smoothstep(radians(40.0), radians(58.0), H)) * lerp(0.6, 1.0, Veil);
	}
	// (By the moon's light the eye sees little colour: the night's halo and dogs mostly white; the corona, bright by the
	// moon, keeps its colours.)
	bool bMoon = dot(LightDir, Moon) > 0.9999;
	if (bMoon)
	{
		Light = lerp(Light, dot(Light, float3(0.2126, 0.7152, 0.0722)), 0.6);
	}
	// The moon's corona.
	if (Halo.z > 0.0 && bMoon)
	{
		const float3 Wavelength = float3(0.65, 0.55, 0.45);
		// (Its first ring at least two and a half times the drawn moon's radius: a moon drawn larger than the real one
		// would hide the real corona's rings.)
		float FirstRing = max(Halo2.z, 2.5 * Halo2.w);
		float3 X = 5.14 * Angle / (FirstRing * Wavelength / Wavelength.r);
		float3 Airy = float3(DSky_BesselJ1(X.r), DSky_BesselJ1(X.g), DSky_BesselJ1(X.b));
		float3 Amplitude = abs(2.0 * Airy / max(X, 1.0e-3));
		// (Drops of many sizes blur the rings and soften the glow's peak: the amplitude to the 0.7, not its square, fading
		// out by the third ring.)
		Light += Halo.z * pow(Amplitude, 0.7) * exp(-Angle / (1.5 * FirstRing)) * lerp(0.5, 1.0, Veil);
	}
	return Light * Lit * Shows;
}

// Meteors and satellites (real-time Seconds). M: sporadic and shower meteors an hour, the head's brightness, satellites
// an hour; Radiant: xyz the shower's radiant, w the satellites' brightness; Look: rgb the meteors' colour, a their
// trails' length. Each second may hold a few meteors, each a short-lived streak along a great circle: the shower's
// leading away from the radiant, a sporadic one from anywhere; brightest at its head, its trail fading behind it,
// flaring and dying out. A satellite crosses on a great circle some 550 km up in five minutes or so, as bright as the
// sun lights it there (the earth's shadow takes it partway across). Pixel: the pixel's footprint, radians.
float3 DSky_MeteorKey(float Slot, float Index, float Salt)
{
	return DSky_Hash33(float3(fmod(Slot, 997.0) + 0.37 * Index, floor(Slot / 997.0) + 13.1 * Salt, 7.3 * Index + 3.1 * Salt));
}

float3 DSky_Meteors(float3 V, float3 Sun, float3 Camera, float4 M, float4 Radiant, float4 Look, float Seconds, float Pixel)
{
	float3 Light = float3(0, 0, 0);
	if (V.z <= -0.02)
	{
		return Light;
	}
	float Width = max(Pixel, radians(0.035));
	// Meteors: four chances a second, the seconds now and before (none lasts longer).
	float PerSecond = (M.x + M.y) / 3600.0;
	if (PerSecond > 0.0 && M.z > 0.0)
	{
		const int Chances = 4;
		float Chance = saturate(PerSecond / float(Chances));
		float Now = floor(Seconds);
		[unroll]
		for (int s = 0; s < 2; ++s)
		{
			float Slot = Now - float(s);
			[unroll]
			for (int j = 0; j < Chances; ++j)
			{
				float3 H0 = DSky_MeteorKey(Slot, float(j), 1.0);
				if (H0.x >= Chance)
				{
					continue;
				}
				float3 H1 = DSky_MeteorKey(Slot, float(j), 2.0);
				float3 H2 = DSky_MeteorKey(Slot, float(j), 3.0);
				float Duration = 0.25 + 0.75 * H1.x;
				float Age = Seconds - (Slot + H0.y);
				if (Age < 0.0 || Age > Duration)
				{
					continue;
				}
				// (Where it is first seen: anywhere well above the horizon.)
				float Z = lerp(0.12, 0.95, H1.y);
				float Around = 6.2831853 * H1.z;
				float3 Start = float3(sqrt(1.0 - Z * Z) * float2(cos(Around), sin(Around)), Z);
				bool bShower = H0.z < M.y / max(M.x + M.y, 1.0e-6);
				float3 From = bShower ? normalize(Radiant.xyz) : normalize(H2 - 0.5);
				float3 Axis = cross(From, Start);
				if (dot(Axis, Axis) < 1.0e-6)
				{
					continue;
				}
				Axis = normalize(Axis);
				float3 Onward = cross(Axis, Start);   // (away from where it comes from)
				float Length = radians(lerp(5.0, 25.0, H2.z)) * Look.a * (bShower ? 1.0 : 0.6);
				float Life = Age / Duration;
				float Head = Length * Life;
				float Tail = min(Head, 0.4 * Length);
				float Off = asin(clamp(dot(V, Axis), -1.0, 1.0));
				float At = atan2(dot(V, Onward), dot(V, Start));
				float Behind = Head - At;   // (0 at the head, growing back along the trail)
				float Along = Behind < 0.0 ? exp(-DSky_Square(Behind / Width)) : (Behind <= Tail ? 1.0 - 0.85 * Behind / max(Tail, 1.0e-4) : exp(-DSky_Square((Behind - Tail) / Width)) * 0.15);
				float Across = exp(-DSky_Square(Off / Width));
				float Flare = sin(3.14159265 * Life) * (0.6 + 0.4 * sin(31.0 * Age + 6.0 * H2.x)) * lerp(0.4, 1.0, H1.x);
				Light += Look.rgb * (M.z * Across * Along * Flare);
			}
		}
	}
	// Satellites: two chances a minute, each crossing for some five minutes; the minutes now and the five before.
	if (M.w > 0.0 && Radiant.w > 0.0)
	{
		float Chance = saturate(M.w / 60.0 / 2.0);
		float Minute = floor(Seconds / 60.0);
		float Planet = DSky_PlanetRadius * 1.0e-5;
		float3 Eye = float3(0.0, 0.0, Planet + max(Camera.z, 0.0) * 1.0e-5);
		[unroll]
		for (int s = 0; s < 6; ++s)
		{
			[unroll]
			for (int j = 0; j < 2; ++j)
			{
				float Slot = Minute - float(s);
				float3 H0 = DSky_MeteorKey(Slot, float(j), 5.0);
				if (H0.x >= Chance)
				{
					continue;
				}
				float3 H1 = DSky_MeteorKey(Slot, float(j), 6.0);
				float Duration = 240.0 + 120.0 * H1.x;
				float Age = Seconds - (Slot + H0.y) * 60.0;
				if (Age < 0.0 || Age > Duration)
				{
					continue;
				}
				// (Its track: a great circle over the sky, horizon to horizon, highest at H1.y of the way to the zenith.)
				float Peak = lerp(0.15, 1.0, H1.y);
				float Heading = 6.2831853 * H1.z;
				float3 Across = float3(cos(Heading), sin(Heading), 0.0);
				float3 Top = normalize(float3(-Across.y, Across.x, 0.0) * sqrt(1.0 - Peak * Peak) + float3(0.0, 0.0, Peak));
				float Angle = 3.14159265 * (Age / Duration - 0.5);
				float3 D = normalize(Top * cos(Angle) + Across * sin(Angle));
				if (D.z <= 0.0)
				{
					continue;
				}
				// (Lit while the sun's ray to it, 550 km up along D, clears the earth and its lower air.)
				float Shell = Planet + 550.0;
				float B = dot(Eye, D);
				float3 P = Eye + D * (-B + sqrt(max(B * B - dot(Eye, Eye) + Shell * Shell, 0.0)));
				float AlongSun = dot(P, Sun);
				float Closest = AlongSun >= 0.0 ? length(P) : length(P - AlongSun * Sun);
				float Lit = smoothstep(Planet + 10.0, Planet + 60.0, Closest);
				float Spot = exp(-DSky_Square(acos(clamp(dot(V, D), -1.0, 1.0)) / (0.8 * Width)));
				Light += float3(1.0, 0.97, 0.92) * (Radiant.w * Lit * Spot * lerp(0.3, 1.0, H1.y) * smoothstep(0.0, 0.08, D.z));
			}
		}
	}
	return Light;
}

// Noctilucent clouds: a thin shell N.y km up, seen where the sun still lights it (its ray to them passing more than
// some 15 km over the ground: the air below screens it), in bands N.z km apart, broken and wavering, with billows
// NC.a km across them, drifting N.w km/s; silver-blue (NC.rgb) as bright as N.x (the dome's measure, already times how
// present they are and how far the twilight lets them show), brightest toward the sun (they scatter forward), denser
// toward the horizon (the shell seen edge on), dimmed by the low air.
float3 DSky_Noctilucent(float3 V, float3 Sun, float3 Camera, float4 N, float4 NC, float Seconds, Texture3D Noise, SamplerState NoiseSampler)
{
	if (N.x <= 0.0 || V.z <= 0.005)
	{
		return float3(0, 0, 0);
	}
	float Planet = DSky_PlanetRadius * 1.0e-5;   // km
	float3 Eye = float3(0.0, 0.0, Planet + max(Camera.z, 0.0) * 1.0e-5);
	float Shell = Planet + N.y;
	float B = dot(Eye, V);
	float T = -B + sqrt(max(B * B - dot(Eye, Eye) + Shell * Shell, 0.0));
	float3 P = Eye + V * T;
	// (Lit while the sun's ray to them clears the screening air.)
	float Along = dot(P, Sun);
	float Closest = Along >= 0.0 ? length(P) : length(P - Along * Sun);
	float Lit = smoothstep(Planet + 10.0, Planet + 22.0, Closest);
	if (Lit <= 0.0)
	{
		return float3(0, 0, 0);
	}
	float2 Q = P.xy + Camera.xy * 1.0e-5;
	// (The bands lie across a slow direction of their own; they drift along it.)
	float2 Across = normalize(float2(0.83, 0.56));
	float2 AlongBands = float2(-Across.y, Across.x);
	Q += Across * (Seconds * N.w);
	float Cover = smoothstep(0.38, 0.72, Noise.SampleLevel(NoiseSampler, float3(Q / 900.0, 0.31), 0).r);
	float Bend = Noise.SampleLevel(NoiseSampler, float3(Q / 260.0, 0.77), 0).r - 0.5;
	float Bands = 0.5 + 0.5 * sin(6.2831853 * (dot(Q, Across) / N.z + 0.5 * Bend));
	float Break = Noise.SampleLevel(NoiseSampler, float3(Q / 120.0, 0.13), 0).r;
	float Billows = 0.5 + 0.5 * sin(6.2831853 * (dot(Q, AlongBands) / NC.a + 2.0 * Break));
	float Pattern = Cover * (0.3 + 0.7 * Bands * sqrt(Bands)) * lerp(0.65, 1.0, Billows) * smoothstep(0.1, 0.5, Break + 0.3);
	// (Edge on toward the horizon the thin shell is seen through more of itself; the low air dims and reddens it a little.)
	float Grazing = sqrt(max(1.0 - dot(Eye, Eye) / (Shell * Shell) * (1.0 - V.z * V.z), 0.0));
	float Path = 1.0 / max(Grazing, 0.12);
	float3 Air = exp(-float3(0.05, 0.08, 0.14) / max(V.z, 0.03));
	float Toward = 0.35 + 0.65 * DSky_Square(saturate(0.5 + 0.5 * dot(V, Sun)));
	return NC.rgb * Air * (N.x * Lit * Pattern * Path * Toward);
}

// The earth's shadow and the Belt of Venus over the style's gradient (Share: how much of the sky is the gradient; the
// physical sky has its own): after sunset, away from the sun, the gradient is tinted blue-grey (Shadow.rgb) up to
// Shadow.a times the sun's depression and pink (Belt.rgb) in a band over it, as strongly as Belt.a; from the sun's
// setting to some 9 degrees under, broad across the sky away from it.
float3 DSky_EarthShadow(float3 V, float3 Sun, float3 Sky, float4 Shadow, float4 Belt, float Share)
{
	float Down = -Sun.z;
	float Shows = smoothstep(0.0, 0.02, Down) * (1.0 - smoothstep(0.1, 0.16, Down)) * Belt.a * Share;
	if (Shows <= 0.0 || dot(V.xy, V.xy) < 1.0e-6 || dot(Sun.xy, Sun.xy) < 1.0e-6)
	{
		return Sky;
	}
	float Away = saturate(-dot(normalize(V.xy), normalize(Sun.xy)));
	float Spread = Away * sqrt(Away) * Shows;
	float Top = Shadow.a * Down;
	float Under = 1.0 - smoothstep(0.8 * Top, 1.15 * Top, V.z);
	float Width = 0.6 * Top + 0.03;
	float Band = exp(-DSky_Square((V.z - 1.3 * Top) / Width)) * smoothstep(-0.01, 0.0, V.z);
	Sky *= lerp(float3(1, 1, 1), Shadow.rgb, Under * Spread);
	return Sky * lerp(float3(1, 1, 1), Belt.rgb, Band * (1.0 - Under) * Spread);
}

// The flat clouds (DreamSkyFlatClouds.ush) seen from below: a sheet at the cloud base, thin edges lit through and the
// thick middles in the style's shade, the side toward the light brighter (the cloud a little denser away from it), dark
// where the weather is (a storm), in the style's tones when it asks (FlatClouds.y); veiled by the air far off like any
// cloud. Returns the colour (premultiplied) and the cover.
float4 DSky_FlatClouds(float3 V, float3 Camera, float3 LightDir, float4 Cloud0, float4 Cloud1, float4 Cloud3, float4 CloudLayer,
	float4 MapParams, float4 FlatClouds, float4 CloudLit, float4 CloudShadow, float3 SkyBehind, float3 Halo, float Thin, Texture2D Map,
	SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler)
{
	if (FlatClouds.x <= 0.0 || V.z <= 0.003 || Camera.z >= CloudLayer.x)
	{
		return float4(0, 0, 0, 0);
	}
	float T = DSky_AltitudeT(Camera, V, CloudLayer.x);
	float2 W = Camera.xy + V.xy * T;
	float Lod = DSky_NoiseLod(T, 95000.0);
	float2 Here = DFC_Cover(W, Cloud0, Cloud1, CloudLayer, MapParams, FlatClouds, Map, MapSampler, Noise, NoiseSampler, Lod);
	// (Thinned round the sun and the moon: eaten back from the edges, the rest fainter.)
	Here.x = saturate((Here.x - 0.35 * Thin) / (1.0 - 0.35 * Thin)) * (1.0 - 0.5 * Thin);
	if (Here.x <= 0.001)
	{
		return float4(0, 0, 0, 0);
	}
	float2 Toward = dot(LightDir.xy, LightDir.xy) > 1.0e-6 ? normalize(LightDir.xy) : float2(1.0, 0.0);
	float Ahead = DFC_Cover(W + Toward * 60000.0, Cloud0, Cloud1, CloudLayer, MapParams, FlatClouds, Map, MapSampler, Noise, NoiseSampler, Lod + 1.0).x;
	float Thick = saturate(1.25 * Here.x - 0.2 + 0.6 * (Ahead - Here.x));
	if (FlatClouds.y >= 2.0)
	{
		// (In flat tones, their edges a little soft.)
		float Steps = FlatClouds.y - 1.0;
		float Scaled = Thick * Steps;
		Thick = (floor(Scaled) + smoothstep(0.42, 0.58, frac(Scaled))) / Steps;
	}
	float3 Shade = CloudShadow.rgb * lerp(1.0, 0.45, Here.y);
	float3 Color = lerp(CloudLit.rgb, Shade, Thick);
	// (Their thin edges glow round the light, as the sky about it does.)
	Color += Halo * (1.5 * (1.0 - Here.x));
	float Alpha = Here.x * FlatClouds.x * smoothstep(0.003, 0.03, V.z);
	Color = lerp(Color, SkyBehind, DCS_AirVeil(T, V.z, Camera.z, Cloud0.x, Cloud3));
	return float4(Color * Alpha, Alpha);
}

// Rain hanging under distant clouds: grey curtains from the cloud base down into the horizon, wherever the weather
// map has rain under a closed cover some way off along V (looked for from 8 to 45 km; the nearest raining one hangs
// its curtain). Broad curtains in azimuth, finely streaked, thinning as they fall and veiled by the air like
// the clouds. The dome draws them, behind any cloud.
float4 DSky_RainShafts(float3 V, float3 Camera, float4 Cloud0, float4 CloudLayer, float4 Cloud3, float4 MapParams,
	Texture2D Map, SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler, float3 SkyBehind, float3 Shade)
{
	if (V.z > 0.15 || V.z < -0.02 || dot(V.xy, V.xy) < 1.0e-6)
	{
		return float4(0, 0, 0, 0);
	}
	float2 Dir = normalize(V.xy);
	float3 ViewWeather = DCS_ViewWeather(Cloud0, CloudLayer);
	float Rain = 0.0;
	float Distance = 0.0;
	const float Probes[6] = { 800000.0, 1400000.0, 2000000.0, 2700000.0, 3500000.0, 4500000.0 };
	[unroll]
	for (int i = 0; i < 6; ++i)
	{
		float D = Probes[i];
		float3 W = DCS_MapAt(Camera.xy + Dir * D, ViewWeather, MapParams, Map, MapSampler);
		float Here = saturate(W.z) * smoothstep(0.6, 0.9, W.x);
		if (Distance <= 0.0 && Here > 0.15)
		{
			Rain = Here;
			Distance = D;
		}
	}
	if (Rain <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	// The cloud base's elevation that far off (over the planet's curve); the curtain hangs from it to the horizon.
	float BaseUp = (CloudLayer.x - Camera.z - Distance * Distance / (2.0 * DSky_PlanetRadius)) / Distance;
	if (V.z > BaseUp)
	{
		return float4(0, 0, 0, 0);
	}
	float Fall = saturate((BaseUp - V.z) / max(BaseUp + 0.01, 0.005));
	float Curtain = smoothstep(0.35, 0.65, Noise.SampleLevel(NoiseSampler, float3(Dir * 1.3, 0.61), 0).r);
	float Streak = Noise.SampleLevel(NoiseSampler, float3(Dir * 14.0, 0.29 + Fall * 0.12), 0).r;
	// (It sets in just under the base: within a fifth of the base's own height above the horizon, however far off.)
	float Alpha = Rain * Curtain * lerp(0.55, 1.0, Streak) * (1.0 - 0.6 * Fall)
		* smoothstep(0.0, 0.2 * max(BaseUp, 0.0) + 0.002, BaseUp - V.z) * 0.75;
	float Veil = DCS_AirVeil(Distance, max(V.z, 0.0) + 0.03, Camera.z, Cloud0.x, Cloud3);
	// Rain darkens the air it falls through: the curtains keep more of their grey through the haze than a cloud does.
	float3 Color = lerp(Shade * 0.6, SkyBehind, 0.15 + 0.45 * Veil);
	return float4(Color * Alpha, Alpha);
}

// The physical sky along V (DreamAtmosphere's sky table: per unit of a light's illuminance outside the air, for any light):
// the sun's and the moon's, each read for its own direction and times its light (AtmosphereSun / Moon rgb), the table's
// values times AtmosphereSun.w (1 for the GPU's table, 1 / its scale for one baked ahead for mobile).
float3 DSky_PhysicalSky(float3 V, float3 Sun, float3 Moon, float4 AtmosphereSun, float4 AtmosphereMoon, Texture3D SkyTable,
	SamplerState SkyTableSampler)
{
	float3 Size;
	SkyTable.GetDimensions(Size.x, Size.y, Size.z);
	float3 L = float3(0.0, 0.0, 0.0);
	for (int i = 0; i < 2; ++i)
	{
		float3 Light = i == 0 ? Sun : Moon;
		float3 Strength = i == 0 ? AtmosphereSun.rgb : AtmosphereMoon.rgb;
		if (dot(Strength, float3(1.0, 1.0, 1.0)) <= 0.0)
		{
			continue;
		}
		float Lengths = length(V.xy) * length(Light.xy);
		float CosAround = Lengths > 1.0e-6 ? dot(V.xy, Light.xy) / Lengths : 1.0;
		float3 P = DSA_SkyUvw(V.z, CosAround, Light.z);
		float3 Uvw = float3(DSA_TableTexcoord(P.x, Size.x), DSA_TableTexcoord(P.y, Size.y), DSA_TableTexcoord(P.z, Size.z));
		L += SkyTable.SampleLevel(SkyTableSampler, Uvw, 0).rgb * Strength;
	}
	return L * AtmosphereSun.w;
}

// The sky's own colour along V, before the bodies, the stars and the clouds -- the same for the dome and the sky cloud
// renderer (the air between its clouds), so the two match to the pixel. Everything comes in as arguments (no shared
// parameters, no material parameters read here):
//   the physical sky: DreamAtmosphere's sky table (UDreamAtmosphereSubsystem::GetSkyTexture) and its sampler, lit by the
//     sun and the moon outside the air (AtmosphereSun / Moon rgb = DDW_AtmosphereSun / Moon; AtmosphereSun.w the table's
//     decode, above 0 while there is one), through the style's grade (SkyGrade0..3 = DDW_SkyGrade0..3, DSG_Grade);
//   the style's gradient (Zenith, Horizon, Ground, SunHalo = DDW_SkyZenith, _SkyHorizon, _SkyGround, _SunHalo), as far as
//     the grade's GradientBlend (SkyGrade2.w) says, and all of it without the table.
// Out: Halo, the gradient's glow round the sun, already scaled by the gradient's share (add it, or leave it out); and
// GradientShare, how much of the gradient shows (the dome scales its own painted extras by it: the moon's halo, the
// afterglow, the colour given back through an overcast's holes -- the physical sky has its own).
float3 DSky_SkyBackdrop(float3 V, float3 Sun, float3 Moon, float4 Zenith, float4 Horizon, float4 Ground, float4 SunHalo,
	float4 SkyGrade0, float4 SkyGrade1, float4 SkyGrade2, float4 SkyGrade3, float4 AtmosphereSun, float4 AtmosphereMoon,
	Texture3D SkyTable, SamplerState SkyTableSampler, out float3 Halo, out float GradientShare)
{
	float3 Gradient = DSky_Backdrop(V, Sun, Zenith, Horizon, Ground, SunHalo, Halo);
	GradientShare = AtmosphereSun.w > 0.0 ? saturate(SkyGrade2.w) : 1.0;
	float3 Base = Gradient;
	if (GradientShare < 1.0)
	{
		float3 Physical = DSky_PhysicalSky(V, Sun, Moon, AtmosphereSun, AtmosphereMoon, SkyTable, SkyTableSampler);
		Base = lerp(DSG_Grade(Physical, V.z, SkyGrade0, SkyGrade1, SkyGrade2, SkyGrade3), Gradient, GradientShare);
	}
	Halo *= GradientShare;
	return Base;
}

// Extra = (cloud sky tint, cloud sun glow, share of the sun disk the sky light capture sees, flash gain).
// Haze = (height fog colour, how much of the dome weather fog hides).
// Aurora, AuroraLow, AuroraHigh: see DSky_Aurora. NightGlow, LightPollution: see DSky_NightGlow. Eclipse: see
// DSky_Eclipse; LunarEclipse: see DSky_Moon.
// Cloud0 = (cover, -, scale, tones), Cloud1 = (wind drift, -, -), Cloud2 = (-, zenith thinning, -, fair-weather towers),
// Cloud3 = (visibility, cm; haze height, cm; high cloud cover; high cloud altitude, cm).
// Capture is 1 while the dome is drawn into the sky light (reflection capture pass), 0 on screen.
float3 DSky_Shade(float3 V, float4 SunDir, float4 MoonDir, float4 Time, float4 Zenith, float4 Horizon, float4 Ground,
	float4 SunHalo, float4 SunDisk, float4 MoonDisk, float4 MoonHalo, float4 Stars, float4 Cloud0, float4 Cloud1,
	float4 Cloud2, float4 Cloud3, float4 CloudLit, float4 CloudShadow, float4 MainLight, float4 MainLightColor, float4 CloudLayer,
	float4 MapParams, float4 Flash, float4 Extra, float4 Haze, float4 Aurora, float4 AuroraLow, float4 AuroraHigh, float4 NightGlow,
	float4 LightPollution, float4 Eclipse, float4 LunarEclipse, float4 Halo4, float4 Halo2, float4 EarthShadow, float4 EarthBelt, float4 Noctilucent, float4 NoctilucentColor, float4 Meteors, float4 MeteorRadiant, float4 MeteorLook, float4 FlatClouds, float4 CloudClearing,
	Texture2D WeatherMap, SamplerState WeatherMapSampler, Texture3D Noise, SamplerState NoiseSampler, Texture2D Panorama,
	SamplerState PanoramaSampler, float4 AuroraTones, float4 AuroraShape, float4 AuroraShape2, float4 AuroraShape3, float4 MoonLook, float4 StarLook, float4 StarPole, float4 StarEquinox, Texture2D StarMap, float4 MilkyWay,
	float4 MilkyWayDust, Texture2D Galaxy, SamplerState GalaxySampler, Texture2D MoonFace, SamplerState MoonFaceSampler, float3 Camera,
	float2 ScreenUV, float Seconds, float Capture,
	float4 SkyGrade0, float4 SkyGrade1, float4 SkyGrade2, float4 SkyGrade3, float4 AtmosphereSun, float4 AtmosphereMoon,
	Texture3D SkyTable, SamplerState SkyTableSampler)
{
	V = normalize(V);
	float3 Sun = normalize(SunDir.xyz);
	float3 Moon = normalize(MoonDir.xyz);
	float3 LightDir = normalize(MainLight.xyz);

	// The sky's own colour (DSky_SkyBackdrop: the physical sky through the grade, or the style's gradient as far as it says).
	float3 Halo;
	float GradientShare;
	float3 Base = DSky_SkyBackdrop(V, Sun, Moon, Zenith, Horizon, Ground, SunHalo, SkyGrade0, SkyGrade1, SkyGrade2, SkyGrade3,
		AtmosphereSun, AtmosphereMoon, SkyTable, SkyTableSampler, Halo, GradientShare);
	float3 Sky = Base + Halo;
	Sky += MoonHalo.rgb * pow(saturate(dot(V, Moon)), max(MoonHalo.a, 1.0)) * GradientShare;
	// The afterglow: once the sun is down the sky over where it set keeps a warm band along the horizon for a while (the
	// style's halo is gone by 6 degrees under), rose going to violet as the sun sinks, gone by some 12 degrees under.
	float Dusk = smoothstep(-0.21, -0.03, Sun.z) * (1.0 - smoothstep(-0.03, 0.03, Sun.z));
	if (Dusk > 0.0 && dot(V.xy, V.xy) > 1.0e-6 && dot(Sun.xy, Sun.xy) > 1.0e-6)
	{
		float Side = saturate(dot(normalize(V.xy), normalize(Sun.xy)) * 0.5 + 0.5);
		float Band = exp(-max(V.z, 0.0) * 7.0) * smoothstep(-0.03, 0.0, V.z);
		float3 Afterglow = lerp(float3(0.16, 0.06, 0.13), float3(0.55, 0.24, 0.12), smoothstep(-0.15, -0.03, Sun.z));
		Sky += Afterglow * Dusk * Side * Side * Side * Band * GradientShare;
	}
	Sky = DSky_EarthShadow(V, Sun, Sky, EarthShadow, EarthBelt, GradientShare);
	// Through the holes of an overcast the sky shows its own colour: the style greys the whole sky as the cover closes
	// (by then it is mostly seen through the cloud), and a hole would show that grey; there it is given its blue back.
	float Closing = smoothstep(0.7, 0.95, Cloud0.x) * GradientShare;
	float SkyGrey = dot(Sky, float3(0.2126, 0.7152, 0.0722));
	Sky = max(SkyGrey + (Sky - SkyGrey) * (1.0 + 1.5 * Closing), 0.0);

	// The cumulus: the sky cloud renderer draws them into the view after the base pass, which the sky light capture never
	// sees; there the dome shows the panorama of them it draws round the view (CloudLayer.w = 1 while it draws them; with
	// no clouds drawn there is no panorama to show, or an empty or stale one).
	float3 Mean = max(0.5 * (Zenith.rgb + Horizon.rgb), 1.0e-4);
	float CloudCore = 0.0;
	float4 VC = float4(0, 0, 0, 0);
	if (CloudLayer.w > 0.5 && Capture > 0.5)
	{
		VC = Panorama.SampleLevel(PanoramaSampler, DSky_PanoramaUV(V), 0) * DSky_PanoramaShare(V);
	}
	float4 High = DSky_HighClouds(V, Cloud0, Cloud1, Cloud3, Camera, Base + Halo, CloudLit, Halo, Noise, NoiseSampler);
	// (The clouds clearing round the sun and the moon: the high cloud fainter there.)
	float Thin = DSky_Clearing(V, Sun, Moon, CloudClearing);
	High *= 1.0 - 0.85 * Thin;
	float4 Shafts = DSky_RainShafts(V, Camera, Cloud0, CloudLayer, Cloud3, MapParams, WeatherMap, WeatherMapSampler, Noise,
		NoiseSampler, Base + Halo, CloudShadow.rgb);
	// The flat clouds, where the renderer does not draw (CloudLayer.w = 0).
	float4 Flat = float4(0, 0, 0, 0);
	if (CloudLayer.w < 0.5 && FlatClouds.x > 0.0)
	{
		Flat = DSky_FlatClouds(V, Camera, LightDir, Cloud0, Cloud1, Cloud3, CloudLayer, MapParams, FlatClouds, CloudLit, CloudShadow,
			Base + Halo, Halo, Thin, WeatherMap, WeatherMapSampler, Noise, NoiseSampler);
	}
	float Clear = (1.0 - VC.a) * (1.0 - 0.6 * High.a) * (1.0 - Flat.a);

	float3 MoonColor = DSky_Moon(V, Moon, Sun, MoonDir.w, MoonDisk.a, MoonDisk.rgb, LunarEclipse, MoonLook, MoonFace, MoonFaceSampler,
		StarPole.xyz);
	float MoonCover = saturate(dot(MoonColor, float3(1, 1, 1)) * 4.0);
	// The sky light sees no stars, and only a share of the sun disk (a full disk makes a hot spot in the
	// captured light that every rough surface would reflect).
	if (Capture < 0.5 && Stars.x > 0.0)
	{
		float3 StarLight = StarPole.w > 0.5 ? DSky_CatalogueStars(V, StarPole, StarEquinox, StarMap, Stars.z, Seconds, Stars.w, StarLook)
			: DSky_Stars(V, Time.z, Stars.y, Stars.z, Seconds, Stars.w, StarLook);
		Sky += Stars.x * StarLight * (1.0 - MoonCover) * Clear;
	}
	if (Capture < 0.5 && any(MilkyWay.rgb > 0.0))
	{
		Sky += DSky_MilkyWay(V, StarPole, StarEquinox, Galaxy, GalaxySampler, MilkyWay, MilkyWayDust) * (1.0 - MoonCover) * Clear;
	}
	// Meteors and satellites, in front of the stars, behind the clouds (the sky light sees none).
	if (Capture < 0.5 && (Meteors.x + Meteors.y + Meteors.w) > 0.0)
	{
		Sky += DSky_Meteors(V, Sun, Camera, Meteors, MeteorRadiant, MeteorLook, Seconds, max(length(fwidth(V)), 1.0e-5)) * Clear;
	}
	Sky = lerp(Sky, MoonColor, MoonCover * Clear);
	float SunShare = lerp(1.0, Extra.z, Capture);
	// (In an eclipse the moon's disk masks the sun's; the corona shows round it at totality.)
	float3 Corona;
	float SunShows = DSky_Eclipse(V, Sun, SunDisk.a, Eclipse, SunDisk.rgb, Corona);
	Sky += SunDisk.rgb * DSky_Disk(V, Sun, SunDisk.a) * smoothstep(-0.02, 0.0, V.z) * Clear * Clear * Clear * Clear * SunShare * SunShows;
	Sky += Corona * Clear * (1.0 - Capture);
	// The aurora, in front of the stars and the moon, behind the high cloud (it lights the sky light a little too).
	Sky += DSky_Aurora(V, Aurora, AuroraLow, AuroraHigh, AuroraTones, AuroraShape, AuroraShape2, AuroraShape3, Seconds, Noise, NoiseSampler, ScreenUV);
	// The night's own glow (more of it through the longer air low down) and a city's light climbing from the horizon.
	Sky += DSky_NightGlow(V, NightGlow, LightPollution);
	// Noctilucent clouds in the deep twilight, far above everything else, behind the high cloud.
	Sky += DSky_Noctilucent(V, Sun, Camera, Noctilucent, NoctilucentColor, Seconds, Noise, NoiseSampler);
	// The ice halos in a sheet of high cloud, the corona in thin cloud round the moon: the sheet milks the sky a little,
	// the halos are in its light (behind the high cloud's veils, which they brighten).
	if (any(Halo4 > 0.0))
	{
		float Closing = smoothstep(0.7, 0.95, Cloud0.x);
		float Veil = saturate(High.a / 0.2);
		Sky = lerp(Sky, CloudLit.rgb * 0.85, Halo4.w * (1.0 - Closing) * smoothstep(0.0, 0.12, V.z));
		Sky += DSky_Halos(V, LightDir, Moon, CloudLit.rgb, Halo4, Halo2, Veil, Closing);
	}

	Sky = Sky * (1.0 - High.a) + High.rgb;
	Sky = Sky * (1.0 - Shafts.a) + Shafts.rgb;
	Sky = Sky * (1.0 - Flat.a) + Flat.rgb;
	Sky = Sky * (1.0 - VC.a) + VC.rgb;

	// Weather fog and dust hide the sky in the height fog's colour, from the horizon up: the fogged ground then
	// meets the dome without a seam. Light fog hazes the horizon; thick fog swallows most of the sky.
	if (Haze.a > 0.0)
	{
		float Amount = Haze.a * lerp(exp(-saturate(V.z) * 8.0), 1.0, Haze.a * Haze.a);
		// (Under a storm the dark base overhead shows through the rain's haze: a storm reads by its low dark cloud.)
		Amount *= 1.0 - 0.5 * VC.a * smoothstep(0.2, 0.6, CloudLayer.y) * saturate(V.z * 4.0);
		Sky = lerp(Sky, Haze.rgb, saturate(Amount));
	}

	// Lightning: the clouds over the strike light up, the rest of the sky a little. Not in the sky light: the
	// capture is sliced over several frames, and the flash already reaches the ambient light directly.
	float FlashNow = Flash.w * Extra.w * (1.0 - Capture);
	if (FlashNow > 0.0)
	{
		float Toward = pow(saturate(dot(V, normalize(Flash.xyz))), 3.0);
		// Against a night sky a flash tuned for daylight whites out everything: it is held back with the sky's
		// own brightness (still many times the night sky), and lights cloud cores more than edges, so the clouds
		// keep their shapes; a storm tower glows from inside.
		float SkyLevel = dot(Mean, float3(0.2126, 0.7152, 0.0722));
		float Level = saturate(0.3 + SkyLevel * 3.0);
		float Body = lerp(0.6, 1.4, saturate(CloudCore));
		float Cloudy = max(VC.a, Flat.a);
		Sky += float3(0.75, 0.8, 1.0) * FlashNow * Level * (0.15 + 0.85 * Toward) * (0.3 + 1.7 * Cloudy) * Body;
	}
	return max(Sky, 0.0);
}

#endif // DREAMSKY_STYLIZED_USH
