// Copyright DreamMoon. All Rights Reserved.
//
// The stylized sky dome: a gradient sky, the sun with its halo, the moon with its phase, stars, thin high cloud
// and (unless the engine's volumetric clouds draw them) the cumulus: the clouds of DreamSkyCloudShape.ush, marched
// to their surface and painted the way anime backgrounds paint them, each lobe lit on its own in a few tones, the
// air between veiling the far ones in the sky's colour. Everything comes in as the vectors the sky subsystem writes
// to the shared parameter collection (see DreamSkyModule.h for the layout); this file only draws.
//
// Directions are world space unit vectors: V from the camera through the pixel, SunDir / MoonDir / LightDir
// from the ground toward the body.

#ifndef DREAMSKY_STYLIZED_USH
#define DREAMSKY_STYLIZED_USH

#include "/Plugin/DreamDynamicWorld/Private/DreamSkyCloudShape.ush"

float DSky_Hash12(float2 p)
{
	float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return frac((p3.x + p3.y) * p3.z);
}

float3 DSky_Hash33(float3 p)
{
	p = frac(p * float3(0.1031, 0.1030, 0.0973));
	p += dot(p, p.yxz + 33.33);
	return frac((p.xxy + p.yxx) * p.zyx);
}

float DSky_ValueNoise(float2 p)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float2 u = f * f * (3.0 - 2.0 * f);
	float a = DSky_Hash12(i);
	float b = DSky_Hash12(i + float2(1.0, 0.0));
	float c = DSky_Hash12(i + float2(0.0, 1.0));
	float d = DSky_Hash12(i + float2(1.0, 1.0));
	return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float3 DSky_Gradient(float3 V, float3 Zenith, float3 Horizon, float HorizonExp, float3 Ground)
{
	float Up = pow(saturate(V.z), max(HorizonExp, 0.05));
	float3 Sky = lerp(Horizon, Zenith, Up);
	float3 Below = lerp(Horizon, Ground, saturate(-V.z * 6.0));
	return lerp(Below, Sky, smoothstep(-0.01, 0.01, V.z));
}

// How close V is to the sun, 0..1, with vertical distance counted up to three times over while the sun is low:
// the glow spreads along the horizon instead of climbing the sky.
float DSky_SunCloseness(float3 V, float3 SunDir)
{
	float Stretch = 1.0 + 2.0 * (1.0 - saturate(-SunDir.z)) * lerp(1.0, 0.25, saturate(SunDir.z * 1.5));
	float3 W = normalize(float3(V.xy, (V.z - SunDir.z) * Stretch + SunDir.z));
	return saturate(dot(W, SunDir));
}

// The halo around the sun, plus a broad glow along the horizon on the sun's side (sunrise / sunset).
float3 DSky_SunHalo(float3 V, float3 SunDir, float3 HaloColor, float HaloExp)
{
	float Halo = pow(DSky_SunCloseness(V, SunDir), max(HaloExp, 1.0));
	float2 Vh = V.xy;
	float2 Sh = SunDir.xy;
	float Side = (length(Vh) > 1e-4 && length(Sh) > 1e-4) ? dot(normalize(Vh), normalize(Sh)) * 0.5 + 0.5 : 0.5;
	float NearHorizon = 1.0 - saturate(abs(V.z) * 3.0);
	return HaloColor * (Halo + 0.35 * pow(Side, 3.0) * NearHorizon);
}

// The sky's own colour along V, before the bodies, the stars and the clouds: the gradient (while the sun is low,
// the warm horizon belongs to its side and the far side cools toward the sky above it), and the sun's halo apart.
float3 DSky_Backdrop(float3 V, float3 Sun, float4 Zenith, float4 Horizon, float4 Ground, float4 SunHalo, out float3 Halo)
{
	float2 Vh = V.xy;
	float2 Sh = Sun.xy;
	float SunSide = (length(Vh) > 1e-4 && length(Sh) > 1e-4) ? dot(normalize(Vh), normalize(Sh)) * 0.5 + 0.5 : 0.5;
	float LowSun = 1.0 - saturate(abs(Sun.z) * 4.0);
	float3 HorizonHere = lerp(Horizon.rgb, 0.5 * (Horizon.rgb + Zenith.rgb), 0.75 * LowSun * (1.0 - SunSide) * (1.0 - SunSide));
	Halo = DSky_SunHalo(V, Sun, SunHalo.rgb, SunHalo.a);
	return DSky_Gradient(V, Zenith.rgb, HorizonHere, Horizon.a, Ground.rgb);
}

// A disk of angular radius RadiusDeg, anti-aliased over one pixel.
float DSky_Disk(float3 V, float3 Dir, float RadiusDeg)
{
	float c = dot(V, Dir);
	float Edge = cos(radians(max(RadiusDeg, 0.01)));
	float Aa = max(fwidth(c), 1e-6);
	return smoothstep(Edge - Aa, Edge + Aa, c);
}

// The moon as a lit sphere: Phase 0 new (dark), 0.5 full; the terminator is a hard toon edge.
float3 DSky_Moon(float3 V, float3 MoonDir, float3 SunDir, float Phase, float RadiusDeg, float3 Color)
{
	float Facing = dot(V, MoonDir);
	if (Facing <= 0.0)
	{
		return 0;
	}
	float SinR = sin(radians(max(RadiusDeg, 0.01)));
	float3 Up = abs(MoonDir.z) < 0.99 ? float3(0, 0, 1) : float3(1, 0, 0);
	float3 X = normalize(cross(Up, MoonDir));
	float3 Y = cross(MoonDir, X);
	float3 D = V - MoonDir * Facing;
	float2 UV = float2(dot(D, X), dot(D, Y)) / SinR;
	float R2 = dot(UV, UV);
	float Aa = max(fwidth(R2), 1e-5);
	float Inside = 1.0 - smoothstep(1.0 - Aa, 1.0 + Aa, R2);
	if (Inside <= 0.0)
	{
		return 0;
	}
	float3 N = float3(UV, sqrt(saturate(1.0 - R2)));
	float2 Toward = float2(dot(SunDir, X), dot(SunDir, Y));
	float Len = length(Toward);
	Toward = Len > 1e-3 ? Toward / Len : float2(1, 0);
	float A = Phase * 6.2831853;
	float3 L = float3(Toward * sin(A), -cos(A));
	float Lit = smoothstep(-0.04, 0.04, dot(N, L));
	float Mare = DSky_ValueNoise(UV * 3.0 + 11.0) * 0.3 + 0.7;
	return Color * Inside * lerp(0.05, 1.0, Lit) * Mare;
}

// Points on a jittered 3D lattice the dome cuts through; Rotation turns them about the vertical (0..1 = a turn).
float DSky_Stars(float3 V, float Rotation, float Density, float Twinkle, float Seconds)
{
	if (V.z <= 0.0 || Density <= 0.0)
	{
		return 0.0;
	}
	float A = Rotation * 6.2831853;
	float3 P = float3(V.x * cos(A) - V.y * sin(A), V.x * sin(A) + V.y * cos(A), V.z);
	float3 G = P * 70.0;
	float3 Cell = floor(G);
	float3 F = frac(G);
	float3 R = DSky_Hash33(Cell);
	float Present = step(1.0 - 0.12 * Density, R.x);
	float Dist = length(F - (0.25 + 0.5 * R.zxy));
	float Size = lerp(0.03, 0.09, R.y);
	// The pixel's footprint in lattice units, from the lattice coordinate itself, which runs on smoothly (the distance
	// to a cell's star jumps where a pixel's neighbour lies in the next cell: its screen derivative there smeared the
	// stars along the cells' faces into dashes, arcs and rings). A star is never drawn smaller than some 0.7 pixel
	// across its radius, dimmed for what it was enlarged, so it does not break up as it falls between pixels.
	float Pixel = max(0.5 * length(fwidth(G)), 1e-4);
	float Radius = max(Size, 0.7 * Pixel);
	float Point = (1.0 - smoothstep(Radius - 0.5 * Pixel, Radius + 0.5 * Pixel, Dist)) * (Size / Radius);
	float Flicker = 1.0 - Twinkle * 0.5 * (1.0 + sin(Seconds * (1.5 + 3.0 * R.z) + R.y * 40.0));
	return Present * Point * lerp(0.35, 1.0, R.z) * Flicker * saturate(V.z * 5.0);
}

// ---------------------------------------------------------------------------------------------------------------
// Volumetric clouds, toon: the cloud layer (shaped in DreamSkyCloudShape.ush, the same clouds the engine's
// volumetric layer draws) ray marched to its surface, which is then lit once, by its normal and its own shadow
// toward the main light, and banded into the style's few tones: volumes with a painted look.

// The cloud field for one frame, as the toon march sees it.
struct FDSkyCloudField
{
	float3 Camera;     // the view in the world (cm): the shapes are anchored in the world, not to the view
	float Base;        // altitude of the cloud layer's base (cm)
	float Iso;         // the level of the clouds' solid shape (0..1) the toon surface is drawn at
	float4 Cloud0;
	float4 Cloud1;
	float4 Cloud2;
	float4 CloudLayer;
};

// What the field holds at a point besides its density.
struct FDSkyCloudSample
{
	float Density;      // 0..1, the surface at one half
	float Solid;        // 0..1, the clouds' solid shape: the surface is where it reaches the field's Iso
	float Signed;       // the shape before it is clamped: Solid inside, below 0 outside and the lower the further out
	float Form;         // the shape before the billows eat into it: >= Solid, so below Iso no cloud can be here
	float Dark;         // storm darkness here
	float Column;       // cm: how tall the cloud type standing here is
	float Height;       // 0 base .. 1 top, where the point sits in that column
	float Deck;         // 1: the point belongs to the deck
	float Z;            // cm above the layer's base
	FDCloudAnchor Anchor; // what samples near this one may take from it (DCS_ShapeNear)
};

// The planet the cloud layer curves over (the engine's cloud layer uses the same without a sky atmosphere).
static const float DSky_PlanetRadius = 636000000.0;

// How far along V (from the view) the ray reaches an altitude A above the ground, over the planet's curve (the
// layer is centred under the world's origin, as the engine's is); 0 if the view is already at or above it.
float DSky_AltitudeT(float3 Camera, float3 V, float A)
{
	float a = dot(V.xy, V.xy) / (2.0 * DSky_PlanetRadius);
	float b = V.z + dot(Camera.xy, V.xy) / DSky_PlanetRadius;
	float c = Camera.z + dot(Camera.xy, Camera.xy) / (2.0 * DSky_PlanetRadius) - A;
	if (c >= 0.0)
	{
		return 0.0;
	}
	// The positive root, in the form that keeps its precision (a is tiny).
	return -2.0 * c / (b + sqrt(max(b * b - 4.0 * a * c, 0.0)));
}

// Where along V the ray's altitude (h + b t + a t^2: over the planet's curve it falls to its lowest, then rises) is A:
// T1 <= T2; false if it never is. In the form that keeps its precision (a is tiny; a nearly vertical ray gets one root
// where its altitude line crosses A and one far off).
bool DSky_AltitudeRoots(float a, float b, float h, float A, out float T1, out float T2)
{
	float c = h - A;
	float D = b * b - 4.0 * a * c;
	T1 = 0.0;
	T2 = 0.0;
	if (D < 0.0)
	{
		return false;
	}
	float q = -0.5 * (b + (b >= 0.0 ? 1.0 : -1.0) * sqrt(D));
	float R1 = q / a;
	float R2 = abs(q) > 1.0e-20 ? c / q : R1;
	T1 = min(R1, R2);
	T2 = max(R1, R2);
	return true;
}

// The stretch along V (from the view) inside the layer between altitudes Lo and Hi above the ground, over the planet's
// curve, within MaxT: [T0, T1], empty if T1 <= T0. From below the ray enters at Lo, from inside it starts at the view,
// from above it enters at Hi; looking down it ends at Lo (nothing stands below the layer's base).
void DSky_LayerSpan(float3 Camera, float3 V, float Lo, float Hi, float MaxT, out float T0, out float T1)
{
	float a = max(dot(V.xy, V.xy) / (2.0 * DSky_PlanetRadius), 1.0e-12);
	float b = V.z + dot(Camera.xy, V.xy) / DSky_PlanetRadius;
	float h = Camera.z + dot(Camera.xy, Camera.xy) / (2.0 * DSky_PlanetRadius);
	T0 = 0.0;
	T1 = 0.0;
	float U1;
	float U2;
	// (Never as low as Hi: always above the layer.)
	if (!DSky_AltitudeRoots(a, b, h, Hi, U1, U2))
	{
		return;
	}
	float Start = max(U1, 0.0);
	float End = min(U2, MaxT);
	float L1;
	float L2;
	if (DSky_AltitudeRoots(a, b, h, Lo, L1, L2))
	{
		// Below the base between L1 and L2: the stretch starts after it, or ends where it dips under it.
		if (Start > L1 && Start < L2)
		{
			Start = L2;
		}
		if (L1 > Start && L1 < End)
		{
			End = L1;
		}
	}
	T0 = Start;
	T1 = End;
}

// The direction whose sky colour the haze takes along V: V itself, or, looking down, the horizon under it (the air
// between the view and a cloud below is lit like the low sky, not coloured like the ground).
float3 DSky_HazeDirection(float3 V)
{
	float3 H = float3(V.xy, max(V.z, 0.0));
	return dot(H, H) > 1.0e-6 ? normalize(H) : float3(1.0, 0.0, 0.0);
}

// The density at a point (cm from the view) as the toon surface sees it: the shared clouds' distance turned into a
// ramp with the surface at one half. Detail (0..1) scales the fine fraying near the view. bNear: a sample within a few
// kilometres of a surface already found (its normal, its shadow), read the cheap way (DCS_ShapeNear: the weather and the
// storm cell taken from the surface's Anchor, no map reads, no search for storm cells).
FDSkyCloudSample DSky_CloudAt(float3 P, FDSkyCloudField F, bool bNear, FDCloudAnchor Anchor, float4 MapParams, Texture2D Map,
	SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler, float Detail)
{
	float3 World = F.Camera + P;
	// The altitude over the planet's curve: far clouds sink toward the horizon.
	float Z = World.z + dot(World.xy, World.xy) / (2.0 * DSky_PlanetRadius) - F.Base;
	FDCloudShape C;
	if (bNear)
	{
		C = DCS_ShapeNear(World, Z, Anchor, F.Cloud0, F.Cloud1, F.Cloud2, F.CloudLayer, MapParams, Map, MapSampler, Noise,
			NoiseSampler);
	}
	else
	{
		C = DCS_Shape(P, World, Z, F.Cloud0, F.Cloud1, F.Cloud2, F.CloudLayer, MapParams, Detail, Map, MapSampler, Noise,
			NoiseSampler);
	}
	FDSkyCloudSample S;
	// (0.5 on the surface, 0 to 1 within a sixteenth of the shape either side of it.)
	S.Density = saturate(0.5 + (C.Solid - F.Iso) * 8.0);
	S.Solid = C.Solid;
	S.Signed = C.Signed;
	S.Form = C.Conservative;
	S.Dark = C.Dark;
	S.Column = C.Column;
	S.Height = C.Height;
	S.Deck = C.Deck;
	S.Z = Z;
	S.Anchor = C.Anchor;
	return S;
}

// The corners of a tetrahedron around a point (the normal's four taps).
float3 DSky_Tetra(int Index)
{
	return float3((Index == 0 || Index == 3) ? 1.0 : -1.0, Index >= 2 ? 1.0 : -1.0, (Index & 1) == 1 ? 1.0 : -1.0);
}

// How far toward the light the shadow's samples lie (cm): 300 m, 1.2 km, 2.7 km, 4.8 km.
float DSky_ShadowAlong(int Index)
{
	return 30000.0 * float((Index + 1) * (Index + 1));
}

float DSky_Square(float X)
{
	return X * X;
}

// The march's pace, in steps of its schedule (a step there is a Schedule-th of the way in X, T growing with X squared:
// samples crowd near the view and spread far off, over the storm band most): half steps where cloud may be, whole
// ones through air the shape's bound says is empty. (Not coarser above the cumulus layer: the bound of a cumulonimbus's
// anvil is the anvil itself, a plate a kilometre or two thick, and longer steps there cut its far rim off.)
float DSky_MarchPace(bool bFine)
{
	return bFine ? 0.45 : 0.9;
}

// How far below the surface's level the signed shape of a ray's closest approach may be and still cover some of the
// pixel (T cm along the ray): about a pixel's width at a cumulus's slope (0.1 of the shape per 300 m) -- the outline is
// soft over a pixel instead of stepping where the samples happen to fall.
float DSky_EdgeWidth(float T)
{
	return max(T * 5.0e-9, 5.0e-4);
}

// The march finds the clouds' surface along V (refined between the two samples that straddle it); the surface is
// then lit once, the way painted cumulus are: by its own normal (each billow on its own), shaded where a whole cloud
// stands between it and the light, then the style's few tones. Returns the clouds' colour (over their own
// transparency) and their cover; Core = how deep the cloud is (for the lightning). SkyBehind = the sky's colour along V:
// the air between the view and a cloud veils it in that colour.
float4 DSky_VolumeClouds(float3 V, float3 LightDir, float4 Cloud0, float4 Cloud1, float4 Cloud2, float4 Cloud3, float4 CloudLayer,
	float4 MapParams, Texture2D Map, SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler, float3 Camera, float3 Tone,
	float3 Halo, float3 SkyBehind, float4 CloudLit, float4 CloudShadow, float4 Extra, float3 Sun, float4 LightColor, out float Core)
{
	Core = 0.0;
	if (Cloud0.x <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	FDSkyCloudField F;
	F.Camera = Camera;
	F.Base = max(CloudLayer.x, 10000.0);
	F.Iso = 0.06;
	F.Cloud0 = Cloud0;
	F.Cloud1 = Cloud1;
	F.Cloud2 = Cloud2;
	F.CloudLayer = CloudLayer;

	const float MaxDist = 9000000.0;
	const float DetailEnd = 6000000.0;
	// The most samples the march takes (finding the surface exactly, its normal and its shadow take up to 21 more), and
	// how long its schedule is: half as long, so that where cloud may be it can take its fine steps all the way.
	const int Steps = 80;
	const float Schedule = 36.0;
	// Far off, a ray skimming a cumulus's top (within some 300 m of its surface, where the march's fine steps are longer
	// than 400 m) takes steps a third as long, up to this many more: the fine steps were longer than a billow there, rows
	// of rays found the surface on one billow or the one behind (or the cloud behind), and far cumulus came out in
	// horizontal streaks and brushed edges. Its own budget: no other ray steps differently.
	const int Skims = 30;
	// The layer along the ray, over the planet's curve, from its base to the top of the tallest towers: entered from
	// below, from inside, or from above (looking down on the clouds).
	float T0;
	float T1;
	DSky_LayerSpan(Camera, V, F.Base, F.Base + DCS_STORM_TOP, MaxDist, T0, T1);
	if (T0 >= T1)
	{
		return float4(0, 0, 0, 0);
	}

	// Every density lookup goes through one call in each of two loops, small state machines: the field is heavy, and
	// each place it is called from is a whole copy the shader compiler must build (nine of them took it past minutes).
	// The march reads the field in full; once it has found where along the ray the cloud is, everything else stays
	// within a few kilometres of a sample it took and reads the field the cheap way, from what that sample found
	// (DCS_ShapeNear: its weather, its storm cell -- no map reads, no search for storm cells), in a loop of its own (in
	// one loop the two ways of reading the field together held more registers than the cheap one saved).
	//   0 march    samples along the ray, the same ones every frame (a sample that moved from frame to frame made far
	//              small clouds flicker and edges crawl): coarse through air the shape's bound says no cloud can be in,
	//              fine where one may be (backing up to the last clear sample first), never more than the samples left
	//              can spread over the rest of the ray
	//   1 refine   halving the gap between the last sample outside the cloud and the first inside
	//   2 closest  a ray that only came near a cloud, or came near one before it hit: a golden-section search of the
	//              signed shape for its closest approach; if it reaches the surface, that is a hit like any other (refined
	//              in 1), else the hit after it is refined
	//   3 here     the surface itself
	//   4 normal   four taps on a tetrahedron around it (wider apart far away)
	//   5 shadow   four samples toward the light, further apart as they go
	//   6 sliver   on a deck or a storm's tower and anvil, two samples on along the ray behind the surface: how much
	//              of the cloud the ray goes through there
	//   7 done
	const float3 Ld = normalize(LightDir + float3(0.0, 0.0, 0.08));
	int Phase = 0;
	int Index = 0;
	float Next = T0;
	float PrevT = T0;
	float U = 0.0;        // where the march is along its schedule (0 .. Schedule)
	float PrevU = 0.0;
	bool bFine = false;
	int Quiet = 0;
	int Skimmed = 0;
	bool bHit = false;
	float BestSigned = -1.0e6;
	float BestT = T0;
	float BestStep = 0.0;
	FDCloudAnchor Anchor = (FDCloudAnchor)0;
	float Lo = 0.0;
	float Hi = 0.0;
	float HitLo = 0.0;
	float HitHi = 0.0;
	bool bHitWaiting = false;
	float FirstProbe = 0.0;
	float SurfaceT = 0.0;
	float3 Surface = float3(0, 0, 0);
	float E = 15000.0;
	FDSkyCloudSample Here = (FDSkyCloudSample)0;
	float3 GradSolid = float3(0, 0, 0);
	float3 GradForm = float3(0, 0, 0);
	float3 GradSigned = float3(0, 0, 0);
	float3 N = -V;
	float3 NForm = -V;    // the normal of the cloud's mass alone (the form before the billows)
	float Depth = 0.0;
	float Travelled = 0.0;
	float Sliver = 0.0;
	[loop]
	for (int It = 0; It < Steps + Skims && Phase == 0; ++It)
	{
		float T = Next;
		FDSkyCloudSample S = DSky_CloudAt(V * T, F, false, Anchor, MapParams, Map, MapSampler, Noise, NoiseSampler,
			1.0 - smoothstep(DetailEnd * 0.5, DetailEnd, T));
		if (S.Solid >= F.Iso)
		{
			// A ray grazing far cloud tops can step over a bump and hit the next one: neighbouring rows found their surface
			// on different billows, and the shading came out in horizontal streaks. If the march came close to cloud before
			// the hit, that closest approach is searched first; where it reaches the surface, that is the surface.
			HitLo = PrevT;
			HitHi = T;
			Anchor = S.Anchor;
			Index = 0;
			if (BestSigned > -0.025 && BestT < PrevT && S.Deck < 0.5 && S.Column < 500000.0)
			{
				bHitWaiting = true;
				Lo = max(BestT - BestStep, T0);
				Hi = min(BestT + BestStep, PrevT);
				Phase = 2;
			}
			else
			{
				Lo = HitLo;
				Hi = HitHi;
				Phase = 1;
			}
		}
		else
		{
			bool bMaybe = S.Form > 0.5 * F.Iso;
			// Cloud may begin anywhere since the last clear sample: back to it, and on in fine steps.
			bool bBack = bMaybe && !bFine && T > PrevT;
			if (bMaybe)
			{
				bFine = true;
				Quiet = 0;
			}
			else if (bFine && ++Quiet >= 2)
			{
				bFine = false;
			}
			// (Never slower than the samples left can cover the rest of the schedule at.)
			float From = bBack ? PrevU : U;
			float Pace = max(DSky_MarchPace(bFine), (Schedule - From) / float(max(Steps - 1 - (Index - Skimmed), 1)));
			if (bFine && !bBack && Skimmed < Skims && S.Signed > -0.1 && S.Deck < 0.5 && S.Column < 500000.0
				&& T0 + (T1 - T0) * DSky_Square((From + Pace) / Schedule) - T > 40000.0)
			{
				Pace /= 3.0;
				++Skimmed;
			}
			float NextU = From + Pace;
			Next = T0 + (T1 - T0) * DSky_Square(NextU / Schedule);
			if (!bBack)
			{
				if (S.Signed > BestSigned)
				{
					BestSigned = S.Signed;
					BestT = T;
					BestStep = max(Next - T, T - PrevT);
					Anchor = S.Anchor;
				}
				PrevT = T;
				PrevU = U;
			}
			U = NextU;
			if (++Index - Skimmed >= Steps || U > Schedule)
			{
				// (A ray that came within some 80 m of a cumulus, a few metres of a deck.)
				Phase = BestSigned > -0.025 ? 2 : 7;
				Lo = max(BestT - BestStep, T0);
				Hi = min(BestT + BestStep, T1);
				Index = 0;
			}
		}
	}
	[loop]
	for (int It2 = 0; It2 < 24 && Phase < 7; ++It2)
	{
		// Where to look.
		float3 P;
		if (Phase == 1)
		{
			P = V * (0.5 * (Lo + Hi));
		}
		else if (Phase == 2)
		{
			P = V * (Lo + (Hi - Lo) * ((Index & 1) == 0 ? 0.382 : 0.618));
		}
		else if (Phase == 3)
		{
			P = Surface;
		}
		else if (Phase == 4)
		{
			// The normal is read at the billows' scale: each billow lit as a whole.
			P = Surface + DSky_Tetra(Index) * E;
		}
		else if (Phase == 5)
		{
			P = Surface + N * 30000.0 + Ld * DSky_ShadowAlong(Index);
		}
		else
		{
			P = Surface + V * (max(30000.0, SurfaceT * 0.01) * float(1 + 2 * Index));
		}

		FDSkyCloudSample S = DSky_CloudAt(P, F, true, Anchor, MapParams, Map, MapSampler, Noise, NoiseSampler, 0.0);

		// What it says.
		float T = dot(P, V);
		bool bSurfaceFound = false;
		if (Phase == 1)
		{
			if (S.Solid >= F.Iso)
			{
				Hi = T;
			}
			else
			{
				Lo = T;
			}
			if (++Index >= 5)
			{
				bHit = true;
				SurfaceT = Hi;
				bSurfaceFound = true;
			}
		}
		else if (Phase == 2)
		{
			if (S.Signed > BestSigned)
			{
				BestSigned = S.Signed;
				BestT = T;
			}
			if ((Index & 1) == 0)
			{
				FirstProbe = S.Signed;
			}
			else if (FirstProbe > S.Signed)
			{
				Hi = Lo + (Hi - Lo) * 0.618;
			}
			else
			{
				Lo = Lo + (Hi - Lo) * 0.382;
			}
			if (++Index >= 6)
			{
				Index = 0;
				if (BestSigned >= F.Iso)
				{
					Lo = max(BestT - BestStep, T0);
					Hi = BestT;
					Phase = 1;
				}
				else if (bHitWaiting)
				{
					Lo = HitLo;
					Hi = HitHi;
					Phase = 1;
				}
				else if (BestSigned > F.Iso - DSky_EdgeWidth(BestT))
				{
					SurfaceT = BestT;
					bSurfaceFound = true;
				}
				else
				{
					Phase = 7;
				}
			}
		}
		else if (Phase == 3)
		{
			Here = S;
			// A deck's shape is solid a couple of hundred metres in from its surface, and its cells meet in sharp creases:
			// its normal is read from the signed shape, which goes on falling outside it, over a few hundred metres (the
			// solid shape's gradient there snapped to straight down; read close, it flipped across every crease, and a
			// storm's deck came out in hard dark arcs across the sky).
			E = lerp(E, max(25000.0, SurfaceT * 0.004), S.Deck);
			Phase = 4;
			Index = 0;
		}
		else if (Phase == 4)
		{
			// The gradient of the shape itself (not of the density's narrow ramp, which is flat a little off the
			// surface) and of the form before the billows: the cloud's mass, which keeps neighbouring billows' light
			// together.
			GradSolid += DSky_Tetra(Index) * S.Solid;
			GradForm += DSky_Tetra(Index) * S.Form;
			GradSigned += DSky_Tetra(Index) * S.Signed;
			if (++Index >= 4)
			{
				float3 Nb = dot(GradSolid, GradSolid) > 1.0e-12 ? -normalize(GradSolid) : -V;
				float3 Nm = dot(GradForm, GradForm) > 1.0e-12 ? -normalize(GradForm) : Nb;
				float3 Ns = dot(GradSigned, GradSigned) > 1.0e-12 ? -normalize(GradSigned) : Nm;
				Nb = normalize(lerp(Nb, Ns, Here.Deck));
				Nm = normalize(lerp(Nm, Ns, Here.Deck));
				// (Far off, where a cloud is small on screen and the march's steps are long, a ray grazing its tops finds its
				// surface on one billow or the next from row to row: lit by the billows' normal, far clouds came out in
				// horizontal streaks. There the cloud is lit by its signed shape's normal, which the wide taps far off read
				// smoothly: the form's, solid a few hundred metres in, snapped between a few directions and drew rings.)
				float Far = smoothstep(1000000.0, 4000000.0, SurfaceT);
				N = normalize(lerp(Nb * 0.55 + Nm * 0.45, Ns, Far) + 1.0e-4 * -V);
				NForm = normalize(lerp(Nm, Ns, Far) + 1.0e-4 * -V);
				// (A deck's underside takes its tones from its thickness and its lobes, and faces away from the light: no
				// shadow to look for there, the heaviest samples of a storm saved.)
				Phase = (Here.Deck > 0.95 && N.z < -0.3) ? 6 : 5;
				Index = 0;
			}
		}
		else if (Phase == 5)
		{
			float Along = DSky_ShadowAlong(Index);
			Depth += S.Solid * (Along - Travelled);
			Travelled = Along;
			if (++Index >= 4)
			{
				Phase = (Here.Deck > 0.05 || Here.Column > 600000.0) ? 6 : 7;
				Index = 0;
			}
		}
		else
		{
			Sliver += 0.5 * smoothstep(F.Iso - 0.08, F.Iso + 0.08, S.Signed);
			if (++Index >= 2)
			{
				Phase = 7;
			}
		}
		if (bSurfaceFound)
		{
			Surface = V * SurfaceT;
			E = max(30000.0, SurfaceT * 0.006);
			Phase = 3;
			Index = 0;
		}
	}
	float Cover = bHit ? 1.0 : smoothstep(F.Iso - DSky_EdgeWidth(SurfaceT), F.Iso, BestSigned);
	if (Cover <= 0.0 || SurfaceT <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	// Shaded where a whole cloud stands toward the light (some hundreds of metres of it), not where the light only
	// grazes a neighbouring billow: a cast shadow is a clean shape, or it breaks the tops into grey patches.
	float Cast = smoothstep(0.35, 0.65, 1.0 - exp(-Depth / 15000.0));

	// Dusk and dawn. With the sun under the horizon a cloud is lit only while it stands above the earth's shadow: the
	// higher it stands and the further toward the sun, the longer. The clouds on the far side of the sky go dark first
	// (helped along a little: in a painting the night comes up from the side away from the sun). Moonlight, the main
	// light at night, does not fade so.
	float2 SunAcross = dot(Sun.xy, Sun.xy) > 1.0e-8 ? normalize(Sun.xy) : float2(1.0, 0.0);
	float SideToSun = dot(V.xy, V.xy) > 1.0e-6 ? dot(normalize(V.xy), SunAcross) : 0.0;
	float Altitude = max(F.Base + Here.Z, 0.0);
	float Reach = sqrt(2.0 * Altitude / DSky_PlanetRadius) + dot(V.xy, SunAcross) * SurfaceT / DSky_PlanetRadius + 0.012 * SideToSun;
	float SunLit = lerp(1.0 - smoothstep(Reach - 0.01, Reach + 0.01, asin(saturate(-Sun.z))), 1.0, LightColor.a);

	// Painted light, three tones the way anime clouds are coloured: near white where the sun falls, a pale
	// blue-lavender half tone (the sky mixed into white), the shade blue; each billow reads by its own normal. A
	// cumulus seen from the ground is painted white over its crown and dark under its base, its sides parting between
	// them: the tone goes by how a billow faces the sun, how much it faces up (the sky lights the tops, the cloud's own
	// shade its underside) and how high in the cloud it sits, and the tones part around where that crosses zero.
	float NdL = dot(N, Ld);
	float Key = 0.7 * NdL + 0.45 * N.z + 0.5 * (Here.Height - 0.35);
	float Light = saturate((Key + 0.3) / 0.6) * (1.0 - Cast) * SunLit;
	float Thin = exp(-Here.Column / 120000.0);
	float Ambient = 0.94 + 0.04 * N.z + 0.12 * Thin + 0.05 * Here.Height;
	// The underside sits in the cloud's own shade and sees little of the sky: darker low in the cloud, the more so where
	// it faces down (a cumulus seen from the ground is dark under its base, not the sky's grey).
	float Under = 1.0 - 0.3 * DSky_Square(1.0 - Here.Height) * (0.5 + 0.5 * saturate(-N.z));

	// Sunrise and sunset: the lit side takes the low sun's own colour (the main light's hue: peach going to orange as
	// it sinks), the more toward the side of the sky the sun is on.
	float Low = (1.0 - smoothstep(0.03, 0.4, Sun.z)) * (1.0 - LightColor.a);
	float3 SunHue = LightColor.rgb / max(max(LightColor.r, max(LightColor.g, LightColor.b)), 1.0e-4);
	float Warmth = Low * (0.7 + 0.3 * saturate(SideToSun * 0.5 + 0.5));

	float3 Shadow = CloudShadow.rgb * lerp(1.0, Tone, Extra.x) * Ambient * Under;
	// (By moonlight the lit side is the shade lifted in the moon's hue, as the style's night colours have it: its lit
	// colour is the sun's, still a sunset pink while the moon has already taken over in the dusk.)
	float3 LitColor = lerp(CloudLit.rgb * lerp(1.0, SunHue, Warmth), CloudShadow.rgb * 1.8 * SunHue, LightColor.a);
	float3 Lit = LitColor * lerp(1.0, Tone, Extra.x * 0.2) + Halo * Extra.y * Light;
	float3 Half = lerp(Shadow, Lit, 0.55) * float3(0.96, 0.97, 1.03);
	float3 Color = Shadow;
	if (Cloud0.w < 1.0)
	{
		Color = lerp(Shadow, Lit, Light);
	}
	else
	{
		Color = lerp(Color, Half, smoothstep(0.24, 0.28, Light));
		Color = lerp(Color, Lit, smoothstep(0.56, 0.6, Light));
	}
	// Undersides, painted soft: from below the lobes of a deck, the base of a cumulus, the underside of a storm's anvil
	// and its mammatus read by their shapes, not as one shade: dark where the cloud is thick over them, light where it
	// is thin, their flanks lighter than their bottoms (they see the sky round them) and the side toward the sun lighter
	// still -- from a deep shade through the shade to the half tone. An underside varies only gently, so each of these
	// is read across the range it spans, not an absolute one: how thick the cloud is here between a deck's thinnest gaps
	// and thickest cells (some 80 m to 1.2 km; a storm's deck 2 to 3 km throughout, its cells still parting from its gaps,
	// the storm darkening all of it below), how far a lobe's flank turns from straight down, and how far it turns toward
	// the sun.
	float Deep = smoothstep(0.15, 0.6, Here.Dark);
	float Thickest = lerp(120000.0, 300000.0, Deep);
	float Thinnest = lerp(8000.0, 190000.0, Deep);
	float Gap = saturate((Thickest - Here.Column) / (Thickest - Thinnest));
	// (Read from the normal of the cloud's mass: by the billows' normal the backlit body of a big cumulus came out
	// spattered with specks of the underside's tones.) Where the ray only clips a cumulonimbus's anvil, near its thinning
	// rim (only its underside, high in the cloud and facing down), it is lighter, and see-through further on (below): the
	// anvil's underside feathers out instead of ending in a hard arc across the sky.
	float Anvil = smoothstep(500000.0, 900000.0, Here.Column) * smoothstep(0.55, 0.75, Here.Height) * smoothstep(-0.2, -0.5, NForm.z);
	float Flank = smoothstep(0.05, 0.4, 1.0 + NForm.z);
	// (A storm's underside is heavy: its lightest is well short of the half tone.)
	float Glow = saturate((0.45 * Gap + 0.45 * Flank + 0.3 * saturate((dot(NForm, Ld) + 0.45) / 0.6) * SunLit) * lerp(1.0, 0.65, Deep)
		+ 0.5 * (1.0 - Sliver) * Anvil);
	float3 Underside = lerp(Shadow * float3(0.62, 0.64, 0.7), Shadow, smoothstep(0.05, 0.35, Glow));
	Underside = lerp(Underside, Half, smoothstep(0.45, 0.8, Glow));
	Color = lerp(Color, Underside, smoothstep(-0.25, -0.65, NForm.z) * (1.0 - smoothstep(0.35, 0.6, Light)));
	// A deck is painted soft, the way an overcast is in anime backgrounds: no bands. Its upper side, seen from above, is
	// a sea of cloud in the sun, from the half tone to the lit white -- only from above: from below, the walls of a hole
	// in it are its underside's tones, not a lit white rim.
	float FromAbove = smoothstep(-20000.0, 20000.0, -V.z * SurfaceT);
	float3 DeckOver = lerp(Half, Lit, smoothstep(0.2, 0.7, Light));
	Color = lerp(Color, lerp(Underside, DeckOver, smoothstep(0.3, 0.7, Here.Height) * FromAbove), Here.Deck);
	// Silver lining: edges turned from the view, with the light behind them; grazed edges glow the most. Only on
	// the upper sides (the lobes of an underside face away from the light), and not round a hole in a deck.
	float Rim = pow(1.0 - saturate(abs(dot(N, V))), 3.0) * smoothstep(0.1, 0.5, Here.Height) * SunLit * (1.0 - Here.Deck);
	Color += CloudLit.rgb * CloudLit.a * Rim * pow(saturate(dot(V, LightDir)), 4.0) * 2.0;
	// Storm clouds are dark below; their lit tops much less so.
	Color *= saturate(1.0 - CloudLayer.z * Here.Dark * lerp(0.55, 1.0, 1.0 - Light) * lerp(1.0, 0.3, Here.Height));
	// The air between: far clouds sink into the sky's colour, their bases (in the hazy low air) before their tops. Painted,
	// the near ones keep their tones (a base a few kilometres overhead stays dark, not the sky's grey) and the haze closes
	// in with distance: the veil eases in, the more slowly under a storm (its low dark base looms through the rain).
	float Veil = DCS_AirVeil(SurfaceT, V.z, Camera.z, Cloud0.x, Cloud3);
	Color = lerp(Color, SkyBehind, pow(Veil, 1.6 + 1.4 * Deep));
	// Where the ray only clips a thin sliver of a deck (the rim of a hole in it, the specks a breaking deck leaves) or of
	// an anvil (its thinning rim) it is see-through: a hole's edge feathers into the sky instead of being cut out, the
	// specks fade instead of sparkling, an anvil's edge thins out.
	Cover *= lerp(1.0, lerp(0.3, 1.0, Sliver), max(Here.Deck, Anvil));
	Cover *= 1.0 - smoothstep(0.85 * MaxDist, MaxDist, SurfaceT);
	Core = Cover * saturate(Here.Column / 300000.0) * (1.0 - Veil);
	return float4(Color * Cover, Cover);
}

// High cloud: thin cirrus veils on a layer far above the cumulus (Cloud3.w cm up), lying along the wind and drifting
// faster than the cumulus, in patches over Cloud3.z of the sky, gone under a closing overcast. The dome draws them
// under either kind of cumulus (they are higher than any). Returns the colour (premultiplied) and the cover.
// The noise level that fits a pattern Scale cm per texture unit seen T cm off (the texture is some 128 texels a side; a
// pixel some 0.0015 of the distance): mip 0 that far below its texels shimmers into moire.
float DSky_NoiseLod(float T, float Scale)
{
	return max(log2(T * 0.0015 * 128.0 / Scale), 0.0);
}

float4 DSky_HighClouds(float3 V, float4 Cloud0, float4 Cloud1, float4 Cloud3, float3 Camera, float3 SkyBehind, float4 CloudLit,
	float3 Halo, Texture3D Noise, SamplerState NoiseSampler)
{
	float Amount = saturate(Cloud3.z) * (1.0 - smoothstep(0.7, 0.95, Cloud0.x));
	if (Amount <= 0.0 || V.z <= 0.01)
	{
		return float4(0, 0, 0, 0);
	}
	float T = DSky_AltitudeT(Camera, V, max(Cloud3.w, 100000.0));
	float2 Wind = dot(Cloud1.xy, Cloud1.xy) > 1.0e-8 ? normalize(Cloud1.xy) : float2(1.0, 0.0);
	float2 W = Camera.xy + V.xy * T + Cloud1.xy * 220000.0 * max(Cloud0.z, 0.05) * 1.6;
	float2 Q = float2(dot(W, Wind), dot(W, float2(-Wind.y, Wind.x)));   // along the wind, across it
	// Where the patches are (large, slow), and a gentle bend of the streaks over tens of kilometres.
	float Patch = Noise.SampleLevel(NoiseSampler, float3(Q / 6000000.0, 0.71), 0).r;
	float Bend = Noise.SampleLevel(NoiseSampler, float3(Q / 6000000.0, 0.23), 0).r - 0.5;
	// The veils: the smooth noise drawn out four to one along the wind, some 3.5 km wide, bent gently and broken into
	// sheets, only the strongest of it (thin streaks twenty-five times as long as they were wide ran together toward one
	// point of the horizon like combed hair; short ones like brush dashes); fine fibres run along them, faint. Thin
	// gauze, not lines. (Explicit levels, the coarser the further: the sky material is also built for ray tracing hits,
	// which have no screen derivatives, and the finest level far below its texels shimmers.)
	float2 S = float2(Q.x / 1500000.0, (Q.y + Bend * 300000.0) / 350000.0);
	float Body = Noise.SampleLevel(NoiseSampler, float3(S, 0.53), DSky_NoiseLod(T, 350000.0)).r;
	float Fibres = Noise.SampleLevel(NoiseSampler, float3(Q.x / 800000.0 + 0.37, Q.y / 60000.0, 0.11), DSky_NoiseLod(T, 60000.0)).r;
	float Along = Noise.SampleLevel(NoiseSampler, float3(Q.x / 2500000.0, Q.y / 1200000.0, 0.87), DSky_NoiseLod(T, 1200000.0)).r;
	float Fibre = smoothstep(0.5, 0.82, Body) * lerp(0.7, 1.0, Fibres) * smoothstep(0.35, 0.7, Along);
	float Mask = saturate((Patch - (1.0 - Amount)) * 2.0);
	float Alpha = Fibre * Mask * 0.3 * smoothstep(0.02, 0.15, V.z);
	// Thin ice: white in the sun and brightest toward it (it scatters forward), letting the sky through; far off,
	// veiled like any cloud.
	float3 Color = lerp(SkyBehind, CloudLit.rgb * 0.9 + Halo * 1.5, 0.75);
	Color = lerp(Color, SkyBehind, DCS_AirVeil(T, V.z, Camera.z, Cloud0.x, Cloud3));
	return float4(Color * Alpha, Alpha);
}

// Rain hanging under distant clouds: grey curtains from the cloud base down into the horizon, wherever the weather
// map has rain under a closed cover some way off along V (looked for from 8 to 45 km; the nearest raining one hangs
// its curtain). Broad curtains in azimuth, finely streaked, thinning as they fall and veiled by the air like
// the clouds. The dome draws them, behind any cloud.
float4 DSky_RainShafts(float3 V, float3 Camera, float4 Cloud0, float4 CloudLayer, float4 Cloud3, float4 MapParams,
	Texture2D Map, SamplerState MapSampler, Texture3D Noise, SamplerState NoiseSampler, float3 SkyBehind, float3 Shade)
{
	if (V.z > 0.15 || V.z < -0.02 || dot(V.xy, V.xy) < 1.0e-6)
	{
		return float4(0, 0, 0, 0);
	}
	float2 Dir = normalize(V.xy);
	float3 ViewWeather = DCS_ViewWeather(Cloud0, CloudLayer);
	float Rain = 0.0;
	float Distance = 0.0;
	const float Probes[6] = { 800000.0, 1400000.0, 2000000.0, 2700000.0, 3500000.0, 4500000.0 };
	[unroll]
	for (int i = 0; i < 6; ++i)
	{
		float D = Probes[i];
		float3 W = DCS_MapAt(Camera.xy + Dir * D, ViewWeather, MapParams, Map, MapSampler);
		float Here = saturate(W.z) * smoothstep(0.6, 0.9, W.x);
		if (Distance <= 0.0 && Here > 0.15)
		{
			Rain = Here;
			Distance = D;
		}
	}
	if (Rain <= 0.0)
	{
		return float4(0, 0, 0, 0);
	}
	// The cloud base's elevation that far off (over the planet's curve); the curtain hangs from it to the horizon.
	float BaseUp = (CloudLayer.x - Camera.z - Distance * Distance / (2.0 * DSky_PlanetRadius)) / Distance;
	if (V.z > BaseUp)
	{
		return float4(0, 0, 0, 0);
	}
	float Fall = saturate((BaseUp - V.z) / max(BaseUp + 0.01, 0.005));
	float Curtain = smoothstep(0.35, 0.65, Noise.SampleLevel(NoiseSampler, float3(Dir * 1.3, 0.61), 0).r);
	float Streak = Noise.SampleLevel(NoiseSampler, float3(Dir * 14.0, 0.29 + Fall * 0.12), 0).r;
	// (It sets in just under the base: within a fifth of the base's own height above the horizon, however far off.)
	float Alpha = Rain * Curtain * lerp(0.55, 1.0, Streak) * (1.0 - 0.6 * Fall)
		* smoothstep(0.0, 0.2 * max(BaseUp, 0.0) + 0.002, BaseUp - V.z) * 0.75;
	float Veil = DCS_AirVeil(Distance, max(V.z, 0.0) + 0.03, Camera.z, Cloud0.x, Cloud3);
	// Rain darkens the air it falls through: the curtains keep more of their grey through the haze than a cloud does.
	float3 Color = lerp(Shade * 0.6, SkyBehind, 0.15 + 0.45 * Veil);
	return float4(Color * Alpha, Alpha);
}

// Extra = (cloud sky tint, cloud sun glow, share of the sun disk the sky light capture sees, flash gain).
// Haze = (height fog colour, how much of the dome weather fog hides).
// Cloud0 = (cover, -, scale, tones), Cloud1 = (wind drift, -, -), Cloud2 = (-, zenith thinning, -, fair-weather towers),
// Cloud3 = (visibility, cm; haze height, cm; high cloud cover; high cloud altitude, cm).
// Capture is 1 while the dome is drawn into the sky light (reflection capture pass), 0 on screen.
float3 DSky_Shade(float3 V, float4 SunDir, float4 MoonDir, float4 Time, float4 Zenith, float4 Horizon, float4 Ground,
	float4 SunHalo, float4 SunDisk, float4 MoonDisk, float4 MoonHalo, float4 Stars, float4 Cloud0, float4 Cloud1,
	float4 Cloud2, float4 Cloud3, float4 CloudLit, float4 CloudShadow, float4 MainLight, float4 MainLightColor, float4 CloudLayer,
	float4 MapParams, float4 Flash, float4 Extra, float4 Haze, Texture2D WeatherMap, SamplerState WeatherMapSampler,
	Texture3D Noise, SamplerState NoiseSampler, float3 Camera, float2 ScreenUV, float Seconds, float Capture)
{
	V = normalize(V);
	float3 Sun = normalize(SunDir.xyz);
	float3 Moon = normalize(MoonDir.xyz);
	float3 LightDir = normalize(MainLight.xyz);

	float3 Halo;
	float3 Base = DSky_Backdrop(V, Sun, Zenith, Horizon, Ground, SunHalo, Halo);
	float3 Sky = Base + Halo;
	Sky += MoonHalo.rgb * pow(saturate(dot(V, Moon)), max(MoonHalo.a, 1.0));
	// The afterglow: once the sun is down the sky over where it set keeps a warm band along the horizon for a while (the
	// style's halo is gone by 6 degrees under), rose going to violet as the sun sinks, gone by some 12 degrees under.
	float Dusk = smoothstep(-0.21, -0.03, Sun.z) * (1.0 - smoothstep(-0.03, 0.03, Sun.z));
	if (Dusk > 0.0 && dot(V.xy, V.xy) > 1.0e-6 && dot(Sun.xy, Sun.xy) > 1.0e-6)
	{
		float Side = saturate(dot(normalize(V.xy), normalize(Sun.xy)) * 0.5 + 0.5);
		float Band = exp(-max(V.z, 0.0) * 7.0) * smoothstep(-0.03, 0.0, V.z);
		float3 Afterglow = lerp(float3(0.16, 0.06, 0.13), float3(0.55, 0.24, 0.12), smoothstep(-0.15, -0.03, Sun.z));
		Sky += Afterglow * Dusk * Side * Side * Side * Band;
	}
	// Through the holes of an overcast the sky shows its own colour: the style greys the whole sky as the cover closes
	// (by then it is mostly seen through the cloud), and a hole would show that grey; there it is given its blue back.
	float Closing = smoothstep(0.7, 0.95, Cloud0.x);
	float SkyGrey = dot(Sky, float3(0.2126, 0.7152, 0.0722));
	Sky = max(SkyGrey + (Sky - SkyGrey) * (1.0 + 1.5 * Closing), 0.0);

	// The volumetric clouds.
	float3 Mean = max(0.5 * (Zenith.rgb + Horizon.rgb), 1.0e-4);
	float3 Tone = clamp(Base / Mean, 0.25, 4.0);
	// CloudLayer.w = 1: the engine's volumetric cloud layer draws the clouds over the dome; the dome leaves its own out.
	float CloudCore = 0.0;
	float4 VC = float4(0, 0, 0, 0);
	if (CloudLayer.w < 0.5)
	{
		// Looking down on clouds, the air between takes the low sky's colour, not the ground's.
		float3 HazeHalo = Halo;
		float3 Haze = V.z >= 0.0 ? Base : DSky_Backdrop(DSky_HazeDirection(V), Sun, Zenith, Horizon, Ground, SunHalo, HazeHalo);
		VC = DSky_VolumeClouds(V, LightDir, Cloud0, Cloud1, Cloud2, Cloud3, CloudLayer, MapParams, WeatherMap, WeatherMapSampler,
			Noise, NoiseSampler, Camera, Tone, Halo, Haze + HazeHalo, CloudLit, CloudShadow, Extra, Sun, MainLightColor, CloudCore);
		VC *= CloudShadow.a;
	}
	float4 High = DSky_HighClouds(V, Cloud0, Cloud1, Cloud3, Camera, Base + Halo, CloudLit, Halo, Noise, NoiseSampler);
	float4 Shafts = DSky_RainShafts(V, Camera, Cloud0, CloudLayer, Cloud3, MapParams, WeatherMap, WeatherMapSampler, Noise,
		NoiseSampler, Base + Halo, CloudShadow.rgb);
	float Clear = (1.0 - VC.a) * (1.0 - 0.6 * High.a);

	float3 MoonColor = DSky_Moon(V, Moon, Sun, MoonDir.w, MoonDisk.a, MoonDisk.rgb);
	float MoonCover = saturate(dot(MoonColor, float3(1, 1, 1)) * 4.0);
	// The sky light sees no stars, and only a share of the sun disk (a full disk makes a hot spot in the
	// captured light that every rough surface would reflect).
	Sky += Stars.x * DSky_Stars(V, Time.z, Stars.y, Stars.z, Seconds) * (1.0 - MoonCover) * Clear * (1.0 - Capture);
	Sky = lerp(Sky, MoonColor, MoonCover * Clear);
	float SunShare = lerp(1.0, Extra.z, Capture);
	Sky += SunDisk.rgb * DSky_Disk(V, Sun, SunDisk.a) * smoothstep(-0.02, 0.0, V.z) * Clear * Clear * Clear * Clear * SunShare;

	Sky = Sky * (1.0 - High.a) + High.rgb;
	Sky = Sky * (1.0 - Shafts.a) + Shafts.rgb;
	Sky = Sky * (1.0 - VC.a) + VC.rgb;

	// Weather fog and dust hide the sky in the height fog's colour, from the horizon up: the fogged ground then
	// meets the dome without a seam. Light fog hazes the horizon; thick fog swallows most of the sky.
	if (Haze.a > 0.0)
	{
		float Amount = Haze.a * lerp(exp(-saturate(V.z) * 8.0), 1.0, Haze.a * Haze.a);
		// (Under a storm the dark base overhead shows through the rain's haze: a storm reads by its low dark cloud.)
		Amount *= 1.0 - 0.5 * VC.a * smoothstep(0.2, 0.6, CloudLayer.y) * saturate(V.z * 4.0);
		Sky = lerp(Sky, Haze.rgb, saturate(Amount));
	}

	// Lightning: the clouds over the strike light up, the rest of the sky a little. Not in the sky light: the
	// capture is sliced over several frames, and the flash already reaches the ambient light directly.
	float FlashNow = Flash.w * Extra.w * (1.0 - Capture);
	if (FlashNow > 0.0)
	{
		float Toward = pow(saturate(dot(V, normalize(Flash.xyz))), 3.0);
		// Against a night sky a flash tuned for daylight whites out everything: it is held back with the sky's
		// own brightness (still many times the night sky), and lights cloud cores more than edges, so the clouds
		// keep their shapes; a storm tower glows from inside.
		float SkyLevel = dot(Mean, float3(0.2126, 0.7152, 0.0722));
		float Level = saturate(0.3 + SkyLevel * 3.0);
		float Body = lerp(0.6, 1.4, saturate(CloudCore));
		float Cloudy = VC.a;
		Sky += float3(0.75, 0.8, 1.0) * FlashNow * Level * (0.15 + 0.85 * Toward) * (0.3 + 1.7 * Cloudy) * Body;
	}
	return max(Sky, 0.0);
}

#endif // DREAMSKY_STYLIZED_USH
