//
// Writes into the sky pixels of the scene colour right after the base pass, before lighting, fog and translucency:
// the point where the sky cloud renderer composites its clouds. A pixel is sky when the depth buffer holds the far
// plane or something beyond SkyDepth (the dome). Debug mode 1 multiplies the sky by a grid of view directions
// (15 degree lines of azimuth and elevation, the horizon band red, the cardinal directions tinted) so the composite
// point can be checked in every kind of view.

#include "/Engine/Private/Common.ush"

Texture2D SceneDepth;
float SkyDepth;      // view depth (cm) beyond which a pixel is sky
uint DebugMode;

float DSkyGridLine(float Degrees, float Spacing, float PixelDegrees)
{
	float F = abs(frac(Degrees / Spacing + 0.5) - 0.5) * Spacing;
	return 1.0 - saturate(F / max(PixelDegrees, 1.0e-4) - 0.5);
}

void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float2 Pixel = SvPosition.xy;
	const float2 Local = Pixel - View.ViewRectMin.xy;
	if (any(Local < 0.0) || any(Local >= View.ViewSizeAndInvSize.xy))
	{
		discard;
	}
	const float DeviceZ = SceneDepth.Load(int3(Pixel, 0)).r;
	if (DeviceZ > 0.0 && ConvertFromDeviceZ(DeviceZ) < SkyDepth)
	{
		discard;
	}

	const float3 V = normalize(SvPositionToTranslatedWorld(float4(Pixel, 0.5, 1.0)) - View.TranslatedWorldCameraOrigin);
	const float Azimuth = degrees(atan2(V.y, V.x));
	const float Elevation = degrees(asin(clamp(V.z, -1.0, 1.0)));
	// Degrees one pixel spans at this direction, for lines of constant width on screen.
	const float PixelDegrees = max(length(float2(ddx(Elevation), ddy(Elevation))), 1.0e-3);
	const float AzimuthPixel = min(abs(ddx(Azimuth)) + abs(ddy(Azimuth)), 2.0);

	float3 Tint = lerp(1.0.xxx, 0.35 + 0.65 * (V * 0.5 + 0.5), 0.8);
	if (abs(Elevation) < 2.0)
	{
		Tint = float3(1.6, 0.2, 0.2);
	}
	const float Line = max(DSkyGridLine(Elevation, 15.0, PixelDegrees), DSkyGridLine(Azimuth, 15.0, max(AzimuthPixel, 1.0e-3)) * step(abs(Elevation), 80.0));
	Tint *= 1.0 - 0.85 * Line;
	OutColor = float4(Tint, 1.0);
}
