// M_DreamCloudVolume.dss -- a local cloud volume (ADreamCloudVolume): the cloud a mesh or a few primitives were baked
// into, marched inside the box of its signed distance field.
//
// The volume draws the engine's unit cube stretched over the field's box; only its back faces draw (the front ones
// return nothing), with the depth test off, so the cloud shows whether the view is outside the box or in it, and scene
// geometry inside the box cuts the march where the scene depth says (the cloud thins out over SoftContact before it).
// The drawing is /Plugin/DreamDynamicWorld/Private/DreamCloudVolume.ush, on the shared march (DreamCloudMarch.ush: big
// skips through clear air by the field's distance, fine steps where there may be cloud) and light (DreamCloudLight.ush).
// The sun, the sky light and the toon colours come from the plugin's shared parameter collection, like the sky's, so a
// cloud volume is lit as the sky's clouds are. The component sets the field and its box (FieldBox = size in cm, texel
// size), its light map (the transmittance toward the light, drawn by a compute shader), what carvers cut out of it, and
// its appearance.
//
// Looks: 0 realistic (a participating medium: the sunlight through the cloud's own shadow, scattered forward and back,
// several times inside; the sky light falling off toward the base), 1 toon (the field's surface, refined, painted in
// three tones by a normal taken at the lobes' scale, the silhouette antialiased by how near the ray passed; a view
// inside the cloud sees it as a fog), 2 painted (a denser volume with its light put in the toon tones and a silver
// lining against the sun).
#pragma material(ShadingModel = Unlit, BlendMode = AlphaComposite, TwoSided = true, bDisableDepthTest = true, bUseTranslucencyVertexFog = false, bComputeFogPerPixel = true, TranslucencyPass = BeforeDOF)

/// The volume's baked field (the component sets it).
/// @group Shape   @sort 10
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
uniform VolumeTexture Field;

/// @group Shape   @sort 20   @desc The field's box in the shape's space: size (cm) in xyz, texel size (cm) in w
uniform float4 FieldBox = float4(100.0, 100.0, 100.0, 10.0);

/// @group Shape   @sort 30   @slider -500 1000   @desc How far the cloud reaches past the shape's surface (cm)
uniform float Inflate = 0.0;

/// @group Shape   @sort 40   @slider 1 2000   @desc Over how many cm from its surface inward the density rises to full
uniform float EdgeSoftness = 50.0;

/// @group Appearance   @sort 10   @slider 0 2   @desc 0 realistic, 1 toon, 2 painted
uniform float Look = 0.0;

/// @group Appearance   @sort 20   @slider 0.01 5   @desc Extinction at full density, per metre
uniform float Extinction = 1.5;

/// @group Appearance   @sort 30   @slider 0 4   @desc Multiplies the sunlight scattered
uniform float SunStrength = 1.5;

/// @group Appearance   @sort 40   @slider 0 4   @desc Multiplies the sky light scattered
uniform float AmbientStrength = 1.0;

/// @group Appearance   @sort 50   @desc Tints the lit side (toon: the style's lit cloud colour)
uniform float4 LitTint = float4(1.0, 1.0, 1.0, 1.0);

/// @group Appearance   @sort 60   @desc Tints the shaded side (toon: the style's cloud shade colour)
uniform float4 ShadeTint = float4(1.0, 1.0, 1.0, 1.0);

/// @group Appearance   @sort 70   @slider 1 2000   @desc Toon: the size of the lobes the tones follow (cm)
uniform float LobeScale = 200.0;

/// @group Appearance   @sort 80   @slider 0 0.3   @desc Toon: how soft the edges between the tones are
uniform float ToneSoftness = 0.03;

/// @group Appearance   @sort 90   @slider 0 1000   @desc How far before scene geometry inside the cloud it thins out (cm)
uniform float SoftContact = 150.0;

/// @group Noise   @sort 10   @slider 10 20000   @desc The size of the eroding noise (cm a tile)
uniform float NoiseScale = 1500.0;

/// @group Noise   @sort 20   @slider 0 2000   @desc How deep the noise eats into the cloud (cm)
uniform float NoiseErosion = 250.0;

/// @group Noise   @sort 30   @desc How the noise drifts through the cloud (cm/s, the shape's space)
uniform float4 NoiseDrift = float4(20.0, 0.0, 5.0, 0.0);

/// @group Quality   @sort 10   @slider 0.25 4   @desc Multiplies the fine step (half a texel at 1)
uniform float StepScale = 1.0;

/// @group Quality   @sort 20   @slider 0 1   @desc 1 once the volume's light map has been drawn (the component sets it)
uniform float LightMapValid = 0.0;

/// The transmittance toward the light over the field's box (the component draws it).
/// @group Quality   @sort 30
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
uniform VolumeTexture LightMap;

/// @group Carving   @sort 10   @slider 0 1   @desc 1 while carvers have cut into the volume (the component sets it)
uniform float HolesValid = 0.0;

/// What carvers cut out over the field's box (the component sets it).
/// @group Carving   @sort 20
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
uniform VolumeTexture Holes;

/// @group Carving   @sort 30   @slider 0 1   @desc How ragged the passages' walls are
uniform float HoleEdgeNoise = 0.35;

/// @group Appearance   @sort 100   @slider 50 5000   @desc Toon: how far into the cloud a view inside it sees (cm)
uniform float InsideFog = 600.0;

/// The 3D noise the edges are eroded with (the sky's clouds' noise).
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
static const VolumeTexture CloudNoise;

/// @custom
/// @name Dream Cloud Volume
float4 DreamCloudVolume_Shade(float3 CamL, float3 PixL, float WorldLen, float PixelDepth, float SceneDepth, float Face,
	float2 Pixel, float Seconds, float3 ViewW, float3 LightW, float3 LightL, float3 AxisX, float3 AxisY, float3 AxisZ,
	float4 MainLight, float4 MainLightColor, float4 AmbientSky, float4 AmbientGround, float4 CloudLit, float4 CloudShadow,
	float4 Box, float InflateW, float EdgeW, float LookMode, float Sigma, float SunMul, float AmbMul, float4 LitMul,
	float4 ShadeMul, float LobeW, float Softness, float Contact, float NoiseW, float ErodeW, float4 Drift, float StepMul,
	float LightValid, float HolesOn, float HoleNoise, float FogW,
	VolumeTexture Field, VolumeTexture Noise, VolumeTexture LightMap, VolumeTexture Holes)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamCloudVolume.ush"

	// The shape's space (cm, the field's box centred at its origin): the cube's local space (-50..50) stretched by the box.
	float3 K = Box.xyz / 100.0;
	float3 Cam = CamL * K;
	float3 Through = PixL * K - Cam;
	float LenM = max(length(Through), 1.0e-3);
	float3 Dir = Through / LenM;
	float CmPerUnit = WorldLen / LenM;                  // world cm per cm of the shape's space along the view ray
	float PixelAngle = length(fwidth(Dir));             // (before any branch: derivatives)

	// Only the back faces draw: the front ones would draw the cloud a second time.
	if (Face > 0.0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	float2 Seg = DCM_BoxSegment(Cam, Dir, 0.5 * Box.xyz);
	float T0 = max(Seg.x, 0.0);
	float TScene = LenM * SceneDepth / max(PixelDepth, 1.0e-3);
	float T1 = min(Seg.y, TScene);
	if (T1 <= T0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}

	// The lengths the component gives in world cm, in the shape's space (the box's mean scale: a volume scaled up keeps
	// its noise, edges and lobes the same size in the world, and gains more of them).
	float ScaleW = max((length(AxisX) / K.x + length(AxisY) / K.y + length(AxisZ) / K.z) / 3.0, 1.0e-4);
	FDCloudVolume V;
	V.Box = Box.xyz;
	V.Texel = max(Box.w, 1.0e-3);
	V.Inflate = InflateW / ScaleW;
	V.Edge = max(EdgeW / ScaleW, 1.0e-3);
	V.ErodeDepth = ErodeW / ScaleW;
	V.InvNoise = ScaleW / max(NoiseW, 1.0);
	V.Drift = Drift.xyz * Seconds / ScaleW;
	V.HolesOn = HolesOn;
	V.HoleNoise = HoleNoise;
	V.DetailNear = 4000.0 / ScaleW;

	float3 LightM = LightL * K;                         // the light's direction in the shape's space
	float LightLen = max(length(LightM), 1.0e-6);

	FDCloudVolumeLook Look;
	Look.Mode = LookMode;
	Look.Sun = MainLightColor.rgb * MainLight.w * SunMul * LitMul.rgb;
	Look.SkyTop = AmbientSky.rgb * AmbMul * ShadeMul.rgb;
	Look.SkyBottom = AmbientGround.rgb * AmbMul * ShadeMul.rgb;
	Look.Lit = CloudLit.rgb * LitMul.rgb;
	Look.Shade = CloudShadow.rgb * ShadeMul.rgb;
	Look.Half = lerp(Look.Shade, Look.Lit, 0.55);
	Look.Softness = Softness;
	Look.Lobe = LobeW / ScaleW;
	Look.InsideFog = FogW / ScaleW;
	Look.Contact = Contact;

	float Jitter = DCM_InterleavedGradientNoise(Pixel, View.StateFrameIndex);
	return DCV_Shade(V, Look, Cam, Dir, T0, T1, TScene, CmPerUnit, LightM / LightLen, 1.0 / LightLen, LightW, ViewW,
		AxisX, AxisY, AxisZ, K, Sigma, StepMul, Jitter, PixelAngle, LightValid,
		Field, FieldSampler, Noise, NoiseSampler, Holes, HolesSampler, LightMap, LightMapSampler);
}

export void M_DreamCloudVolume(inout material m)
{
	float4 MainLight      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLight");
	float4 MainLightColor = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLightColor");
	float4 AmbientSky     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AmbientSky");
	float4 AmbientGround  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AmbientGround");
	float4 CloudLit       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudLit");
	float4 CloudShadow    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudShadow");

	float3 World = UE.WorldPosition().XYZ;
	float3 Camera = UE.CameraPositionWS();
	float3 LightW = normalize(MainLight.xyz);
	float3 CamL = UE.TransformPosition(Camera, Source = World, Destination = Local);
	float3 PixL = UE.TransformPosition(World, Source = World, Destination = Local);
	float3 LightL = UE.TransformVector(LightW, Source = World, Destination = Local);
	float3 AxisX = UE.TransformVector(float3(1.0, 0.0, 0.0), Source = Local, Destination = World);
	float3 AxisY = UE.TransformVector(float3(0.0, 1.0, 0.0), Source = Local, Destination = World);
	float3 AxisZ = UE.TransformVector(float3(0.0, 0.0, 1.0), Source = Local, Destination = World);

	float4 C = DreamCloudVolume_Shade(CamL, PixL, length(World - Camera), UE.PixelDepth(), UE.SceneDepth(), UE.TwoSidedSign(),
		UE.ScreenPosition().PixelPosition, UE.Time(), -UE.CameraVectorWS(), LightW, LightL, AxisX, AxisY, AxisZ,
		MainLight, MainLightColor, AmbientSky, AmbientGround, CloudLit, CloudShadow,
		FieldBox, Inflate, EdgeSoftness, Look, Extinction, SunStrength, AmbientStrength, LitTint, ShadeTint,
		LobeScale, ToneSoftness, SoftContact, NoiseScale, NoiseErosion, NoiseDrift, StepScale,
		LightMapValid, HolesValid, HoleEdgeNoise, InsideFog, Field, CloudNoise, LightMap, Holes);
	m.EmissiveColor = C.rgb;
	m.Opacity = C.a;
}
