// M_DreamRainDrop.dss -- a falling rain drop: a thin streak on a velocity-aligned Niagara sprite.
//
// The streak is lit by the sky (ambient plus a share of the main light, from the shared parameter
// collection), so rain reads pale in daylight, dim at night and flashes with the lightning. The sprite's
// colour (particle colour) tints it and its alpha fades it; the drop fades out where it meets geometry.
#pragma material(ShadingModel = Unlit, BlendMode = Translucent, TwoSided = true, bUsedWithNiagaraSprites = true)

/// @group Look @desc How bright the drop is against the light around it
uniform float Brightness = 2.4;

/// @group Look @desc Share of the main (sun / moon) light the drop catches
uniform float MainLightShare = 0.08;

/// @group Look @desc Width of the bright core across the streak, 0..1
uniform float CoreWidth = 0.35;

/// @group Look @desc Distance over which a drop fades into geometry, cm
uniform float SoftEdge = 40.0;

/// @group Look @desc Drops closer to the camera than this are not drawn (they would cover the screen), cm
uniform float NearClip = 30.0;

/// @group Look @desc Distance beyond NearClip over which drops fade in, cm
uniform float NearFade = 100.0;

/// @custom
float RainStreak(float2 UV, float Core)
{
    // Across the sprite: a bright core with soft sides. Along it: tapered at both ends.
    float Across = 1.0 - abs(UV.x * 2.0 - 1.0);
    float Width = pow(saturate(Across), lerp(6.0, 1.5, saturate(Core)));
    float Along = smoothstep(0.0, 0.25, UV.y) * (1.0 - smoothstep(0.7, 1.0, UV.y));
    return Width * Along;
}

export void M_DreamRainDrop(inout material m)
{
    float2 UV = UE.TexCoord(Index = 0);
    float4 Particle = UE.VertexColor();
    float4 Ambient   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AmbientSky");
    float4 MainLight = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLight");
    float4 MainColor = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLightColor");

    float3 Light = Ambient.rgb + MainColor.rgb * MainLight.w * MainLightShare;
    m.EmissiveColor = Particle.rgb * Light * Brightness;
    // A drop brushing past the lens would draw a sheet across the screen: fade drops out near the camera.
    float Near = saturate((UE.PixelDepth() - NearClip) / NearFade);
    m.Opacity = UE.DepthFade(InOpacity = RainStreak(UV, CoreWidth) * Particle.a * Near, FadeDistance = SoftEdge);
}
