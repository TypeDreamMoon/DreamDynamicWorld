// M_DreamRainSplash.dss -- a rain drop's splash: a small crown that opens and fades over the particle's life.
//
// Drawn on a camera-facing Niagara sprite placed where a fall path lands. The crown is a ring of droplets
// above the impact point that widens with the particle's relative time (0..1) and fades as it opens; lit by
// the sky like the drops.
#pragma material(ShadingModel = Unlit, BlendMode = Translucent, TwoSided = true, bUsedWithNiagaraSprites = true)

/// @group Look @desc How bright the splash is against the light around it
uniform float Brightness = 2.6;

/// @group Look @desc Number of droplets around the crown
uniform float Droplets = 7.0;

/// @custom
float SplashCrown(float2 UV, float Age, float Count)
{
    // The impact point is at the bottom centre; the crown rises and widens from it.
    float2 P = float2(UV.x * 2.0 - 1.0, (1.0 - UV.y) * 2.0);
    float Radius = lerp(0.15, 0.95, sqrt(saturate(Age)));
    float Dist = length(P);
    float Ring = 1.0 - saturate(abs(Dist - Radius) / 0.12);
    // Break the ring into droplets, only above the ground.
    float Angle = atan2(P.y, P.x);
    float Beads = pow(saturate(0.5 + 0.5 * cos(Angle * Count)), 3.0);
    float Above = saturate(P.y * 6.0);
    return Ring * lerp(0.35, 1.0, Beads) * Above * (1.0 - saturate(Age));
}

export void M_DreamRainSplash(inout material m)
{
    float2 UV = UE.TexCoord(Index = 0);
    float4 Particle = UE.ParticleColor();   // (not VertexColor: a Niagara sprite carries none, it reads white and opaque)
    float Age = UE.ParticleRelativeTime();
    float4 Ambient   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AmbientSky");
    float4 MainLight = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLight");
    float4 MainColor = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLightColor");

    float3 Light = Ambient.rgb + MainColor.rgb * MainLight.w * 0.08;
    m.EmissiveColor = Particle.rgb * Light * Brightness;
    m.Opacity = SplashCrown(UV, Age, Droplets) * Particle.a;
}
