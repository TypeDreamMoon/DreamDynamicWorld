// M_DreamSnowFlake.dss -- a snowflake: a soft round dot on a camera-facing Niagara sprite.
//
// Lit by the sky like the rain (ambient plus a share of the main light), so snow glows pale blue at night and
// warm in a low sun; the particle colour tints it and its alpha fades it; it fades out where it meets geometry.
#pragma material(ShadingModel = Unlit, BlendMode = Translucent, TwoSided = true, bUsedWithNiagaraSprites = true)

/// @group Look @desc How bright a flake is against the light around it
uniform float Brightness = 1.8;

/// @group Look @desc Share of the main (sun / moon) light a flake catches
uniform float MainLightShare = 0.12;

/// @group Look @desc Distance over which a flake fades into geometry, cm
uniform float SoftEdge = 20.0;

/// @custom
float SnowDot(float2 UV)
{
    float2 P = UV * 2.0 - 1.0;
    float R2 = dot(P, P);
    // A firm core with a soft rim, so the flake still reads when it is a few pixels across.
    return saturate(1.0 - R2) * lerp(0.6, 1.0, saturate(1.0 - R2 * 3.0));
}

export void M_DreamSnowFlake(inout material m)
{
    float2 UV = UE.TexCoord(Index = 0);
    float4 Particle = UE.ParticleColor();   // (not VertexColor: a Niagara sprite carries none, it reads white and opaque)
    float4 Ambient   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AmbientSky");
    float4 MainLight = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLight");
    float4 MainColor = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLightColor");

    float3 Light = Ambient.rgb + MainColor.rgb * MainLight.w * MainLightShare;
    m.EmissiveColor = Particle.rgb * Light * Brightness;
    // Flakes right at the lens would be big soft blobs: fade them out within half a metre of the camera.
    float Near = saturate((UE.PixelDepth() - 20.0) / 40.0);
    m.Opacity = UE.DepthFade(InOpacity = SnowDot(UV) * Particle.a * Near, FadeDistance = SoftEdge);
}
