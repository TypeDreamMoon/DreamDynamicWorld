// M_DreamDustPuff.dss -- a soft puff of blown dust on a camera-facing Niagara sprite: the near haze of a dust storm.
//
// A wide Gaussian with no edge to it, so many overlapping puffs read as drifting haze rather than as balls; lit by the
// sky like the rain and the snow (ambient plus a share of the main light); the particle colour tints it and its alpha
// fades it; it fades into geometry over a long distance and away right at the lens.
#pragma material(ShadingModel = Unlit, BlendMode = Translucent, TwoSided = true, bUsedWithNiagaraSprites = true)

/// @group Look @desc How bright the dust is against the light around it
uniform float Brightness = 1.4;

/// @group Look @desc Share of the main (sun / moon) light the dust catches
uniform float MainLightShare = 0.35;

/// @group Look @desc Distance over which a puff fades into geometry, cm
uniform float SoftEdge = 250.0;

/// @group Look @desc Distance from the camera within which a puff fades away, cm
uniform float NearFade = 300.0;

/// @custom
float PuffShape(float2 UV)
{
    float2 P = UV * 2.0 - 1.0;
    // A Gaussian that reaches zero at the sprite's edge (no visible rim).
    float R2 = dot(P, P);
    return saturate(exp(-R2 * 3.0) - 0.05) / 0.95;
}

export void M_DreamDustPuff(inout material m)
{
    float2 UV = UE.TexCoord(Index = 0);
    float4 Particle = UE.ParticleColor();   // (not VertexColor: a Niagara sprite carries none, it reads white and opaque)
    float4 Ambient   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AmbientSky");
    float4 MainLight = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLight");
    float4 MainColor = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLightColor");

    float3 Light = Ambient.rgb + MainColor.rgb * MainLight.w * MainLightShare;
    m.EmissiveColor = Particle.rgb * Light * Brightness;
    float Near = saturate((UE.PixelDepth() - 30.0) / max(NearFade, 1.0));
    m.Opacity = UE.DepthFade(InOpacity = PuffShape(UV) * Particle.a * Near, FadeDistance = SoftEdge);
}
