// M_DreamSky.dss -- the stylized sky dome of ADreamSky.
//
// Draws a gradient sky, the sun and its halo, the moon with its phase, stars (the real sky's, or a stylized scatter), the Milky Way, the aurora, the night's glow and a city's light, eclipses, thin high cloud with its ice halos and the moon's corona, noctilucent clouds, meteors and satellites, and rain shafts; the
// cumulus are the sky cloud renderer's (in the sky light capture, the panorama of them it draws), or where it does not draw,
// the dome's own flat clouds.
// It has no parameters of its own: everything comes from the plugin's shared parameter collection, which
// the world clock (sun, moon, time), the weather (cloud cover, the weather map's placement) and the sky
// subsystem (colours, clouds, lighting, the main light's colour) write every frame, so the dome always shows what the
// lights are doing.
// Where the clouds are thick or dark comes from the weather map, so a storm zone shows from afar. In the sky
// light capture the dome leaves out the stars and most of the sun disk (see DDW_SkyExtra). The drawing
// lives in /Plugin/DreamDynamicWorld/Private/DreamSkyStylized.ush.
#pragma material(ShadingModel = Unlit, TwoSided = true, bIsSky = true)

/// @default /DreamDynamicWorld/Weather/RT_DreamWeatherMap
static const Texture2D WeatherMap;

/// The 3D noise the high cloud and rain shafts are shaped from (Setup generates it; the sky cloud renderer uses the same).
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
static const VolumeTexture CloudNoise;

/// The sky cloud renderer's panorama of the clouds round the view: the dome shows it in the sky light capture while the
/// renderer draws the clouds (the capture never sees what the renderer draws into the view).
/// @default /DreamDynamicWorld/Sky/RT_DreamCloudPanorama
static const Texture2D CloudPanorama;

/// The real stars, from the Yale Bright Star Catalogue (Setup builds it; see DreamStarMap.h): read cell by cell.
/// @default /DreamDynamicWorld/Sky/T_DreamStarMap
static const Texture2D StarMap;

/// The Milky Way, made from noise (Setup builds it; see DreamMilkyWay.h): galactic longitude across, latitude down.
/// @default /DreamDynamicWorld/Sky/T_DreamMilkyWay
static const Texture2D MilkyWayMap;

/// The moon's face, NASA's colour map of the moon (Setup bakes it): selenographic longitude across, latitude down.
/// @default /DreamDynamicWorld/Sky/T_DreamMoonMap
static const Texture2D MoonMap;

/// The physical sky (DreamAtmosphere's sky table, built at run time; the sky sets it on the dome). The default only
/// stands in until then: while the table is not built the dome draws the style's gradient (DDW_AtmosphereSun.w = 0).
/// @group Atmosphere
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
uniform VolumeTexture SkyTable;

/// @custom
/// @name Dream Sky
float3 DreamSky_Shade(float3 V, float4 SunDir, float4 MoonDir, float4 Time, float4 Zenith, float4 Horizon, float4 Ground,
	float4 SunHalo, float4 SunDisk, float4 MoonDisk, float4 MoonHalo, float4 Stars, float4 Cloud0, float4 Cloud1,
	float4 Cloud2, float4 Cloud3, float4 CloudLit, float4 CloudShadow, float4 MainLight, float4 MainLightColor, float4 CloudLayer,
	float4 MapParams,
	float4 Flash, float4 Extra, float4 Haze, float4 Aurora, float4 AuroraLow, float4 AuroraHigh, float4 NightGlow,
	float4 LightPollution, float4 Eclipse, float4 LunarEclipse, float4 HaloRing, float4 HaloRing2, float4 EarthShadow, float4 EarthBelt, float4 Noctilucent, float4 NoctilucentColor, float4 Meteors, float4 MeteorRadiant, float4 MeteorLook, float4 FlatClouds, float4 CloudClearing, Texture2D Map, VolumeTexture Noise,
	Texture2D Panorama, float4 AuroraTones, float4 AuroraShape, float4 AuroraShape2, float4 AuroraShape3, float4 MoonLook, float4 StarLook, float4 StarPole, float4 StarEquinox, Texture2D StarCells, float4 MilkyWay, float4 MilkyWayDust,
	Texture2D Galaxy, Texture2D MoonFace, float3 Camera, float2 ScreenUV, float Seconds, float Capture,
	float4 SkyGrade0, float4 SkyGrade1, float4 SkyGrade2, float4 SkyGrade3, float4 AtmosphereSun, float4 AtmosphereMoon, VolumeTexture Air)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSkyStylized.ush"
	return DSky_Shade(V, SunDir, MoonDir, Time, Zenith, Horizon, Ground, SunHalo, SunDisk, MoonDisk, MoonHalo, Stars,
		Cloud0, Cloud1, Cloud2, Cloud3, CloudLit, CloudShadow, MainLight, MainLightColor, CloudLayer, MapParams, Flash, Extra,
		Haze, Aurora, AuroraLow, AuroraHigh, NightGlow, LightPollution, Eclipse, LunarEclipse, HaloRing, HaloRing2, EarthShadow, EarthBelt, Noctilucent, NoctilucentColor, Meteors, MeteorRadiant, MeteorLook, FlatClouds, CloudClearing, Map, MapSampler, Noise, NoiseSampler, Panorama,
		PanoramaSampler, AuroraTones, AuroraShape, AuroraShape2, AuroraShape3, MoonLook, StarLook, StarPole, StarEquinox, StarCells, MilkyWay, MilkyWayDust, Galaxy, GalaxySampler, MoonFace, MoonFaceSampler, Camera, ScreenUV,
		Seconds, Capture, SkyGrade0, SkyGrade1, SkyGrade2, SkyGrade3, AtmosphereSun, AtmosphereMoon, Air, AirSampler);
}

export void M_DreamSky(inout material m)
{
	float3 V = -UE.CameraVectorWS();
	float4 SunDir      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunDir");
	float4 MoonDir     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MoonDir");
	float4 Time        = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Time");
	float4 Zenith      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyZenith");
	float4 Horizon     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyHorizon");
	float4 Ground      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyGround");
	float4 SunHalo     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunHalo");
	float4 SunDisk     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunDisk");
	float4 MoonDisk    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MoonDisk");
	float4 MoonHalo    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MoonHalo");
	float4 Stars       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Stars");
	float4 Cloud0      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud0");
	float4 Cloud1      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud1");
	float4 Cloud2      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud2");
	float4 Cloud3      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud3");
	float4 CloudLit    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudLit");
	float4 CloudShadow = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudShadow");
	float4 MainLight   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLight");
	float4 MainLightColor = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLightColor");
	float4 CloudLayer  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudLayer");
	float4 MapParams   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_WeatherMap");
	float4 Flash       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Flash");
	float4 Extra       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyExtra");
	float4 Haze        = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyHaze");
	float4 Aurora      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Aurora");
	float4 AuroraLow   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AuroraLow");
	float4 AuroraHigh  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AuroraHigh");
	float4 NightGlow   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_NightGlow");
	float4 LightPollution = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_LightPollution");
	float4 Eclipse     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Eclipse");
	float4 LunarEclipse = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_LunarEclipse");
	float4 HaloRing    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Halo");
	float4 HaloRing2   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Halo2");
	float4 EarthShadow = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_EarthShadow");
	float4 EarthBelt   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_EarthBelt");
	float4 Noctilucent = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Noctilucent");
	float4 NoctilucentColor = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_NoctilucentColor");
	float4 Meteors     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Meteors");
	float4 MeteorRadiant = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MeteorRadiant");
	float4 MeteorLook  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MeteorLook");
	float4 FlatClouds  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_FlatClouds");
	float4 CloudClearing = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudClearing");
	float4 StarLook    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_StarLook");
	float4 MoonLook    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MoonLook");
	float4 AuroraTones = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AuroraTones");
	float4 AuroraShape = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AuroraShape");
	float4 AuroraShape2 = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AuroraShape2");
	float4 AuroraShape3 = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AuroraShape3");
	float4 StarPole    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_StarPole");
	float4 StarEquinox = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_StarEquinox");
	float4 MilkyWay    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MilkyWay");
	float4 MilkyWayDust = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MilkyWayDust");
	float4 SkyGrade0   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyGrade0");
	float4 SkyGrade1   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyGrade1");
	float4 SkyGrade2   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyGrade2");
	float4 SkyGrade3   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyGrade3");
	float4 AtmosphereSun  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AtmosphereSun");
	float4 AtmosphereMoon = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_AtmosphereMoon");
	// 1 while the dome is drawn into the sky light: the shader leaves out stars and most of the sun disk there.
	float Capture = UE.ReflectionCapturePassSwitch(Default = 0.0, Reflection = 1.0);
	m.EmissiveColor = DreamSky_Shade(V, SunDir, MoonDir, Time, Zenith, Horizon, Ground, SunHalo, SunDisk, MoonDisk, MoonHalo,
		Stars, Cloud0, Cloud1, Cloud2, Cloud3, CloudLit, CloudShadow, MainLight, MainLightColor, CloudLayer, MapParams, Flash, Extra,
		Haze, Aurora, AuroraLow, AuroraHigh, NightGlow, LightPollution, Eclipse, LunarEclipse, HaloRing, HaloRing2, EarthShadow, EarthBelt, Noctilucent, NoctilucentColor, Meteors, MeteorRadiant, MeteorLook, FlatClouds, CloudClearing, WeatherMap, CloudNoise, CloudPanorama,
		AuroraTones, AuroraShape, AuroraShape2, AuroraShape3, MoonLook, StarLook, StarPole, StarEquinox, StarMap, MilkyWay, MilkyWayDust, MilkyWayMap, MoonMap,
		UE.CameraPositionWS(),
		UE.ScreenPosition().ViewportUV,
		UE.Time(), Capture, SkyGrade0, SkyGrade1, SkyGrade2, SkyGrade3, AtmosphereSun, AtmosphereMoon, SkyTable);
}
