// M_DreamSky.dss -- the stylized sky dome of ADreamSky.
//
// Draws a gradient sky, the sun and its halo, the moon with its phase, stars, thin high cloud and rain shafts; the
// cumulus are the sky cloud renderer's (in the sky light capture, the panorama of them it draws).
// It has no parameters of its own: everything comes from the plugin's shared parameter collection, which
// the world clock (sun, moon, time), the weather (cloud cover, the weather map's placement) and the sky
// subsystem (colours, clouds, lighting, the main light's colour) write every frame, so the dome always shows what the
// lights are doing.
// Where the clouds are thick or dark comes from the weather map, so a storm zone shows from afar. In the sky
// light capture the dome leaves out the stars and most of the sun disk (see DDW_SkyExtra). The drawing
// lives in /Plugin/DreamDynamicWorld/Private/DreamSkyStylized.ush.
#pragma material(ShadingModel = Unlit, TwoSided = true, bIsSky = true)

/// @default /DreamDynamicWorld/Weather/RT_DreamWeatherMap
static const Texture2D WeatherMap;

/// The 3D noise the high cloud and rain shafts are shaped from (Setup generates it; the sky cloud renderer uses the same).
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
static const VolumeTexture CloudNoise;

/// The sky cloud renderer's panorama of the clouds round the view: the dome shows it in the sky light capture while the
/// renderer draws the clouds (the capture never sees what the renderer draws into the view).
/// @default /DreamDynamicWorld/Sky/RT_DreamCloudPanorama
static const Texture2D CloudPanorama;

/// @custom
/// @name Dream Sky
float3 DreamSky_Shade(float3 V, float4 SunDir, float4 MoonDir, float4 Time, float4 Zenith, float4 Horizon, float4 Ground,
	float4 SunHalo, float4 SunDisk, float4 MoonDisk, float4 MoonHalo, float4 Stars, float4 Cloud0, float4 Cloud1,
	float4 Cloud2, float4 Cloud3, float4 CloudLit, float4 CloudShadow, float4 MainLight, float4 MainLightColor, float4 CloudLayer,
	float4 MapParams,
	float4 Flash, float4 Extra, float4 Haze, Texture2D Map, VolumeTexture Noise, Texture2D Panorama, float3 Camera,
	float2 ScreenUV, float Seconds, float Capture)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSkyStylized.ush"
	return DSky_Shade(V, SunDir, MoonDir, Time, Zenith, Horizon, Ground, SunHalo, SunDisk, MoonDisk, MoonHalo, Stars,
		Cloud0, Cloud1, Cloud2, Cloud3, CloudLit, CloudShadow, MainLight, MainLightColor, CloudLayer, MapParams, Flash, Extra,
		Haze, Map, MapSampler, Noise, NoiseSampler, Panorama, PanoramaSampler, Camera, ScreenUV, Seconds, Capture);
}

export void M_DreamSky(inout material m)
{
	float3 V = -UE.CameraVectorWS();
	float4 SunDir      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunDir");
	float4 MoonDir     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MoonDir");
	float4 Time        = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Time");
	float4 Zenith      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyZenith");
	float4 Horizon     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyHorizon");
	float4 Ground      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyGround");
	float4 SunHalo     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunHalo");
	float4 SunDisk     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunDisk");
	float4 MoonDisk    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MoonDisk");
	float4 MoonHalo    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MoonHalo");
	float4 Stars       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Stars");
	float4 Cloud0      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud0");
	float4 Cloud1      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud1");
	float4 Cloud2      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud2");
	float4 Cloud3      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud3");
	float4 CloudLit    = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudLit");
	float4 CloudShadow = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudShadow");
	float4 MainLight   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLight");
	float4 MainLightColor = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_MainLightColor");
	float4 CloudLayer  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudLayer");
	float4 MapParams   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_WeatherMap");
	float4 Flash       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Flash");
	float4 Extra       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyExtra");
	float4 Haze        = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyHaze");
	// 1 while the dome is drawn into the sky light: the shader leaves out stars and most of the sun disk there.
	float Capture = UE.ReflectionCapturePassSwitch(Default = 0.0, Reflection = 1.0);
	m.EmissiveColor = DreamSky_Shade(V, SunDir, MoonDir, Time, Zenith, Horizon, Ground, SunHalo, SunDisk, MoonDisk, MoonHalo,
		Stars, Cloud0, Cloud1, Cloud2, Cloud3, CloudLit, CloudShadow, MainLight, MainLightColor, CloudLayer, MapParams, Flash, Extra,
		Haze, WeatherMap, CloudNoise, CloudPanorama, UE.CameraPositionWS(), UE.ScreenPosition().ViewportUV, UE.Time(), Capture);
}
