// M_DreamVolumetricCloud.dss -- the cloud layer of ADreamSky when its clouds are volumetric (the engine's
// volumetric cloud renderer).
//
// The engine marches, lights (the sun and the moon are the atmosphere lights, plus the sky light), shadows and
// filters the layer; this material says how dense the cloud is at a sample, what it scatters, and an ambient glow
// (the sky light the engine's single sky-light term leaves out). The shapes are the same clouds the dome's toon
// clouds draw: /Plugin/DreamDynamicWorld/Private/DreamSkyCloudShape.ush, from the weather map and the 3D noise
// T_DreamCloudNoise; the colours and the weather come from the plugin's shared parameter collection, like the sky
// dome's. The air between the view and a cloud veils it in the dome's own colour behind it (hazy low down, clear
// higher up), as on the toon clouds.
//
// The look is a fair-weather cumulus field: the sunlit faces bright (a cloud hardly absorbs, so what the sun puts in
// comes back out), the bases flat and several times darker (the sun's light is spent before it gets there, and the
// sky above is hidden by the cloud itself: the glow falls off steeply toward the base), the outline clear (a
// cumulus is optically thick: its faint fringe is thin). An overcast deck is mottled from below, darker where it
// is thicker, rather than one flat grey.
#pragma material(Domain = Volume, BlendMode = Additive, bTangentSpaceNormal = false, bCastRayTracedShadows = false)

/// @default /DreamDynamicWorld/Weather/RT_DreamWeatherMap
static const Texture2D WeatherMap;

/// The 3D noise the shapes are built from (Setup generates it).
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
static const VolumeTexture CloudNoise;

/// @group Cloud   @sort 10   @slider 0.01 0.3   @desc Extinction of a solid cloud, per metre (a real cumulus is about 0.04 to 0.2): higher = harder, the inside unseen
uniform float CloudExtinction = 0.08;

/// @group Cloud   @sort 20   @slider 0.5 1   @desc How much of the light a cloud scatters rather than absorbs (a real cloud: nearly all of it)
uniform float CloudAlbedo = 0.98;

/// @group Cloud   @sort 30   @slider 0 4   @desc How much of the style's shade colour the clouds glow with at their tops (the sky light falling on them)
uniform float CloudGlow = 0.75;

/// @group Cloud   @sort 40   @slider 0 1   @desc How much of that glow reaches a cloud's base (the sky above it is hidden by the cloud): lower = darker, flatter bases
uniform float BaseGlow = 0.15;

/// @group Cloud   @sort 50   @slider 0 1   @desc How mottled an overcast deck is from below (darker where it is thicker)
uniform float DeckMottle = 0.45;

/// @group Cloud   @sort 60   @desc Multiplies the style's shade colour in the glow: the shaded sides keep the sky's blue-grey even where the weather greys the style's colours
uniform float4 ShadeTint = float4(0.86, 0.95, 1.14, 1.0);

/// @group Cloud   @sort 70   @slider 0.1 1   @desc By day, how thick the body of a near cloud is to the eye (not to the light): lower = less grain, the inside seen a little deeper
uniform float ViewThinning = 0.35;

/// @group Cloud   @sort 80   @desc How far the cloud shadow map reaches around the view, cm (Dream Sky makes it its VolumetricTracingDistance): the clouds' shadows fade out short of it
uniform float ShadowReach = 6000000.0;

/// @group Scattering   @sort 10   @slider -0.9 0.9   @desc Forward scattering lobe (silver lining): stronger makes small lumps near the sun glow as white balls
uniform float ScatterForward = 0.8;
/// @group Scattering   @sort 20   @slider -0.9 0.9   @desc Backward scattering lobe (the sunlit faces seen with the sun behind the view)
uniform float ScatterBackward = -0.3;
/// @group Scattering   @sort 30   @slider 0 1   @desc Blend between the forward and the backward lobe
uniform float ScatterBlend = 0.5;
/// @group Scattering   @sort 40   @slider 0 1   @desc Multiple scattering: how much light keeps scattering inside
uniform float MultiScatter = 0.85;
/// @group Scattering   @sort 50   @slider 0 1   @desc How much the cloud occludes its own multiple scattering: higher = the light spreads less deep, the bases darker
uniform float MultiScatterOcclusion = 0.5;
/// @group Scattering   @sort 60   @slider 0 1   @desc How directional multiple scattering stays
uniform float MultiScatterEccentricity = 0.5;

/// @custom
/// @name Dream Cloud Sample
void DreamCloud_Sample(float3 Rel, float3 World, float Z, float4 Cloud0, float4 Cloud1, float4 Cloud2, float4 Cloud3,
	float4 CloudLayer, float4 MapParams, float4 CloudShadow, float4 Flash, float4 Extra, float4 SunDir, float4 Zenith,
	float4 Horizon, float4 Ground, float4 SunHalo, float Sigma, float Albedo, float Glow, float BaseShare, float Mottle,
	float Occlusion, float4 ShadeMul, float Detail, float ViewThinning, float ShadowReach, Texture2D Map, VolumeTexture Noise,
	out float3 OutExtinction, out float3 OutAlbedo, out float3 OutEmissive, out float OutConservative)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSkyStylized.ush"
	FDCloudShape S = DCS_Shape(Rel, World, Z, Cloud0, Cloud1, Cloud2, CloudLayer, MapParams, Detail, Map, MapSampler,
		Noise, NoiseSampler);
	OutConservative = S.Conservative;
	// A storm cloud is denser and darker (it absorbs: rain and graupel), its lit top less so.
	float Storm = CloudLayer.z * S.Dark * lerp(1.0, 0.35, S.Height);
	// The density's faint fringe is drawn in a little (1 - (1 - d)^2): the outline reads clear instead of a smoky
	// skirt, yet stays soft (drawn in harder, small cumulus turned to hard white balls and the billows to grapes).
	// At night the core, where a small cumulus is still thin by the shape's measure, is thickened: the stars must not
	// show through it. (Not by day: thickened, every narrow crevice between the cores of a big cloud drew as a thin
	// dark line.)
	float Fringe = 1.0 - (1.0 - S.Density) * (1.0 - S.Density);
	float Night = 1.0 - smoothstep(-0.12, -0.02, SunDir.z);
	float Core = smoothstep(0.08, 0.3, S.Density) * Night;
	float E = (Fringe + 2.0 * Core) * Sigma * (1.0 + S.Dark);
	// By day the march toward the eye sees the body a third as thick. Its steps (some 80 m near, hundreds far off) are
	// many times a solid cloud's mean free path (some 12 m): the first sample that lands in it would take the whole
	// pixel, lit by wherever in its step the per-pixel jitter put it -- a standing grain over every cloud. Thinner,
	// a pixel is the average of a few samples. (Toward the light, for the shading and the shadows, it stays as thick;
	// so do the faint outer parts and every cloud at night, or the sun and the stars would show through. Far off, where
	// a cloud is small and veiled, it stays as thick too: the rays would go deeper before the engine stops them, at a
	// cost and nothing to see. Not spared in front of the sun: spared there, the disk read through a storm's deck as a
	// ring of other brightness.)
	float Distance = length(Rel);
	float3 Ray = Rel / max(Distance, 1.0);
	if (Detail > 0.5)
	{
		float Body = smoothstep(0.08, 0.3, S.Density) * (1.0 - Night) * (1.0 - smoothstep(800000.0, 2000000.0, Distance));
		E *= lerp(1.0, ViewThinning, Body);
	}
	else
	{
		// Toward the light the cloud fades out by where its shadow lands, short of the shadow map's edge (the map
		// reaches ShadowReach around the view; past it the ground is in full sun). Seen from among the clouds, far ground
		// is squeezed into a few degrees over the horizon: faded over the last few kilometres the edge was still a line;
		// faded from a quarter of the way out it is a gradient.
		float3 L = normalize(SunDir.xyz);
		float2 Lands = Rel.xy - L.xy * (max(World.z, 0.0) / max(L.z, 0.05));
		E *= 1.0 - smoothstep(0.25 * ShadowReach, 0.95 * ShadowReach, length(Lands));
	}
	OutExtinction = E.xxx;
	OutAlbedo = (Albedo * (1.0 - 0.75 * Storm) * (1.0 - 0.2 * S.Deck)).xxx;

	// The glow: the sky light on the cloud, which its top sees whole and its base hardly (UDS's top / bottom emissive,
	// (1 - h)^3): the style's shade colour at the top, BaseShare of it at the base.
	float FromBase = 1.0 - saturate(S.Height);
	float Shade01 = lerp(1.0, BaseShare, FromBase * FromBase * FromBase);
	// An overcast deck seen from below: thicker and thinner patches some kilometres across.
	if (S.Deck > 0.0)
	{
		float Scale = max(Cloud0.z, 0.05);
		float2 P = World.xy + Cloud1.xy * 220000.0 * Scale;
		float Patch = Noise.SampleLevel(NoiseSampler, float3(P / (1100000.0 * Scale), 0.83), 0).g;
		Shade01 *= 1.0 + (Patch - 0.5) * 2.0 * Mottle * S.Deck;
	}
	float3 Shade = CloudShadow.rgb * ShadeMul.rgb * Glow * Shade01 * (1.0 - 0.8 * Storm);
	// The air between: what the cloud scatters fades, and the sky behind it (a dense cloud glows Emissive / E)
	// takes its place.
	float Veil = DCS_AirVeil(Distance, Ray.z, World.z - Rel.z, Cloud0.x, Cloud3);
	float3 Halo;
	// (Looking down on a cloud, the air between takes the low sky's colour, not the ground's.)
	float3 Behind = DSky_Backdrop(DSky_HazeDirection(Ray), normalize(SunDir.xyz), Zenith, Horizon, Ground, SunHalo, Halo) + Halo;
	OutAlbedo *= 1.0 - Veil;
	// The engine adds the glow again for each of its two multiple scattering octaves, through the cloud thinned to
	// Occlusion and Occlusion squared: in a dense cloud it shows 1 + 1 / Occlusion + 1 / Occlusion^2 times over.
	// Divided out, the glow is what it says (a cloud the air veils completely is exactly the sky behind it).
	float Thin = 1.0 / max(Occlusion, 0.05);
	OutEmissive = lerp(Shade, Behind, Veil) * E / (1.0 + Thin + Thin * Thin);
	// Lightning lights the clouds toward the strike from inside.
	float FlashNow = Flash.w * Extra.w;
	if (FlashNow > 0.0)
	{
		float Toward = pow(saturate(dot(Ray, normalize(Flash.xyz))), 3.0);
		OutEmissive += float3(0.75, 0.8, 1.0) * FlashNow * (0.15 + 0.85 * Toward) * E * 3.0;
	}
}

export void M_DreamVolumetricCloud(inout material m)
{
	float4 Cloud0      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud0");
	float4 Cloud1      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud1");
	float4 Cloud2      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud2");
	float4 Cloud3      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud3");
	float4 CloudLayer  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudLayer");
	float4 MapParams   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_WeatherMap");
	float4 CloudShadow = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudShadow");
	float4 Flash       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Flash");
	float4 Extra       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyExtra");
	float4 SunDir      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunDir");
	float4 Zenith      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyZenith");
	float4 Horizon     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyHorizon");
	float4 Ground      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyGround");
	float4 SunHalo     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunHalo");

	float3 SampleExtinction;
	float3 SampleAlbedo;
	float3 SampleEmissive;
	float Conservative;
	float3 World = UE.WorldPosition().XYZ;
	// Samples taken toward a light (the engine's shadow march, its shadow and sky occlusion maps) skip the fine fraying.
	float ShadowDetail = saturate(1.0 - UE.CloudSampleAttribute().ShadowSampleDistance);
	DreamCloud_Sample(World - UE.CameraPositionWS(), World, UE.CloudSampleAttribute().AltitudeInLayer,
		Cloud0, Cloud1, Cloud2, Cloud3, CloudLayer, MapParams, CloudShadow, Flash, Extra, SunDir, Zenith, Horizon, Ground, SunHalo,
		CloudExtinction, CloudAlbedo, CloudGlow, BaseGlow, DeckMottle, MultiScatterOcclusion, ShadeTint, ShadowDetail, ViewThinning, ShadowReach, WeatherMap, CloudNoise,
		SampleExtinction, SampleAlbedo, SampleEmissive, Conservative);

	// Two octaves of multiple scattering carry the sunlight deeper into the sunlit faces (they cost arithmetic, not
	// material evaluations); the bases of big clouds stay dark. (Not a grey-scale material: the engine would read only
	// the red channel of the glow too, and the shade's blue would be lost.)
	UE.VolumetricAdvancedMaterialOutput(PhaseG = ScatterForward, PhaseG2 = ScatterBackward, PhaseBlend = ScatterBlend,
		MultiScatteringContribution = MultiScatter, MultiScatteringOcclusion = MultiScatterOcclusion,
		MultiScatteringEccentricity = MultiScatterEccentricity, ConservativeDensity = float3(Conservative, Conservative, Conservative),
		MultiScatteringApproximationOctaveCount = 2, bClampMultiScatteringContribution = false, bGroundContribution = false);

	m.BaseColor = SampleAlbedo;
	m.SubsurfaceColor = SampleExtinction;
	m.EmissiveColor = SampleEmissive;
	m.AmbientOcclusion = 1.0;
}
