// M_DreamVolumetricCloud.dss -- the cloud layer of ADreamSky when its clouds are volumetric (the engine's
// volumetric cloud renderer).
//
// The engine marches, lights (the sun and the moon are the atmosphere lights, plus the sky light), shadows and
// filters the layer; this material says how dense the cloud is at a sample, what it scatters, and an ambient glow
// (sky light the engine's single sky-light term leaves out, so undersides keep the style's shade colour rather
// than going grey). The shapes are the same clouds the dome's toon clouds draw: /Plugin/DreamDynamicWorld/Private/
// DreamSkyCloudShape.ush, from the weather map and the 3D noise T_DreamCloudNoise; the colours and the weather
// come from the plugin's shared parameter collection, like the sky dome's. The air between the view and a cloud
// veils it in the dome's own colour behind it (hazy low down, clear higher up), as on the toon clouds.
#pragma material(Domain = Volume, BlendMode = Additive, bTangentSpaceNormal = false, bCastRayTracedShadows = false)

/// @default /DreamDynamicWorld/Weather/RT_DreamWeatherMap
static const Texture2D WeatherMap;

/// The 3D noise the shapes are built from (Setup generates it).
/// @default /DreamDynamicWorld/Sky/T_DreamCloudNoise
static const VolumeTexture CloudNoise;

/// @group Cloud   @sort 10   @slider 0.01 0.3   @desc Extinction of a solid cloud, per metre (a real cumulus is about 0.04 to 0.2): higher = harder, the inside unseen
uniform float CloudExtinction = 0.08;

/// @group Cloud   @sort 30   @slider 0 4   @desc How much of the style's shade colour the clouds glow with (keeps undersides from going grey)
uniform float CloudGlow = 1.7;

/// @group Scattering   @sort 10   @slider -0.9 0.9   @desc Forward scattering lobe (silver lining)
uniform float ScatterForward = 0.8;
/// @group Scattering   @sort 20   @slider -0.9 0.9   @desc Backward scattering lobe
uniform float ScatterBackward = -0.5;
/// @group Scattering   @sort 30   @slider 0 1   @desc Blend between the forward and the backward lobe
uniform float ScatterBlend = 0.5;
/// @group Scattering   @sort 40   @slider 0 1   @desc Multiple scattering: how much light keeps scattering inside
uniform float MultiScatter = 0.8;
/// @group Scattering   @sort 50   @slider 0 1   @desc How much the cloud occludes its own multiple scattering
uniform float MultiScatterOcclusion = 0.3;
/// @group Scattering   @sort 60   @slider 0 1   @desc How directional multiple scattering stays
uniform float MultiScatterEccentricity = 0.6;

/// @custom
/// @name Dream Cloud Sample
void DreamCloud_Sample(float3 Rel, float3 World, float Z, float4 Cloud0, float4 Cloud1, float4 Cloud2, float4 Cloud3,
	float4 CloudLayer, float4 MapParams, float4 CloudShadow, float4 Flash, float4 Extra, float4 SunDir, float4 Zenith,
	float4 Horizon, float4 Ground, float4 SunHalo, float Sigma, float Glow, float Occlusion, Texture2D Map, VolumeTexture Noise,
	out float3 OutExtinction, out float3 OutAlbedo, out float3 OutEmissive, out float OutConservative)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSkyStylized.ush"
	FDCloudShape S = DCS_Shape(Rel, World, Z, Cloud0, Cloud1, Cloud2, CloudLayer, MapParams, 1.0, Map, MapSampler,
		Noise, NoiseSampler);
	// A storm cloud is denser and darker (lower albedo), its lit top less so.
	float Storm = CloudLayer.z * S.Dark * lerp(1.0, 0.35, S.Height);
	float E = S.Density * Sigma * (1.0 + S.Dark);
	OutExtinction = E.xxx;
	// An overcast deck is grey from below, not white.
	float Deck = S.Deck;
	OutAlbedo = (0.95 * (1.0 - 0.75 * Storm) * (1.0 - 0.35 * Deck)).xxx;
	// The glow: the style's shade colour, held to about that colour however thick; dimmer toward the base (the sky
	// light reaching a cloud's underside is mostly blocked by the cloud itself).
	float3 Shade = CloudShadow.rgb * lerp(0.3, 1.0, pow(S.Height, 0.7)) * Glow * (1.0 - 0.8 * Storm);
	// The air between: what the cloud scatters fades, and the sky behind it (a dense cloud glows Emissive / E)
	// takes its place.
	float Distance = length(Rel);
	float3 Ray = Rel / max(Distance, 1.0);
	float Veil = DCS_AirVeil(Distance, Ray.z, Cloud0.x, Cloud3);
	float3 Halo;
	float3 Behind = DSky_Backdrop(Ray, normalize(SunDir.xyz), Zenith, Horizon, Ground, SunHalo, Halo) + Halo;
	OutAlbedo *= 1.0 - Veil;
	// The engine adds the glow again for its multiple scattering octave, through the cloud thinned to Occlusion: in a
	// dense cloud it shows 1 + 1 / Occlusion times over. Divided out, the glow is what it says (a cloud the air
	// veils completely is exactly the sky behind it).
	OutEmissive = lerp(Shade, Behind, Veil) * E / (1.0 + 1.0 / max(Occlusion, 0.05));
	// Lightning lights the clouds toward the strike from inside.
	float FlashNow = Flash.w * Extra.w;
	if (FlashNow > 0.0)
	{
		float Toward = pow(saturate(dot(normalize(Rel), normalize(Flash.xyz))), 3.0);
		OutEmissive += float3(0.75, 0.8, 1.0) * FlashNow * (0.15 + 0.85 * Toward) * E * 3.0;
	}
	OutConservative = S.Conservative;
}

export void M_DreamVolumetricCloud(inout material m)
{
	float4 Cloud0      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud0");
	float4 Cloud1      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud1");
	float4 Cloud2      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud2");
	float4 Cloud3      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Cloud3");
	float4 CloudLayer  = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudLayer");
	float4 MapParams   = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_WeatherMap");
	float4 CloudShadow = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_CloudShadow");
	float4 Flash       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_Flash");
	float4 Extra       = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyExtra");
	float4 SunDir      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunDir");
	float4 Zenith      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyZenith");
	float4 Horizon     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyHorizon");
	float4 Ground      = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SkyGround");
	float4 SunHalo     = UE.CollectionParameter(Collection = "/DreamDynamicWorld/MPC_DreamDynamicWorld.MPC_DreamDynamicWorld", Parameter = "DDW_SunHalo");

	float3 SampleExtinction;
	float3 SampleAlbedo;
	float3 SampleEmissive;
	float Conservative;
	float3 World = UE.WorldPosition().XYZ;
	DreamCloud_Sample(World - UE.CameraPositionWS(), World, UE.CloudSampleAttribute().AltitudeInLayer,
		Cloud0, Cloud1, Cloud2, Cloud3, CloudLayer, MapParams, CloudShadow, Flash, Extra, SunDir, Zenith, Horizon, Ground, SunHalo,
		CloudExtinction, CloudGlow, MultiScatterOcclusion, WeatherMap, CloudNoise, SampleExtinction, SampleAlbedo, SampleEmissive,
		Conservative);

	UE.VolumetricAdvancedMaterialOutput(PhaseG = ScatterForward, PhaseG2 = ScatterBackward, PhaseBlend = ScatterBlend,
		MultiScatteringContribution = MultiScatter, MultiScatteringOcclusion = MultiScatterOcclusion,
		MultiScatteringEccentricity = MultiScatterEccentricity, ConservativeDensity = float3(Conservative, Conservative, Conservative),
		MultiScatteringApproximationOctaveCount = 1, bClampMultiScatteringContribution = false, bGroundContribution = true);

	m.BaseColor = SampleAlbedo;
	m.SubsurfaceColor = SampleExtinction;
	m.EmissiveColor = SampleEmissive;
	m.AmbientOcclusion = 1.0;
}
