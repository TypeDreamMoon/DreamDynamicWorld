// DreamSurface - the weather on a surface, realistic: one node at the end of a material's attributes.
//
// MF_DreamSurfaceWeather(Attributes) -> Attributes
//
//   MF_DreamSurfaceWeather(Attrs, Attrs);     // the last thing before Base.MaterialAttributes
//
// What the weather has left there (as MF_DreamSurfaceSample: wet, standing water, snow, dust, lowered under cover)
// changes the attributes the way the real thing does (after Lagarde, "Water drop 3b", 2013):
//   wet     a porous surface darkens, soft ground (Softness) the most; a hard one turns glossier (roughness 0.2-0.35,
//           never a mirror), soft ground barely; metal does not darken
//   water   stands where it lies deep enough on what faces up - small hollows of Puddle Scale, the ground's own dips
//           (the level's baked heights) - dark, mirror-smooth, flat; faint on soft ground
//   snow    lies on what faces up first, steep slopes last, thinning out softly over metres; white, matte, flat
//   dust    settles on what faces up, under the snow: the dust's colour, rough, not metal
// MF_DreamSurfaceWeatherTerrain adds the snow's depth; MF_DreamSurfaceWeatherToon shifts colour bands instead.
// The HLSL is Shaders/Private/DreamSurfaceMaterial.ush.

Function float4 DreamSurface_Shown(
	in float3 WorldPos,
	in float4 NearPlace, in float4 FarPlace, in float4 ViewState, in float4 Params,
	in Texture2D NearMap, in Texture2D FarMap, in Texture2D CoverMap, in Texture2D MaskMap)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSurfaceMaterial.ush"
	float4 Mask = DSM_Mask(WorldPos, NearPlace, MaskMap, MaskMapSampler);
	float4 State = DSM_State(WorldPos, NearPlace, FarPlace, ViewState, NearMap, NearMapSampler, FarMap, FarMapSampler) * Mask;
	// The snow fades over metres where it changes (DSM_SnowSoft).
	State.z = DSM_SnowSoft(WorldPos, NearPlace, FarPlace, ViewState, NearMap, NearMapSampler, FarMap, FarMapSampler) * Mask.z;
	return DSM_Covered(State, DSM_Exposure(WorldPos, NearPlace, Params, CoverMap, CoverMapSampler));
}

Function float DreamSurface_RainHere(in float3 WorldPos, in float4 NearPlace, in float4 Params, in float4 Weather0, in Texture2D CoverMap)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSurfaceMaterial.ush"
	return DSM_RainHere(Weather0, DSM_Exposure(WorldPos, NearPlace, Params, CoverMap, CoverMapSampler));
}

Function float4 DreamSurface_Trail(in float3 WorldPos, in float4 TrailPlace, in Texture2D TrailMap)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSurfaceMaterial.ush"
	return DSM_Trail(WorldPos, TrailPlace, TrailMap, TrailMapSampler);
}

Function float DreamSurface_Low(in float3 WorldPos, in float4 NearPlace, in Texture2D CoverMap)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSurfaceMaterial.ush"
	return DSM_Low(WorldPos, NearPlace, CoverMap, CoverMapSampler);
}

Function float4 DreamSurface_ColorRough(in float3 Color, in float Rough, in float Metal, in float3 Normal, in float4 State, in float3 WorldPos, in float Up, in float Rain, in float Time, in float4 Trail, in float Soft, in float Low, in float PuddleScale, in float4 LookWet, in float4 LookWater, in float4 LookSnow, in float4 LookDust, in float4 LookMore)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSurfaceMaterial.ush"
	FDreamSurfaceLook L = DSM_Realistic(Color, Rough, Metal, Normal, State, WorldPos, Up, Rain, Time, Trail, Soft, Low, PuddleScale, LookWet, LookWater, LookSnow, LookDust, LookMore);
	return float4(L.Color, L.Roughness);
}

Function float4 DreamSurface_NormalMetal(in float3 Color, in float Rough, in float Metal, in float3 Normal, in float4 State, in float3 WorldPos, in float Up, in float Rain, in float Time, in float4 Trail, in float Soft, in float Low, in float PuddleScale, in float4 LookWet, in float4 LookWater, in float4 LookSnow, in float4 LookDust, in float4 LookMore)
{
	#include "/Plugin/DreamDynamicWorld/Private/DreamSurfaceMaterial.ush"
	FDreamSurfaceLook L = DSM_Realistic(Color, Rough, Metal, Normal, State, WorldPos, Up, Rain, Time, Trail, Soft, Low, PuddleScale, LookWet, LookWater, LookSnow, LookDust, LookMore);
	return float4(L.Normal, L.Metallic);
}

ShaderFunction(Name="Surface/MaterialFunctions/MF_DreamSurfaceWeather", Root="Plugin.DreamDynamicWorld")
{
	Settings = {
		Description       = "DreamSurface: the weather on a surface (wet, puddles, snow, dust), realistic. Attributes in, attributes out: put it last.";
		ExposeToLibrary   = true;
		LibraryCategories = "DreamSurface";
	}

	Properties = {
		const Texture2D NearMap  = Path(Plugin.DreamDynamicWorld, "Surface/RT_DreamSurfaceNear");
		const Texture2D FarMap   = Path(Plugin.DreamDynamicWorld, "Surface/RT_DreamSurfaceFar");
		const Texture2D CoverMap = Path(Plugin.DreamDynamicWorld, "Surface/RT_DreamSurfaceCover");
		const Texture2D MaskMap  = Path(Plugin.DreamDynamicWorld, "Surface/RT_DreamSurfaceMask");
		const Texture2D TrailMap = Path(Plugin.DreamDynamicWorld, "Surface/RT_DreamSurfaceTrails");
		UE.CollectionParam(Collection = Path(Plugin.DreamDynamicWorld, "MPC_DreamDynamicWorld"), Parameter = "DDW_SurfaceNear") NearPlace;
		UE.CollectionParam(Collection = Path(Plugin.DreamDynamicWorld, "MPC_DreamDynamicWorld"), Parameter = "DDW_SurfaceFar") FarPlace;
		UE.CollectionParam(Collection = Path(Plugin.DreamDynamicWorld, "MPC_DreamDynamicWorld"), Parameter = "DDW_SurfaceView") ViewState;
		UE.CollectionParam(Collection = Path(Plugin.DreamDynamicWorld, "MPC_DreamDynamicWorld"), Parameter = "DDW_SurfaceParams") Params;
		UE.CollectionParam(Collection = Path(Plugin.DreamDynamicWorld, "MPC_DreamDynamicWorld"), Parameter = "DDW_SurfaceTrails") TrailPlace;
		UE.CollectionParam(Collection = Path(Plugin.DreamDynamicWorld, "MPC_DreamDynamicWorld"), Parameter = "DDW_Weather0") Weather0;

		Group("Weather Look|Wet") {
			ScalarParameter WetValueHard    = 0.85 [Slider(0, 1); Description="How much of its colour a wet hard surface (stone, paving) keeps: 1 none darker."];
			ScalarParameter WetValuePorous  = 0.4  [Slider(0, 1); Description="How much of its colour a wet porous surface (rough, or soft ground) keeps."];
			ScalarParameter WetRoughHard    = 0.2  [Slider(0, 1); Description="The roughness a wet hard surface goes down to (low: glossier)."];
			ScalarParameter WetRoughPorous  = 0.35 [Slider(0, 1); Description="The roughness a wet porous surface goes down to."];
		}
		Group("Weather Look|Water") {
			ScalarParameter PuddleValue     = 0.35 [Slider(0, 1); Description="How much of its colour a surface under standing water keeps."];
			ScalarParameter PuddleRoughness = 0.02 [Slider(0, 1); Description="Standing water's roughness: 0 a mirror."];
			ScalarParameter RippleStrength  = 0.35 [Slider(0, 1); Description="How far the rain's ripples tilt the water's surface."];
		}
		Group("Weather Look|Snow") {
			VectorParameter SnowColor       = float4(0.88, 0.9, 0.93, 1.0) [Description="The snow's colour."];
			ScalarParameter SnowRoughness   = 0.6  [Slider(0, 1)];
			ScalarParameter SnowCoverGain   = 1.0  [Slider(0, 3); Description="How readily the snow covers: above 1 a thin fall covers sooner, below 1 later."];
			ScalarParameter PrintDarken     = 0.12 [Slider(0, 1); Description="How much darker a print trodden in the snow is."];
		}
		Group("Weather Look|Dust") {
			VectorParameter DustColor       = float4(0.55, 0.46, 0.34, 1.0) [Description="The dust's colour."];
			ScalarParameter DustAmount      = 0.85 [Slider(0, 1); Description="How much of the dust's colour shows where it lies."];
			ScalarParameter DustRoughness   = 0.95 [Slider(0, 1)];
		}
	}

	Inputs = {
		MaterialAttributes Attributes;
		float Softness = 0.0 [Desc="0 a hard surface (stone, paving, wood, metal) .. 1 soft ground (soil, grass): wet, soft ground mostly darkens, its puddles are faint."];
	}

	Outputs = {
		MaterialAttributes Result;
	}

	Graph = {
		float3 WP = UE.WorldPosition();
		float Up = saturate(UE.VertexNormalWS().z);
		float4 State = DreamSurface_Shown(WP, NearPlace, FarPlace, ViewState, Params, NearMap, FarMap, CoverMap, MaskMap);
		float Rain = DreamSurface_RainHere(WP, NearPlace, Params, Weather0, CoverMap);
		float Seconds = UE.Time();
		float4 Trail = DreamSurface_Trail(WP, TrailPlace, TrailMap);
		float Low = DreamSurface_Low(WP, NearPlace, CoverMap);
		float4 LookWet = float4(WetValueHard, WetValuePorous, WetRoughHard, WetRoughPorous);
		float4 LookWater = float4(PuddleValue, PuddleRoughness, RippleStrength, 0.0);
		float4 LookSnow = float4(SnowColor.rgb, SnowRoughness);
		float4 LookDust = float4(DustColor.rgb, DustAmount);
		float4 LookMore = float4(SnowCoverGain, DustRoughness, PrintDarken, 0.0);
		float4 CR = DreamSurface_ColorRough(Attributes.BaseColor, Attributes.Roughness, Attributes.Metallic, Attributes.Normal, State, WP, Up, Rain, Seconds, Trail, Softness, Low, Params.w, LookWet, LookWater, LookSnow, LookDust, LookMore);
		float4 NM = DreamSurface_NormalMetal(Attributes.BaseColor, Attributes.Roughness, Attributes.Metallic, Attributes.Normal, State, WP, Up, Rain, Seconds, Trail, Softness, Low, Params.w, LookWet, LookWater, LookSnow, LookDust, LookMore);
		Result = Attributes;
		Result.BaseColor = CR.xyz;
		Result.Roughness = CR.w;
		Result.Normal = NM.xyz;
		Result.Metallic = NM.w;
	}
}
